<a onclick="Approve(@Model.LeaveApplicationId)" class="btn btn-primary btn-lg"><i class="fa fa-plus left"></i> APPROVE LEAVE</a>

<script type="text/javascript">
    function Approve(leaveTypeId) {
        //var url = "/LeaveApplications/Approve?id=" + leaveTypeId;
        $.post("/LeaveApplications/Approve", { "id": leaveTypeId },
            function (data) {
                if (data.status) {
                    $('#actionsList').modal("hide");
                    toastr["success"](data.message);
                    window.oTable.ajax.reload(); //run my_fun() ondomready

                } else {
                    toastr["error"](data.message);
                    window.oTable.ajax.reload(); //run my_fun() ondomready

                }
            });
        //$('#myModalDivBody').load(url,
        //    function () {
        //        $('#actionsList').modal("show");
        //    });
    };
</script>
