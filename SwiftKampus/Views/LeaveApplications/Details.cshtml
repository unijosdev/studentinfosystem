@model SwiftKampusModel.Employee.Leave.LeaveApplication
@{
    var noOfDays = Model.EndDate - Model.StartDate ;

    double calcBusinessDays =
        1 + ((Model.EndDate - Model.StartDate).TotalDays * 5 -
             (Model.StartDate.DayOfWeek - Model.EndDate.DayOfWeek) * 2) / 7;

    if (Model.EndDate.DayOfWeek == DayOfWeek.Saturday) {calcBusinessDays--;}
    if (Model.StartDate.DayOfWeek == DayOfWeek.Sunday) {calcBusinessDays--;}

    
        }
