@*<a href="@Url.Action("Create","LeaveApplications")" class="btn btn-primary btn-lg" ><i class="fa fa-plus left"></i> APPLY FOR LEAVE</a>*@
<br />
<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h3>List of Pending Leave Application</h3>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                        <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                            <i class="fa fa-wrench"></i>
                        </a>
                    </div>
                </div>


                <div class="ibox-content">
                    <div class="table-responsive">
                        <table id="Jdatatable" class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>Leave Type Name</th>
                                    <th>Full Name</th>
                                    <th>Start Date</th>
                                    <th>End Date</th>
                                    <th>Reason</th>
                                    <th>Is Half day</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


                <!-- Modal -->
                <div class="modal fade modal-bf-fh" id="actionsList" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
                    <div class="modal-dialog" role="document">
                        <!--Content-->
                        <div class="modal-content">
                            <!--Header-->
                            <div class="modal-header">
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                                <div class="flex-center">
                                    <h4 class="modal-title">PENDING LEAVE APPLICATIONS</h4>
                                    @*<a class="btn btn-primary btn-sm">Create new action</a>*@
                                </div>
                            </div>
                            <!--Body-->
                            <div class="modal-body" id="myModalDivBody">
                            </div>
                        </div>
                        <!--/.Content-->
                    </div>
                </div>
                <!-- /.Modal-->

                <script src="~/Scripts/jquery-3.1.1.min.js"></script>

                <script type="text/javascript">
    $(document).ready(function () {
        if ("@ViewBag.Message") {
            toastr["success"]("@ViewBag.Message");
        }
        window.oTable = $("#Jdatatable").DataTable({
            "processing": true, // for show progress bar while loading

            "ajax": {
                "url": "/LeaveApplications/GetUnApproved",
                "type": "POST",
                "datatype": "json"
            },
            "columns": [
                { "data": "LeaveTypeName", "autoWidth": true },
                { "data": "FullName", "autoWidth": true },
                { "data": "StartDate", "autoWidth": true },
                { "data": "EndDate", "autoWidth": true },
                { "data": "ReasonForLeave", "autoWidth": true },
                { "data": "IsHalfDay", "autoWidth": true },
                { "data": "Staus", "autoWidth": true },

                {
                    "data": "LeaveApplicationId",
                    "autoWidth": true,
                    "render": function (data) {
                        return '<a href="#" data-toggle="modal" data-target="#actionsList" onclick="Details(' + data + ')" >  <i class="fa fa-info-circle" aria-hidden="true" >&nbsp;Details</i></a>&nbsp;&nbsp;' +
                            '<a href="#" data-toggle="modal" data-target="#actionsList"  onclick="Approve(' + data + ')" ><i class="fa fa-thumbs-o-up" aria-hidden="true" >&nbsp;Approve<i /></a>';                    }
                }

                //{ "data": "EmailID", "autoWidth": true },
                //{ "data": "Phone", "autoWidth": true },
            ]
        });

    });


    function Details(leaveTypeId) {
        var url = "/LeaveApplications/Details?id=" + leaveTypeId;
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
    };
    function Approve(leaveTypeId) {
        //var url = "/LeaveApplications/Approve?id=" + leaveTypeId;
        $.post("/LeaveApplications/Approve",{ "id": leaveTypeId },
            function(data) {
                if (data.status) {
                    $('#actionsList').modal("hide");
                    toastr["success"](data.message);
                    window.oTable.ajax.reload(); //run my_fun() ondomready

                } else {
                    toastr["error"](data.message);
                }
            });
        //$('#myModalDivBody').load(url,
        //    function () {
        //        $('#actionsList').modal("show");
        //    });
    };
    function myFunction() {
        var url = "/leaveTypeId/Save?id=0";

        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
    };




                </script>
