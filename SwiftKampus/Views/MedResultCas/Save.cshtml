@model SwiftKampusModel.MedicalScience.MedResultCa

<form id="myform" onsubmit="return false;">
    @Html.AntiForgeryToken()
    <div class="card">
        <div class="card-head style-primary">


        </div><!--end .card-head -->
        <div class="card-body">

            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            @if (Model != null && Model.MedResultCaId > 0)
            {
                @Html.HiddenFor(model => model.MedResultCaId)
            }

            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            <div class="form-group">
                @Html.Label("Result Category Name")
                @Html.DropDownList("MedResultCategoryId", null, htmlAttributes: new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.MedResultCategoryId, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.Label("Result Ca Name")
                @Html.EditorFor(model => model.ResultCaName, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.ResultCaName, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.Label("Maximum Score")
                @Html.EditorFor(model => model.MaximumScore, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.MaximumScore, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.Label("Pass Mark")
                @Html.EditorFor(model => model.PassMark, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.PassMark, "", new { @class = "text-danger" })
            </div>
        </div>

            <div class="md-form">

                @if (Model != null && Model.MedResultCaId > 0)
                {
                    <input id="btnsubmit" type="submit" value="Update" class="btn btn-primary btn-lg" />
                }
                else
                {
                    <input id="btnsubmit" type="submit" value="Save" class="btn btn-primary btn-lg" />
                }
                <a href="#" class="btn btn-danger btn-lg" data-dismiss="modal">Cancel</a>
            </div>
        </div><!--end .card-body -->
    </div><!--end .card -->

</form>
@*@section Scripts {
        @Scripts.Render("~/bundles/jqueryval")
    }*@


<script type="text/javascript">

    $("#btnsubmit").click(function () {
        var data = $("#myform").serialize();
        $.ajax({
            type: "POST",
            url: "/MedResultCas/Save",
            data: data,
            success: function (data) {
                if (data.status) {
                    $('#actionsList').modal("hide");
                    window.oTable.ajax.reload(); //run my_fun() ondomready
                    toastr["success"](data.message);
                    $('#myform')[0].reset();
                } else {
                    toastr["error"](data.message);
                    $('#actionsList').modal("hide");

                }

            }
        });
    });
</script>


