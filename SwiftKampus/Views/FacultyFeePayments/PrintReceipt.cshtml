
@{
    ViewBag.Title = "Faculty Reciept";
    Layout = "~/Views/Shared/_LayoutPrint.cshtml";
}


@model SwiftKampus.ViewModels.Fee_Management.FacultyReciept


<div class="transparentbox">
    <div style="text-align: center;">
        <img src="~/Content/Images/uniben_bana.bmp" />
    </div>

    <h4 class="text-center"> FACULTY FEE RECIEPT </h4>
</div>
<table style="width: 100%">
    <tr>
        <th>

            <div class="col-md-3">
                <img src="@Url.Action("RenderImage", "Students",new { studentId = Model.Student.StudentId})" width="100" height="100" />
            </div>
        </th>
        <th>
            <div class="col-md-4">
                <table class="table table-banded no-margin table-responsive">
                    <tbody>
                        <tr><td>FULLNAME: <strong> @Model.Student.FullName</strong></td></tr>
                        <tr><td>MATRIC NO: <strong> @Model.Student.StudentId</strong></td></tr>
                        <tr><td>SEX: <strong> @Model.Student.Gender</strong></td></tr>
                        <tr><td>SESSION: <strong> @Model.FacultyFeePayment.Session.SessionName</strong></td></tr>
                        <tr><td>LEVEL: <strong>@Model.FacultyFeePayment.Semester.SemesterName</strong></td></tr>
                    </tbody>
                </table>
            </div>
        </th>
        <th>
            <div class="col-md-4">
                <table class="table table-banded no-margin table-responsive">
                    <tbody>
                        <tr><td>FACULTY: <strong> @Model.Student.Programme.ProgrammeName</strong></td></tr>
                        <tr><td>DEPARTMENT: <strong> @Model.Student.Programme.ProgrammeName</strong></td></tr>
                        <tr><td>LEVEL: <strong>@Model.FacultyFeePayment.Semester.SemesterName</strong></td></tr>
                        <tr><td>DEPT OPTION:<strong> @Model.Student.Programme.ProgrammeName</strong></td></tr>
                    </tbody>
                </table>
            </div>
        </th>
    </tr>
</table>
<table style="width: 100%">
    <tr>
        <td>
            PAYMENT DETAILS
            <table style="width: 100%">
                <tr><td>Payment Date:<i class="text-left">@Html.DisplayFor(modelItem => Model.FacultyFeePayment.Date)</i></td></tr>
                <tr><td>Payment Status: @Html.DisplayFor(modelItem => Model.FacultyFeePayment.PaymentStatus)</td></tr>
                <tr><td>Amount Paid: @Html.DisplayFor(modelItem => Model.FacultyFeePayment.TotalAmount)</td></tr>
            </table>
        </td>
        <td>
            <table style="width: 100%">
                SCHOOL FEE BREAKDOWN
                <tr>
                    <th>
                        Fee Name
                    </th>

                    <th>Amount</th>
                    <th>
                        Description
                    </th>
                </tr>

                @foreach (var item in Model.FacultyFeeTypes)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.FeeName)
                        </td>

                        <td>
                            @Html.DisplayFor(modelItem => item.Amount)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Description)
                        </td>

                    </tr>
                }

            </table>
        </td>
    </tr>
</table>











<script type="text/javascript">
    function Excel() {
        var url = "/CourseRegistrations/PrintDetails?model=" +@ViewBag.Course ;
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
    };
    function AddNew() {
        window.open('@Url.Action("Create", "Students")', '_self');
    };
</script>



