

<link href="~/AdminTemplate/css/plugins/fullcalendar/fullcalendar.css" rel="stylesheet" />

<div class="row animated fadeInDown">

    <div class="col-lg-12">
        <div class="ibox float-e-margins">
            <div class="ibox-title">
                <h5>Session TimeTable</h5>
                <div class="ibox-tools">
                    <a class="collapse-link">
                        <i class="fa fa-chevron-up"></i>
                    </a>
                    <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                        <i class="fa fa-wrench"></i>
                    </a>
                    <ul class="dropdown-menu dropdown-user">
                        <li>
                            <a href="#">Config option 1</a>
                        </li>
                        <li>
                            <a href="#">Config option 2</a>
                        </li>
                    </ul>
                    <a class="close-link">
                        <i class="fa fa-times"></i>
                    </a>
                </div>
            </div>
            <div class="ibox-content">
                <div id="calendar"></div>
            </div>
        </div>
    </div>
</div>

<script src="~/AdminTemplate/js/jquery-3.1.1.min.js"></script>
<script>

    $(document).ready(function () {
        
        var events = [],
            calendar = $('#calendar'),
            myModal = $('#myModal6');

        $.ajax({
            type: "GET",
            url: "/ClassRoomAllocations/StudentTimeTableDetail",
            success: function (data) {
                console.log(data);
                for (var i = 0; i < data.length; i++) {
                    var sd = new Date(data[i]["StartDate"]);
                    sd = new Date(sd.getTime() + sd.getTimezoneOffset() * 60 * 1000);

                    var ed = new Date(data[i]["EndDate"]);
                    ed = new Date(ed.getTime() + sd.getTimezoneOffset() * 60 * 1000);

                    var list = {
                        id: data[i]["TimeTableAllocationId"],
                        dow: [sd.getDay()],
                        title: data[i]["CourseCode"] + " " + data[i]["LectureRoomCode"],
                        start: sd,
                        end: ed
                    }
                    events.push(list);
                }
                /* initialize the calendar
         -----------------------------------------------------------------*/
                var date = new Date();
                var d = date.getDate();
                var m = date.getMonth();
                var y = date.getFullYear();

                calendar.fullCalendar({
                    header: {
                        theme: true,
                        left: 'prev,next today',
                        center: 'title',
                        right: 'agendaWeek'
                    },
                    defaultView: 'agendaWeek',
                    minTime: '08:00:00',
                    maxTime: '19:00:00',
                    slotDuration: '01:00:00',
                    navLinks: true, // can click day/week names to navigate views
                    selectable: false,
                    selectHelper: false,
                    weekends: false,
                    editable: false,
                    eventLimit: true, // allow "more" link when too many events
                    events: events
                });
                console.log(events);
            }
        });
    });

</script>
