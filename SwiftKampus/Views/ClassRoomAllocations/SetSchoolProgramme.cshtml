@model SwiftKampus.ViewModels.SetSchoolProgrammeVm

@{
    ViewBag.Title = "SetSchoolProgramme";
}

@using (Html.BeginForm("SetTimeTable", "ClassRoomAllocations", FormMethod.Post))
{ 
    @Html.AntiForgeryToken()


<div class="card">
    <div class="card-head style-primary">
        <header></header>

    </div><!--end .card-head -->
    <div class="card-body">

        <div class="form-group">
            @Html.LabelFor(model => model.SchoolProgrammeId)
            @Html.DropDownList("SchoolProgrammeId", null, htmlAttributes: new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.SchoolProgrammeId, "", new { @class = "text-danger" })
        </div>

        <div class="md-form">

            <input type="submit" value="Set Time Table" class="btn btn-primary" />

        </div>
    </div><!--end .card-body -->
</div><!--end .card -->
}
    @section Scripts {
        @Scripts.Render("~/bundles/jqueryval")
    }
