
@{
    ViewBag.Title = "New Student IDCard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <!-- First row -->
    <div class="row">
        <div class="col-md-12">
            <div class="wrapper wrapper-content animated fadeInRight">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="ibox float-e-margins">
                            <div class="ibox-title">
                                <h5>C O N V O C A T I O N</h5>
                                    <div class="ibox-tools">
                                        <a onclick="myFunction()" class="btn btn-primary"><i class="fa fa-file-excel-o"></i> EXCEL UPLOAD</a>
                                        @*<a href="#" onclick="AddNew()" class="btn btn-primary"><i class="fa fa-user"></i>&nbsp;ADD STUDENT</a>*@
                                        @if (ViewBag.Message != null)
                                        {
                                            <div class="alert alert-success">
                                                <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
                                                <strong>@ViewBag.Message</strong>
                                            </div>
                                        }

                                        <a class="collapse-link">
                                            <i class="fa fa-chevron-up"></i>
                                        </a>
                                        <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                                            <i class="fa fa-wrench"></i>
                                        </a>
                                    </div>

                                    @*<a class="collapse-link">
                                        <i class="fa fa-chevron-up"></i>
                                    </a>
                                    <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                                        <i class="fa fa-wrench"></i>
                                    </a>*@
                                <div class="ibox-content">
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-2">
                                                <div class="form-group">
                                                    <label>Faculty</label>
                                                    @Html.DropDownList("FacultyId", (SelectList)ViewBag.FacultyId, "", new { @class = "form-control", @onchange = "getDeptList()" })
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <label>Department</label>
                                                    @Html.DropDownList("DepartmentId", (SelectList)ViewBag.DepartmentId, "", new { @class = "form-control", @onchange = "getprogrammelist()" })
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <label>Dept Option</label>
                                                    @Html.DropDownList("ProgrammeId", (SelectList)ViewBag.ProgrammeId, "", new { @class = "form-control" })
                                                </div>
                                            </div>
                                            <div class="col-md-2">
                                                <div class="form-group">
                                                    <label>Session</label>
                                                    @Html.DropDownList("SessionId", (SelectList)ViewBag.SessionId, "", new { @class = "form-control", })
                                                </div>
                                            </div>
                                            <div class="col-md-1">
                                                <br />
                                                <button type="submit" id="btn-search" class="btn btn-primary">Search/View</button>
                                            </div>
                                        </div>
                                        <br />
                                        <div class="row ">

                                        </div>
                                    </div>
                                </div>
                            </div><!--end .row -->
                        </div>
                    </div>
                    <div class="ibox-content">
                        <div class="table-responsive">
                            <table id="Jdatatable" class="table table-striped table-bordered table-hover table-responsive dataTables-example">
                                <thead>
                                    <tr>
                                        <th>Matric No</th>
                                        <th> Fullname</th>
                                        <th> Class Of Degree</th>
                                        <th> Mobile</th>
                                        <th> Programme</th>
                                        <th> Attending</th>
                                        <th> Lease Gown</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- Modal -->
<div class="modal fade inmodal" id="actionsList" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <!--Content-->
        <div class="modal-content animated">
            <!--Header-->
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>

            </div>
            <!--Body-->
            <div class="modal-body" id="myModalDivBody">
            </div>
        </div>
        <!--/.Content-->
    </div>
</div>
<!-- /.Modal-->

<script src="~/Scripts/jquery-3.1.1.min.js"></script>

<script type="text/javascript">

    $(document).ready(function () {
        window.oTable = $("#Jdatatable").DataTable({
            "processing": true, // for show progress bar while loading
            "serverSide": true, // if it is true the preocess is done on server side
            "filter": true, // disables search box
            "info": true,

            "stateSave": true,
            "orderMulti": false, // disable multiple column loading at once
            "ajax": {
                "url": "/ConvocationList/getConvocationList",
                "type": "POST",
                "datatype": "json",
                "data": function (d) {
                    //d.SchoolProgrammeId = $('#SchoolProgrammeId').val();
                    d.hasRegistered = $('#hasRegistered').val();
                    d.FacultyId = $('#FacultyId').val();
                    d.DepartmentId = $('#DepartmentId').val();
                    d.ProgrammeId = $('#ProgrammeId').val();
                    d.SessionId = $('#SessionId').val();
                }
            },
            "columns": [
                { "data": "Matric", "autoWidth": true, "orderable": true },
                { "data": "Fullname", "autoWidth": true, "orderable": true },
                { "data": "ClassOfDegree", "autoWidth": true },
                { "data": "PhoneNumber", "autoWidth": true },
                { "data": "ProgrammeOfStudy", "autoWidth": true },
                { "data": "WillAttend", "autoWidth": true },
                { "data": "LeaseGown",  "autoWidth": true },
                {
                    "data": "StudentId",
                    "autoWidth": true,
                    "render": function (data) {
                        return '<a href="#" onclick="RejectStudent(\'' + data + '\')" data-toggle="tooltip" data-placement="top" title="Enter Blood Group"><i class="fa fa-pencil" aria-hidden="true"></i> Action here!</a>';
                    }
                }
            ],
            dom: '<"html5buttons"B>lTfgitp',
            buttons: [
                { extend: 'copy' },
                { extend: 'csv' },
                { extend: 'excel', title: 'Student List' },
                { extend: 'pdf', title: 'Student List' },

                {
                    extend: 'print',
                    customize: function (win) {
                        $(win.document.body).addClass('white-bg');
                        $(win.document.body).css('font-size', '10px');

                        $(win.document.body).find('table')
                            .addClass('compact')
                            .css('font-size', 'inherit');
                    }
                }
            ]
        });
        window.oTable.fnSort([[1, "asc"], [2, "desc"]]);



    });

    function getDeptList() {
        var facultyid = $("#FacultyId").val();
        $.ajax
            ({
                url: '/students/getdeptlist?codeid=' + facultyid,
                type: 'get',
                datatype: 'application/json',
                contenttype: 'application/json',
                success: function (result) {
                    $("#DepartmentId").html("");
                    $.each(JSON.parse(result),
                        function (i, city) {
                            $("#DepartmentId").append($('<option></option>').val(city.DepartmentId).html(city.DeptName));
                        });

                },
                error: function () {
                    $("#DepartmentId").html("");
                    $("#Programmeid").html("");
                }
            });
    }

    function getprogrammelist() {
        var deptid = $("#DepartmentId").val();
        $.ajax
            ({
                url: '/students/getprogrammelist?codeid=' + deptid,
                type: 'get',
                datatype: 'application/json',
                contenttype: 'application/json',
                success: function (result) {
                    $("#ProgrammeId").html("");
                    $.each(JSON.parse(result),
                        function (i, city) {
                            $("#ProgrammeId").append($('<option></option>').val(city.ProgrammeId).html(city.ProgrammeName));
                        });
                },
                error: function () {
                    $("#ProgrammeId").html("");
                }
            });

        //$("#btn-search").click(function () {
        //    var url = "/ConvocationList/getConvocationList?programmeid=" + $('#ProgrammeId').val();
        //    jQuery.noConflict();
        //    $('#Jdatatable').load(url);
        //});
    }

    $("#btn-search").click(function () {
        window.oTable.ajax.reload();

    });

    function myFunction() {
        var url = "/ConvocationList/ExcelUpload";
        $('#myModalDivBody').load(url,
            function () {
                jQuery.noConflict();
                $('#actionsList').modal("show");
            });
    };

   
</script>
