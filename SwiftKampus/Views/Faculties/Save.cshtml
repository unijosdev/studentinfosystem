@model SwiftKampusModel.Faculty

<form id="myform" onsubmit="return false;">
    @Html.AntiForgeryToken()
   
        
        <div class="card-body">

            @Html.ValidationSummary(true, "", new {@class = "text-danger"})
            @if (Model != null && Model.FacultyId > 0)
            {
                @Html.HiddenFor(model => model.FacultyId)
            }


            <div class="form-group">
                @Html.LabelFor(model => model.FacultyCode)
                @Html.EditorFor(model => model.FacultyCode, new {htmlAttributes = new {@class = "form-control"}})
                @Html.ValidationMessageFor(model => model.FacultyCode, "", new {@class = "text-danger"})
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.FacultyName)

                @Html.EditorFor(model => model.FacultyName, new {htmlAttributes = new {@class = "form-control"}})
                @Html.ValidationMessageFor(model => model.FacultyName, "", new {@class = "text-danger"})
            </div>

            <div class="md-form">

                @if (Model != null && Model.FacultyId > 0)
                {
                    <input id="btnsubmit" type="submit" value="Update" class="btn btn-primary btn-lg"/>
                }
                else
                {
                    <input id="btnsubmit" type="submit" value="Save" class="btn btn-primary btn-lg"/>
                }
                <a href="#" class="btn btn-danger btn-lg" data-dismiss="modal">Cancel</a>
            </div>
        </div><!--end .card-body -->
  
    
</form>


<script type="text/javascript">
  
    $("#btnsubmit").click(function () {

        var data = $("#myform").serialize();
        
        $.ajax({
            type: "POST",
            url: "/Faculties/Save",
            data: data,
            success: function (data) {
                if (data.status) {
                    $('#actionsList').modal("hide");
                    window.oTable.ajax.reload(); //run my_fun() ondomready
                    toastr["success"](data.message);
                    $('#myform')[0].reset();
                } else {
                    toastr["error"](data.message);
                    $('#actionsList').modal("hide");
                   
                }

            }
        });
    });
</script>