                    <div class="row">

                        <div class="col-md-12">

                            <p><em><h3 class="text-center">ALLOCATION/ACCEPTANCE OF HOSTEL ACCOMMODATION</h3></em></p>

                        </div>

                    </div>

                    <div class="table-responsive m-t">
                        <table class="table table-bordered">
