        @@media print {
            @@page {
                size: auto; /* auto is the initial value */
                margin: 0mm; /* this affects the margin in the printer settings */
            }

            .hidden-print,
            .hidden-print * {
                display: none !important;
            }

            #Header, #Footer {
                display: none !important;
            }

            .noprint {
                display: none
            }

            .pagebreak {
                /* border: 1px solid rgb(19, 11, 11);
                    margin: 0 !important;
                    padding: 0 !important;
                    overflow: hidden; */
                page-break-before: always;
            }

            .page-break {
                display: block;
                page-break-before: always;
            }
        }
    </style>
