@model IEnumerable<SwiftKampusModel.Accomodation.StudentAssignedRoom>
@using SwiftKampus.ViewModels

@{
    ViewBag.Title = "Index";
    var model = (List<ReserveAccomodationVm>)ViewBag.Model;
}

<div class="modal fade modal-bf-fh" id="actionsList" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <!--Content-->
        <div class="modal-content">
            <!--Header-->
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <div class="flex-center">
                    <h4 class="modal-title">Session Accomodation</h4>
                    @*<a class="btn btn-primary btn-sm">Create new action</a>*@
                </div>
            </div>
            <!--Body-->
            <div class="modal-body" id="myModalDivBody">
            </div>
        </div>
        <!--/.Content-->
    </div>
</div>
<!-- /.Modal-->
@*<a onclick="myFunction()" class="btn btn-primary btn-lg" data-toggle="modal" data-target="#actionsList"><i class="fa fa-plus left"></i> ADD DEPARTMENT</a>*@
<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>List of Assigned Rooms</h5>
                    <div class="ibox-tools">

                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                        <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                            <i class="fa fa-wrench"></i>
                        </a>

                    </div>
                </div>
                <div class="ibox-content">
                    <h2>@ViewBag.Message</h2>
                    @if (model != null && model.Count() > 0)
                    {
                        <table>
                            <thead>
                                <tr>Email</tr>
                                <tr>Hostel</tr>
                                <tr>Block</tr>
                                <tr>Room</tr>
                                <tr>Spcae</tr>
                            </thead>
                            @foreach (var item in model)
                            {
                                <tr>@item.Email</tr>
                                <tr>@item.HostelName</tr>
                                <tr>@item.BlockName</tr>
                                <tr>@item.RoomName</tr>
                                <tr>@item.Space</tr>
                            }
                        </table>
                    }

                    <div class="table-responsive">
                        <table id="Jdatatable" class="table table-striped table-bordered table-hover table-responsive dataTables-example">
                            <thead>
                                <tr>
                                    <th>Mat NO</th>
                                    <th>Email</th>
                                    <th>Session Name</th>
                                    <th>FullName</th>
                                    <th>Hostel Name</th>
                                    <th>Block Name</th>
                                    <th>Room Name</th>
                                    <th>Bed Space</th>
                                    <th>Payment Status</th>
                                    @*<th>Action</th>*@
                                </tr>
                            </thead>
                        </table>

                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/Scripts/jquery-3.1.1.min.js"></script>

<script type="text/javascript">
    $(document).ready(function () {

        window.oTable = $("#Jdatatable").DataTable({
            "processing": true, // for show progress bar while loading
            //"serverSide": true, // if it is true the preocess is done on server side
            //"filter": true, // disables search box
            //"info": true,
            //"stateSave": true,
            //"orderMulti": false, // disable multiple column loading at once
            "ajax": {
                "url": "/AssignedRooms/GetIndex",
                "type": "POST",
                "datatype": "json"
            },
            "columns": [
                { "data": "MatricNo", "autoWidth": true },
                { "data": "Email", "autoWidth": true },
                { "data": "SessionName", "autoWidth": true },
                { "data": "FullName", "autoWidth": true },
                { "data": "HostelName", "autoWidth": true },
                { "data": "BlockName", "autoWidth": true },
                { "data": "RoomName", "autoWidth": true },
                { "data": "BedSpace", "autoWidth": true },
                { "data": "PaymentStatus", "autoWidth": true },
                //{
                //    "data": "AssignedRoomId",
                //    "autoWidth": true,
                //    "render": function (data) {
                //        //return '<a class="text-danger" data-toggle="modal" data-target="#actionsList"  onclick="Delete(' + data + ')" ><i class="fa fa-remove" aria-hidden="true" >&nbsp;Remove<i /></a>';
                //    }
                //}

                //{ "data": "EmailID", "autoWidth": true },
                //{ "data": "Phone", "autoWidth": true },
            ],
            dom: '<"html5buttons"B>lTfgitp',
            lengthMenu: [
                [10, 25, 50, 100, 200, 500, 1000, 2000, 4000, 5000],
                [10, 25, 50, 100, 200, 500, 1000, 2000, 4000, 5000]
            ],
            buttons: [
                //{   extend: 'copy' },
                //{   pageLength: 'pageLength' },
                //{   extend: 'csv'},
                {   extend: 'excel', title: 'Student List'},
                {   extend: 'pdf', title: 'Student List' },

                {
					extend: 'collection',
					text: 'Table control',
					buttons: [
						{
							collectionTitle: 'Visibility control',
							extend: 'colvis'
						}
					]
				},

                {extend: 'print',
                    customize: function (win){
                        $(win.document.body).addClass('white-bg');
                        $(win.document.body).css('font-size', '10px');

                        $(win.document.body).find('table')
                            .addClass('compact')
                            .css('font-size', 'inherit');
                    }
                }
            ]
        });

    });
    function Edit(sessionAccomodationId) {
        var url = "/SessionAccomodations/Save?id=" + sessionAccomodationId;
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal('show');
            });
    };
    function Delete(sessionAccomodationId) {
        var url = "/SessionAccomodations/Delete?id=" + sessionAccomodationId;
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
    };
    function myFunction() {
        var url = "/SessionAccomodations/Save?id=0";
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
    };
</script>