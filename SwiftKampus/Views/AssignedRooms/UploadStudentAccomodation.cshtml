

@{
    ViewBag.Title = "Upload Reserved Accomodation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="ibox float-e-margins">
    <div class="ibox-title">
        <h5>Post Graduate Student Admission Excel Upload</h5>

        @if (ViewBag.Message != null)
        {
            <div class="alert alert-success">
                <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
                <strong>@ViewBag.Message</strong>
            </div>
        }
        <div class="ibox-tools">
            @*<a class="btn btn-primary" href="~/Excel Template/Student Template.xlsx"> Download Excel Template</a>*@

            <a class="collapse-link">
                <i class="fa fa-chevron-up"></i>
            </a>
            <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                <i class="fa fa-wrench"></i>
            </a>
        </div>
    </div>
    <div class="ibox-content">

        <div class="card-body">
            <h3>Instructions</h3>
            <ul>
                <li>Please the button above to download the format required for the upload.</li>
                <li>Please leave no cell empty in the excel template before you upload.</li>
                <li>Please use a valid Date for student's date of birth.</li>
                <li>Please use a valid Date for student's admission date.</li>
                <li>You will be redirect to the list of students after successful upload.</li>
            </ul>
            <br />
            <br />
            @using (Html.BeginForm("UploadStudentAccomodation", "AssignedRooms", FormMethod.Post, new { enctype = "multipart/form-data", id = "theform" }))
            {
                @Html.Raw(ViewBag.Error)
                <span>Excel File </span> <input type="file" name="excelfile" />
                <br />
                <input id="btnsubmit" type="submit" value="Upload Reserved Students" class="btn btn-lg btn-primary" />
            }

            <div>
            </div>
        </div>
    </div>
</div>



<script src="~/Scripts/jquery-3.3.1.min.js"></script>
<script type="text/javascript">
    $(function () {
        $('#theform').submit(function () {
            $("input[type='submit']", this)
                .val("Uploading Please Wait...")
                .attr('disabled', 'disabled');
            return true;
        });
    });
</script>


