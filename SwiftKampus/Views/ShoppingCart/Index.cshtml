@model SwiftKampus.ViewModels.ShoppingCart.ShoppingCartVm
@{
    ViewBag.Title = "Shopping Cart";
}


<script type="text/javascript">
    $(function () {
        // Document.ready -> link up remove event handler
        $(".RemoveLink").click(function () {
            // Get the id from the link
            var recordToDelete = $(this).attr("data-id");
            if (recordToDelete != '') {
                // Perform the ajax post
                $.post("/ShoppingCart/RemoveFromCart", { "id": recordToDelete },
                    function (data) {
                        // Successful requests get here
                        // Update the page elements
                        if (data.ItemCount == 0) {
                            $('#row-' + data.DeleteId).fadeOut('slow');
                        } else {
                            $('#item-count-' + data.DeleteId).text(data.ItemCount);
                        }
                        $('#cart-total').text(data.CartTotal);
                        $('#update-message').text(data.Message);
                        $('#cart-status').text('Cart (' + data.CartCount + ')');
                    });
            }
        });

        $('#checkout').click(function () {
            var url = "/Checkout/AddressAndPayment";
            $('#myModalDivBody').load(url,
                function () {
                    $('#actionsList').modal("show");
                });
        });
    });
</script>
<h3>
    <em>Review</em> your cart:
</h3>
<p class="btn-block btn-outline-warning">
    @*<input id="checkout" type="submit" value="click to Checkout >>" class="btn btn-success btn-xs" />*@
   
</p>
<div id="update-message">
</div>
<div class="ibox-content">
    <div class="table-responsive">
        <table class="table table-striped table-bordered table-hover table-responsive">
            <thead>
                <tr>
                    <th>Album Name </th>
                    <th> Price (each) </th>
                    <th> Quantity </th>
                    <th> Action </th>
                </tr>
            </thead>
            @foreach (var item in @Model.CartItems)
            {
                <tr id="row-@item.RecordId">
                    <td>
                        @Html.ActionLink(item.Produt.ProductName, "Details", "Store", new { id = item.ProductId }, null)
                    </td>
                    <td>
                        @item.Produt.ProductPrice
                    </td>
                    <td id="item-count-@item.RecordId">
                        @item.Count
                    </td>
                    <td>
                        <a href="#" class="text-danger RemoveLink" data-id="@item.RecordId"><i class="fa fa-remove" aria-hidden="true">&nbsp; Reduce Qty</i></a>
                    </td>
                </tr>
            }
            <tr>
                <td>
                    Total
                </td>
                <td></td>
                <td></td>
                <td id="cart-total" class="cart-btn">
                    @Model.CartTotal
                </td>
            </tr>
        </table>
        <div>
            <a href="#" class="btn btn-success pull-right checkout" id="checkout">
                Process Payment >>
            </a>
        </div>
    </div>
</div>