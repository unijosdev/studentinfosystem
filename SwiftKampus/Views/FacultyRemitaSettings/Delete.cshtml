@model SwiftKampusModel.Payment.FacultyRemitaSetting

@{
    ViewBag.Title = "Delete";
}

<div class="card">
    <div class="card-body">
        <h3>Are you sure you want to delete this?</h3>
        <div>
            <dl class="dl-horizontal">
                <dt>
                    @Html.DisplayNameFor(model => model.Faculty.FacultyName)
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.Faculty.FacultyName)
                </dd>

                <dt>
                    @Html.DisplayNameFor(model => model.ApiKey)
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.ApiKey)
                </dd>

                <dt>
                    @Html.DisplayNameFor(model => model.MerchantId)
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.MerchantId)
                </dd>

                <dt>
                    @Html.DisplayNameFor(model => model.ServiceType)
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.ServiceType)
                </dd>
            </dl>

            <form id="myform" onsubmit="return false;">
                @Html.AntiForgeryToken()

                <input type="hidden" id="id" name="id" class="form-control" value="@Model.FacultyRemitaSettingId">
                <input id="btndelete" type="submit" value="Delete" class="btn btn-danger" /> |

                <a href="#" class="btn btn-info" data-dismiss="modal">Cancel</a>
            </form>
        </div>
    </div>
</div>

<script type="text/javascript">

    $("#btndelete").click(function () {

        var data = $("#myform").serialize();
        //window.alert(data);
        $.ajax({
            type: "POST",
            url: "/FacultyRemitaSettings/Delete",
            data: data,
            success: function (data) {
                if (data.status) {
                    $('#actionsList').modal("hide");
                    window.oTable.ajax.reload(); //run my_fun() ondomready

                    toastr["info"](data.message);
                    $('#myform')[0].reset();
                } else {
                    //$('#actionsList').modal("hide");
                    toastr["error"](data.message);
                }

            }
        });
    });
</script>
