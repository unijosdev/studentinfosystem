@model SwiftKampusModel.Faq

@{
    ViewBag.Title = "Details";
}

<div class="container">
    <div class="page-header">
        <h2>Details</h2>
    </div>

    <div class="panel panel-default">
        <div class="panel-heading">
            <h4>Frequently Asked Question</h4>
        </div>
        <div class="panel-body">
            <dl class="dl-horizontal">
                <dt>
                    @Html.DisplayNameFor(model => model.Question)
                </dt>
                <dd>
                    @Html.DisplayFor(model => model.Question)
                </dd>

                <dt>
                    @Html.DisplayNameFor(model => model.QuestionBy)
                </dt>
                <dd>
                    @Html.DisplayFor(model => model.QuestionBy)
                </dd>

                <dt>
                    @Html.DisplayNameFor(model => model.AskedDate)
                </dt>
                <dd>
                    @Html.DisplayFor(model => model.AskedDate)
                </dd>

                <dt>
                    @Html.DisplayNameFor(model => model.Answer)
                </dt>
                <dd>
                    @Html.DisplayFor(model => model.Answer)
                </dd>

                <dt>
                    @Html.DisplayNameFor(model => model.AnswerBy)
                </dt>
                <dd>
                    @Html.DisplayFor(model => model.AnswerBy)
                </dd>

                <dt>
                    @Html.DisplayNameFor(model => model.RepliedDate)
                </dt>
                <dd>
                    @Html.DisplayFor(model => model.RepliedDate)
                </dd>
            </dl>
        </div>
    </div>

    <p>
        @Html.ActionLink("Edit", "Edit", new { id = Model.FaqId }, new { @class = "btn btn-primary" }) |
        @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-default" })
    </p>
</div>