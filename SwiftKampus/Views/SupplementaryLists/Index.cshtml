
@{
    ViewBag.Title = "Supplemetary List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<!-- Modal -->
<div class="modal fade modal-bf-fh" id="actionsList" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <!--Content-->
        <div class="modal-content">
            <!--Header-->
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <div class="flex-center">
                    <h4 class="modal-title">SUPPLEMENTARY LIST</h4>
                    @*<a class="btn btn-primary btn-sm">Create new action</a>*@
                </div>
            </div>
            <!--Body-->
            <div class="modal-body" id="myModalDivBody">
            </div>
        </div>
        <!--/.Content-->
    </div>
</div>
<!-- /.Modal-->
@*<a onclick="myFunction()" class="btn btn-primary btn-lg" data-toggle="modal" data-target="#actionsList"><i class="fa fa-plus left"></i> ADD DEPARTMENT</a>*@
<a href="#" onclick="myFunction()" data-toggle="modal" data-target="#actionsList" class="btn btn-primary btn-lg"><i class="fa fa-plus left"></i> ADD TO LIST</a>
<a href="#" onclick="ExcelUpload()" data-toggle="modal" data-target="#actionsList" class="btn btn-primary btn-lg"><i class="fa fa-plus left"></i> UPLOAD SUPPLEMENTARY LIST</a>

<table id="Jdatatable" class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Jamb Reg No</th>
            <th>First Name</th>
            <th>Gender</th>
            <th>State Of Origin</th>
            <th>Score</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
</table>


<script src="~/Scripts/jquery-3.1.1.min.js"></script>

<script type="text/javascript">
    $(document).ready(function () {

        window.oTable = $("#Jdatatable").DataTable({
            "processing": true, // for show progress bar while loading
            
            "ajax": {
                "url": "/SupplementaryLists/GetIndex",
                "type": "POST",
                "datatype": "json"
            },
            "columns": [
                { "data": "JambRegNo", "autoWidth": true },
                { "data": "FullName", "autoWidth": true },
                { "data": "Gender", "autoWidth": true },
                { "data": "StateOfOrigin", "autoWidth": true },
                { "data": "JambScore", "autoWidth": true },
                { "data": "IsAdmitted", "autoWidth": true },
                {
                    "data": "SupplementaryListId",
                    "autoWidth": true,
                    "render": function (data) {
                        return '<a href="#" data-toggle="modal" data-target="#actionsList" onclick="Edit(' + data + ')" >  <i class="fa fa-pencil" aria-hidden="true" >&nbsp;Edit</i></a>&nbsp;&nbsp;' +
                            '<a href="#" class="text-danger" data-toggle="modal" data-target="#actionsList"  onclick="Delete(' + data + ')" ><i class="fa fa-remove" aria-hidden="true" >&nbsp;Remove<i /></a>';
                    }
                }

                //{ "data": "EmailID", "autoWidth": true },
                //{ "data": "Phone", "autoWidth": true },
            ]
        });

    });
    function Edit(listId) {
        var url = "/SupplementaryLists/Save?id=" + listId;
   
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal('show');
            });
    };
    function Delete(listId) {
        var url = "/SupplementaryLists/Delete?id=" + listId;
     
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
    };
    function myFunction() {
        var url = "/SupplementaryLists/Save?id=0";
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
    };
    function ExcelUpload() {
        var url = "/SupplementaryLists/UploadSupplementaryList";
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
    };
</script>