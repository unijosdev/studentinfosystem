
@{
    ViewBag.Title = "CustomerOrders";
}

<link href="~/AdminTemplate/css/plugins/sweetalert/sweetalert.css" rel="stylesheet">

<div class="row wrapper border-bottom white-bg page-heading">
    <div class="col-lg-10">
        <h2>Convocation Gowns, Materials and Souvenirs</h2>
        <ol class="breadcrumb">
            <li>
                <a href="index-2.html">Home</a>
            </li>
            <li>
                <a>E-commerce</a>
            </li>
            <li class="active">
                <strong>Orders</strong>
            </li>
        </ol>
    </div>
    <div class="col-lg-2">

    </div>
</div>

<div class="wrapper wrapper-content animated fadeInRight ecommerce">


    <div class="ibox-content m-b-sm border-bottom">
        <div class="row">
            <div class="col-sm-4">
                <div class="form-group">
                    <label class="control-label" for="order_id">Email/Phone Number</label>
                    <input type="text" id="Email" name="Email" value="" placeholder="Type Email/Phone Number" class="form-control">
                </div>
            </div>
            @*<div class="col-sm-4">
                    <div class="form-group">
                        <label class="control-label" for="status">Order status</label>
                        <input type="text" id="status" name="status" value="" placeholder="Status" class="form-control">
                    </div>
                </div>*@

            <div class="col-sm-4">
                <br />
                <button type="submit" id="btn-search" class="btn btn-primary">Search/View</button>
            </div>
        </div>


    </div>

    <div id="partialOrderList" class="row">

    </div>


</div>

<script src="~/Scripts/jquery-3.1.1.min.js"></script>
<script src="~/AdminTemplate/js/plugins/sweetalert/sweetalert.min.js"></script>

<script type="text/javascript">
    $(document).ready(function () {
        var orderUrl = "/MarketPlace/GetCustomerOrder?customerId=" + '@ViewBag.OrderId';
        $('#partialOrderList').load(orderUrl);
    });


    $("#btn-search").click(function () {
        var orderUrl = "/MarketPlace/GetCustomerOrder?id=" + $('#Email').val();
        $('#partialOrderList').load(orderUrl);

    });

    function deleteOrder(orderId) {
        var order_Id = orderId;

        swal({
            title: "Do you want to delete this order?",
            //text: "Do you  Proceed?..",
            type: "warning",
            showCancelButton: true,
            confirmButtonColor: "#ab973a",
            confirmButtonText: "Proceed!",
            closeOnConfirm: false,
            closeOnCancel: true
        },
            function (isConfirm) {
                if (isConfirm) {
                    deleteOrderConfimation(order_Id);
                    swal("Great!", "Order successfully deleted", "success");
                }
            });
    }

    function deleteOrderConfimation(order_Id) {
        var orderId = order_Id;
        var url = "/MarketPlace/DeleteCustomerOrder?orderId=" + orderId;

        $.ajax({
            url: url,
            type: 'GET',
            success: function (data) {
                if (data.status) {
                    var orderUrl = "/MarketPlace/GetCustomerOrder?id=" + $('#Email').val();
                    $('#partialOrderList').load(orderUrl);
                } else {
                    swal({
                        title: "Warning",
                        text: data.message,
                        type: "warning",
                    });
                }
            },
            cache: false,
            contentType: false,
            processData: false
        });
    }

</script>
