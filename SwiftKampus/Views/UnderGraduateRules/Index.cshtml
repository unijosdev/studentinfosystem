@model IEnumerable<SwiftKampusModel.AddmissionApplicant.UnderGraduateRule>

@{
    ViewBag.Title = "Index";
}
<!-- Modal -->
<div class="modal fade modal-bf-fh" id="actionsList" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <!--Content-->
        <div class="modal-content">
            <!--Header-->
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <div class="flex-center">
                    <h4 class="modal-title">APPLICANT SUBJECT RULE</h4>
                </div>
            </div>
            <!--Body-->
            <div class="modal-body" id="myModalDivBody">
            </div>
        </div>
        <!--/.Content-->
    </div>
</div>
<!-- /.Modal-->

<div class="container-fluid">

    <div class="wrapper wrapper-content animated fadeInRight">
        <div class="row">
            <div class="col-lg-12">
                <div class="ibox float-e-margins">
                    <div class="ibox-title">
                        <h5>List of Subject Rules</h5>
                        <div class="ibox-tools">
                            <a href="#" onclick="myFunction()" class="btn btn-primary"><i class="fa fa-plus left"></i> ADD APPLICANT SUBJECT RULE</a>
                            <a href="#" onclick="ExcelUpload()" class="btn btn-primary"><i class="fa fa-file-excel-o left"></i> UPLOAD RULES</a>

                            @if (ViewBag.Message != null)
                            {
                                <div class="alert alert-success">
                                    <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
                                    <strong>@ViewBag.Message</strong>
                                </div>
                            }

                            <a class="collapse-link">
                                <i class="fa fa-chevron-up"></i>
                            </a>
                            <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                                <i class="fa fa-wrench"></i>
                            </a>
                        </div>
                        <div class="ibox-content">
                            <article class="margin-bottom-xxl">
                                <p class="lead">
                                    Please use the following parameters to perform Search
                                </p>
                            </article>
                            <div class="card-body">
                                <div class="row form-inline">
                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label> School Programme</label>
                                            @Html.DropDownList("SchoolProgrammeId", (SelectList)ViewBag.SchoolProgrammeId, "", new { @class = "form-control" })

                                        </div>
                                    </div>
                                    <div class="col-sm-6">
                                        <div class="form-group">
                                            <label>Dept Option</label>
                                            @Html.DropDownList("ProgrammeId", (SelectList)ViewBag.ProgrammeId, "", new { @class = "form-control" })
                                        </div>
                                    </div>

                                    <div class="col-sm-3">
                                        <br />
                                        <button type="submit" id="btn-search" class="btn btn-primary">Search/View</button>

                                    </div>
                                </div>


                            </div><!--end .row -->

                        </div>
                    </div>
                    <div class="ibox-content">
                        <div class="table-responsive">
                            <table id="Jdatatable" class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>Programme Name</th>
                                        <th>Dept Option</th>
                                        <th>Subject Name</th>
                                        <th>Required Grade</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>


<script src="~/Scripts/jquery-3.1.1.min.js"></script>

<script type="text/javascript">
    $(document).ready(function () {

        window.oTable = $("#Jdatatable").DataTable({
            "processing": true, // for show progress bar while loading
            "serverSide": true, // if it is true the preocess is done on server side
            "filter": true, // disables search box
            "info": true,

            "stateSave": true,
            "orderMulti": false, // disable multiple column loading at once
            "ajax": {
                "url": "/UnderGraduateRules/GetIndex",
                "type": "POST",
                "datatype": "json",
                "data": function (d) {
                    d.ProgrammeId = $('#ProgrammeId').val();
                    d.SchoolProgrammeId = $('#SchoolProgrammeId').val();
                }

            },
            "columns": [
                { "data": "FullName", "autoWidth": true },
                { "data": "ProgrammeName", "autoWidth": true },
                { "data": "CourseName", "autoWidth": true },
                { "data": "IsRequired", "autoWidth": true },

                {
                    "data": "UnderGraduateRuleId",
                    "autoWidth": true,
                    "render": function (data) {
                        return '<a href="#"  onclick="Edit(' + data + ')" >  <i class="fa fa-pencil" aria-hidden="true" >&nbsp;Edit</i></a>&nbsp;&nbsp;' +
                            '<a href="#" class="text-danger" onclick="Delete(' + data + ')" ><i class="fa fa-remove" aria-hidden="true" >&nbsp;Remove<i /></a>';
                    }
                }

                //{ "data": "EmailID", "autoWidth": true },
                //{ "data": "Phone", "autoWidth": true },
            ]
        });

    });

    $("#btn-search").click(function () {
        window.oTable.ajax.reload();

    });
    function Edit(underGraduateRuleId) {
        var url = "/UnderGraduateRules/Save?id=" + underGraduateRuleId;
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal('show');
            });
    };
    function Delete(underGraduateRuleId) {
        var url = "/UnderGraduateRules/Delete?id=" + underGraduateRuleId;
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
    };
    function myFunction() {
        var url = "/UnderGraduateRules/Save?id=0";       
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
    };

    function ExcelUpload() {
        var url = "/UnderGraduateRules/UploadUndergraduateRule";
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
    };
</script>
