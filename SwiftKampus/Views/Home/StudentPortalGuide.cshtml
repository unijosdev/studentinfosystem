
@{
    ViewBag.Title = "Student Portal Guide";
    Layout = "~/Views/Shared/_LayoutWebSite.cshtml";
}


<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">
        <div class="col-md-4">
            <div class="ibox ">
                <div class="ibox-title">
                    <h5>Student Registration Guide</h5>
                </div>

                <div class="ibox-content">
                    <p>
                        Quick and easy way to Register and Pay School fee.
                    </p>

                    <div class=" m-t-sm">

                        <a href="#" class="btn btn-primary startTour"><i class="fa fa-play"></i> Start Tour</a>
                        <a href="~/Excel Template/Uniben Student Manual.pdf" class="btn btn-primary">Download Manual Now</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="ibox ">
                <div class="ibox-title">
                    <h5>Tour step 1</h5>
                </div>
                <div class="ibox-content text-center" id="step1">
                    <div class="p-sm">
                        <h3>Please type your Matric No or Jamb RegNo and click "Submit"</h3>
                        <img class="img-responsive" src="~/AdminTemplate/Uniben manual/signupHomepage.PNG" height="50" />
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="ibox ">
                <div class="ibox-title">
                    <h5>Tour Step 2</h5>
                </div>
                <div class="ibox-content text-center" id="step2">
                    <div class="p-sm">
                        <h3>Confirm your LastName, FirstName and Matric/JambReg No</h3>
                        <h4>Please use your personal and current email address</h4>
                        <h4>Please use password that can be easily remembered</h4>
                        <img  class="img-responsive" src="~/AdminTemplate/Uniben manual/confirmSignUp.PNG" />
                    </div>
                </div>
            </div>
        </div>
      
    </div>
    <div class="row">

        <div class="col-md-4">
            <div class="ibox ">
                <div class="ibox-title">
                    <h5>Tour step 3</h5>
                </div>
                <div class="ibox-content text-center" id="step3">
                    <div class="p-sm">
                        <h3>Confirmation link will be sent to the registered email address</h3>
                        <img class="img-responsive"src="~/AdminTemplate/Uniben manual/emailSent.PNG" />
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="ibox ">
                <div class="ibox-title">
                    <h5>Tour step 4</h5>
                </div>
                <div class="ibox-content text-center" id="step4">
                    <div class="p-sm">
                        <h3>Clicking the link sent to the registered email will display this page</h3>
                        <h4>Please check the "Spam" folder in your email for the confirmation link</h4>
                        <h4>Click the Login button on the page</h4>
                        <img class="img-responsive" src="~/AdminTemplate/Uniben manual/EmailConfirmed.PNG" />

                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="ibox ">
                <div class="ibox-title">
                    <h5>Tour step 5</h5>
                </div>
                <div class="ibox-content text-center" id="step5">
                    <div class="p-sm">
                        <h3>Please use the registered Matric/Jamb No or Email </h3>
                        <h3>Type your password and click login </h3>
                        <img class="img-responsive" src="~/AdminTemplate/Uniben manual/loginpage.PNG" />
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-4">
            <div class="ibox ">
                <div class="ibox-title">
                    <h5>Tour step 6</h5>
                </div>
                <div class="ibox-content text-center" id="step6">
                    <div class="p-sm">
                        <h3>After successful Login, Please Click the "Fee Management"</h3>
                        <h3>then select "Pay Fee" and finally select "Pay School Fee"</h3>
                        <img class="img-responsive" src="~/AdminTemplate/Uniben manual/selectpayment.PNG" />
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="ibox ">
                <div class="ibox-title">
                    <h5>Tour Step 7</h5>
                </div>
                <div class="ibox-content text-center" id="step7">
                    <div class="p-sm">
                        <h3>Select School Fee and Click "Select Payment" </h3>
                        <img class="img-responsive" src="~/AdminTemplate/Uniben manual/Proceedtopayment.PNG" />
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="ibox ">
                <div class="ibox-title">
                    <h5>Tour Step 8</h5>
                </div>
                <div class="ibox-content text-center" id="step8">
                    <div class="p-sm">
                        <h3>Please Confirm Payment breakdown, Select the Payment Option that you prefer </h3>
                        <img class="img-responsive" src="~/AdminTemplate/Uniben manual/confirmpayment.png" />
                    </div>
                </div>
            </div>
        </div>
    </div>
<div class="row">
  
    <div class="col-md-6">
        <div class="ibox ">
            <div class="ibox-title">
                <h5>Tour Step 9 </h5>
            </div>
            <div class="ibox-content text-center" id="step9">
                <div class="p-sm">
                    <h3>Please Click "Confirm and Proceed" after details Confirmation</h3>
                    <img class="img-responsive" src="~/AdminTemplate/Uniben manual/selectconfirmpayment.PNG" />

                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="ibox ">
            <div class="ibox-title">
                <h5>Tour step 10</h5>
            </div>
            <div class="ibox-content text-center" id="step10">
                <div class="p-sm">
                    <h3>Please confirm Personal details and Amount on the Remita payment page </h3>
                    <img class="img-responsive" src="~/AdminTemplate/Uniben manual/remitapaymentpage.PNG" />
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="row">
        <div class="col-md-12">
            <div class="ibox ">
                <div class="ibox-title">
                    <h5>Tour step 11</h5>
                </div>
                <div class="ibox-content text-center" id="step11">
                    <div class="p-sm">
                        <h3>Please, print your receipt after payment by </h3>
                        <ol>
                            <li>Click the "Fee Management"</li>
                            <li>Select "Print Receipt"</li>
                            <li>Select the "School Fee"</li>


                        </ol>
                        <img class="img-responsive" src="~/AdminTemplate/Uniben manual/recieptPage.PNG" />
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
    </div>
<script src="~/AdminTemplate/js/jquery-3.1.1.min.js"></script>
<script src="~/AdminTemplate/js/plugins/bootstrapTour/bootstrap-tour.min.js"></script>

<script>
    $(document).ready(function (){

        // Instance the tour
        var tour = new Tour({
            steps: [{

                    element: "#step1",
                    title: "Title of my step",
                    content: "Introduce new users to your product by walking them through it step by step.",
                    placement: "top"
                },
                {
                    element: "#step2",
                    title: "Title of my step",
                    content: "Content of my step",
                    placement: "top",
                    backdrop: true,
                    backdropContainer: '#wrapper',
                    onShown: function (tour) {
                        $('body').addClass('tour-open');
                    },
                    onHidden: function (tour) {
                        $('body').removeClass('tour-close');
                    }
                },
                {
                    element: "#step3",
                    title: "Title of my step",
                    content: "Introduce new users to your product by walking them through it step by step.",
                    placement: "bottom"
                },
                {
                    element: "#step4",
                    title: "Title of my step",
                    content: "Introduce new users to your product by walking them through it step by step.",
                    placement: "bottom"
                },
                {
                    element: "#step5",
                    title: "Title of my step",
                    content: "Introduce new users to your product by walking them through it step by step.",
                    placement: "bottom"
                },
                {
                    element: "#step6",
                    title: "Title of my step",
                    content: "Introduce new users to your product by walking them through it step by step.",
                    placement: "bottom"
                }, {
                    element: "#step7",
                    title: "Title of my step",
                    content: "Introduce new users to your product by walking them through it step by step.",
                    placement: "bottom"
                }, {
                    element: "#step8",
                    title: "Title of my step",
                    content: "Introduce new users to your product by walking them through it step by step.",
                    placement: "bottom"
                }, {
                    element: "#step9",
                    title: "Title of my step",
                    content: "Introduce new users to your product by walking them through it step by step.",
                    placement: "bottom"
                },
                {
                    element: "#step10",
                    title: "Title of my step",
                    content: "Introduce new users to your product by walking them through it step by step.",
                    placement: "bottom"
                },
                {
                    element: "#step11",
                    title: "Title of my step",
                    content: "Introduce new users to your product by walking them through it step by step.",
                    placement: "top"
                }

            ]});

        // Initialize the tour
        tour.init();

        $('.startTour').click(function() {
            tour.restart();

            // Start the tour
            // tour.start();
        });

    });

</script>