                <li>0915 789 2727, 0915 789 2728</li>
            </ul><br />
            <p><strong>Whatsapp Number:</strong><br />0915 789 2745</p>
            <p class="email"><strong>Email:</strong><br /> <a href="mailto:support@unijos.edu.ng">support@unijos.edu.ng</a></p>
