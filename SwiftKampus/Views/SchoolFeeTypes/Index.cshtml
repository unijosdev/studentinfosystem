@using SwiftKampus.Models

@{
    ViewBag.Title = "School Fee Type";
}


<!-- Modal -->
<div class="modal fade modal-bf-fh" id="actionsList" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <!--Content-->
        <div class="modal-content">
            <!--Header-->
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <div class="flex-center">
                    <h4 class="modal-title">SCHOOL CHARGES TYPE</h4>
                    @*<a class="btn btn-primary btn-sm">Create new action</a>*@
                </div>
            </div>
            <!--Body-->
            <div class="modal-body" id="myModalDivBody">
            </div>
        </div>
        <!--/.Content-->
    </div>
</div>
<!-- /.Modal-->

<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>List of School Charges</h5>
                    <div class="ibox-tools">
                        <a href="#" onclick="myFunction()" class="btn btn-primary"><i class="fa fa-plus left"></i> ADD SCHOOL CHARGES</a>

                        <a href="#" onclick="downloadExcel()" class="btn btn-primary"><i class="fa fa-excel left"></i> UPLOAD SCHOOL CHARGES</a>


                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                        <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                            <i class="fa fa-wrench"></i>
                        </a>

                    </div>
                </div>
                <div class="ibox-content">
                    <article class="margin-bottom-xxl">
                        <p class="lead">
                            Please use the following parameters to perform Query
                        </p>
                    </article>
                    <div class="card-body">
                        <form class="form-inline" id="formFilter" onsubmit="return false;">
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            <label>School Programme</label>
                                            @Html.DropDownList("SchoolProgrammeId", (SelectList)ViewBag.SchoolProgrammeId, "", new { @class = "form-control" })
                                        </div>
                                    </div>

                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label>Session Name</label>
                                        @Html.DropDownList("SessionId", (SelectList)ViewBag.SessionId, "", new { @class = "form-control" })
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label>Fee Category</label>
                                        @Html.DropDownList("SchoolFeeCategory", (SelectList)ViewBag.SchoolFeeCategory, "", new { @class = "form-control" })
                                    </div>
                                </div>

                                <div class="col-md-3">
                                    <br />
                                    <button type="submit" id="btn-search" class="btn btn-primary btn-lg">Search/View</button>
                                </div>
                            </div>
                            <br />
                           
                        </form>
                    </div><!--end .row -->

                </div>
                <div class="ibox-content">

                    <div class="table-responsive">
                        <table id="Jdatatable" class="table table-striped table-bordered table-hover table-responsive dataTables-example">
                            <thead>
                                <tr>
                                    <th>School Programme</th>
                                    <th>Student Type</th>
                                    <th>Session Name</th>
                                    <th>Category Name</th>
                                    <th>Fee Name</th>                                    
                                    <th>Amount</th>
                                    <th>Amount In Words</th>
                                    @*<th>Description</th>*@
                                    <th>Indigene</th>
                                    <th>Active</th>
                                </tr>
                            </thead>
                        </table>

                    </div>

                </div>
            </div>
        </div>
    </div>
</div>



<script src="~/Scripts/jquery-3.1.1.min.js"></script>

<script type="text/javascript">
    $(document).ready(function () {

        window.oTable = $("#Jdatatable").DataTable({
            "processing": true, // for show progress bar while loading

            "ajax": {
                "url": "/SchoolFeeTypes/GetIndex",
                "type": "POST",
                "data": function (d) {
                    return $('#formFilter').serialize();
                },
                "datatype": "json"
            },
            "columns": [
                { "data": "FancyName", "autoWidth": true },
                { "data": "StudentType", "autoWidth": true },
                { "data": "SessionName", "autoWidth": true },
                { "data": "FeeCategory", "autoWidth": true },
                { "data": "FeeName", "autoWidth": true },                
                { "data": "Amount", "autoWidth": true },
                { "data": "AmountInWords", "autoWidth": true },
                //{ "data": "Description", "autoWidth": true },
                { "data": "Indegine", "autoWidth": true },
                {
                    "data": "SchoolFeeTypeId",
                    "autoWidth": true,
                    "render": function (data) {
                        return '<a href="#" onclick="Edit(' + data + ')" >  <i class="fa fa-pencil" aria-hidden="true" >&nbsp;Edit</i></a>&nbsp;&nbsp;' +
                            '<a href="#" class="text-danger" onclick="Delete(' + data + ')" ><i class="fa fa-remove" aria-hidden="true" >&nbsp;Remove<i /></a>';
                    }
                }
            ],
            responsive: true,
            dom: '<"html5buttons"B>lTfgitp',
            buttons: [
                { extend: 'copy' },
                { extend: 'csv' },
                { extend: 'excel', title: 'FacultyList' },
                { extend: 'pdf', title: 'FacultyList' },

                {
                    extend: 'print',
                    customize: function (win) {
                        $(win.document.body).addClass('white-bg');
                        $(win.document.body).css('font-size', '10px');

                        $(win.document.body).find('table')
                            .addClass('compact')
                            .css('font-size', 'inherit');
                    }
                }
            ]
        });

    });

    $("#btn-search").click(function () {
        // window.alert("sem:" + $('#SemesterId').val() + " sess:" + $('#SessionId').val());
        window.oTable.ajax.reload();

    });
    function Edit(schoolFeeTypeId) {
        var url = "/SchoolFeeTypes/Save?id=" + schoolFeeTypeId;

        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal('show');
            });
    };
    function Delete(schoolFeeTypeId) {
        var url = "/SchoolFeeTypes/Delete?id=" + schoolFeeTypeId;
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
    };
    function myFunction() {
        var url = "/SchoolFeeTypes/Save?id=0";
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
    };
    function downloadExcel() {
        var url = "/SchoolFeeTypes/UploadSchoolFeeType";
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
    };

</script>