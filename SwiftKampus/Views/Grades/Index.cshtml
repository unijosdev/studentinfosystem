@model IEnumerable<SwiftKampusModel.Grade>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>Grade Settings</h5>
                    <div class="ibox-tools">
                        <a onclick="myFunction()" class="btn btn-primary" ><i class="fa fa-plus left"></i> ADD GRADE SETTINGS</a>

                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                        <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                            <i class="fa fa-wrench"></i>
                        </a>

                    </div>
                </div>
                <div class="ibox-content">

                    <div class="table-responsive">
                        <table id="Jdatatable" class="table table-striped table-bordered table-hover table-responsive dataTables-example">
                            <thead>
                                <tr>
                                    <th>School Programme</th>
                                    <th>Result Template</th>
                                    <th>Grade Name</th>
                                    <th>Minimum Value</th>
                                    <th>Maximum Value</th>
                                    <th>Grade Point</th>
                                    <th>Remark</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                        </table>

                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade modal-bf-fh" id="actionsList" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <!--Content-->
        <div class="modal-content">
            <!--Header-->
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <div class="flex-center">
                    <h4 class="modal-title">GRADE SETTINGS</h4>
                </div>
            </div>
            <!--Body-->
            <div class="modal-body" id="myModalDivBody">
            </div>
        </div>
        <!--/.Content-->
    </div>
</div>
<!-- /.Modal-->

<script src="~/Scripts/jquery-3.1.1.min.js"></script>

<script type="text/javascript">
    $(document).ready(function () {
        if ("@ViewBag.Message") {
            toastr["success"]("@ViewBag.Message");
        }
        window.oTable = $("#Jdatatable").DataTable({
            "processing": true, // for show progress bar while loading
           
            "ajax": {
                "url": "/Grades/GetIndex",
                "type": "POST",
                "datatype": "json"
            },
            "columns": [
                { "data": "FancyName", "autoWidth": true },
                { "data": "ResultTemplateName", "autoWidth": true }, 
                { "data": "GradeName", "autoWidth": true },
                { "data": "MinimumValue", "autoWidth": true },
                { "data": "MaximumValue", "autoWidth": true },
                { "data": "GradePoint", "autoWidth": true },
                { "data": "Remark", "autoWidth": true },
              
                {
                    "data": "GradeId",
                    "autoWidth": true,
                    "render": function (data) {
                        return '<a href="#" data-toggle="modal" data-target="#actionsList" onclick="Edit(' + data + ')" >  <i class="fa fa-pencil" aria-hidden="true" >&nbsp;Edit</i></a>&nbsp;&nbsp;' +
                            '<a href="#" class="text-danger" data-toggle="modal" data-target="#actionsList"  onclick="Delete(' + data + ')" ><i class="fa fa-remove" aria-hidden="true" >&nbsp;Remove<i /></a>';
                    }
                }

                //{ "data": "EmailID", "autoWidth": true },
                //{ "data": "Phone", "autoWidth": true },
            ]
        });

    });


    function Edit(gradeId) {
        var url = "/Grades/Save?id=" + gradeId;
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
    };
    function Delete(gradeId) {
        var url = "/Grades/Delete?id=" + gradeId;
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
    };
    function myFunction() {
        var url = "/Grades/Save?id=0";
        
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
    };

   


</script>