@model SwiftKampus.ViewModels.MisconductVm.FindStudent
@using Vereyon.Web;
@{
    ViewBag.Title = "Find Student";
}

@*<h2>Find Student</h2>*@

@using (Html.BeginForm("FindStudent", "StudentDisciplinary", FormMethod.Post))
{
    @Html.Raw(ViewBag.Message)
    @Html.AntiForgeryToken()
    <br />
    <div class="ibox float-e-margins col-md-10 col-md-offset-1">
        <div class="ibox-title">
            <div class="form-horizontal">
                <h4>Search for student using Matriculation Number</h4>
                <hr />
                @Html.RenderFlashMessages()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="error">
                </div>
                <div class="form-group col-md-12">
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.MatricNumber, new { htmlAttributes = new { @class = "form-control", @placeholder = "Matriculation Number", id="matricNumber" } })
                        @Html.ValidationMessageFor(model => model.MatricNumber, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-2">
                        <input type="submit" value="Search" class="btn btn-default" />
                    </div>
                </div>

                <div class="form-group">

                </div>
            </div>
        </div>
    </div>
}
<script src="~/AdminTemplate/js/jquery-3.1.1.min.js"></script>
<script>
    $(document).ready(function () {
        $(':input[type="submit"]').prop('disabled', true);
        $('#matricNumber').keyup(function () {
            if ($(this).val() != '') {
                $(':input[type="submit"]').prop('disabled', false);
            }
        });
    });
</script>