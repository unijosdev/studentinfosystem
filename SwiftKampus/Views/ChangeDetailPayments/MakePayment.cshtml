

@{
    ViewBag.Title = "Change Detail Payment";
}

<div class="row wrapper border-bottom white-bg page-heading">
    <div class="col-lg-10">
        <h2>Change Detail Payment</h2>

    </div>
    <div class="col-lg-2">

    </div>
</div>
<div class="container-fluid">
    <div class="wrapper wrapper-content animated fadeInRight">



        <div class="row">

            <div class="col-md-4">
                <div class="ibox-content">

                </div>
            </div>
            <div class="col-md-8">
                <div class="ibox-content">
                    <h2 class="text-danger text-center"> @ViewBag.Message</h2>
                    @using (Html.BeginForm("Create", "ChangeDetailPayments", FormMethod.Get))
                    {
                        @Html.AntiForgeryToken()


                        <div class="form-horizontal">
                            <hr />
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                            <h2> Payment for @ViewBag.StudentId</h2>



                            <div class="form-group">
                                @Html.Label("Select Payment", htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.DropDownList("ChangeDetailId", null, htmlAttributes: new { @class = "form-control" })
                                </div>
                            </div>
                           
                            <div class="form-group">
                                <div class="col-md-offset-2 col-md-10">
                                    <input type="submit" value="SELECT PAYMENT" class="btn btn-primary btn-lg" />
                                </div>
                            </div>
                        </div>
                    }
                </div>

            </div>
        </div>
    </div>
</div>


<script src="~/Scripts/jquery-3.1.1.min.js"></script>
<script type="text/javascript">
    document.getElementById('SchoolFeePaymentType').style.display = "none";
    document.getElementById('SemesterType').style.display = "none";

    $(document).ready(function () {

        $('#FeeCategory').change(function () {

            var selectedValue = $('#FeeCategory').val();
            // window.alert(selectedValue);

            if (selectedValue === 'School_Fee') {
                document.getElementById('SchoolFeePaymentType').style.display = "block";
            } else {
                document.getElementById('SchoolFeePaymentType').style.display = "none";
            }
        });
    });
</script>



