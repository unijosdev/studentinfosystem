@model IEnumerable<SwiftKampusModel.AddmissionApplicant.ApplicantFeeSetting>

@{
    ViewBag.Title = "Applicant Fee Setting";
}


<!-- Modal -->
<div class="modal fade modal-bf-fh" id="actionsList" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <!--Content-->
        <div class="modal-content">
            <!--Header-->
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <div class="flex-center">
                    <h4 class="modal-title">SCREENING FEE SETTINGS</h4>
                </div>
            </div>
            <!--Body-->
            <div class="modal-body" id="myModalDivBody">
            </div>
        </div>
        <!--/.Content-->
    </div>
</div>
<!-- /.Modal-->

<div class="container-fluid">

            <div class="wrapper wrapper-content animated fadeInRight">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="ibox float-e-margins">
                            <div class="ibox-title">
                                <h4>List of Screening/Application Form Fees</h4>
                                <img src="@Url.Action("BarcodeImage","Home", new {barcodeText = "Screening/Application Form Fees" })" />
                                <div class="ibox-tools">
                                    <a href="#" onclick="myFunction()" class="btn btn-primary"><i class="fa fa-plus left"></i> ADD SCREENING FEE</a>

                                    <a class="collapse-link">
                                        <i class="fa fa-chevron-up"></i>
                                    </a>
                                    <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                                        <i class="fa fa-wrench"></i>
                                    </a>
                                </div>
                            </div>


                            <div class="ibox-content">
                                <div class="table-responsive">
                                    <table id="Jdatatable" class="table table-striped table-hover">
                                        <thead>
                                            <tr>
                                                <th>Programme Name</th>
                                                <th>Session Name</th>
                                                <th>Application Fee</th>
                                                <th>Allocated Email</th>
                                                <th>Allocated Sms</th>
                                                <th>Email Enabled</th>
                                                <th>Sms Enabled</th>
                                                @*<th>Amount in Words</th>*@
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                    </table>

                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
  


<script src="~/Scripts/jquery-3.1.1.min.js"></script>

<script type="text/javascript">
    $(document).ready(function () {

        window.oTable = $("#Jdatatable").DataTable({
            "processing": true, // for show progress bar while loading

            "ajax": {
                "url": "/ApplicantFeeSettings/GetIndex",
                "type": "POST",
                "datatype": "json"
            },
            "columns": [
                { "data": "FancyName", "autoWidth": true },
                { "data": "SessionName", "autoWidth": true },
                { "data": "ApplicationFee", "autoWidth": true },
                { "data": "AllocatedEmail", "autoWidth": true },
                { "data": "AllocatedSms", "autoWidth": true },
                { "data": "IsEmailEnabled", "autoWidth": true },
                { "data": "IsSmsEnabled", "autoWidth": true },
                {
                    "data": "ApplicantFeeSettingId",
                    "autoWidth": true,
                    "render": function (data) {
                        return '<a href="#" data-toggle="modal" data-target="#actionsList" onclick="Edit(' + data + ')" >  <i class="fa fa-pencil" aria-hidden="true" >&nbsp;Edit</i></a>&nbsp;&nbsp;' +
                            '<a href="#" class="text-danger" data-toggle="modal" data-target="#actionsList"  onclick="Delete(' + data + ')" ><i class="fa fa-remove" aria-hidden="true" >&nbsp;Remove<i /></a>';
                    }
                }

                //{ "data": "EmailID", "autoWidth": true },
                //{ "data": "Phone", "autoWidth": true },
            ]
        });

    });
    function Edit(applicantFeeSettingId) {
        var url = "/ApplicantFeeSettings/Save?id=" + applicantFeeSettingId;
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal('show');
            });
    };
    function Delete(applicantFeeSettingId) {
        var url = "/ApplicantFeeSettings/Delete?id=" + applicantFeeSettingId;
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
    };
    function myFunction() {
        var url = "/ApplicantFeeSettings/Save?id=0";
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
    };
</script>
