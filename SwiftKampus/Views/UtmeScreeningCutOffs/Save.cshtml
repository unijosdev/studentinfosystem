@model SwiftKampusModel.AddmissionApplicant.UtmeScreeningCutOff

<form id="myform" onsubmit="return false;">
    @Html.AntiForgeryToken()
    <div class="card">
        <div class="card-body">

            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            @if (Model != null && Model.UtmeScreeningCutOffId > 0)
            {
                @Html.HiddenFor(model => model.UtmeScreeningCutOffId)
            }

            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="form-group">
                @Html.Label("Session Name")
                @Html.DropDownList("SessionId", null, htmlAttributes: new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.SessionId, "", new { @class = "text-danger" })
            </div>
            <div class="form-group">
                @Html.Label("Programme")
                @Html.DropDownList("ProgrammeId", null, htmlAttributes: new { @class = "form-control js-example-basic-single" })
                @Html.ValidationMessageFor(model => model.ProgrammeId, "", new { @class = "text-danger" })
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.CutOffMark)
                @Html.EditorFor(model => model.CutOffMark, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.CutOffMark, "", new { @class = "text-danger" })
            </div>

            <br />
            <div class="md-form">

                @if (Model != null && Model.UtmeScreeningCutOffId > 0)
                {
                    <input id="btnsubmit" type="submit" value="Update" class="btn btn-primary btn-lg" />
                }
                else
                {
                    <input id="btnsubmit" type="submit" value="Save" class="btn btn-primary btn-lg" />
                }
                <a href="#" class="btn btn-danger btn-lg" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</form>

<script type="text/javascript">

    $("#btnsubmit").click(function () {

        var data = $("#myform").serialize();

        $.ajax({
            type: "POST",
            url: "/UtmeScreeningCutOffs/Save",
            data: data,
            success: function (data) {
                if (data.status) {
                    $('#actionsList').modal("hide");
                    window.oTable.ajax.reload(); //run my_fun() ondomready
                    toastr["success"](data.message);
                    $('#myform')[0].reset();
                } else {
                    //$('#actionsList').modal("hide");
                    toastr["error"](data.message);
                }

            }
        });
    });
</script>