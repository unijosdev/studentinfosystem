@{
    ViewBag.Title = "Cut Off Mark";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>List of Utme Cut Off Mark</h5>
                    <div class="ibox-tools">
                        <a onclick="myFunction()" class="btn btn-primary"><i class="fa fa-plus left"></i> ADD CUT-OFF MARK</a>
                        <a href="@Url.Action("UploadDeptUtmeCutOff", "UtmeScreeningCutOffs")" class="btn btn-primary"><i class="fa fa-plus left"></i> UPLOAD CUT-OFF MARK</a>
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                        <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                            <i class="fa fa-wrench"></i>
                        </a>
                    </div>
                </div>


                <div class="ibox-content">
                    <div class="table-responsive">
                        <table id="Jdatatable" class="table table-striped table-bordered table-hover table-responsive dataTables-example">
                            <thead>
                                <tr>
                                    <th>Session Name</th>
                                    <th>Programme Name</th>
                                    <th>Cut Off</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- Modal -->
<div class="modal fade inmodal" id="actionsList" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <!--Content-->
        <div class="modal-content animated">
            <!--Header-->
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <div class="flex-center">
                    <h4 class="modal-title">UTME CUT OFF </h4>
                    @*<a class="btn btn-primary btn-sm">Create new action</a>*@
                </div>
            </div>
            <!--Body-->
            <div class="modal-body" id="myModalDivBody">
            </div>
        </div>
        <!--/.Content-->
    </div>
</div>
<!-- /.Modal-->

<link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.9/css/select2.min.css" rel="stylesheet" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.9/js/select2.min.js"></script>
<script src="~/Scripts/jquery-3.1.1.min.js"></script>

<script type="text/javascript">
    $(document).ready(function () {
        window.oTable = $("#Jdatatable").DataTable({
            "processing": true, // for show progress bar while loading

            "ajax": {
                "url": "/UtmeScreeningCutOffs/GetIndex",
                "type": "POST",
                "datatype": "json"
            },
            "columns": [
                { "data": "SessionName", "autoWidth": true },
                { "data": "ProgrammeName", "autoWidth": true },
                { "data": "CutOffMark", "autoWidth": true },
                {
                    "data": "UtmeScreeningCutOffId",
                    "autoWidth": true,
                    "render": function (data) {
                        return '<a href="#" onclick="Edit(' + data + ')" >  <i class="fa fa-pencil" aria-hidden="true" >&nbsp;Edit</i></a>&nbsp;&nbsp;' +
                            '<a href="#" class="text-danger" onclick="Delete(' + data + ')" ><i class="fa fa-remove" aria-hidden="true" >&nbsp;Remove<i /></a>';
                    }
                }
            ],
            responsive: true,
            dom: '<"html5buttons"B>lTfgitp',
            buttons: [
                { extend: 'copy' },
                { extend: 'csv' },
                { extend: 'excel', title: 'LevelList' },
                { extend: 'pdf', title: 'LevelList' },

                {
                    extend: 'print',
                    customize: function (win) {
                        $(win.document.body).addClass('white-bg');
                        $(win.document.body).css('font-size', '10px');

                        $(win.document.body).find('table')
                            .addClass('compact')
                            .css('font-size', 'inherit');
                    }
                }
            ]
        });
    });
    function Edit(cutOffId) {
        var url = "/UtmeScreeningCutOffs/Save?id=" + cutOffId;
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
        $('.js-example-basic-single').select2();

    };
    function Delete(cutOffId) {
        var url = "/UtmeScreeningCutOffs/Delete?id=" + cutOffId;
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
        });
    };
    function myFunction() {
        var url = "/UtmeScreeningCutOffs/Save?id=0";
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
        $('.js-example-basic-single').select2();
    };
</script>