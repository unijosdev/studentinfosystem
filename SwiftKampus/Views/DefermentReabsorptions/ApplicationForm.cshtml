@model Unijos.Web.ViewModels.StudentStatus.DefermentReabsorptionApplicationViewModel

@{
    ViewBag.Title = "Application Form For Deferment of Studies";
}
<link href="~/AdminTemplate/css/plugins/sweetalert/sweetalert.css" rel="stylesheet">


<div class="row animated fadeInDown">

    <div class="col-lg-12">
        <div class="ibox float-e-margins">
            <div class="ibox-title">
                <h5>Application Form For Deferment of Studies</h5>
                <div class="ibox-tools">
                    <a class="collapse-link">
                        <i class="fa fa-chevron-up"></i>
                    </a>
                    <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                        <i class="fa fa-wrench"></i>
                    </a>
                    <ul class="dropdown-menu dropdown-user">
                        <li>
                            <a href="#">Config option 1</a>
                        </li>
                        <li>
                            <a href="#">Config option 2</a>
                        </li>
                    </ul>
                    <a class="close-link">
                        <i class="fa fa-times"></i>
                    </a>
                </div>
            </div>
            <div class="ibox-content">
                @using (Html.BeginForm(null, null, FormMethod.Post, new { id = "applicationForm", @class = "applicationForm" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ChangeOfCoursePaymentId" id="ChangeOfCoursePaymentId" value="@Model.ChangeOfCoursePaymentId" />

                    <div class="form-horizontal">
                        <div class="row">
                            <div class="col-md-4">
                                <dl class="dl-horizontal">

                                    <dt>
                                        @Html.DisplayNameFor(model => model.Student.MatricNo)
                                    </dt>

                                    <dd>
                                        @Html.DisplayFor(model => model.Student.MatricNo)
                                    </dd>

                                    <dt>
                                        @Html.DisplayNameFor(model => model.Student.FullName)
                                    </dt>

                                    <dd>
                                        @Html.DisplayFor(model => model.Student.FullName)

                                    </dd>

                                    <dt>
                                        @Html.DisplayNameFor(model => model.Student.Programme.Department.Faculty.FacultyName)
                                    </dt>

                                    <dd>
                                        @Html.DisplayFor(model => model.Student.Programme.Department.Faculty.FacultyName)
                                    </dd>

                                    <dt>
                                        @Html.DisplayNameFor(model => model.Student.Programme.Department.DeptName)
                                    </dt>

                                    <dd>
                                        @Html.DisplayFor(model => model.Student.Programme.Department.DeptName)
                                    </dd>

                                    <dt>
                                        @Html.DisplayNameFor(model => model.Student.Programme.ProgrammeName)
                                    </dt>

                                    <dd>
                                        @Html.DisplayFor(model => model.Student.Programme.ProgrammeName)
                                    </dd>

                                    <dt>
                                        @Html.DisplayNameFor(model => model.SessionName)
                                    </dt>

                                    <dd>
                                        @Html.DisplayFor(model => model.SessionName)
                                    </dd>

                                    <dt>
                                        @Html.DisplayNameFor(model => model.Student.PrimaryEmail)
                                    </dt>

                                    <dd>
                                        @Html.DisplayFor(model => model.Student.PrimaryEmail)
                                    </dd>

                                    <dt>
                                        @Html.DisplayNameFor(model => model.Student.Email)
                                    </dt>

                                    <dd>
                                        @Html.DisplayFor(model => model.Student.Email)
                                    </dd>

                                    <dt>
                                        @Html.DisplayNameFor(model => model.Student.PhoneNumber)
                                    </dt>

                                    <dd>
                                        @Html.DisplayFor(model => model.Student.PhoneNumber)
                                    </dd>
                                </dl>
                            </div>
                            <div class="col-md-8">
                                <h3 class="col-md-12">Upload support document(s) if any in <span class="label label-danger">PDF format</span></h3>
                                <div class="fileupload col-md-12">
                                    <div class="col-md-10">
                                        <div class="fileinput fileinput-new input-group" data-provides="fileinput">
                                            <div class="form-control" data-trigger="fileinput">
                                                <i class="glyphicon glyphicon-file fileinput-exists"></i>
                                                <span class="fileinput-filename"></span>
                                            </div>
                                            <span class="input-group-addon btn btn-default btn-file">
                                                <span class="fileinput-new">Select file</span>
                                                <span class="fileinput-exists">Change</span>
                                                <input type="file" class="file ignore" id="file" accept=".pdf" />
                                            </span>
                                            <a href="#" class="input-group-addon btn btn-default fileinput-exists" data-dismiss="fileinput">Remove</a>
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <button type="button" class="btn-add btn btn-primary"><i class="fa fa-plus"></i></button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <h4>Application Form For Deferment of Studies</h4>
                        <hr />
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        <div class="form-group">
                            @Html.Label("Session to be deferred", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @*@Html.DropDownList("EndSessionId", null, "--SELECT--", htmlAttributes: new { @class = "form-control" })*@
                                @Html.DropDownList("StartSessionId", (IEnumerable<SelectListItem>)ViewBag.StartSession, htmlAttributes: new { @class = "form-control" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.Label("Session for which deferment is sought", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @*@Html.DropDownList("StartSessionId", null, "--SELECT--", htmlAttributes: new { @class = "form-control" })*@
                                @Html.DropDownList("EndSessionId", (IEnumerable<SelectListItem>)ViewBag.EndSession, htmlAttributes: new { @class = "form-control" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.Label("Reason(s) for which deferment is sought", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @*<textarea name="ReasonForDeferment" id="ReasonForDeferment" value="@Model?.ReasonForDeferment ?? ''" class="form-control" ></textarea>*@
                                @Html.TextAreaFor(model => model.ReasonForDeferment, new { @class="form-control", @id="ReasonForDeferment", @name="ReasonForDeferment", @value = @Model.ReasonForDeferment})
                            </div>
                        </div>
                        @Html.HiddenFor(model => model.Student.StudentId)

                        <div class="form-group">
                            <div class="col-md-offset-4 col-md-8">
                                <input type="submit" id="btnSubmitApplication" value="Submit Application" class="btn btn-primary" />
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script src="~/AdminTemplate/js/jquery-3.1.1.min.js"></script>
<script src="~/AdminTemplate/js/plugins/sweetalert/sweetalert.min.js"></script>

<script>
    $(document).ready(function () {
        var reasonForDeferment = $("#ReasonForDeferment"),
            startSessionId = $("#StartSessionId"),
            endSessionId = $("#EndSessionId");
            changeOfCoursePaymentId = $("#ChangeOfCoursePaymentId");

        var count = 1;
        $('.btn-add').click(function () {
            if (count < 3) {
                $('.fileupload').append(`<div class="file-container">
                                        <div class="col-md-10">
                                            <div class="fileinput fileinput-new input-group" data-provides="fileinput">
                                                <div class="form-control" data-trigger="fileinput">
                                                    <i class="glyphicon glyphicon-file fileinput-exists"></i>
                                                    <span class="fileinput-filename"></span>
                                                </div>
                                                <span class="input-group-addon btn btn-default btn-file">
                                                    <span class="fileinput-new">Select file</span>
                                                    <span class="fileinput-exists">Change</span>
                                                    <input type="file" class="file ignore" accept=".pdf" />
                                                </span>
                                                <a href="#" class="input-group-addon btn btn-default fileinput-exists" data-dismiss="fileinput">Remove</a>
                                            </div>
                                        </div>
                                        <div class="col-md-2">
                                            <button type="button" class="btn-minus btn btn-danger"><i class="fa fa-minus"></i></button>
                                        </div>
                                    </div >`);
                count++;
            }
        });

        $('.fileupload').on("click", '.btn-minus', function () {
            if (count > 0) {
                $(this).closest('.file-container').remove();
                count--;
            }
        });

        //document.addEventListener('click', function (e) {
        //    if (e.target && e.target.id == 'file') {
        //        console.log("target");
        //    }
        //});

        $('span.btn-file').on('click', 'input.file', function () {
            console.log(this);
            if (this.files[0].size > 307200) {
                alert("File is too big!");
                this.value = "";
            };
        });

        $("#btnSubmitApplication").on("click", function (e) {
            //e.preventDefault();
            $('form[id="applicationForm"]').validate({
                ignore: ".ignore",
                rules: {
                    ReasonForDeferment: {
                        required: true,
                        minlength: 10
                    },
                    StartSessionId: {
                        required: true
                    },
                    EndSessionId: {
                        required: true
                    }
                },
                messages: {
                    StartSessionId: 'This field is required',
                    EndSessionId: 'This field is required',
                    ReasonForDeferment: {
                        minlength: 'This field must be at least 8 characters long'
                    }
                },
                submitHandler: function (form) {
                    // Checking whether FormData is available in browser
                    if (window.FormData !== undefined) {
                        // Create FormData object
                        var fileData = new FormData();

                        var fileUploads = $(".file");

                        jQuery.each(fileUploads, function (key, value) {
                            if (value.files[0] != undefined) {
                                //console.log(key + "," + value.files[0].name);
                                fileData.append(value.files[0].name, value.files[0]);
                            }
                        });

                        // Adding one more key to FormData object
                        fileData.append('ReasonForDeferment', reasonForDeferment.val());
                        fileData.append('StartSessionId', startSessionId.val());
                        fileData.append('EndSessionId', endSessionId.val());
                        fileData.append('ChangeOfCoursePaymentId', changeOfCoursePaymentId.val());
                        
                        $.ajax({
                            url: '/DefermentReabsorptions/JSONDefermentApplicationForm/',
                            type: "POST",
                            contentType: false, // Not to set any content header
                            processData: false, // Not to process data
                            data: fileData,
                            success: function (result) {
                                swal({
                                    title: "Success!",
                                    text: "Your application for deferment of studies was saved successfully.",
                                    type: "success",
                                }, function () {
                                    window.location = "DefermentReabsorptions/Index";
                                });
                            },
                            error: function (err) {
                                swal({
                                    title: "Important!",
                                    text: "The form did not save. Please try again.",
                                    type: "warning",
                                });
                                window.location = "DefermentReabsorptions/Index";
                            }
                        });
                    } else {
                        swal({
                            title: "Important!",
                            text: "Your browser does not support file upload. Please use a different browser.",
                            type: "danger",
                        });
                    }
                }
            });
        });
    });
</script>
