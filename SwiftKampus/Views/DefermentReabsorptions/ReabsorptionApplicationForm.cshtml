@model Unijos.Web.ViewModels.StudentStatus.DefermentReabsorptionApplicationViewModel

@{
    ViewBag.Title = "Application Form For Re-Absorption into Programme";
}

<div class="row animated fadeInDown">

    <div class="col-lg-12">
        <div class="ibox float-e-margins">
            <div class="ibox-title">
                <h5>Application Form For Re-Absorption into Programme</h5>
                <div class="ibox-tools">
                    <a class="collapse-link">
                        <i class="fa fa-chevron-up"></i>
                    </a>
                    <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                        <i class="fa fa-wrench"></i>
                    </a>
                    <ul class="dropdown-menu dropdown-user">
                        <li>
                            <a href="#">Config option 1</a>
                        </li>
                        <li>
                            <a href="#">Config option 2</a>
                        </li>
                    </ul>
                    <a class="close-link">
                        <i class="fa fa-times"></i>
                    </a>
                </div>
            </div>
            <div class="ibox-content">
                @using (Html.BeginForm(null, null, FormMethod.Post, new { id = "applicationForm", @class = "applicationForm" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-horizontal">
                        <div class="row">
                            <div class="col-md-6">
                                <dl class="dl-horizontal">

                                    <dt>
                                        @Html.DisplayNameFor(model => model.Student.MatricNo)
                                    </dt>

                                    <dd>
                                        @Html.DisplayFor(model => model.Student.MatricNo)
                                    </dd>

                                    <dt>
                                        @Html.DisplayNameFor(model => model.Student.FullName)
                                    </dt>

                                    <dd>
                                        @Html.DisplayFor(model => model.Student.FullName)

                                    </dd>

                                    <dt>
                                        @Html.DisplayNameFor(model => model.Student.Programme.Department.Faculty.FacultyName)
                                    </dt>

                                    <dd>
                                        @Html.DisplayFor(model => model.Student.Programme.Department.Faculty.FacultyName)
                                    </dd>

                                    <dt>
                                        @Html.DisplayNameFor(model => model.Student.Programme.Department.DeptName)
                                    </dt>

                                    <dd>
                                        @Html.DisplayFor(model => model.Student.Programme.Department.DeptName)
                                    </dd>

                                    <dt>
                                        @Html.DisplayNameFor(model => model.Student.Programme.ProgrammeName)
                                    </dt>

                                    <dd>
                                        @Html.DisplayFor(model => model.Student.Programme.ProgrammeName)
                                    </dd>

                                    <dt>
                                        @Html.DisplayNameFor(model => model.SessionName)
                                    </dt>

                                    <dd>
                                        @Html.DisplayFor(model => model.SessionName)
                                    </dd>

                                    <dt>
                                        @Html.DisplayNameFor(model => model.Student.PrimaryEmail)
                                    </dt>

                                    <dd>
                                        @Html.DisplayFor(model => model.Student.PrimaryEmail)
                                    </dd>

                                    <dt>
                                        @Html.DisplayNameFor(model => model.Student.Email)
                                    </dt>

                                    <dd>
                                        @Html.DisplayFor(model => model.Student.Email)
                                    </dd>

                                    <dt>
                                        @Html.DisplayNameFor(model => model.Student.PhoneNumber)
                                    </dt>

                                    <dd>
                                        @Html.DisplayFor(model => model.Student.PhoneNumber)
                                    </dd>
                                </dl>
                            </div>
                            <div class="col-md-6">
                                <h3>Upload support document(s) if any</h3>
                                <div class="fileinput fileinput-new input-group" data-provides="fileinput">
                                    <div class="form-control" data-trigger="fileinput">
                                        <i class="glyphicon glyphicon-file fileinput-exists"></i>
                                        <span class="fileinput-filename"></span>
                                    </div>
                                    <span class="input-group-addon btn btn-default btn-file">
                                        <span class="fileinput-new">Select file</span>
                                        <span class="fileinput-exists">Change</span>
                                        <input type="file" class="file" name="evidence_1" id="evidence_1" />
                                    </span>
                                    <a href="#" class="input-group-addon btn btn-default fileinput-exists" data-dismiss="fileinput">Remove</a>
                                </div>
                            </div>
                        </div>

                        <h4>Application Form For Reabsorption</h4>
                        <hr />
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                        <div class="form-group">
                            @Html.Label("Reason(s) for Extension of Duration of Studies", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                <textarea name="ReasonForExtensionDuration" id="ReasonForExtensionDuration" class="form-control" readonly>@Html.DisplayFor(model => model.ReasonForDeferment)</textarea>
                            </div>
                        </div>

                        @Html.HiddenFor(model => model.DefermentReabsorptionId)

                        @Html.HiddenFor(model => model.StudentId)

                        <div class="form-group">
                            <div class="col-md-offset-4 col-md-8">
                                <input type="submit" id="btnSubmitApplication" value="Submit Application" class="btn btn-primary" />
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script src="~/AdminTemplate/js/jquery-3.1.1.min.js"></script>
<script src="~/AdminTemplate/js/plugins/validate/jquery.validate.min.js"></script>
<script>
    $(document).ready(function () {
        var reasonForExtensionDuration = $("#ReasonForExtensionDuration"),
            StudentId = $("#StudentId"),
            DefermentReabsorptionId = $("#DefermentReabsorptionId");

        $('form[id="applicationForm"]').validate({
            rules: {
                ReasonForExtensionDuration: {
                    required: true,
                    minlength: 10
                }
            },
            messages: {
                ReasonForExtensionDuration: {
                    minlength: 'This field must be at least 8 characters long'
                }
            },
            submitHandler: function (form) {
                // Checking whether FormData is available in browser
                if (window.FormData !== undefined) {

                    var fileUpload = $(".file").get(0);
                    var files = fileUpload.files;

                    // Create FormData object
                    var fileData = new FormData();

                    // Looping over all files and add it to FormData object
                    for (var i = 0; i < files.length; i++) {
                        fileData.append(files[i].name, files[i]);
                    }

                    // Adding one more key to FormData object
                    fileData.append('ReasonForExtensionDuration', reasonForExtensionDuration.val());
                    fileData.append('DefermentReabsorptionId', DefermentReabsorptionId.val());
                    fileData.append('StudentId', StudentId.val());

                    $.ajax({
                        url: '/DefermentReabsorptions/JSONReabsorptionApplicationForm/',
                        type: "POST",
                        contentType: false, // Not to set any content header
                        processData: false, // Not to process data
                        data: fileData,
                        success: function (result) {
                            swal({
                                title: "Success!",
                                text: "Your application for re-absorption into programme was saved successfully.",
                                type: "success",
                            }, function () {
                                window.location = "/";
                            });
                        },
                        error: function (err) {
                            swal({
                                title: "Important!",
                                text: "The form did not save. Please try again.",
                                type: "warning",
                            });
                        }
                    });
                } else {
                    swal({
                        title: "Important!",
                        text: "Your browser does not support file upload. Please use a different browser.",
                        type: "danger",
                    });
                }
            }
        });
    });
</script>
