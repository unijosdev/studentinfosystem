@model SwiftKampus.ViewModels.StaffRoleVm

<script src="~/AdminTemplate/js/plugins/chosen/chosen.jquery.js"></script>
<link href="~/AdminTemplate/css/plugins/chosen/bootstrap-chosen.css" rel="stylesheet" />

<form id="myform" onsubmit="return false;">
    @Html.AntiForgeryToken()

    <div class="card">
        <div class="card-head style-primary">
            <header>
                <h3>Adding Staff Roles</h3>
            </header>
        </div><!--end .card-head -->
        <div class="card-body">

            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="form-group">
                @Html.Label("Staff ID")
                @Html.EditorFor(model => model.StaffId, new { htmlAttributes = new { @class = "form-control", @readonly = true } })
                @Html.ValidationMessageFor(model => model.StaffId, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.Label("Staff Role Name")
                @Html.DropDownList("StaffRoleName", null, htmlAttributes: new { @class = "form-control chosen-select", @multiple = "true" })
                @Html.ValidationMessageFor(model => model.StaffRoleName, "", new { @class = "text-danger" })
            </div>

            <div class="md-form">

                <input id="btnsubmit" type="submit" value="Add Role" class="btn btn-success btn-lg" />

                <a href="#" class="btn btn-danger btn-lg" data-dismiss="modal">Cancel</a>
            </div>
        </div><!--end .card-body -->
    </div><!--end .card -->
</form>
@*@section Scripts {
        @Scripts.Render("~/bundles/jqueryval")
    }*@

<script type="text/javascript">

    $('.chosen-select').chosen();
    $(function () {
        $('.listbox').multiselect({
            includeSelectAllOption: true
        });
    });

    $("#btnsubmit").click(function () {

        var data = $("#myform").serialize();

        $.ajax({
            type: "POST",
            url: "/RolesAdmin/AddStaff",
            data: data,
            success: function (data) {
                if (data.status) {
                    $('#actionsList').modal("hide");

                    window.oTable.ajax.reload(); //run my_fun() ondomready
                    toastr["success"](data.message);
                    $('#myform')[0].reset();
                } else {
                    //$('#actionsList').modal("hide");
                    toastr["error"](data.message);
                }

            }
        });
    });
</script>