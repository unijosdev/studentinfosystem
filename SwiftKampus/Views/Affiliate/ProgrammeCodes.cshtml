@model IEnumerable<SwiftKampusModel.Programme>

@{
    ViewBag.Title = "Programme Codes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h4>List of Department Option</h4>
                </div>

                <div class="ibox-content">
                    <div class="table-responsive">
                        <table id="Jdatatable" class="table table-striped table-bordered table-hover table-responsive dataTables-example">
                            <thead>
                                <tr>
                                    <th>Department Name</th>
                                    <th>Dept Option Name</th>
                                    <th>Dept Option Code</th>
                                    <th>Awarding Degree Name</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



<!-- Modal -->
<div class="modal fade inmodal" id="actionsList" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <!--Content-->
        <div class="modal-content animated">
            <!--Header-->
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <div class="flex-center">
                    <h4 class="modal-title">DEPT OPTION</h4>
                    @*<a class="btn btn-primary btn-sm">Create new action</a>*@
                </div>
            </div>
            <!--Body-->
            <div class="modal-body" id="myModalDivBody">
            </div>
        </div>
        <!--/.Content-->
    </div>
</div>
<!-- /.Modal-->

<script src="~/Scripts/jquery-3.1.1.min.js"></script>

<script type="text/javascript">
    $(document).ready(function () {

        window.oTable = $("#Jdatatable").DataTable({
            "processing": true, // for show progress bar while loading

            "ajax": {
                "url": "/Affiliate/GetProgrammeCodes",
                "type": "POST",
                "datatype": "json"
            },
            "columns": [
                { "data": "DeptName", "autoWidth": true },
                { "data": "ProgrammeName", "autoWidth": true },
                { "data": "ProgrammeCode", "autoWidth": true },
                { "data": "AwardingDegreeName", "autoWidth": true },
            ],
            responsive: true,
            dom: '<"html5buttons"B>lTfgitp',
            lengthMenu: [
                [10, 25, 50, 100, 200, 500, 1000, 2000, 3000, 5000],
                [10, 25, 50, 100, 200, 500, 1000, 2000, 3000, 5000]
            ],
            buttons: [
                { extend: 'copy' },
                { extend: 'csv' },
                { extend: 'excel', title: 'DeptOption' },
                { extend: 'pdf', title: 'DeptOption' },

                {
                    extend: 'print',
                    customize: function (win) {
                        $(win.document.body).addClass('white-bg');
                        $(win.document.body).css('font-size', '10px');

                        $(win.document.body).find('table')
                            .addClass('compact')
                            .css('font-size', 'inherit');
                    }
                }
            ]
        });

    });
    function myFunction() {
        var url = "/Programmes/Save?id=0";

        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
    };
</script>