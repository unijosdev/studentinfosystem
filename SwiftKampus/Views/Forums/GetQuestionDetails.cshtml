@model SwiftKampusModel.CourseForum.ForumQuestionVm


<div class="card">
    <div class="card-head style-primary">
        <header>
            <h3>
                Question Replies
            </h3>
        </header>

    </div><!--end .card-head -->
    <div class="card-body">
        <div>
   
            <dl class="dl-horizontal">
                <dt>
                    @Html.DisplayNameFor(model => model.Forum.Name)
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.Forum.Name)
                </dd>

                <dt>
                    @Html.DisplayNameFor(model => model.ForumQuestion.ForumQuestionId)
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.ForumQuestion.ForumQuestionId)
                </dd>

                @*<dt>
                    @Html.DisplayNameFor(model => model.Student.ImeiNo)
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.Student.ImeiNo)
                </dd>*@

                <dt>
                    @Html.DisplayNameFor(model => model.ForumQuestion.Title)
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.ForumQuestion.Title)
                </dd>

                <dt>
                    @Html.DisplayNameFor(model => model.ForumQuestion.Question)
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.ForumQuestion.Question)
                </dd>

            </dl>
        </div>
    </div>
</div>
<div class="row">
    <!-- BEGIN INBOX EMAIL LIST -->
    <div class="col-md-10 col-lg-12 height-6 scroll-sm">
        <div class="list-group list-email list-gray">
       
            @foreach (var item in Model.ForumQuestionReplies)
            {
                <div class="list-group-item">
                    
                    <p class="text-ultra-bold">@item.Answer</p>
                    <div class="stick-top-right small-padding text-default-light text-sm"><i>answered</i>&nbsp; @item.ReplyDate
                        <br/> <strong class="text-bold">By @item.UserId</strong>
                    </div>

                    <div>
                        <table table table-striped table-hover>
                            @foreach (var comment in Model.ForumComment.Where(x => x.ContentId.Equals(item.ForumQuestionReplyId)))
                            {
                                <tr style="width: 100%">

                                    <td class="hidden-xs hidden-sm">@comment.Body</td>
                                    <td class="hidden-xs hidden-sm"> by: @comment.UserId &nbsp;</td>
                                    <td class="hidden-xs hidden-sm"> @comment.CommentDateTime</td>

                                </tr>
                                <br/>
                            }

                        </table>

                    </div>
                    <div class="stick-bottom-right small-padding">
                        <span><a href="#" onclick="AddReplyComment(@item.ForumQuestionReplyId)" data-toggle="tooltip" data-placement="top" title="Add Comment"><i class="fa fa-plus" aria-hidden="true">Add Comment</i></a></span>
                    </div>



                </div>
            }
        

            @*<a href="../../html/mail/inbox.html" class="list-group-item">
                <h5>Jonathan Smith</h5>
                <h4>I am on my way</h4>
                <p class="hidden-xs hidden-sm">Donec id elit non mi porta gravida at eget metus. Maecenas sed diam eget risus varius blandit...</p>
                <div class="stick-top-right small-padding text-default-light text-sm">12:46 am</div>
                <div class="stick-bottom-right small-padding">
                    <span class="glyphicon glyphicon-paperclip"></span>
                </div>
            </a>*@

        </div><!--end .list-group -->
    </div><!--end .col -->
    <!-- END INBOX EMAIL LIST -->
</div>
<div class="card">
    <div class="card-head style-primary">
        <header>
            <h3>
                Your Answer
            </h3>
        </header>

    </div><!--end .card-head -->
    <div class="card-body">
        <!-- BEGIN MAIL COMPOSE -->
        <div class="col-sm-8 col-md-9 col-lg-10">
     
            <form id="formCompose" onsubmit="return false;">
                <div class="form-group floating-label">
                    <input type="number" class="form-control" id="ForumQuestionId" name="ForumQuestionId" value="@Model.ForumQuestion.ForumQuestionId">
                    <label for="ForumQuestionId">To</label>
                </div><!--end .form-group -->

                <div class="form-group">
                    <textarea id="simple-summernote" name="Answer" class="form-control control-6-rows" spellcheck="true"></textarea>
                </div><!--end .form-group -->
                <input id="btnQuestionReply" type="submit" value="Submit Answer" class="btn btn-primary btn-lg" />
            </form>
        </div><!--end .col -->
        <!-- END MAIL COMPOSE -->
    </div>
</div>

<!-- Modal -->
<div class="modal fade modal-bf-fh" id="actionsList" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <!--Content-->
        <div class="modal-content">
            <!--Header-->
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <div class="flex-center">
                    <h4 class="modal-title">COMMENT</h4>
                    @*<a class="btn btn-primary btn-sm">Create new action</a>*@
                </div>
            </div>
            <!--Body-->
            <div class="modal-body" id="myModalDivBody">
                <form class="form" id="replyComment" onsubmit="return false;">
                        <div class="form-group floating-label">
                            <input type="text" class="form-control" id="Body" name="Body" >
                            <label for="Body">CC</label>
                        </div><!--end .form-group -->
                        <div class="form-group floating-label">
                            <input type="number" class="form-control" id="ContentId" value="" name="ContentId" >
                            <label for="ContentId">BCC</label>
                        </div><!--end .form-group -->
                        <div class="form-group">
                            <input id="btnReplyComment" type="submit" value="Submit Answer" class="btn btn-primary btn-lg" />
                    </div><!--end #emailOptions -->
                </form>
            </div>
        </div>
        <!--/.Content-->
    </div>
</div>
<!-- /.Modal-->



<script type="text/javascript">
    $("#btnQuestionReply").click(function () {

        var data = $("#formCompose").serialize();

        $.ajax({
            type: "POST",
            url: "/Forums/SaveQuestionReply",
            data: data,
            success: function (data) {
                if (data.status) {
                    $('#actionsList').modal("hide");
                    toastr["success"](data.message);
                    $('#myform')[0].reset();
                    window.GetQuestion(data.id);
                } else {
                    //$('#actionsList').modal("hide");
                    toastr["error"](data.message);
                }

            }
        });
    });
    $("#btnReplyComment").click(function () {
        window.alert("hi");
        var data = $("#replyComment").serialize();
        window.alert(data);
        $.ajax({
            type: "POST",
            url: "/Forums/SaveForumComment",
            data: data,
            success: function (data) {
                if (data.status) {
                    $('#actionsList').modal("hide");
                    toastr["success"](data.message);
                    $('#myform')[0].reset();
                    window.GetQuestion(data.id);
                } else {
                    //$('#actionsList').modal("hide");
                    toastr["error"](data.message);
                }

            }
        });
    });

    function GetQuestion(forumQuestionId) {
        var url = "/Forums/GetQuestionDetails?id=" + forumQuestionId;
        // document.getElementById('topicContentDetail').scrollIntoView();
        $('#topicContentDetail').load(url);
        $('html, body').animate({ scrollTop: $('#topicContentDetail').offset().top }, 'slow');
    };

    
    function AddReplyComment(contentId) {
        document.getElementById("ContentId").value = contentId;
        $('#actionsList').modal("show");
            
    };

</script>