    <!-- This script adds searching for a particular menu item in admin dashboard -->
    <script>
        $(document).ready(function () {
            $("#searchButton").click(function () {
                filterMenu();
            });

            // Handle input change (clearing the search input)
            $("#menuSearch").on('input', function () {
                var searchTerm = $(this).val().toLowerCase();
                if (searchTerm === "") {
                    resetMenu();
                } else {
                    filterMenu();
                }
            });

            function filterMenu() {
                var searchTerm = $("#menuSearch").val().toLowerCase();

                // Loop through each menu item and check if it contains the search term
                $("#side-menu li").each(function () {
                    var menuItemText = $(this).text().toLowerCase();

                    if (menuItemText.includes(searchTerm)) {
                        $(this).show(); // Display the menu item if it matches
                    } else {
                        $(this).hide(); // Hide the menu item if it doesn't match
                    }
                });
            }

            function resetMenu() {
                // Show all menu items
                $("#side-menu li").show();
            }
        });
    </script>

