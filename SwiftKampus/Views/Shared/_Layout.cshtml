                        //var msg = chatformat_msg('Wow! What a Beautiful theme!', 'receive', name);
                        //msg += chatformat_msg('Yes! Crest Admin Theme ;)', 'sent', 'You');
                        activeChats = activeChats + 1;
                        $('#small-chat span').html(activeChats);
                        var userId = '@User.Identity.GetUserId()';
                        chat.server.loadPrivateMessage(userId, id);
                             //chat.server.sendPrivateMessage(id, msg, userId);
                        var html = '<div class="small-chat-box fadeInRight animated user-window" id= "user-window' + id + '" data-user-id="' + id + '">';
                            html += '<div class="heading" draggable="true">';
                            html += '<small class="pull-right">';
                            html += '<a href="#"><i class="fa fa-close" onclick="close_box(\''+id+'\')"></i></a>';
                            html += '</small>'+name;
                            html += '</div>';
                            html += '<div class="content">';
                            html += '</div>';
                            html += '<div class="form-chat">';
                            html += '<div class="input-group input-group-sm">';
                            html += '<input type="text" class="form-control chatMessage" data-user-id="' + id + '" id="chat' + id + '">';
                            html += '<span class="input-group-btn">';
                            html += '<button class="btn btn-primary sendMessage" type="button" onclick="sendMessage(\'' + id + '\')">Send';
                            html += '</button>';
                            html += '</span>';
                            html += '</div>';
                            html += '</div>';
                            html += '</div>';
                            $(".message-area").append(html);
                            $(".message-area #user-window" + id + " .content").scrollTop($(".message-area #user-window" + id + " .content")[0].scrollHeight);
                    }
                }
                $(".message-area").removeClass('showit');
            }

            //formatGroupChat function to format group chat
            function formatGroupChat(name, message) {
                var d = new Date();
                var h = d.getHours();
                var m = d.getMinutes();
                if (name === username) {
                    var html = '<div class="chat-message right">' +
                        '<img class="message-avatar" src="/images/DP/dummy.png" alt="">' +
                        '<div class="message">' +
                        '<a class="message-author" href="#">' + name + '</a>' +
                        '<span class="message-date">' + h + ':' + m + '</span>' +
                        '<span class="message-content">' + message +
                        '</span>' +
                        '</div>' +
                        '</div>';
                    return html;
                } else {
                    var html = '<div class="chat-message left">' +
                        '<img class="message-avatar" src="/images/DP/dummy.png" alt="">' +
                        '<div class="message">' +
                        '<a class="message-author" href="#">' + name + '</a>' +
                        '<span class="message-date">' + h + ':' + m + '</span>' +
                        '<span class="message-content">' + message +
                        '</span>' +
                        '</div>' +
                        '</div>';
                    return html;
                }
            }

            //create format for message to display in chat box
            function chatformat_msg(msg, name, time) {

                if (name === username) {

                    if (msg === '') {
                        return "";
                    }
                    else {
                        html = '<div class="right">';
                        html += '<div class="author-name">' + 'You' + ' ';
                        html += '<small class="chat-date">' + time;
                        html += '</small>';
                        html += '</div>';
                        html += '<div class="chat-message">' + msg;
                        html += '</div>';
                        html += '</div>';
                        return html;
                    }
                } else {
                    if (msg === '') {
                        return "";
                    }
                    else {
                        html = '<div class="left">';
                        html += '<div class="author-name">' + name + ' ';
                        html += '<small class="chat-date">' + time;
                        html += '</small>';
                        html += '</div>';
                        html += '<div class="chat-message active">' + msg;
                        html += '</div>';
                        html += '</div>';
                        return html;
                    }
                }
            }

            function fetchGroupMessages() {
                readmoreCount = readmoreCount + 20;
                chat.server.sendGroupMessages(readmoreCount);
            }

            function sendMessage(userId) {
                var id = userId;
                console.log(id);
                    var msg = $('#chat' + id).val();
                    var userId = '@User.Identity.GetUserId()';
                        //send message to recipient
                    chat.server.sendPrivateMessage(id, msg, userId);
                    var d = new Date();
                    var h = d.getHours();
                    var m = d.getMinutes();
                    var time = h + ':' + m;
                    msg = chatformat_msg(msg, username, time);
                        //Add message to senders chat window
                        $(".message-area #user-window" + id + " .content").append(msg);
                        $('#chat'+id).val("");
                        $('#chat' + id).focus();
                        $(".message-area #user-window" + id + " .content").scrollTop($(".message-area #user-window" + id + " .content")[0].scrollHeight);
                        e.preventDefault();
            }

            function close_box(id) {
                    console.log(id);
                    $('#user-window' + id).hide();
                    activeChats = activeChats < 1 ? 0 : activeChats - 1;
                    $('#small-chat span').html(activeChats);
            }
        </script>*@
