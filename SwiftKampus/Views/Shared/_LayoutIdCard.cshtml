<!DOCTYPE html>
<html lang="en">
<head>
    <style media="screen">
        body {
            margin-top: 0px;
            margin-bottom: 0px;
            margin-left: 0px;
            margin-right: 0px;
        }

        .idCardbgfront {
            background-image: url(../Content/Images/front.jpg) ;
            background-repeat: no-repeat;
            background-position: center;
        }

        .idCardbgback {
            background-image: url(../Content/Images/back.jpg);
            background-repeat: no-repeat;
            background-position: center;
        }

        .idText {
            font-family: Verdana, Arial, Helvetica, sans-serif;
            color: #000000;
            font-size: 8px;
        }

        .idTextBold {
            font-family: Verdana, Arial, Helvetica, sans-serif;
            font-weight: bold;
            color: #000000;
            font-size: 8px;
        }

        .idTextHead {
            font-family: Verdana, Arial, Helvetica, sans-serif;
            font-weight: bold;
            color: #000000;
            font-size: 10px;
        }

        .idTextExtHead {
            font-family: Verdana, Arial, Helvetica, sans-serif;
            font-weight: bold;
            color: #000000;
            font-size: 12px;
        }

        .idtextm {
            font-family: Verdana, Arial, Helvetica, sans-serif;
            font-size: 8px;
        }
    </style>
</head>
<body>
    @RenderBody()
</body>
</html>
