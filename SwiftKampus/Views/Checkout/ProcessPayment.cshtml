
@model SwiftKampus.ViewModels.ShoppingCart.CheckoutVm

    @{
        ViewBag.Title = "SubmitRemita";
    }



    <img src="~/Content/Images/processing.gif" /> 
    <form id="form1" method="POST" action="https://login.remita.net/remita/ecomm/init.reg">
        @Html.AntiForgeryToken()

        <div>
            <hr />
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            @Html.HiddenFor(model => model.CustomerFullname)
            @Html.HiddenFor(model => model.CustomerEmail)
            @Html.HiddenFor(model => model.CustomerPhoneNumber)
            @Html.HiddenFor(model => model.OrderId)
            @Html.HiddenFor(model => model.merchantId)
            @Html.HiddenFor(model => model.serviceTypeId)
            @Html.HiddenFor(model => model.responseurl)
            @Html.HiddenFor(model => model.TotalAmount)
            @Html.HiddenFor(model => model.hash)
            @Html.HiddenFor(model => model.paymenttype)

        </div>
    </form>



    @section Scripts {
        @Scripts.Render("~/bundles/jqueryval")
    }
    <script src="~/Scripts/jquery-3.1.1.min.js"></script>
    <script type="text/javascript">document.getElementById("form1").submit();</script>
