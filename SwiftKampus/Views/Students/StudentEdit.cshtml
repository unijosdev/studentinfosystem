                                                            @Html.ValidationMessageFor(model => model.PChallengedDetail, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <br />
                                            <br />
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <input type="submit" id="btnStudentSubmit" value="Save Biodata" class="btn btn-primary btn-sm text-right">
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <a id="btneditNext" href="#" class="btn btn-warning btn-sm btnNext text-left">NEXT</a>
                                                    </div>
                                                </div>

                                            </div>
                                            <!-- Edit Form -->
                                        </div>
                                        <!--/.Card content-->
                                    </div>
                                </div>
                                <!--/.Card-->
                            </div>

                        </div>
                        <!-- /.First row -->
                    </section>
                    <!-- /.Section: Edit Account -->
                </div>
            </form>
            <!--/Main layout-->

        </div>
    </div>
</div>

