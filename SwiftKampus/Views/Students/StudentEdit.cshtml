    function getLgaList() {
        var stateId = $("#StateOfOrigin").val();
        //alert(stateId);
        $.ajax
            ({
                url: '/Students/GetLgaList?codeId=' + stateId,
                type: 'GET',
                datatype: 'application/json',
                contentType: 'application/json',
                //data: JSON.stringify({
                //    codeId: +stateId
                //}),
                success: function (result) {
                    $("#Lga").html("");
                    $.each($.parseJSON(result),
                        function (i, city) {
                            $("#Lga").append($('<option></option>').val(city).html(city));
                        });

                },
                error: function () {
                    alert("Whooaaa! Something went wrong..");
                }
            });
    }
    function goNextStudent() {
        $("#passportsignature").click();
    }
    $("#btneditNext").click(function () {
        $("#passportsignature").click();
