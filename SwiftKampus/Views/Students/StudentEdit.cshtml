                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <div class="col-sm-12">
                                                            @Html.LabelFor(model => model.Religion, new { htmlAttributes = new { @class = "control-label" } })
                                                            @*@Html.DropDownList("Religion", (SelectList)ViewBag.Religion, "", new { @class = "form-control", id = "Religion", @placeholder = "Select Religion" })*@
                                                            @Html.DropDownList("Religion", null, "", htmlAttributes: new { @class = "form-control", id = "Religion" })

                                                        </div>
                                                        @Html.ValidationMessageFor(model => model.Religion, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>

                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <div class="col-sm-12">
                                                            @Html.LabelFor(model => model.MaritalStatus, new { htmlAttributes = new { @class = "control-label" } })
