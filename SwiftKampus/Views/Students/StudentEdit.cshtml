                                                            @Html.DropDownList("Lga", null, "", htmlAttributes: new { @class = "form-control", id = "Lga" })
                                                        </div>
                                                        @*@Html.DropDownList("Lga", null, htmlAttributes: new { @class = "form-control" })*@
