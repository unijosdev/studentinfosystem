@model SwiftKampus.ViewModels.StudentEditViewModel
@using SwiftKampus.Models

@{
    Layout = null;
    ViewBag.Title = "Update Student";
    var dateOfBirth = Model.DateOfBirth.ToString("yyyy-MM-dd");
}
<br />
<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">
        <div class="col-lg-12">
            <form id="myStudentform" method="post" onsubmit="return false;">

                @Html.HiddenFor(model => model.StudentId)
                @Html.HiddenFor(model => model.MatricNo)
                @Html.HiddenFor(model => model.JambRegNo)
                @Html.HiddenFor(model => model.LevelId)
                @Html.HiddenFor(model => model.EnrollmentDate)
                @Html.HiddenFor(model => model.ProgrammeId)
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="container-fluid">
                    <!-- Section: Edit Account -->
                    <section class="section">
                        <!-- First row -->
                        <div class="row">
                            <div class="col-lg-12">
                                <!--Card-->
                                <div class="card">
                                    <div class="card-head style-primary">
                                        <header>
                                            <h3>Student Profile</h3>
                                        </header>

                                    </div><!--end .card-head -->
                                    <div class="card-body">


                                        <div class="card-block">
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <div class="col-sm-12">
                                                            @Html.LabelFor(model => model.JambRegNo, new { htmlAttributes = new { @class = "control-label" } })
                                                            @Html.EditorFor(model => model.JambRegNo, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly", @required = "true" } })
                                                        </div>
                                                        @Html.ValidationMessageFor(model => model.JambRegNo, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <div class="col-sm-12">
                                                            @Html.LabelFor(model => model.LastName, new { htmlAttributes = new { @class = "control-label" } })
                                                            @Html.EditorFor(model => model.LastName, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                                                        </div>
                                                        @Html.ValidationMessageFor(model => model.LastName, "", new { @class = "text-danger", @readonly = "readonly" })
                                                    </div>
                                                </div>

                                            </div>
                                            <br />
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <div class="col-sm-12">
                                                            @Html.LabelFor(model => model.FirstName, new { htmlAttributes = new { @class = "control-label" } })
                                                            @Html.EditorFor(model => model.FirstName, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                                                        </div>
                                                        @Html.ValidationMessageFor(model => model.FirstName, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <div class="col-sm-12">
                                                            @Html.LabelFor(model => model.MiddleName, new { htmlAttributes = new { @class = "control-label" } })
                                                            @Html.EditorFor(model => model.MiddleName, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                                                        </div>
                                                        @Html.ValidationMessageFor(model => model.MiddleName, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>

                                            </div>
                                            <br />
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <div class="col-sm-12">
                                                            @Html.LabelFor(model => model.PhoneNumber, new { htmlAttributes = new { @class = "control-label" } })
                                                            @Html.EditorFor(model => model.PhoneNumber, new { htmlAttributes = new { @class = "form-control", required = "required" } })
                                                        </div>
                                                        @Html.ValidationMessageFor(model => model.PhoneNumber, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <div class="col-sm-12">
                                                            @Html.LabelFor(model => model.Gender, new { htmlAttributes = new { @class = "control-label" } })
                                                            @Html.DropDownList("Gender", null, "", htmlAttributes: new { @class = "form-control" })
                                                        </div>
                                                        @Html.ValidationMessageFor(model => model.Gender, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>

                                            </div>
                                            <br />
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <div class="col-sm-12">
                                                            @Html.LabelFor(model => model.DateOfBirth, new { htmlAttributes = new { @class = "control-label" } })
