        document.getElementById("DateOfBirth").valueAsDate = new Date('@dateOfBirth');
        $('#pChallenge').hide();
    });


    function updateTotal(elem) {
        if ($(elem).is(':checked')) {
            $('#pChallenge').show();
        } else {
            $('#pChallenge').hide();
        }
    }


   $("#myStudentform").submit(function (e) {
        e.preventDefault();
        var formData = new FormData(this);
        $.ajax({
            url: "/Students/StudentFormEdit",
            type: 'POST',
            data: formData,
            success: function (data) {
                if (data.status) {
                    swal({
                        title: "Bio-Data saved successfully",
                        //text: "Do you  Proceed?..",
                        type: "warning",
                        showCancelButton: true,
                        confirmButtonColor: "#ab973a",
                        confirmButtonText: "Proceed!",
                        //cancelButtonText: "No, See Result List!",
                        closeOnConfirm: false,
                        closeOnCancel: false
                    },
                        function (isConfirm) {
                            if (isConfirm) {
                                swal("Great!", "Proceed!!!.", "success");
                                goNextStudent();
                            } else {
                                swal("Great", "You can click the next button to proceed", "success");
                            }
                        });
                    toastr["success"](data.message);
                } else {
                    swal({
                        title: "Warning",
                        text: data.message,
                        type: "warning",
                    });
                    toastr["warning"](data.message);
                }


            },
            cache: false,
            contentType: false,
            processData: false
        });
    });

