                                                            @Html.EditorFor(model => model.Nationality, new { htmlAttributes = new { @class = "form-control", id = "Nationality", @placeholder = "Nationality" } })
                                                        </div>
                                                        @Html.ValidationMessageFor(model => model.Nationality, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <div class="col-sm-12">
                                                            @Html.LabelFor(model => model.TownOfBirth, new { htmlAttributes = new { @class = "control-label" } })
