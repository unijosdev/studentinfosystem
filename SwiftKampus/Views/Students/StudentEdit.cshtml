                                                            {
                                                                @Html.TextBoxFor(model => model.DateOfBirth, "{0:d}", new { @class = "form-control", type = "date", @readonly = "readonly" })
                                                            }
                                                            else
                                                            {
                                                                @Html.TextBoxFor(model => model.DateOfBirth, "{0:d}", new { @class = "form-control", type = "date"})
                                                            }
                                                        </div>
                                                        @Html.ValidationMessageFor(model => model.DateOfBirth, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <div class="col-sm-12">
                                                            @Html.LabelFor(model => model.Hobby, new { htmlAttributes = new { @class = "control-label" } })
                                                            @Html.EditorFor(model => model.Hobby, new { htmlAttributes = new { @class = "form-control", id = "Hobby" } })
                                                        </div>
                                                        @Html.ValidationMessageFor(model => model.Hobby, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>
                                            <br />
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
