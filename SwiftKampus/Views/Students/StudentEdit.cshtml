                                                        </div>
                                                        @Html.ValidationMessageFor(model => model.TownOfBirth, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>

                                            </div>
                                            <br />
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        @Html.Label("Is Physically Challenge?", htmlAttributes: new { @class = "control-label col-md-4" })
                                                        <div class="col-md-8">
                                                            <div class="checkbox">
                                                                @Html.EditorFor(model => model.IsPhysicallyChallenged, new { htmlAttributes = new { @class = "form-control", onchange = "updateTotal(this)" } })<br><br>
                                                                @Html.ValidationMessageFor(model => model.IsPhysicallyChallenged, "", new { @class = "text-danger" })
                                                            </div>
                                                        </div>
                                                    </div>
                                           
                                                </div>
