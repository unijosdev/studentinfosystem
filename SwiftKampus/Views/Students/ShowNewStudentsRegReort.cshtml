@model IEnumerable<SwiftKampus.ViewModels.RegistrationReportVm>

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>ShowNewStudentsRegReort</title>
</head>
<body>
    <p>
        @Html.ActionLink("Create New", "Create")
    </p>
    <table class="table">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.DepartmentName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UTMERegCount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DERegCount)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.TotalRegistered)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.NotRegistered)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.TotalAdmitted)
            </th>
            <th></th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.DepartmentName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.UTMERegCount)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DERegCount)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.TotalRegistered)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.NotRegistered)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.TotalAdmitted)
                </td>
                <td>
                    @Html.ActionLink("Edit", "Edit", new { id = item.Id }) |
                    @Html.ActionLink("Details", "Details", new { id = item.Id }) |
                    @Html.ActionLink("Delete", "Delete", new { id = item.Id })
                </td>
            </tr>
        }

    </table>
</body>
</html>
