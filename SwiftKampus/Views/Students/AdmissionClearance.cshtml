@model IEnumerable<SwiftKampusModel.Student>

@{
    ViewBag.Title = "Admission Cleareance";
}
<link href="~/AdminTemplate/css/plugins/sweetalert/sweetalert.css" rel="stylesheet">

<style>
    .note-text {
        margin-bottom: 30px;
        color: red;
        font-size: 14px;
    }
</style>

<h2>@ViewBag.Gender</h2>


<div class="container-fluid">
    <!-- First row -->
    <div class="row">
        <!-- First column -->
        <div class="col-md-12">

            <div class="wrapper wrapper-content animated fadeInRight">
                <div class="row">
                    <form id="formFilter" onsubmit="return false;" class="col-md-12">
                        <div class="col-lg-12">
                            <div class="ibox float-e-margins">
                                <div class="ibox-title">
                                    <h5>List of Uncleared Students</h5>
                                    <div class="ibox-tools">
                                        @if (ViewBag.Message != null)
                                        {
                                            <div class="alert alert-success">
                                                <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
                                                <strong>@ViewBag.Message</strong>
                                            </div>
                                        }

                                        <a class="collapse-link">
                                            <i class="fa fa-chevron-up"></i>
                                        </a>
                                        <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                                            <i class="fa fa-wrench"></i>
                                        </a>
                                    </div>
                                    <div class="ibox-content">
                                        <article class="margin-bottom-xxl">
                                            <p class="lead">
                                                Please use the following parameters to perform Query
                                            </p>
                                            <p class="note-text">Note: Current Undergraduate session is <strong>@ViewBag.CurrentUGSession</strong> and Postgraduate session is <strong>@ViewBag.CurrentPGSession</strong></p>
                                        </article>
                                        <div class="card-body">
                                            <div class="row form-inline">
                                                <div class="col-sm-6">
                                                    <div class="col-md-12">
                                                        <div class="form-group">
                                                            <label>School Programme</label>
                                                            @Html.DropDownList("SchoolProgrammeId", (SelectList)ViewBag.SchoolProgrammeId, null, new { @class = "form-control programmeId js-example-basic-single" })
                                                        </div>
                                                    </div>


                                                </div>
                                                <div class="col-sm-3">
                                                    <div class="form-group">
                                                        <label class="col-sm-12">Admitted Session</label>
                                                        @Html.DropDownList("SessionId", (SelectList)ViewBag.SessionId, "", new { @class = "form-control", @onchange = "getProgrammeList()" })
                                                    </div>
                                                </div>
                                                <div class="col-sm-3">
                                                    <div class="form-group">
                                                        <label class="col-sm-12"> Clearance Status</label>
                                                        <select class="form-control dropdown" id="hasRegistered" name="hasRegistered">
                                                            <option>UnCleared</option>
                                                            <option>Cleared</option>
                                                        </select>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row form-inline">
                                                <div class="col-sm-4">
                                                    <div class="col-md-12">
                                                        <br />
                                                        <label> Student Registration Number</label>
                                                        <input id="studentId" name="studentId" class="form-control" type="text" required placeholder="Type the Jamb Reg No/ Form No/ Matric No" style="width:100%;" />
                                                    </div>
                                                </div>

                                                <div class="col-md-2">
                                                    <div class="col-md-12">
                                                        <br /><br />
                                                        <button type="submit" id="btn-search" class="btn btn-primary">Search/View</button>
                                                    </div>
                                                </div>
                                            </div>


                                        </div><!--end .row -->

                                    </div>
                                </div>


                                <div class="ibox-content">
                                    <div class="table-responsive">
                                        <table id="Jdatatable" class="table table-striped table-bordered table-hover table-responsive dataTables-example">
                                            <thead>
                                                <tr>
                                                    <th>Matric No</th>
                                                    <th> Full Name</th>
                                                    <th> Gender</th>
                                                    <th> Dept Option</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

        </div>

        <!-- /.First column -->

    </div>
    <!-- /.First row -->
</div>


<!-- Modal -->
<div class="modal fade inmodal" id="actionsList" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <!--Content-->
        <div class="modal-content animated">
            <!--Header-->
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <div class="flex-center">
                    <h4 class="modal-title">STUDENT</h4>
                </div>
            </div>
            <!--Body-->
            <div class="modal-body" id="myModalDivBody">
            </div>
        </div>
        <!--/.Content-->
    </div>
</div>
<!-- /.Modal-->

<script src="~/Scripts/jquery-3.1.1.min.js"></script>
<script src="~/AdminTemplate/js/plugins/sweetalert/sweetalert.min.js"></script>
<script type="text/javascript">
    $(document).ready(function () {

        //for select2 plugin
        jQuery(function ($) {
            $('.js-example-basic-single').select2({
                placeholder: 'Select an option...',
                allowClear: true
            });
        });

        $(".programmeId").on("change", getCurrentSessionId);
    });

    $(window).scroll(function () {
        $("#mydetailBody").stop().animate({ "marginTop": ($(window).scrollTop()) + "px", "marginLeft": ($(window).scrollLeft()) + "px" }, "slow");
    });

    function ClearStudent(studentId) {

        swal({
            title: "Student Clearance",
            text: "Are you sure you want to clear this student?..",
            type: "warning",
            showCancelButton: true,
            confirmButtonColor: "#ab973a",
            confirmButtonText: "Yes, Clear Student Now!",
            cancelButtonText: "No, Reject Student!",
            closeOnConfirm: false,
            closeOnCancel: false
        },
            function (isConfirm) {
                if (isConfirm) {
                    $('.confirm').attr("disabled", "true");

                    var AllData = {
                        "id": studentId,
                    };
                    var Mydata = JSON.stringify(AllData);

                    $.ajax({
                        contentType: 'application/json',
                        type: "POST",
                        url: "/Students/FacultyClearStudent?id=" + studentId,
                        data: Mydata,
                        success: function (data) {
                            if (data.status) {
                                swal({
                                    title: "Great",
                                    text: data.message,
                                    type: "success",
                                });
                                //window.oTable.ajax.reload(); //run my_fun() ondomready
                                toastr["success"](data.message);
                            } else {
                                swal({
                                    title: "Warning",
                                    text: data.message,
                                    type: "warning",
                                });
                                toastr["error"](data.message);
                            }

                        },
                        complete: function () {
                            $('.confirm').removeAttr("disabled");
                        },
                        error: function () {
                            $('.confirm').removeAttr("disabled");
                        }
                    });
                }
                else {
                    RejectStudent(studentId);
                    swal("Good", "Operation has been cancelled successfully", "success");

                }
            });
    };

    function RejectStudent(studentId) {
        var url = "/Students/RejectStudent?studentId=" + studentId + "&level=Faculty";
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
    };

    $("#btn-search").click(function () {
        var id = $('#studentId').val();

        if (id == "") {
            alert("Student Registration Number field cannot be empty");
        }
        else {
            // Destroy the existing DataTable if it exists
            if ($.fn.DataTable.isDataTable('#Jdatatable')) {
                $('#Jdatatable').DataTable().destroy();
            }

            // Initialize the DataTable when the button is clicked
            $("#Jdatatable").DataTable({
                "processing": true, // for show progress bar while loading
                //"serverSide": true, // if it is true the preocess is done on server side
                "filter": true, // disables search box
                "info": true,

                "stateSave": true,
                "orderMulti": false, // disable multiple column loading at once
                "ajax": {
                    "url": "/Students/GetFClearance",
                    "type": "POST",
                    "datatype": "json",
                    "data": function (d) {
                        return $('#formFilter').serialize();
                    },
                    "complete": function () {
                        $('#btn-search').removeAttr("disabled");
                    },
                    "error": function () {
                        $('#btn-search').removeAttr("disabled");
                        $('#Jdatatable_processing').hide();
                    }
                },
                "columns": [
                    { "data": "MatricNo", "autoWidth": true, "orderable": true },
                    { "data": "FullName", "autoWidth": true, "orderable": true },
                    { "data": "Gender", "autoWidth": true },
                    { "data": "ProgrammeName", "autoWidth": true },
                    {
                        "data": "StudentId",
                        "autoWidth": true,
                        "render": function (data) {
                            return '<a href="#" onclick="Detail(\'' + data + '\')" data-toggle="tooltip" data-placement="top" title="View Details"><i class="fa fa-info-circle" aria-hidden="true">Details&nbsp;&nbsp;</i></a>' +
                                '<a href="#" onclick="ClearStudent(\'' + data + '\')" data-toggle="tooltip" data-placement="top" title="Clear Student Now"><i class="fa fa-pencil" aria-hidden="true"></i>Process Clearance</a>';
                        }
                    }
                ],
                dom: '<"html5buttons"B>lTfgitp',
                buttons: [
                    { extend: 'copy' },
                    { extend: 'csv' },
                    { extend: 'excel', title: 'FacultyList' },
                    { extend: 'pdf', title: 'FacultyList' },

                    {
                        extend: 'print',
                        customize: function (win) {
                            $(win.document.body).addClass('white-bg');
                            $(win.document.body).css('font-size', '10px');

                            $(win.document.body).find('table')
                                .addClass('compact')
                                .css('font-size', 'inherit');
                        }
                    }
                ]
            });
            // Disable the button after initializing the DataTable
            $('#btn-search').attr("disabled", "true");
        }
    });

    function Detail(studentId) {
        var url = "/Students/StudentFullDetail?id=" + studentId;
        window.open(url, '_blank');
    };

    function getCurrentSessionId() {
        var programmeId = $('.programmeId').val();
        $.ajax({
            url: '/Students/GetCurrentSessionId?programmeId=' + programmeId,
            type: 'GET',
            datatype: 'application/json',
            contentType: 'application/json',
            success: function (data) {
                $('#SessionId').val(data.Data);
            }
        });
    };

</script>