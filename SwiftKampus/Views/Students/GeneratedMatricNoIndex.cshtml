@model IEnumerable<SwiftKampusModel.Student>

@{
    ViewBag.Title = "Email Student List";
}

<h2>@ViewBag.Gender</h2>
<div class="container-fluid">
    <!-- First row -->
    <div class="row">
        <!-- First column -->
        <div class="col-md-12">
            <div class="wrapper wrapper-content animated fadeInRight">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="ibox float-e-margins">
                            <div class="ibox-title">
                                <h5>List of Students</h5>
                                <div class="ibox-tools">
                                    @if (ViewBag.Message != null)
                                    {
                                        <div class="alert alert-success">
                                            <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
                                            <strong>@ViewBag.Message</strong>
                                        </div>
                                    }

                                    <a class="collapse-link">
                                        <i class="fa fa-chevron-up"></i>
                                    </a>
                                    <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                                        <i class="fa fa-wrench"></i>
                                    </a>
                                </div>
                                <div class="ibox-content">
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-sm-4">
                                                <div class="form-group">
                                                    <label>School Programme</label>
                                                    @Html.DropDownList("SchoolProgrammeId", (SelectList)ViewBag.SchoolProgrammeId, "", new { @class = "form-control js-example-basic-single" })
                                                </div>
                                            </div>

                                            <div class="col-md-4">
                                                <div class="form-group">
                                                    <label>Faculty</label>
                                                    @Html.DropDownList("FacultyId", (SelectList)ViewBag.FacultyId, "", new { @class = "form-control js-example-basic-single", @onchange = "getDeptList()" })
                                                </div>
                                            </div>
                                            <div class="col-sm-4">
                                                <div class="form-group">
                                                    <label> Download Status</label>
                                                    <select class="form-control dropdown js-example-basic-single" id="isDownloded" name="hasRegistered">
                                                        <option>Select an option...</option>
                                                        <option value="true">True</option>
                                                        <option value="null">False</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                        <br />
                                        <div class="row ">
                                            <div class="col-sm-4">
                                                <div class="form-group">
                                                    <label>Department</label>
                                                    @Html.DropDownList("DepartmentId", (SelectList)ViewBag.DepartmentId, "", new { @class = "form-control js-example-basic-single", @onchange = "getProgrammeList()" })
                                                </div>
                                            </div>
                                            <div class="col-sm-5">
                                                <div class="form-group">
                                                    <label>Dept Option</label>
                                                    @Html.DropDownList("ProgrammeId", (SelectList)ViewBag.ProgrammeId, "", new { @class = "form-control js-example-basic-single", @onchange = "getCourseList()" })
                                                </div>
                                            </div>

                                        </div>
                                        <div class="row">
                                            <div class="col-sm-4">
                                                <div class="form-group">
                                                    <label>Admitted Session</label>
                                                    @Html.DropDownList("SessionId", (SelectList)ViewBag.SessionId, "", new { @class = "form-control js-example-basic-single", @onchange = "getProgrammeList()" })
                                                </div>
                                            </div>
                                            <div class="col-sm-4">
                                                <div class="form-group">
                                                    <label>Level Name</label>
                                                    @Html.DropDownList("LevelId", (SelectList)ViewBag.LevelId, "", new { @class = "form-control js-example-basic-single", @onchange = "getProgrammeList()" })
                                                </div>
                                            </div>
                                            <div class="col-m-1">
                                                <br />
                                                <button type="submit" id="btn-search" class="btn btn-primary">Search/View</button>
                                                <button type="submit" id="btn-download" class="btn btn-primary">Download</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div><!--end .row -->
                        </div>
                    </div>


                    <div class="ibox-content">
                        <div class="table-responsive">
                            <table id="Jdatatable" class="table table-striped table-bordered table-hover table-responsive dataTables-example">
                                <thead>
                                    <tr>
                                        <th>Matric No</th>
                                        <th>Email No</th>
                                        <th> Full Name</th>
                                        <th> Phone Number</th>
                                        <th> Gender</th>
                                        <th> Level Name</th>
                                        <th> Dept Option</th>
                                    </tr>
                                </thead>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- /.First column -->

    </div>

</div>

@*<link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.9/css/select2.min.css" rel="stylesheet" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.9/js/select2.min.js"></script>*@

<script src="~/Scripts/jquery-3.1.1.min.js"></script>
<script type="text/javascript">

    $(document).ready(function () {

        jQuery(function ($) {
            $('.js-example-basic-single').select2({
                placeholder: 'Select an option...',
                allowClear: true
            });
        });

        window.oTable = $("#Jdatatable").DataTable({
            "processing": true, // for show progress bar while loading
            "serverSide": true, // if it is true the preocess is done on server side
            "filter": true, // disables search box
            "info": true,

            "stateSave": true,
            "orderMulti": false, // disable multiple column loading at once
            "ajax": {
                "url": "/Students/GetMatIndex",
                "type": "POST",
                "datatype": "json",
                "data": function (d) {
                    d.SchoolProgrammeId = $('#SchoolProgrammeId').val();
                    d.isDownloded = $('#isDownloded').val();
                    d.FacultyId = $('#FacultyId').val();
                    d.DepartmentId = $('#DepartmentId').val();
                    d.ProgrammeId = $('#ProgrammeId').val();
                    d.SessionId = $('#SessionId').val();
                    d.LevelId = $('#LevelId').val();
                }
            },
            "columns": [
                { "data": "MatricNo", "autoWidth": true, "orderable": true },
                { "data": "Email", "autoWidth": true, "orderable": true },
                { "data": "FullName", "autoWidth": true, "orderable": true },
                { "data": "PhoneNumber", "autoWidth": true, "orderable": true },
                { "data": "Gender", "autoWidth": true },
                { "data": "LevelName", "autoWidth": true },
                { "data": "ProgrammeName", "autoWidth": true },

                //{
                //    "data": "StudentId",
                //    "autoWidth": true,
                //    "render": function(data) {
                //        return '<a href="#" onclick="Detail(\'' + data + '\')" data-toggle="tooltip" data-placement="top" title="View Details"><i class="fa fa-info-circle" aria-hidden="true">Details&nbsp;&nbsp;</i></a>' +
                //            '<a href="#" onclick="Edit(\'' + data + '\')" data-toggle="tooltip" data-placement="top" title="Edit Student"><i class="fa fa-pencil" aria-hidden="true"></i>Edit</a>&nbsp;&nbsp;' +
                //            '<a href="#" onclick="ChangeLevel(\'' + data + '\')" data-toggle="tooltip" data-placement="top" title="Update Student"><i class="fa fa-info" aria-hidden="true"></i>Update</a>&nbsp;&nbsp;'; +
                //            '<a href="#" onclick="MakeSchoorlaship(\'' + data + '\')" data-toggle="tooltip" data-placement="top" title="Update Student"><i class="fa fa-info" aria-hidden="true"></i>Schoolarship</a>&nbsp;&nbsp;';
                //            //'<a href="#" onclick="Delete(\'' + data + '\')" data-toggle="tooltip" data-placement="top" title="Delete Student Record">&nbsp;&nbsp;<i class="fa fa-remove" aria-hidden="true" >Delete</i></a>';
                //    }
                //}
            ],
            dom: '<"html5buttons"B>lTfgitp',
            lengthMenu: [
                [10, 25, 50, 100, 200, 500, 1000, 2000, 4000, 5000],
                [10, 25, 50, 100, 200, 500, 1000, 2000, 4000, 5000]
            ],
            buttons: [
                { extend: 'copy' },
                { extend: 'csv' },
                { extend: 'excel', title: 'Student List' },
                { extend: 'pdf', title: 'Student List' },

                {
                    extend: 'print',
                    customize: function (win) {
                        $(win.document.body).addClass('white-bg');
                        $(win.document.body).css('font-size', '10px');

                        $(win.document.body).find('table')
                            .addClass('compact')
                            .css('font-size', 'inherit');
                    }
                }
            ]
        });
        window.oTable.fnSort([[1, "asc"], [2, "desc"]]);

    });

    function getDeptList() {
        var facultyid = $("#FacultyId").val();
        $.ajax
            ({
                url: '/students/getdeptlist?codeid=' + facultyid,
                type: 'get',
                datatype: 'application/json',
                contenttype: 'application/json',
                success: function (result) {
                    $("#DepartmentId").html("");
                    $.each(JSON.parse(result),
                        function (i, city) {
                            $("#DepartmentId").append($('<option></option>').val(city.DepartmentId).html(city.DeptName));
                        });

                },
                error: function () {
                    $("#DepartmentId").html("");
                    $("#Programmeid").html("");
                }
            });
    }

    function getProgrammeList() {
        var deptid = $("#DepartmentId").val();
        $.ajax
            ({
                url: '/students/getprogrammelist?codeid=' + deptid,
                type: 'get',
                datatype: 'application/json',
                contenttype: 'application/json',
                success: function (result) {
                    $("#ProgrammeId").html("");
                    $.each(JSON.parse(result),
                        function (i, city) {
                            $("#ProgrammeId").append($('<option></option>').val(city.ProgrammeId).html(city.ProgrammeName));
                        });
                },
                error: function () {
                    $("#ProgrammeId").html("");
                }
            });

        //$("#btn-search").click(function () {
        //    var url = "/ConvocationList/getConvocationList?programmeid=" + $('#ProgrammeId').val();
        //    jQuery.noConflict();
        //    $('#Jdatatable').load(url);
        //});
    }

    $("#btn-search").click(function () {
        window.oTable.ajax.reload();

    });

    //$("#btn-search").click(function () {
    //    window.oTable.ajax.reload();
    //});

    $("#btn-download").click(function () {
        var url = "/Students/DownloadMatGenReport?SchoolProgrammeId=" + $('#SchoolProgrammeId').val() + "&FacultyId=" + $('#FacultyId').val() +
            "&DepartmentId=" + $('#DepartmentId').val() + "&ProgrammeId=" + $('#ProgrammeId').val() + "&SessionId=" + $('#SessionId').val() +
            "&LevelId=" + $('#LevelId').val();
        window.open(url, '_blank');
    });


</script>