@model IEnumerable<SwiftKampus.ViewModels.StudentBioData.DuplicateStudentVm>

@{
    ViewBag.Title = "DuplicateIndex";
}

<h2>Duplicate Index</h2>
<h2>@ViewBag.Message</h2>
<table id="Jdatatable" class="table table-striped table-bordered table-hover table-responsive dataTables-example">
    <thead>
        <tr>
            <th>Full Name</th>
            <th>Matric Number</th>
            <th>Count</th>
        </tr>
    </thead>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.FullName</td>
            <td>@item.MatricNo</td>
            <td>@item.Count</td>
        </tr>
    }
</table>
