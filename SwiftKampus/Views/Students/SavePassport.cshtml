@model SwiftKampusModel.Student
@using SwiftKampus.Models

@{
    Layout = null;
    ViewBag.Title = "Update Student";
}
<br />
<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">
        <div class="col-lg-12">

            <form id="passportForm" class="form-horizontal" method="post" enctype="multipart/form-data" onsubmit="return false;">

                @Html.HiddenFor(model => model.StudentId)
                @Html.HiddenFor(model => model.MatricNo)
                @Html.HiddenFor(model => model.JambRegNo)
                @*@Html.HiddenFor(model => model.Passport)*@
                @Html.HiddenFor(model => model.LevelId)
                @Html.HiddenFor(model => model.EnrollmentDate)
                @*@Html.AntiForgeryToken()*@
                <div class="container-fluid">
                    <!-- Section: Edit Account -->
                    <section class="section">
                        <!-- First row -->
                        <div class="row">
                            <div class="col-lg-12">
                                <!--Card-->
                                <div class="card">
                                    <div class="card-head style-primary">
                                        <header>
                                            <h3>Student Passport/Signature</h3>
                                        </header>

                                    </div><!--end .card-head -->
                                    <div class="card-body">
                                        <div class="card-block">
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="ibox float-e-margins text-center">
                                                        <img id="output" alt="Passport" src="@Url.Action("RenderImage", new { studentId = Model.StudentId})" class="rounded-circle contact-avatar my-2 mx-auto" height="150" />

                                                        <p class="text-muted">
                                                            <small>Passport will be changed automatically</small>
                                                        </p>

                                                        @*Disable changing of passport for new undergraduate students*@
                                                        @*@if (ViewBag.studentStatus == "New_Student" && ViewBag.applicantType == "UnderGraduate")
                                                            {
                                                                <input id="File" type="file" name="File" onchange="loadFile(event)" style="display: none">
                                                                <label for="File" class="btn btn-primary" style="display: none">Click to Upload Passport</label>
                                                            }*@

                                                        @if (ViewBag.applicantType != "UnderGraduate" && ViewBag.applicantType != "Remedial_Science")
                                                        {
                                                            <input id="File" type="file" name="File" onchange="loadFile(event)" style="display: none">
                                                            <label for="File" class="btn btn-primary">Click to Upload Passport</label>
                                                        }
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="ibox float-e-margins text-center">
                                                        <img id="output2" alt="Signature" src="@Url.Action("RenderSignature", new { studentId = Model.StudentId})" class="rounded-circle contact-avatar my-2 mx-auto" height="150" />

                                                        <p class="text-muted">
                                                            <small>Signature will be changed automatically</small>
                                                        </p>

                                                        @if (Model.StudentStatus == "New_Student")
                                                        {
                                                            <input id="FileSignature" type="file" name="FileSignature" onchange="loadFileTwo(event)" style="display: none">
                                                            <label for="FileSignature" class="btn btn-primary">Click to Upload Signature</label>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <input type="submit" value="Save Passport And Signature" class="btn btn-primary btn-sm text-right">
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <a id="btneditPassportNext" href="#" class="btn btn-warning btn-sm btnNext text-left">NEXT</a>
                                                    </div>
                                                </div>

                                            </div>
                                            <!-- Edit Form -->
                                        </div>
                                        <!--/.Card content-->
                                    </div>
                                </div>
                                <!--/.Card-->
                            </div>

                        </div>
                        <!-- /.First row -->
                    </section>
                    <!-- /.Section: Edit Account -->
                </div>
            </form>
            <!--/Main layout-->

        </div>
    </div>
</div>





<script src="~/Scripts/jquery-3.1.1.min.js"></script>
<script>
    var loadFile = function (event) {
        var fileUpload = document.getElementById("File");
        if (typeof (fileUpload.files) !== "undefined") {
            var size = parseFloat(fileUpload.files[0].size / 1024).toFixed(2);
            if (size > 25) {
                toastr["error"]("The image is bigger than the specified size of (25kb)");
                var output = document.getElementById('output');
                output.src = "#";
            } else {
                var output2 = document.getElementById('output');
                output2.src = URL.createObjectURL(event.target.files[0]);
            }
        } else {
            alert("This browser does not support HTML5.");
        }

    };
    var loadFileTwo = function (event) {
        var fileUpload = document.getElementById("FileSignature");
        if (typeof (fileUpload.files) !== "undefined") {
            var size = parseFloat(fileUpload.files[0].size / 1024).toFixed(2);
            if (size > 20) {
                toastr["error"]("The image is bigger than the specified size of (25kb)");
                var output = document.getElementById('output2');
                output.src = "#";
            } else {
                var output2 = document.getElementById('output2');
                output2.src = URL.createObjectURL(event.target.files[0]);
            }
        } else {
            alert("This browser does not support HTML5.");
        }

    };



    $("#passportForm").submit(function (e) {
        e.preventDefault();
        var formData = new FormData(this);

        $.ajax({
            url: "/Students/SavePassport",
            type: 'POST',
            data: formData,
            success: function (data) {
                if (data.status) {
                    swal({
                        title: "Bio-Data Passport and Signature has been saved successfully",
                        //text: "Do you  Proceed?..",
                        type: "warning",
                        showCancelButton: true,
                        confirmButtonColor: "#ab973a",
                        confirmButtonText: "Proceed!",
                        //cancelButtonText: "No, See Result List!",
                        closeOnConfirm: false,
                        closeOnCancel: false
                    },
                        function (isConfirm) {
                            if (isConfirm) {
                                swal("Great!", "Proceed!!!.", "success");
                                goNextStudentPassport();
                            } else {
                                swal("Great", "You can click the next button to proceed", "success");
                            }
                        });
                    toastr["success"](data.message);
                } else {
                    swal({
                        title: "Warning",
                        text: data.message,
                        type: "warning",
                    });
                    toastr["warning"](data.message);
                }


            },
            cache: false,
            contentType: false,
            processData: false
        });
    });
    function goNextStudentPassport() {
        $("#olevel").click();
    }

    $("#btneditPassportNext").click(function () {
        $("#olevel").click();
    });
</script>
