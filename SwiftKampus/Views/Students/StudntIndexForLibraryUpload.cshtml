
@{
    ViewBag.Title = "Result List";
}

<h2>@ViewBag.Gender</h2>
<div class="container-fluid">
    <!-- First row -->
    <div class="row">
        <!-- First column -->
        <div class="col-md-12">
            <div class="wrapper wrapper-content animated fadeInRight">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="ibox float-e-margins">
                            <div class="ibox-title">
                                <h5>List of Students</h5>
                                <div class="ibox-tools">
                                    @if (ViewBag.Message != null)
                                    {
                                        <div class="alert alert-success">
                                            <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
                                            <strong>@ViewBag.Message</strong>
                                        </div>
                                    }

                                    <a class="collapse-link">
                                        <i class="fa fa-chevron-up"></i>
                                    </a>
                                    <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                                        <i class="fa fa-wrench"></i>
                                    </a>
                                </div>
                                <div class="ibox-content">
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-sm-4">
                                                <div class="form-group">
                                                    <label>School Programme</label>
                                                    @Html.DropDownList("SchoolProgrammeId", (SelectList)ViewBag.SchoolProgrammeId, "", new { @class = "form-control" })
                                                </div>
                                            </div>

                                            <div class="col-md-4">
                                                <div class="form-group">
                                                    <label>Faculty</label>
                                                    @Html.DropDownList("FacultyId", (SelectList)ViewBag.FacultyId, "", new { @class = "form-control", @onchange = "getDeptList()" })
                                                </div>
                                            </div>

                                        </div>
                                        <br />
                                        <div class="row ">
                                            <div class="col-sm-4">
                                                <div class="form-group">
                                                    <label>Department</label>
                                                    @Html.DropDownList("DepartmentId", (SelectList)ViewBag.DepartmentId, "", new { @class = "form-control", @onchange = "getProgrammeList()" })
                                                </div>
                                            </div>
                                            <div class="col-sm-5">
                                                <div class="form-group">
                                                    <label>Dept Option</label>
                                                    @Html.DropDownList("ProgrammeId", (SelectList)ViewBag.ProgrammeId, "", new { @class = "form-control", @onchange = "getCourseList()" })
                                                </div>
                                            </div>

                                        </div>
                                        <div class="row">
                                            <div class="col-sm-4">
                                                <div class="form-group">
                                                    <label>Admitted Session</label>
                                                    @Html.DropDownList("SessionId", (SelectList)ViewBag.SessionId, "", new { @class = "form-control", @onchange = "getProgrammeList()" })
                                                </div>
                                            </div>
                                            <div class="col-sm-4">
                                                <div class="form-group">
                                                    <label>Level Name</label>
                                                    @Html.DropDownList("LevelId", (SelectList)ViewBag.LevelId, "", new { @class = "form-control", @onchange = "getProgrammeList()" })
                                                </div>
                                            </div>
                                            <div class="col-m-1">
                                                <br />
                                                <button type="submit" id="btn-search" class="btn btn-primary">Search/View</button>
                                                <button type="submit" id="btn-download" class="btn btn-primary">Download</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div><!--end .row -->
                        </div>
                    </div>


                    <div class="ibox-content">
                        <div class="table-responsive">
                            <table id="Jdatatable" class="table table-striped table-bordered table-hover table-responsive dataTables-example">
                                <thead>
                                    <tr>
                                        <th> cardnumber</th>
                                        <th> surname</th>
                                        <th> firstname</th>
                                        <th> title</th>
                                        <th> othernames</th>
                                        <th> initials</th>
                                        <th> streetnumber</th>
                                        @*<th> streettype</th>*@
                                        <th> address</th>
                                        @*<th> address2</th>*@
                                        <th> city</th>
                                        <th> state</th>
                                        @*<th> zipcode</th>*@
                                        <th> country</th>
                                        <th> email</th>
                                        <th> phone</th>
                                        @*<th> mobile</th>
            <th> fax</th>
            <th> emailpro</th>
            <th> phonepro</th>
            <th> B_streetnumber</th>
            <th> B_streettype</th>*@
                                        <th> B_address</th>
                                        <th> B_address2</th>
                                        <th> B_city</th>
                                        <th> B_state</th>
                                        <th> B_zipcode</th>
                                        <th> B_country</th>
                                        <th> B_email</th>
                                        <th> B_phone</th>
                                        <th> dateofbirth</th>
                                        <th> branchcode</th>
                                        <th> categorycode</th>
                                        <th> dateenrolled</th>
                                        @*<th> dateexpiry</th>
            <th> date_renewed</th>
            <th> gonenoaddress</th>
            <th> lost</th>
            <th> debarred</th>
            <th> debarredcomment</th>
            <th> contactname</th>
            <th> contactfirstname</th>
            <th> contacttitle</th>
            <th> guarantorid</th>
            <th> borrowernotes</th>
            <th> relationship</th>*@
