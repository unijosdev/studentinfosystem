                                        <th> password</th>
                                        @*<th> flags</th>*@
                                        <th> userid</th>
                                        @*<th> opacnote</th>
            <th> contactnote</th>
            <th> sort1</th>
            <th> sort2</th>*@
                                        <th> altcontactfirstname</th>
                                        <th> altcontactsurname</th>
                                        <th> altcontactaddress1</th>
                                        @*<th> altcontactaddress2</th>
            <th> altcontactaddress3</th>
            <th> altcontactstate</th>
            <th> altcontactzipcode</th>*@
