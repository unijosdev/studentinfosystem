
@{
    ViewBag.Title = "Student List Blood Group ";
}

<h2>@ViewBag.Gender</h2>
<div class="container-fluid">
    <!-- First row -->
    <div class="row">
        <!-- First column -->
        <div class="col-md-12">
            <div class="wrapper wrapper-content animated fadeInRight">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="ibox float-e-margins">
                            <div class="ibox-title">
                                <h5>List of Student for Blood Group Upload</h5>
                                <div class="ibox-tools">
                                    <a onclick="myFunction()" class="btn btn-primary"><i class="fa fa-file-excel-o"></i> EXCEL UPLOAD</a>
                                    @if (ViewBag.Message != null)
                                    {
                                        <div class="alert alert-success">
                                            <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
                                            <strong>@ViewBag.Message</strong>
                                        </div>
                                    }

                                    <a class="collapse-link">
                                        <i class="fa fa-chevron-up"></i>
                                    </a>
                                    <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                                        <i class="fa fa-wrench"></i>
                                    </a>
                                </div>
                                <div class="ibox-content">
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-sm-4">
                                                <div class="form-group">
                                                    <label>School </label>
                                                    @Html.DropDownList("SchoolProgrammeId", (SelectList)ViewBag.SchoolProgrammeId, "", new { @class = "form-control" })
                                                </div>
                                            </div>
                                            <div class="col-sm-2">
                                                <div class="form-group">
                                                    <label> Active Student</label>
                                                    <select class="form-control dropdown" id="hasRegistered" name="hasRegistered">
                                                        <option>True</option>

                                                    </select>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="form-group">
                                                    <label>Faculty</label>
                                                    @Html.DropDownList("FacultyId", (SelectList)ViewBag.FacultyId, "", new { @class = "form-control", @onchange = "getDeptList()" })
                                                </div>
                                            </div>

                                        </div>
                                        <br />
                                        <div class="row ">
                                            <div class="col-md-4">
                                                <div class="form-group">
                                                    <label>Department</label>
                                                    @Html.DropDownList("DepartmentId", (SelectList)ViewBag.DepartmentId, "", new { @class = "form-control", @onchange = "getProgrammeList()" })
                                                </div>
                                            </div>
                                            <div class="col-md-5">
                                                <div class="form-group">
                                                    <label>Programme</label>
                                                    @Html.DropDownList("ProgrammeId", (SelectList)ViewBag.ProgrammeId, "", new { @class = "form-control", @onchange = "getCourseList()" })
                                                </div>
                                            </div>

                                            <div class="col-md-1">
                                                <br />
                                                <button type="submit" id="btn-search" class="btn btn-primary">Search/View</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div><!--end .row -->
                        </div>
                    </div>


                    <div class="ibox-content">
                        <div class="table-responsive">
                            <table id="Jdatatable" class="table table-striped table-bordered table-hover table-responsive dataTables-example">
                                <thead>
                                    <tr>
                                        <th>Matric No</th>
                                        <th> Full Name</th>
                                        <th> Gender</th>
                                        <th> Level Name</th>
                                        <th> Dept Option</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- /.First column -->
        <!-- Second column -->
        @*<div class="col-md-3">
                <div class="ibox-content">
                    <div class="card contact-card with-padding">
                        <div class="card-body" id="mydetailBody">
                        </div>
                    </div>
                </div>
            </div>*@
    </div>

</div>


<!-- Modal -->
<div class="modal fade inmodal" id="actionsList" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <!--Content-->
        <div class="modal-content animated">
            <!--Header-->
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <div class="flex-center">
                    <h4 class="modal-title">STUDENT BLOOD GROUP UPLOAD</h4>
                </div>
            </div>
            <!--Body-->
            <div class="modal-body" id="myModalDivBody">
            </div>
        </div>
        <!--/.Content-->
    </div>
</div>
<!-- /.Modal-->

<script src="~/Scripts/jquery-3.1.1.min.js"></script>

<script type="text/javascript">
    $(document).ready(function () {
        window.oTable = $("#Jdatatable").DataTable({
            "processing": true, // for show progress bar while loading
            "serverSide": true, // if it is true the preocess is done on server side
            "filter": true, // disables search box
            "info": true,

            "stateSave": true,
            "orderMulti": false, // disable multiple column loading at once
            "ajax": {
                "url": "/Students/GetAllStudentsForBloodGroupUpload",
                "type": "POST",
                "datatype": "json",
                "data": function (d) {
                    d.SchoolProgrammeId = $('#SchoolProgrammeId').val();
                    d.hasRegistered = $('#hasRegistered').val();
                    d.FacultyId = $('#FacultyId').val();
                    d.DepartmentId = $('#DepartmentId').val();
                    d.ProgrammeId = $('#ProgrammeId').val();
                    d.ClearanceStage = $('#clearanceStage').val();
                }
            },
            "columns": [
                { "data": "MatricNo", "autoWidth": true, "orderable": true },
                { "data": "FullName", "autoWidth": true, "orderable": true },
                { "data": "Gender", "autoWidth": true },
                { "data": "LevelName", "autoWidth": true },
                { "data": "ProgrammeName", "autoWidth": true },
                {
                    "data": "StudentId",
                    "autoWidth": true,
                    "render": function (data) {
                        return'<a href="#" onclick="RejectStudent(\'' + data + '\')" data-toggle="tooltip" data-placement="top" title="Enter Blood Group"><i class="fa fa-pencil" aria-hidden="true"></i> Enter Blood Group</a>';
                    }
                }
            ],
            dom: '<"html5buttons"B>lTfgitp',
            buttons: [
                { extend: 'copy' },
                { extend: 'csv' },
                { extend: 'excel', title: 'Student List' },
                { extend: 'pdf', title: 'Student List' },

                {
                    extend: 'print',
                    customize: function (win) {
                        $(win.document.body).addClass('white-bg');
                        $(win.document.body).css('font-size', '10px');

                        $(win.document.body).find('table')
                            .addClass('compact')
                            .css('font-size', 'inherit');
                    }
                }
            ]
        });
        window.oTable.fnSort([[1, "asc"], [2, "desc"]]);

    });


    function RejectStudent(studentId) {
        var url = "/Students/UploadBloodGroupView?studentId=" + studentId + "&level=Department";
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
    };


    $(window).scroll(function () {
        $("#mydetailBody").stop().animate({ "marginTop": ($(window).scrollTop()) + "px", "marginLeft": ($(window).scrollLeft()) + "px" }, "slow");
    });
    $("#btn-search").click(function () {
        window.oTable.ajax.reload();
    });

    function Detail(studentId) {
        var url = "/Students/PartialDetails?id=" + studentId;
        jQuery.noConflict();
        $('#mydetailBody').load(url);

    };


    function getDeptList() {
        var facultyId = $("#FacultyId").val();
        //alert(stateId);
        $.ajax
            ({
                url: '/Students/GetDeptList?codeId=' + facultyId,
                type: 'GET',
                datatype: 'application/json',
                contentType: 'application/json',
                success: function (result) {
                    $("#DepartmentId").html("");
                    $.each($.parseJSON(result),
                        function (i, city) {
                            //alert(result);
                            $("#DepartmentId").append($('<option></option>').val(city.DepartmentId).html(city.DeptName));
                        });

                },
                error: function () {
                    $("#DepartmentId").html("");
                    $("#ProgrammeId").html("");
                }
            });
    }
    function getProgrammeList() {
        var deptId = $("#DepartmentId").val();
        //alert(stateId);
        $.ajax
            ({
                url: '/Students/GetProgrammeList?codeId=' + deptId,
                type: 'GET',
                datatype: 'application/json',
                contentType: 'application/json',
                //data: JSON.stringify({
                //    codeId: +stateId
                //}),
                success: function (result) {
                    $("#ProgrammeId").html("");
                    $.each($.parseJSON(result),
                        function (i, city) {
                            //alert(result);
                            $("#ProgrammeId").append($('<option></option>').val(city.ProgrammeId).html(city.ProgrammeName));
                        });

                },
                error: function () {
                    $("#ProgrammeId").html("");
                }
            });
        }

    function myFunction() {
        var url = "/Students/BloodGroupExcelUpload";
        $('#myModalDivBody').load(url,
            function () {
                jQuery.noConflict();
                $('#actionsList').modal("show");
            });
    };
</script>
