@using SwiftKampusModel
@model SwiftKampusModel.Classroom.TopicMaterial

@{
    ViewBag.Title = "Details";
}

<h2>Details</h2>

<div>
    <h4>TopicMaterial</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>
            @Html.DisplayNameFor(model => model.Topic.TopicName)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Topic.TopicName)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.FileType)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.FileType)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.Name)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Name)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.NoteBody)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.NoteBody)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.Author)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Author)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.Description)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Description)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.FileLocation)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.FileLocation)
        </dd>

    </dl>
</div>

<div>
    @if (Model.FileType == FileType.MP4)
    {
        <div style="text-align:center">
            <button onclick="playPause()">Play/Pause</button>
            <button onclick="makeBig()">Big</button>
            <button onclick="makeSmall()">Small</button>
            <button onclick="makeNormal()">Normal</button>
            <br><br>
            @*<video controls="controls">
                    <source src="~/TopicMaterials/How%20to%20Use%20our%20Learning%20Management%20System.mp4" type="video/mp4" />
                </video>*@
            <video controls="controls" id="video1" width="420">
                <source src="~/MaterialUpload/@Model.FileLocation" type="video/mp4">
                Your browser does not support HTML5 video.
            </video>
        </div>
    }
    @if (Model.FileType == FileType.MP3)
    {
        <div style="text-align:center">
            <button onclick="playPause()">Play/Pause</button>
            <button onclick="makeBig()">Big</button>
            <button onclick="makeSmall()">Small</button>
            <button onclick="makeNormal()">Normal</button>
            <br><br>
                <audio id="video1" controls="controls">
                    <source src="~/MaterialUpload/05%20Above%20All.mp3" type="audio/mpeg" />
                </audio>
            @*<video controls="controls" id="video1" width="420">
                <source src="~/MaterialUpload/@Model.FileLocation" type="video/mp4">
                Your browser does not support HTML5 video.
            </video>*@
        </div>
    }
    else if (Model.FileType == FileType.PDF)
    {
        @*<iframe src="~/TopicMaterials/@Model.FileLocation" style="width: 100%;height: 100%;border: none;"></iframe>*@
        <object data="~/TopicMaterials/@Model.FileLocation" type="application/pdf">
            @*<embed src="~/TopicMaterials/@Model.FileLocation" width="500" height="375" type='application/pdf'></embed>*@
            <iframe src="~/TopicMaterials/@Model.FileLocation" style="width: 100%;height: 100%;border: none;"></iframe>


        </object>

    }
</div>

<script>

    var myVideo = document.getElementById("video1");

    function playPause() {
        if (myVideo.paused)
            myVideo.play();
        else
            myVideo.pause();
    }

    function makeBig() {
        myVideo.width = 860;
    }

    function makeSmall() {
        myVideo.width = 320;
    }

    function makeNormal() {
        myVideo.width = 420;
    }
</script>
