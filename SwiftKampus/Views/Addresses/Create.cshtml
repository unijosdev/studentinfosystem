@model SwiftKampusModel.Address

@{
    ViewBag.Title = "Add Address";
}
<div class="row wrapper border-bottom white-bg page-heading">
    <div class="col-lg-12">
        <h2>
            <i class="fa fa-plus"></i> Add Address(Parent or Guardian)
            <span><a class="btn btn-primary" href="@Url.Action("Index","Addresses")">List of Address</a></span>
        </h2>

    </div>
    <div class="col-lg-2">

    </div>
</div>
<div class="card">

    <div class="card-body">

        <br />
        <br />

        @using (Html.BeginForm())
        {

            <div class="card-body">

                @Html.AntiForgeryToken()

                <div class="form-horizontal">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <div class="form-group">
                        @Html.LabelFor(model => model.AddressType, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-6">
                            @Html.DropDownList("AddressType", null, htmlAttributes: new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.AddressType, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.State, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-6">
                            @Html.DropDownList("State", null, htmlAttributes: new { @class = "form-control", @onchange = "getLgaList()" })
                            @Html.ValidationMessageFor(model => model.State, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.Label("Local Government", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-6">
                            @Html.DropDownList("Lga", null, htmlAttributes: new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.State, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.Town, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-6">
                            @Html.EditorFor(model => model.Town, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.Town, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.Street, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-6">
                            @Html.EditorFor(model => model.Street, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.Street, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.HouseNo, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-6">
                            @Html.EditorFor(model => model.HouseNo, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.HouseNo, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="col-md-offset-2 col-md-6">
                            <input type="submit" value="Add Address" class="btn btn-primary ink-reaction" />
                        </div>
                    </div>
                </div>
            </div><!--end .card-body -->
          
        } 


    </div>
</div>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
<script src="~/Scripts/jquery-3.1.1.min.js"></script>
<script>
    function getLgaList() {
        var stateId = $("#State").val();
        //alert(stateId);
        $.ajax
            ({
                url: '/Students/GetLgaList?codeId=' + stateId,
                type: 'GET',
                datatype: 'application/json',
                contentType: 'application/json',
                //data: JSON.stringify({
                //    codeId: +stateId
                //}),
                success: function (result) {
                    $("#Lga").html("");
                    $.each($.parseJSON(result),
                        function (i, city) {
                            $("#Lga").append($('<option></option>').val(city).html(city));
                        });

                },
                error: function () {
                    alert("Whooaaa! Something went wrong..");
                }
            });
    }
</script>