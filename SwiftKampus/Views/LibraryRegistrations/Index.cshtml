@model IEnumerable<SwiftKampusModel.Library.LibraryRegistration>

@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.MembershipType.TypeOfMembership)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.MembershipType.TypeOfMembership)
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id=item.LibraryRegistrationId }) |
            @Html.ActionLink("Details", "Details", new { id=item.LibraryRegistrationId }) |
            @Html.ActionLink("Delete", "Delete", new { id=item.LibraryRegistrationId })
        </td>
    </tr>
}

</table>
