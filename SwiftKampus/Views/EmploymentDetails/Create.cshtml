@model SwiftKampusModel.AddmissionApplicant.EmploymentDetail

@{
    ViewBag.Title = "Add Employment Details";

}
<link href="~/AdminTemplate/css/plugins/sweetalert/sweetalert.css" rel="stylesheet">

<form id="myform" onsubmit="return false;">

    <div class="row wrapper border-bottom white-bg page-heading">
        <div class="col-md-9">
            <h2>Add Employment Details</h2>

        </div>
        <div class="col-md-3">
            <a href="@Url.Action("Create","EmploymentDetails")" class="btn btn-primary"> LIST OF EMPLOYMENT DETAIL</a>

        </div>
    </div>

    <div class="wrapper wrapper-content animated fadeInRight">
        <div class="row">
            <div class="col-md-2">
                <div class="com-md-12">
                    <h4 class="text-center">Instruction</h4>
                    @*<ol class="bold">
                            <li>You are only allowed to Add 5 results from <i class="bold italic">Maximum of two sittings</i> </li>
                            <li>Select Exam Type</li>
                            <li>Select Subject(s)</li>
                            <li>Add Grade based on the order of subject selected</li>
                        </ol>*@
                </div>
            </div>
            <div class="col-md-10">
                <div class="ibox float-e-margins">
                    <div class="ibox-content form-horizontal">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        <div class="repeatable">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.EmployeeName)
                                            @Html.EditorFor(model => model.EmployeeName, new { htmlAttributes = new { @class = "form-control employeeName" } })
                                            @Html.ValidationMessageFor(model => model.EmployeeName, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                </div>
                                <div class="col-md-6">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.Address)
                                            @Html.EditorFor(model => model.Address, new { htmlAttributes = new { @class = "form-control address" } })
                                            @Html.ValidationMessageFor(model => model.Address, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>


                                <div class="col-md-6">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.FromDate)
                                            @Html.EditorFor(model => model.FromDate, new { htmlAttributes = new { @class = "form-control fromDate" } })
                                            @Html.ValidationMessageFor(model => model.FromDate, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.ToDate)
                                            @Html.EditorFor(model => model.ToDate, new { htmlAttributes = new { @class = "form-control toDate" } })
                                            @Html.ValidationMessageFor(model => model.ToDate, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <span input-group-btn col-sm-2">
                                <button id="btnAddMore" type="button" class="btn btn-primary"><i class="fa fa-plus"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="hr-line-dashed"></div>
                <div class="form-group">
                    <div class="col-md-10">
                        <input type="submit" id="btnSave" value="Add Employment History" class="btn btn-primary btn-lg" />

                        <a class="btn btn-flat btn-danger btn-lg" href="@Url.Action("Create","RelevantDocuments")">NEXT</a>

                    </div>
                </div>
            </div>
        </div>
    </div>

</form>

<script src="~/Scripts/jquery-3.3.1.min.js"></script>
<script src="~/AdminTemplate/js/plugins/sweetalert/sweetalert.min.js"></script>
<script>
    var count = 2;
    $(document).ready(function () {     

        $('#btnAddMore').click(function () {
            if (count <= 5) {
                var new_field = ` <div class="row">
                                <div class="col-md-6">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.EmployeeName)
                                            @Html.EditorFor(model => model.EmployeeName, new { htmlAttributes = new { @class = "form-control employeeName" } })
                                            @Html.ValidationMessageFor(model => model.EmployeeName, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                </div>
                                <div class="col-md-6">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.Address)
                                            @Html.EditorFor(model => model.Address, new { htmlAttributes = new { @class = "form-control address" } })
                                            @Html.ValidationMessageFor(model => model.Address, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>


                                <div class="col-md-6">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.FromDate)
                                            @Html.EditorFor(model => model.FromDate, new { htmlAttributes = new { @class = "form-control fromDate" } })
                                            @Html.ValidationMessageFor(model => model.FromDate, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.ToDate)
                                            @Html.EditorFor(model => model.ToDate, new { htmlAttributes = new { @class = "form-control toDate" } })
                                            @Html.ValidationMessageFor(model => model.ToDate, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                            <span onclick="remove_button(this)" input-group-btn col-sm-2">
                                <button type="button" class="btn btn-primary"><i class="fa fa-minus"></i></button>
                            </span>
                            </div>
                            
                        </div>`;
                $('.repeatable').append(new_field);
                count++;
            }
            else
            {
                swal({
                    title: "Warning",
                    text: "Maximum number of fields exceeded!",
                    type: "warning",
                });
               
            }
        });

        $('#btnSave').click(function () {
            var employeeName = [];
            var address = [];
            var fromDate = [];
            var toDate = [];
            var emplymentDetailList = [];

            //pulling the form data using the class and adding it to a list
            $.each($('.employeeName'), function () {
                employeeName.push($(this).val());
            });

            $.each($('.address'), function () {
                address.push($(this).val());
            });

            $.each($('.fromDate'), function () {
                fromDate.push($(this).val());
            });

            $.each($('.toDate'), function () {
                toDate.push($(this).val());
            });

            //////validation
            ////if (subjectid.length == 0 || subjectgrade.length == 0) {
            ////    alert("Invalid selection!");
            ////}
            ////else {

            ////}
            //append to list for c# in controller
            for (var i = 0; i < employeeName.length; i++) {
                var data = {
                    "EmployeeName": employeeName[i],
                    "Address": address[i],
                    "FromDate": fromDate[i],
                    "ToDate": toDate[i]
                };
                emplymentDetailList.push(data);
            }
            //var AllData = {
            //    //"ResultName": $('#ResultName').val(),
            //    //"ExaminationCenter": $('#ExaminationCenter').val(),
            //    //"Year": $('#Year').val(),
            //    "SubjectGrades": subjectgradelist
            //};


            var Mydata = JSON.stringify(emplymentDetailList);
            alert(Mydata);


            $.ajax({
               // type: "POST",
               // contentType: 'application/json',
               // url: "/ApplicantOLevelResults/Create",
               //// data: JSON.stringify(AllData),
                //data: AllData,
                contentType: 'application/json',
                type: "POST",
                url: "/EmploymentDetails/Create",
                data: Mydata,
                success: function (data) {
                    if (data.status) {
                        swal({
                            title: "Good Job!!!",
                            text: "Did you want to add More Result?..",
                            type: "warning",
                            showCancelButton: true,
                            confirmButtonColor: "#ab973a",
                            confirmButtonText: "Yes, Add More it!",
                            cancelButtonText: "No, See Employment Detail List!",
                            closeOnConfirm: false,
                            closeOnCancel: false
                        },
                            function (isConfirm) {
                                if (isConfirm) {
                                    swal("Great!", "You can now add more.", "success");
                                } else {
                                    swal("Great", "You can now see your Employment Detail list", "success");
                                    window.open('@Url.Action("Index", "EmploymentDetails")', '_self');

                                }
                            });
                        toastr["success"](data.message);
                    } else {
                        swal({
                            title: "Warning",
                            text: data.message,
                            type: "warning",
                        });
                        toastr["success"](data.message);
                    }

                }
            });
        });

    });

    function remove_button(elem) {
        if (count > 1) {
            $(elem).closest('div').remove();
            count--;
        }
    }




</script>


