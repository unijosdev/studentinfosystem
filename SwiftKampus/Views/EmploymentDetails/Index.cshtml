@model IEnumerable<SwiftKampusModel.AddmissionApplicant.EmploymentDetail>

@{
    ViewBag.Title = "Index";
}


<div class="container-fluid">
    <div class="wrapper wrapper-content animated fadeInRight">
        <div class="row">
            <div class="col-lg-12">
                <div class="ibox float-e-margins">
                    <div class="ibox-title">
                        <h5>List of Employment Details</h5>

                        <div class="ibox-tools">
                            <a href="@Url.Action("Create","EmploymentDetails")" class="btn btn-primary"> <i class="fa fa-plus left"></i> ADD EMPLOYMENT DETAIL</a>

                            <a class="collapse-link">
                                <i class="fa fa-chevron-up"></i>
                            </a>
                        </div>
                    </div>
                    <div class="ibox-content">
                        <table class=" table table-responsive">
                            <tr>

                                <th>
                                    @Html.DisplayNameFor(model => model.EmployeeName)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Address)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.FromDate)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.ToDate)
                                </th>
                                <th></th>
                            </tr>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        @Html.DisplayFor(modelItem => item.EmployeeName)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Address)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.FromDate)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.ToDate)
                                    </td>
                                    <td>
                                        @*@Html.ActionLink("Edit", "Edit", new { id=item.EmploymentDetailId }) |
                                            @Html.ActionLink("Details", "Details", new { id=item.EmploymentDetailId }) |*@
                                        @Html.ActionLink("Remove", "Delete", new { id = item.EmploymentDetailId })
                                    </td>
                                </tr>
                            }

                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
