@{
    ViewBag.Title = "Staff List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>@ViewBag.Gender</h2>
<div class="container-fluid">
    <!-- First row -->
    <div class="row">
        <!-- First column -->
        <div class="col-md-9">

            <div class="wrapper wrapper-content animated fadeInRight">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="ibox float-e-margins">
                            <div class="ibox-title">
                                <h5>List of Academic Staff</h5>
                                <div class="ibox-tools">                                  
                                    @if (ViewBag.Message != null)
                                    {
                                        <div class="alert alert-success">
                                            <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
                                            <strong>@ViewBag.Message</strong>
                                        </div>
                                    }

                                    <a class="collapse-link">
                                        <i class="fa fa-chevron-up"></i>
                                    </a>
                                    <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                                        <i class="fa fa-wrench"></i>
                                    </a>
                                </div>
                                <div class="ibox-content">
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-sm-2">
                                                <div class="form-group">
                                                    <label>Staff Role</label>
                                                    @Html.DropDownList("StaffRole", (SelectList)ViewBag.StaffRole, "", new { @class = "form-control" })
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="form-group">
                                                    <label>Faculty</label>
                                                    @Html.DropDownList("FacultyId", (SelectList)ViewBag.FacultyId, "", new { @class = "form-control", @onchange = "getDeptList()" })
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="form-group">
                                                    <label>Department</label>
                                                    @Html.DropDownList("DepartmentId", (SelectList)ViewBag.DepartmentId, "", new { @class = "form-control", @onchange = "getProgrammeList()" })
                                                </div>
                                            </div>

                                            <div class="col-md-2">
                                                <br />
                                                <button type="submit" id="btn-search" class="btn btn-primary">Search/View</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="ibox-content">
                                <div class="table-responsive">
                                    <table id="Jdatatable" class="table table-responsive">
                                        <thead>
                                            <tr>
                                                <th>Staff ID</th>
                                                <th> Full Name</th>
                                                <th> Gender</th>
                                                <th> Dept Name</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                    </table>
                                </div>
                            </div>
                        </div><!--end .card-body -->
                    </div>

                </div>

                <!-- /.First column -->

            </div>
            <!-- /.First row -->
        </div>

        <!-- Second column -->
        <div class="col-md-3">
            <div class="card contact-card with-padding">
                <div class="card-body" id="mydetailBody">
                </div>
            </div>
        </div>
        <!-- /.Second column -->
    </div>
</div>
<!-- Modal -->
<div class="modal fade modal-bf-fh" id="actionsList" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <!--Content-->
        <div class="modal-content">
            <!--Header-->
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <div class="flex-center">
                    <h4 class="modal-title">STAFF</h4>
                    @*<a class="btn btn-primary btn-sm">Create new action</a>*@
                </div>
            </div>
            <!--Body-->
            <div class="modal-body" id="myModalDivBody">
            </div>
        </div>
        <!--/.Content-->
    </div>
</div>
<!-- /.Modal-->
<script src="~/Scripts/jquery-1.11.3.min.js"></script>

<script type="text/javascript">
    $(document).ready(function () {

        // var gender = "@ViewBag.Gender";
        window.oTable = $("#Jdatatable").DataTable({
            "processing": true, // for show progress bar while loading
            "serverSide": true, // if it is true the preocess is done on server side
            "filter": true, // disables search box
            "info": true,
            "stateSave": true,
            "orderMulti": false, // disable multiple column loading at once
            "ajax": {
                "url": "/Staffs/GetIndex",
                "type": "POST",
                "datatype": "json",
                "data": function (d) {
                    d.StaffRole = $('#StaffRole').val();
                    d.FacultyId = $('#FacultyId').val();
                    d.DepartmentId = $('#DepartmentId').val();
                }
            },
            "columns": [
                { "data": "StaffId", "autoWidth": true },
                { "data": "FullName", "autoWidth": true },
                { "data": "Gender", "autoWidth": true },
                { "data": "DeptName", "autoWidth": true },
                {
                    "data": "StaffId",
                    "autoWidth": true,
                    "render": function(data) {
                        return '<a href="#" onclick="Detail(\'' + data + '\')" data-toggle="tooltip" data-placement="top" title="View Details"><i class="fa fa-info-circle" aria-hidden="true">Details&nbsp;&nbsp;</i></a>';
                    }
                }
                //{ "data": "EmailID", "autoWidth": true },
                //{ "data": "Phone", "autoWidth": true },
            ]
        });

    });
    $(window).scroll(function(){
        $("#mydetailBody").stop().animate({"marginTop": ($(window).scrollTop()) + "px", "marginLeft":($(window).scrollLeft()) + "px"}, "slow" );
    });

    $("#btn-search").click(function () {
        window.oTable.ajax.reload();
    });

    function Detail(staffId) {
        var url = "/Staffs/PartialDetails?id=" + staffId;
        $('#mydetailBody').load(url);
    };

    function getDeptList() {
        var facultyId = $("#FacultyId").val();
        //alert(stateId);
        $.ajax
            ({
                url: '/Students/GetDeptList?codeId=' + facultyId,
                type: 'GET',
                datatype: 'application/json',
                contentType: 'application/json',
                success: function (result) {
                    $("#DepartmentId").html("");
                    $.each($.parseJSON(result),
                        function (i, city) {
                            //alert(result);
                            $("#DepartmentId").append($('<option></option>').val(city.DepartmentId).html(city.DeptName));
                        });

                },
                error: function () {
                    $("#DepartmentId").html("");
                    $("#ProgrammeId").html("");
                }
            });
    }
</script>
