
@model IEnumerable<SwiftKampusModel.Staff>

@{
    ViewBag.Title = "None-Academic Staff";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>@ViewBag.Gender</h2>
<div class="container-fluid">
    <!-- First row -->
    <div class="row">
        <!-- First column -->
        <div class="col-md-8">

            <div class="wrapper wrapper-content animated fadeInRight">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="ibox float-e-margins">
                            <div class="ibox-title">
                                <h5>List of None-Academic Staff</h5>
                                <div class="ibox-tools">
                                    <a href="#" onclick="Excel()" class="btn btn-primary btn-lg"><i class="fa fa-file-excel-o"></i>&nbsp;Excel Upload</a>
                                    <a href="#" onclick="AddNew()" class="btn btn-primary btn-lg"><i class="fa fa-user"></i>&nbsp;ADD STAFF</a>

                                    @if (ViewBag.Message != null)
                                    {
                                        <div class="alert alert-success">
                                            <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
                                            <strong>@ViewBag.Message</strong>
                                        </div>
                                    }

                                    <a class="collapse-link">
                                        <i class="fa fa-chevron-up"></i>
                                    </a>
                                    <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                                        <i class="fa fa-wrench"></i>
                                    </a>
                                </div>
                            </div>


                            <div class="ibox-content">
                                <div class="table-responsive">
                                    <table id="Jdatatable" class="table table-responsive">
                                        <thead>
                                            <tr>
                                                <th>Staff ID</th>
                                                <th> Full Name</th>
                                                <th> Gender</th>
                                                <th> Dept Name</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                    </table>
                                </div>
                            </div>
                        </div><!--end .card-body -->
                    </div>

                </div>

                <!-- /.First column -->

            </div>
            <!-- /.First row -->
        </div>

        <!-- Second column -->
        <div class="col-md-4 mb-1">
            <div class="card contact-card with-padding">
                <div class="card-body" id="mydetailBody">
                </div>
            </div>
        </div>
        <!-- /.Second column -->
    </div>
</div>
<!-- Modal -->
<div class="modal fade modal-bf-fh" id="actionsList" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <!--Content-->
        <div class="modal-content">
            <!--Header-->
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <div class="flex-center">
                    <h4 class="modal-title">STAFF</h4>
                    @*<a class="btn btn-primary btn-sm">Create new action</a>*@
                </div>
            </div>
            <!--Body-->
            <div class="modal-body" id="myModalDivBody">
            </div>
        </div>
        <!--/.Content-->
    </div>
</div>
<!-- /.Modal-->
<script src="~/Scripts/jquery-1.11.3.min.js"></script>

<script type="text/javascript">
    $(document).ready(function () {

        // var gender = "@ViewBag.Gender";
        window.oTable = $("#Jdatatable").DataTable({
            "processing": true, // for show progress bar while loading
            "serverSide": true, // if it is true the preocess is done on server side
            "filter": true, // disables search box
            "info": true,
            "stateSave": true,
            "orderMulti": false, // disable multiple column loading at once
            "ajax": {
                //"url": "/Students/GetIndex?gender=" + "@ViewBag.Gender",
                "url": "/Staffs/GetNoneAcademic",
                "type": "POST",
                "datatype": "json"
            },
            "columns": [
                { "data": "StaffId", "autoWidth": true },
                { "data": "FullName", "autoWidth": true },
                { "data": "Gender", "autoWidth": true },
                { "data": "DeptName", "autoWidth": true },
                {
                    "data": "StaffId",
                    "autoWidth": true,
                    "render": function(data) {
                        return '<a href="#" onclick="AddRole(\'' + data + '\')" data-toggle="tooltip" data-placement="top" title="Add User Roles"><i class="fa fa-diamond" aria-hidden="true">Add Role&nbsp;&nbsp;</i></a>' +
                        '<a href="#" onclick="Detail(\'' + data + '\')" data-toggle="tooltip" data-placement="top" title="View Details"><i class="fa fa-info-circle" aria-hidden="true">Details&nbsp;&nbsp;</i></a>' +
                            '<a href="#" onclick="Edit(\'' + data + '\')" data-toggle="tooltip" data-placement="top" title="Edit Student"><i class="fa fa-pencil" aria-hidden="true" ><i />Edit</a>';
                    }
                }
                //{ "data": "EmailID", "autoWidth": true },
                //{ "data": "Phone", "autoWidth": true },
            ]
        });

    });
    $(window).scroll(function(){
        $("#mydetailBody").stop().animate({"marginTop": ($(window).scrollTop()) + "px", "marginLeft":($(window).scrollLeft()) + "px"}, "slow" );
    });
    function Edit(staffId) {

        var url = "/Staffs/Edit?id=" + staffId;
        window.open(''+url+'', '_self');
    };

    function Detail(staffId) {
        //window.alert(subjecId);
        var url = "/Staffs/PartialDetails?id=" + staffId;

        $('#mydetailBody').load(url);

    };

    function AddRole(staffId) {
        var url = "/RolesAdmin/AddStaff?id=" + staffId;

        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });

    };

    function Excel() {
        var url = "/Staffs/ExcelUpload";
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
    };
    function AddNew() {
        window.open('@Url.Action("Create", "Staffs")', '_self');
    };
</script>


