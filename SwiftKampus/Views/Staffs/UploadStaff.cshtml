
@{
    ViewBag.Title = "UploadStaff";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row wrapper border-bottom white-bg page-heading">
    <div class="col-lg-6">
        <h2>Staff Excel Upload</h2>
    </div>
    <div class="col-lg-2">

    </div>
</div>
</br>
<a class="btn btn-primary" href="~/Excel Template/Staff Upload.xlsx">Download Excel Template</a>


<div class="card-body">
    <h3>Instructions</h3>
    <ul>
        <li>Please the button above to download the format required for the upload.</li>
        <li>Please leave no cell empty in the excel template before you upload.</li>
        <li>Please use a valid Date for staff's date of birth.</li>
        <li>Please use a valid Date for staff's resumption date.</li>
        <li>Staff Role type format is <b>"Academic"</b> and <b>"None Academic"</b>.</li>
        <li>You will be redirect to the list of staffs after successful upload.</li>
    </ul>
    <div>
    </div>
</div>


@using (Html.BeginForm("UploadStaff", "Staffs", FormMethod.Post, new { enctype = "multipart/form-data", id = "theform" }))
{
    @Html.Raw(ViewBag.Error)
    <span>Excel File </span> <input type="file" name="excelfile" />
    <br />
    <input id="btnsubmit" type="submit" value="Upload Staff Record" class="btn btn-primary" />
}

<script src="~/Scripts/jquery-3.1.1.min.js"></script>
<script type="text/javascript">
    $(function () {
        $('#theform').submit(function () {
            $("input[type='submit']", this)
                .val("Uploading Please Wait...")
                .attr('disabled', 'disabled');
            return true;
        });
    });
</script>

