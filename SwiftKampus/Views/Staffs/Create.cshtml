@model SwiftKampusModel.Staff

@{
    ViewBag.Title = "Add Staff";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>Add New Staff</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                        <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                            <i class="fa fa-wrench"></i>
                        </a>
                    </div>
                </div>


                <div class="ibox-content">

                    @using (Html.BeginForm("Create", "Staffs", FormMethod.Post, new { enctype = "multipart/form-data", id = "myform" }))
                    {
                        <h3 class="text-danger">@ViewBag.Message</h3>
                        @Html.AntiForgeryToken()
                        <div class="container-fluid">
                            <!-- Section: Edit Account -->
                            <section class="section">
                                <!-- First row -->
                                <div class="row">
                                    <!-- First column -->
                                    <div class="col-lg-4">
                                        <div class="row">

                                            <div class="card">
                                                <div class="card-head style-primary">
                                                    <header>
                                                        <h5>Add Staff Passport</h5>
                                                    </header>

                                                </div><!--end .card-head -->
                                                <div class="card-body">

                                                    <!-- Card content -->
