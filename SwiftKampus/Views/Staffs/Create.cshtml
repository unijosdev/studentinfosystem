                                                                    @Html.DropDownList("Religion", null, htmlAttributes: new { @class = "form-control" })
                                                                    @Html.ValidationMessageFor(model => model.Religion, "", new { @class = "text-danger" })
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <!--/.First row-->
                                                        <!--Second row-->
                                                        <div class="row">
                                                            <!--First column-->
                                                            <div class="col-md-4">
                                                                <div class="form-group">
