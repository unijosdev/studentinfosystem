                                                                    @Html.EditorFor(model => model.PhoneNumber, new { htmlAttributes = new { @class = "form-control" } })
                                                                    @Html.ValidationMessageFor(model => model.PhoneNumber, "", new { @class = "text-danger" })
                                                                </div>
                                                            </div>

                                                            <div class="col-md-4">
                                                                <div class="form-group">
                                                                    @Html.Label("Department")
                                                                    @Html.DropDownList("DepartmentId", null, htmlAttributes: new { @class = "form-control js-example-basic-single" })
                                                                    @Html.ValidationMessageFor(model => model.DepartmentId, "", new { @class = "text-danger" })
                                                                </div>
                                                            </div>

                                                            <div class="col-md-4">
                                                                <div class="form-group">
                                                                    @Html.LabelFor(model => model.Nationality)
                                                                    @Html.EditorFor(model => model.Nationality, new { htmlAttributes = new { @class = "form-control" } })
                                                                    @Html.ValidationMessageFor(model => model.Nationality, "", new { @class = "text-danger" })
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <!--/.Third row-->
                                                        <!--Forth row-->
                                                        <div class="row">
                                                            <div class="col-md-4">
                                                                <div class="form-group">
                                                                    @Html.Label("Staff Category")
                                                                    @Html.DropDownList("StaffRole", null, htmlAttributes: new { @class = "form-control" })
                                                                    @Html.ValidationMessageFor(model => model.StaffRole, "", new { @class = "text-danger" })
                                                                </div>
                                                            </div>

                                                            <div class="col-md-4">
                                                                <div class="form-group">
                                                                    @Html.LabelFor(model => model.MaritalStatus)
                                                                    @Html.DropDownList("MaritalStatus", null, htmlAttributes: new { @class = "form-control" })
                                                                    @Html.ValidationMessageFor(model => model.MaritalStatus, "", new { @class = "text-danger" })
                                                                </div>
                                                            </div>
                                                            @*<div class="col-md-4">
                                                                    <div class="form-group">
                                                                        @Html.LabelFor(model => model.Nationality)
                                                                        @Html.EditorFor(model => model.Nationality, new {htmlAttributes = new {@class = "form-control"}})
                                                                        @Html.ValidationMessageFor(model => model.Nationality, "", new {@class = "text-danger"})
                                                                    </div>
                                                                </div>*@
                                                        </div>
                                                        <!--/.Forth row-->
                                                        <!-- Fifth row -->
                                                        <div class="row">
                                                            <div class="col-md-12 text-center">
                                                                <input type="submit" id="btnsubmit" value="Add Staff Record" class="btn btn-primary btn-lg">
                                                            </div>
                                                        </div>
                                                        <!-- /.Fifth row -->
                                                    </form>
                                                    <!-- Edit Form -->
                                                </div>
                                                <!--/.Card content-->
                                            </div>
                                        </div>
                                        <!--/.Card-->
                                    </div>
                                    <!-- /.Second column -->
                                </div>
                                <!-- /.First row -->
                            </section>
                            <!-- /.Section: Edit Account -->
                        </div>
                    }
                    <!--/Main layout-->

                </div>
            </div>
        </div>
    </div>
</div>



@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
<script src="~/Scripts/jquery-3.1.1.min.js"></script>
<link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.9/css/select2.min.css" rel="stylesheet" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.9/js/select2.min.js"></script>

<script>

    jQuery(function ($) {
        $('.js-example-basic-single').select2({
            placeholder: 'Select an option...',
            allowClear: true
        });
    });

    var loadFile = function (event) {
        var fileUpload = document.getElementById("File");
        if (typeof (fileUpload.files) != "undefined") {
            var size = parseFloat(fileUpload.files[0].size / 1024).toFixed(2);
            if (size > 20) {
                toastr["error"]("The image is bigger than the specified size.");
                var output = document.getElementById('output');
                output.src = "#";
            } else {
                var output = document.getElementById('output');
                output.src = URL.createObjectURL(event.target.files[0]);
            }
        } else {
            alert("This browser does not support HTML5.");
        }

    };
    var loadFile2 = function (event) {
        var fileUpload = document.getElementById("BannerFile");
        if (typeof (fileUpload.files) != "undefined") {
            var size = parseFloat(fileUpload.files[0].size / 1024).toFixed(2);
            if (size > 30) {
                toastr["error"]("The image is bigger than the specified size.");
                var output2 = document.getElementById('output2');
                output2.src = "#";
            } else {
                var output2 = document.getElementById('output2');
                output2.src = URL.createObjectURL(event.target.files[0]);
            }
        } else {
            alert("This browser does not support HTML5.");
        }
    };

    function getLgaList() {
        var stateId = $("#StateOfOrigin").val();
        //alert(stateId);
        $.ajax
            ({
                url: '/Students/GetLgaList?codeId=' + stateId,
                type: 'GET',
                datatype: 'application/json',
                contentType: 'application/json',
                //data: JSON.stringify({
                //    codeId: +stateId
                //}),
                success: function (result) {
                    $("#Lga").html("");
                    $.each($.parseJSON(result),
                        function (i, city) {
                            $("#Lga").append($('<option></option>').val(city).html(city));
                        });

                },
                error: function () {
                    alert("Whooaaa! Something went wrong..");
                }
            });
    }
</script>
