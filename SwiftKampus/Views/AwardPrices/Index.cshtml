@model IEnumerable<SwiftKampusModel.AddmissionApplicant.AwardPrice>

@{
    ViewBag.Title = "Award and Prices";
}

<div class="container-fluid">
    <div class="wrapper wrapper-content animated fadeInRight">
        <div class="row">
            <div class="col-lg-12">
                <div class="ibox float-e-margins">
                    <div class="ibox-title">
                        <h5>List of Award and Prices</h5>
                        <div class="ibox-tools">
                            <a href="@Url.Action("Create","AwardPrices")" class="btn btn-primary"> <i class="fa fa-plus left"></i> ADD AWARD/PRICES</a>

                            <a class="collapse-link">
                                <i class="fa fa-chevron-up"></i>
                            </a>
                        </div>
                    </div>
                    <div class="ibox-content">
                        <table class="table table-responsive">
                            <tr>

                                <th>
                                    @Html.DisplayNameFor(model => model.AwardingBody)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.AcademicPrice)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Year)
                                </th>
                                <th></th>
                            </tr>

                            @foreach (var item in Model)
                            {
                                <tr>
                                    
                                    <td>
                                        @Html.DisplayFor(modelItem => item.AwardingBody)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.AcademicPrice)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Year)
                                    </td>
                                    <td>
                                        @Html.ActionLink("Delete", "Delete", new { id = item.AwardPriceId })
                                    </td>
                                </tr>
                            }

                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
