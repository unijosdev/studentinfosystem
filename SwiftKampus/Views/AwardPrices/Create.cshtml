@model SwiftKampusModel.AddmissionApplicant.AwardPrice

@{
    ViewBag.Title = "Award Price";
    Layout = null;
}
<link href="~/AdminTemplate/css/plugins/sweetalert/sweetalert.css" rel="stylesheet">

<form id="myform" onsubmit="return false;">

    <div class="row wrapper border-bottom white-bg page-heading">
        <div class="col-lg-10">
            <h2>Add Award and Price</h2>
        </div>
        <div class="col-lg-2">

        </div>
    </div>

    <div class="wrapper wrapper-content animated fadeInRight">
        <div class="row">
            <div class="col-md-2">
                <div class="com-md-12">
                    <h4 class="text-center">Instruction</h4>
                    @*<ol class="bold">
                            <li>You are only allowed to Add 5 results from <i class="bold italic">Maximum of two sittings</i> </li>
                            <li>Select Exam Type</li>
                            <li>Select Subject(s)</li>
                            <li>Add Grade based on the order of subject selected</li>
                        </ol>*@
                </div>
            </div>
            <div class="col-md-10">
                <div class="ibox float-e-margins">
                    <div class="ibox-content form-horizontal">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        <div class="repeatable">
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.AwardingBody)
                                            @Html.EditorFor(model => model.AwardingBody, new { htmlAttributes = new { @class = "form-control awardingBody" } })
                                            @Html.ValidationMessageFor(model => model.AwardingBody, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.AcademicPrice)
                                            @Html.EditorFor(model => model.AcademicPrice, new { htmlAttributes = new { @class = "form-control academicPrice" } })
                                            @Html.ValidationMessageFor(model => model.AcademicPrice, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.Year)
                                            @Html.EditorFor(model => model.Year, new { htmlAttributes = new { @class = "form-control year" } })
                                            @Html.ValidationMessageFor(model => model.Year, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>


                                <span class="col-md-12" input-group-btn col-sm-2">
                                    <button id="btnAddMore" type="button" class="btn btn-primary"><i class="fa fa-plus"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="hr-line-dashed"></div>
                    <div class="form-group">
                        <div class="col-md-offset-2 col-md-10">
                            <input type="submit" id="btnSave" value="Add Award and Price" class="btn btn-primary btn-lg" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</form>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

<script src="~/Scripts/jquery-3.3.1.min.js"></script>
<script src="~/AdminTemplate/js/plugins/sweetalert/sweetalert.min.js"></script>
<script>
    var count = 2;
    $(document).ready(function () {

        $('#btnAddMore').click(function () {
            if (count <= 5) {
                var new_field = `<div class="row">
                                <div class="col-md-4">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.AwardingBody)
                                            @Html.EditorFor(model => model.AwardingBody, new { htmlAttributes = new { @class = "form-control awardingBody" } })
                                            @Html.ValidationMessageFor(model => model.AwardingBody, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.AcademicPrice)
                                            @Html.EditorFor(model => model.AcademicPrice, new { htmlAttributes = new { @class = "form-control academicPrice" } })
                                            @Html.ValidationMessageFor(model => model.AcademicPrice, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.Year)
                                            @Html.EditorFor(model => model.Year, new { htmlAttributes = new { @class = "form-control year" } })
                                            @Html.ValidationMessageFor(model => model.Year, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                 <span class="col-md-12" onclick="remove_button(this)" input-group-btn col-sm-2">
                                <button type="button" class="btn btn-primary"><i class="fa fa-minus"></i></button>
                            </span>
                            </div>

                        </div>`;
                $('.repeatable').append(new_field);
                count++;
            }
            else
            {
                swal({
                    title: "Warning",
                    text: "Maximum number of fields exceeded!",
                    type: "warning",
                });
            }
        });

        $('#btnSave').click(function () {
            var awardingBody = [];
            var academicPrice = [];
            var year = [];
            var emplymentDetailList = [];

            //pulling the form data using the class and adding it to a list
            $.each($('.awardingBody'), function () {
                awardingBody.push($(this).val());
            });

            $.each($('.academicPrice'), function () {
                academicPrice.push($(this).val());
            });

            $.each($('.year'), function () {
                year.push($(this).val());
            });

            //////validation
            ////if (subjectid.length == 0 || subjectgrade.length == 0) {
            ////    alert("Invalid selection!");
            ////}
            ////else {

            ////}
            //append to list for c# in controller
            for (var i = 0; i < awardingBody.length; i++) {
                var data = {
                    "AwardingBody": awardingBody[i],
                    "AcademicPrice": academicPrice[i],
                    "Year": year[i]
                };
                emplymentDetailList.push(data);
            }

            var Mydata = JSON.stringify(emplymentDetailList);


            $.ajax({
                contentType: 'application/json',
                type: "POST",
                url: "/AwardPrices/Create",
                data: Mydata,
                success: function (data) {
                    if (data.status) {
                        swal({
                            title: "Good Job!!!",
                            text: "Did you want to add More Result?..",
                            type: "warning",
                            showCancelButton: true,
                            confirmButtonColor: "#ab973a",
                            confirmButtonText: "Yes, Add More it!",
                            cancelButtonText: "No, See Result List!",
                            closeOnConfirm: false,
                            closeOnCancel: false
                        },
                            function (isConfirm) {
                                if (isConfirm) {
                                    swal("Great!", "You can now add more.", "success");
                                } else {
                                    swal("Great", "You can now see your result list", "success");
                                    window.open('@Url.Action("Index", "AwardPrices")', '_self');

                                }
                            });
                        toastr["success"](data.message);
                    } else {
                        swal({
                            title: "Warning",
                            text: data.message,
                            type: "warning",
                        });
                        toastr["success"](data.message);
                    }

                }
            });
        });

    });

    function remove_button(elem) {
        if (count > 1) {
            $(elem).closest('div').remove();
            count--;
        }
    }




</script>
