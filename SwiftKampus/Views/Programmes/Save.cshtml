@model SwiftKampusModel.Programme

<form id="myform" onsubmit="return false;">
    @Html.AntiForgeryToken()

    <div class="card">
     
        <div class="card-body">

            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            @if (Model != null && Model.ProgrammeId > 0)
            {
                @Html.HiddenFor(model => model.ProgrammeId)
            }

            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            <div class="form-group">
                @Html.LabelFor(model => model.DepartmentId)
                @Html.DropDownList("DepartmentId", null, htmlAttributes: new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.DepartmentId, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.Label("Dept Option Code")
                @Html.EditorFor(model => model.ProgrammeCode, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.ProgrammeCode, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.Label("Dept Option Name")
                @Html.EditorFor(model => model.ProgrammeName, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.ProgrammeName, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.Label("Awarding Degree Name")
                @Html.EditorFor(model => model.AwardingDegreeName, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.AwardingDegreeName, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.Label("Minimum No of Semeters")
                @Html.EditorFor(model => model.NoOfSemesters, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.NoOfSemesters, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.Label("Level Name")
                @Html.DropDownList("LevelId", null, htmlAttributes: new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.LevelId, "", new { @class = "text-danger" })
            </div>

            <div class="md-form">

                @if (Model != null && Model.ProgrammeId > 0)
                {
                    <input id="btnsubmit" type="submit" value="Update" class="btn btn-lg btn-primary" />
                }
                else
                {
                    <input id="btnsubmit" type="submit" value="Save" class="btn btn-lg btn-primary" />
                }
                <a href="#" class="btn btn-danger" data-dismiss="modal">Cancel</a>
            </div>
        </div>
    </div>
</form>
@*@section Scripts {
        @Scripts.Render("~/bundles/jqueryval")
    }*@

<script type="text/javascript">
    $("#btnsubmit").click(function () {

        var data = $("#myform").serialize();

        $.ajax({
            type: "POST",
            url: "/Programmes/Save",
            data: data,
            success: function (data) {
                if (data.status) {
                    $('#actionsList').modal("hide");

                    window.oTable.ajax.reload(); //run my_fun() ondomready
                    toastr["success"](data.message);
                    $('#myform')[0].reset();
                } else {
                    //$('#actionsList').modal("hide");
                    toastr["error"](data.message);
                }

            }
        });
    });
</script>