@model IEnumerable<SwiftKampusModel.Payment.DepartmentFeePayment>

@{
    ViewBag.Title = "Index";
}

<div class="card">
    <div class="card-head style-primary">
        <header>
            <h3>
                Department Fee Payment History
            </h3>
        </header>

    </div><!--end .card-head -->
    <div class="card-body">
        <table class="table">
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Department.DeptCode)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Semester.SemesterName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Session.SessionName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Students.StudentType)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.PaidFee)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.TotalAmount)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.PaymentMode)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Date)
                </th>
             
                <th>
                    @Html.DisplayNameFor(model => model.PaymentStatus)
                </th>
                <th></th>
            </tr>

            @foreach (var item in Model) {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Department.DeptCode)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Semester.SemesterName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Session.SessionName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Students.StudentType)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.PaidFee)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.TotalAmount)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.PaymentMode)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Date)
                    </td>
                 
                    <td>
                        @Html.DisplayFor(modelItem => item.PaymentStatus)
                    </td>
                    <td>
                        @Html.ActionLink("Print Receipt", "PrintReceipt", new { id=item.DepartmentFeePaymentId }) 
                        @*<a href="#">Print Receipt</a>*@
                        
                    </td>
                </tr>
            }

        </table>
    </div>
</div>

