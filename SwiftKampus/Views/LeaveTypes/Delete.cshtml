@model SwiftKampusModel.Employee.Leave.LeaveType


<div class="card">
    <div class="card-head style-primary">
        <header>
            <h3>
                <i class="fa fa-remove"></i> Delete Record
            </h3>
        </header>

    </div><!--end .card-head -->
    <div class="card-body">
        <h3>Are you sure you want to delete this?</h3>
        <div>

            <dl class="dl-horizontal">
                <dt>
                    @Html.DisplayNameFor(model => model.LeaveTypeName)
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.LeaveTypeName)
                </dd>

                <dt>
                    @Html.DisplayNameFor(model => model.MaximumLeaveCount)
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.MaximumLeaveCount)
                </dd>

                <dt>
                    @Html.DisplayNameFor(model => model.EbanbleCarryForward)
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.EbanbleCarryForward)
                </dd>

                <dt>
                    @Html.DisplayNameFor(model => model.IsActive)
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.IsActive)
                </dd>

                <dt>
                    @Html.DisplayNameFor(model => model.LeaveTime)
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.LeaveTime)
                </dd>

            </dl>

            <form id="myform" onsubmit="return false;">
                @Html.AntiForgeryToken()

                <input type="hidden" id="id" name="id" class="form-control" value="@Model.LeaveTypeId">
                <input data-target="#actionsList" id="btndelete" type="submit" value="Delete" class="btn btn-danger" /> |

                <a href="#" class="btn btn-info" data-dismiss="modal">Cancel</a>
            </form>
        </div>
    </div><!--end .card-body -->
</div><!--end .card -->


<script type="text/javascript">

    $("#btndelete").click(function () {

        var data = $("#myform").serialize();
        //window.alert(data);
        $.ajax({
            type: "POST",
            url: "/LeaveTypes/Delete",
            data: data,
            success: function (data) {
                if (data.status) {
                    $('#actionsList').modal("hide");
                    window.oTable.ajax.reload(); //run my_fun() ondomready
                    toastr["info"](data.message);
                    $('#myform')[0].reset();
                } else {
                    //$('#actionsList').modal("hide");
                    toastr["error"](data.message);
                }

            }
        });
    });
</script>
