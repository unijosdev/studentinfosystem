@model IEnumerable<SwiftKampusModel.AddmissionApplicant.AvailableCourse>

@{
    ViewBag.Title = "Index";
}

<!-- Modal -->
<div class="modal fade modal-bf-fh" id="actionsList" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <!--Content-->
        <div class="modal-content">
            <!--Header-->
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <div class="flex-center">
                    <h4 class="modal-title">PROGRAMME COURSE</h4>
                    @*<a class="btn btn-primary btn-sm">Create new action</a>*@
                </div>
            </div>
            <!--Body-->
            <div class="modal-body" id="myModalDivBody">
            </div>
        </div>
        <!--/.Content-->
    </div>
</div>
<!-- /.Modal-->

<div class="container-fluid">
    <!-- First row -->
    <div class="row">
        <!-- First column -->
        <div class="col-md-12">

            <div class="wrapper wrapper-content animated fadeInRight">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="ibox float-e-margins">
                            <div class="ibox-title">
                                <h5>List Available School Programme Course</h5>
                                <div class="ibox-tools">
                                    <a href="#" onclick="myFunction()" class="btn btn-primary btn-lg"><i class="fa fa-plus left"></i> ADD PROGRAMME COURSE</a>
                                    <a href="#" onclick="uplouadProgramme()" class="btn btn-primary btn-lg"><i class="fa fa-file-excel-o left"></i> UPLOAD PROGRAMME COURSE</a>
                                    @if (ViewBag.Message != null)
                                    {
                                        <div class="alert alert-success">
                                            <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
                                            <strong>@ViewBag.Message</strong>
                                        </div>
                                    }

                                    <a class="collapse-link">
                                        <i class="fa fa-chevron-up"></i>
                                    </a>
                                    <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                                        <i class="fa fa-wrench"></i>
                                    </a>
                                </div>

                            </div>

                            <div class="ibox-content">
                                <table id="Jdatatable" class="table table-striped table-hover">
                                    <thead>
                                        <tr>
                                            <th>School Programme</th>
                                            <th>Available Course</th>
                                            <th>Status</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<script src="~/Scripts/jquery-3.1.1.min.js"></script>
<link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.9/css/select2.min.css" rel="stylesheet" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.9/js/select2.min.js"></script>


<script type="text/javascript">
    $(function ($) {
        //$(".select-add-placeholder").prepend("<option value='' disabled selected>Select an option...</option>");
        //$('.js-example-basic-single').select2({
        //  placeholder: 'Select an option...',
        //  allowClear: true
        //});
    });
    $(document).ready(function () {

        $(".js-example-basic-single").select2({
            dropdownParent: $("#actionsList")
        });

        window.oTable = $("#Jdatatable").DataTable({
            "processing": true, // for show progress bar while loading
            //"serverSide": true, // if it is true the preocess is done on server side
            //"filter": true, // disables search box
            //"info": true,
            //"stateSave": true,
            //"orderMulti": false, // disable multiple column loading at once
            "ajax": {
                "url": "/AvailableCourses/GetIndex",
                "type": "POST",
                "datatype": "json"
            },
            "columns": [
                { "data": "FancyName", "autoWidth": true },
                { "data": "ProgrammeName", "autoWidth": true },
                { "data": "IsActive", "autoWidth": true },


                {
                    "data": "AvailableCourseId",
                    "autoWidth": true,
                    "render": function (data) {
                        return '<a href="#" data-toggle="modal" data-target="#actionsList" onclick="Edit(' + data + ')" >  <i class="fa fa-pencil" aria-hidden="true" >&nbsp;Edit</i></a>&nbsp;&nbsp;' +
                            '<a href="#" class="text-danger" data-toggle="modal" data-target="#actionsList"  onclick="Delete(' + data + ')" ><i class="fa fa-remove" aria-hidden="true" >&nbsp;Remove<i /></a>';
                    }
                }

                //{ "data": "EmailID", "autoWidth": true },
                //{ "data": "Phone", "autoWidth": true },
            ]
        });

    });
    function Edit(availableCourseId) {

        console.log($('#AvailableCourseId').val());

        var url = "/AvailableCourses/Save?id=" + availableCourseId;
        $('#myModal').appendTo("body").modal('show');
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal('show');
            });

    };
    function Delete(availableCourseId) {
        var url = "/AvailableCourses/Delete?id=" + availableCourseId;
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
    };
    function myFunction() {
        var url = "/AvailableCourses/Save?id=0";
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
    };

    function uplouadProgramme() {
        var url = "/AvailableCourses/UploadAvailableProgramme";

        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
    };
</script>
