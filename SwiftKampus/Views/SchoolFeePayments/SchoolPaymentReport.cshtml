@model SwiftKampus.ViewModels.SchoolFeePaymentSearchVm

@{
    ViewBag.Title = "School Payment Report";
}


<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>List of School Payment</h5>
                    <div class="ibox-tools">

                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                        <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                            <i class="fa fa-wrench"></i>
                        </a>

                    </div>
                </div>
                <div class="ibox-content">
                    <article class="margin-bottom-xxl">
                        <p class="lead">
                            Please use the following parameters to perform search
                        </p>
                    </article>
                    <div class="card-body">
                        <form id="formFilter" onsubmit="return false;">
                            <div class="row">
                                <div class="row col-md-12">
                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label for="DepartmentId">School Programme</label>
                                            @Html.DropDownList("SchoolProgrammeId", null, htmlAttributes: new { @class = "form-control" })
                                        </div>
                                    </div>
                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label>Category</label>
                                            @Html.DropDownList("FeeCategoryId", null, htmlAttributes: new { @class = "form-control" })
                                        </div>
                                    </div>
                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label>Student Type</label>
                                            @Html.DropDownList("StudentType", null, htmlAttributes: new { @class = "form-control" })
                                        </div>
                                    </div>
                                    <div class="col-sm-2">
                                        <div class="form-group">
                                            <label>Status</label>
                                            <select class="form-control dropdown" id="HasPayed" name="HasPayed">
                                                <option>True</option>
                                                <option>False</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-sm-4">
                                        <div class="form-group">
                                            <label>Department Name</label>
                                            @Html.DropDownList("DepartmentId", (SelectList)ViewBag.DepartmentId, "", new { @class = "form-control" })
                                        </div>
                                    </div>

                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label>Session Name</label>
                                        @Html.DropDownList("SessionId", (SelectList)ViewBag.SessionId, "", new { @class = "form-control" })
                                    </div>
                                </div>
                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label>Level Name</label>
                                        @Html.DropDownList("LevelId", (SelectList)ViewBag.LevelId, "", new { @class = "form-control" })
                                    </div>
                                </div>
                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label>Start Date</label>
                                        @Html.EditorFor(m => m.StartDate, new { @class = "form-control" })
                                    </div>
                                </div>
                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label>End Date</label>
                                        @Html.EditorFor(m => m.EndDate, new { @class = "form-control" })
                                    </div>

                                </div>

                                <div class="col-sm-1">
                                    <div class="form-group">
                                        <br />
                                        <button type="submit" id="btn-search" class="btn btn-raised btn-primary ink-reaction">Search/View</button>
                                    </div>
                                </div>
                            </div>
                        </form>
                        <br />
                        <div id="reportBody" class="table-responsive">
                           
                        </div>
                    </div><!--end .row -->

                </div>


            </div>
        </div>
    </div>


</div>

<script src="~/Scripts/jquery-3.1.1.min.js"></script>

<script type="text/javascript">

    //$("#btn-search").click(function () {
    //    window.oTable.ajax.reload();
    //});
    $("#btn-search").click(function () {

        var url = "/SchoolFeePayments/GetSchoolPaymentReport?SessionId=" + $('#SessionId').val()
            + "&SchoolProgrammeId=" + $('#SchoolProgrammeId').val()
            + "&FeeCategoryId=" + $('#FeeCategoryId').val()
            + "&LevelId=" + $('#LevelId').val()
            + "&HasPayed=" + $('#HasPayed').val()
            + "&StartDate=" + $('#StartDate').val()
            + "&EndDate=" + $('#EndDate').val()
            + "&DepartmentId=" + $('#DepartmentId').val()
        + "&StudentType=" + $('#StudentType').val();
        jQuery.noConflict();
        $('#reportBody').load(url);
    });
   
</script>


