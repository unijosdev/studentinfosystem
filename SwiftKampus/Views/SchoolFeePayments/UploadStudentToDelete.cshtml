
@{
    ViewBag.Title = "Student To Delete";
}

<h2>@ViewBag.Message</h2>
<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h2>Remove Student Account</h2>

                    <div class="ibox-tools">

                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                    <h3 class="text-danger">@ViewBag.Message</h3>

                    @using (Html.BeginForm("UploadStudentToDelete", "SchoolFeePayments", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Get, new { @class = "", role = "form" }))
                    {

                        <br />
                        <div class="form-group">

                            <div class="col-md-7">
                                <label for="Id">Form No</label>
                                <input id="formNo" name="formNo" class="form-control" type="text" required placeholder="Type your Form No" />
                            </div>
                        </div>

                        <button class="btn btn-primary btn-lg" type="submit">Update Record<span class="icon-more-icon"></span></button>

                    }
                </div>
            </div>
        </div>
    </div>
</div>

