@model SwiftKampus.ViewModels.SchoolFeePaymentSearchVm

@{
    ViewBag.Title = "School Fee Payment";
}


<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>List of School Charges Payment</h5>
                    <div class="ibox-tools">

                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                        <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                            <i class="fa fa-wrench"></i>
                        </a>

                    </div>
                </div>
                <div class="ibox-content">
                    <article class="margin-bottom-xxl">
                        <p class="lead">
                            Please use the following parameters to perform search
                        </p>
                    </article>
                    <div class="card-body">
                        <form  id="formFilter" onsubmit="return false;">
                            <div class="row">
                                <div class="row col-md-12">
                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label for="DepartmentId">School Programme</label>
                                            @Html.DropDownList("SchoolProgrammeId", null, htmlAttributes: new { @class = "form-control" })
                                        </div>
                                    </div>
                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label>Category</label>
                                            @Html.DropDownList("FeeCategoryId", null, htmlAttributes: new { @class = "form-control" })
                                        </div>
                                    </div>
                                    <div class="col-sm-2">
                                        <div class="form-group">
                                            <label>Status</label>
                                            <select class="form-control dropdown" id="hasPayed" name="hasPayed">
                                                <option>True</option>
                                                <option>False</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="col-sm-4">
                                        <div class="form-group">
                                            <label>Faculty Name</label>
                                            @Html.DropDownList("FacultyId", (SelectList)ViewBag.FacultyId, "", new { @class = "form-control" })
                                        </div>
                                    </div>  
                                    <div class="col-sm-4">
                                        <div class="form-group">
                                            <label>Department Name</label>
                                            @Html.DropDownList("DepartmentId", (SelectList)ViewBag.DepartmentId, "", new { @class = "form-control" })
                                        </div>
                                    </div> 
                                    <div class="col-md-3">
                                        <div class="form-group">
                                            @Html.Label("State")
                                            @Html.DropDownList("StateOfOrigin", null, htmlAttributes: new { @class = "form-control", @onchange = "getLgaList()" })

                                        </div>
                                    </div>

                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label>Session Name</label>
                                        @Html.DropDownList("SessionId", (SelectList)ViewBag.SessionId, "", new { @class = "form-control" })
                                    </div>
                                </div>
                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label>Level Name</label>
                                        @Html.DropDownList("LevelId", (SelectList)ViewBag.LevelId, "", new { @class = "form-control" })
                                    </div>
                                </div>
                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label>Start Date</label>
                                        @Html.EditorFor(m => m.StartDate, new { @class = "form-control" })
                                    </div>
                                </div>
                                <div class="col-sm-2">
                                    <div class="form-group">
                                        <label>End Date</label>
                                        @Html.EditorFor(m => m.EndDate, new { @class = "form-control"})
                                    </div>

                                </div>

                                <div class="col-sm-1">
                                    <div class="form-group">
                                        <br />
                                        <button type="submit" id="btn-search" class="btn btn-raised btn-primary ink-reaction">Search/View</button>
                                    </div>
                                </div>
                            </div>
                        </form>
                        <br />
                        <div class="table-responsive">
                            <table id="Jdatatable" class="table table-striped table-bordered table-hover table-responsive dataTables-example">
                                <thead>
                                    <tr>
                                        <td>Matric No</td>
                                        <td>FullName</td>
                                        <td>State</td>
                                        <td>LGA</td>
                                        <td>Reference No</td>
                                        <td>Status</td>
                                        @*<td>Gender</td>*@
                                        <td>Programme Name</td>
                                        <td>Level</td>
                                        <td>PhoneNumber</td>
                                        <td>Amount</td>
                                        <td>RemainingBalance</td>
                                        <td>Date</td>
                                        <td>Action</td>
                                    </tr>
                                </thead>
                            </table>

                        </div>
                    </div><!--end .row -->

                </div>


            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade inmodal" id="actionsList" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog  modal-lg" role="document">
        <!--Content-->
        <div class="modal-content animated">
            <!--Header-->
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <div class="flex-center">
                    <h4 class="modal-title">STUDENT</h4>
                </div>
            </div>
            <!--Body-->
            <div class="modal-body" id="myModalDivBody">
            </div>
        </div>
        <!--/.Content-->
    </div>
</div>
<!-- /.Modal-->



<script src="~/Scripts/jquery-3.1.1.min.js"></script>

<script type="text/javascript">


    $(document).ready(function () {
        window.oTable = $("#Jdatatable").DataTable({
            "processing": true, // for show progress bar while loading
            "serverSide": true, // if it is true the preocess is done on server side
            "filter": true, // disables search box
            "info": true,

            "stateSave": true,
            "orderMulti": false, // disable multiple column loading at once
            "ajax": {
                "url": "/SchoolFeePayments/GetStudentPayment",
                "type": "POST",
                "datatype": "json",
                "data": function (d) {
                    d.SchoolProgrammeId = $('#SchoolProgrammeId').val();
                    d.FeeCategoryId = $('#FeeCategoryId').val();
                    d.DepartmentId = $('#DepartmentId').val();
                    d.FacultyId = $('#FacultyId').val();
                    d.SessionId = $('#SessionId').val();
                    d.LevelId = $('#LevelId').val();
                    d.HasPayed = $('#hasPayed').val();
                    d.StartDate = $('#StartDate').val();
                    d.EndDate = $('#EndDate').val();
                    d.StateOfOrigin = $('#StateOfOrigin').val();
                }
            },
            "columns": [
                { "data": "MatricNo", "autoWidth": true },
                { "data": "FullName", "autoWidth": true },
                { "data": "StateOfOrigin", "autoWidth": true },
                { "data": "Lga", "autoWidth": true },
                { "data": "ReferenceNo", "autoWidth": true },
                { "data": "Status", "autoWidth": true },
                //{ "data": "Gender", "autoWidth": true },
                { "data": "ProgrammeName", "autoWidth": true },
                { "data": "LevelName", "autoWidth": true },
                { "data": "PhoneNumber", "autoWidth": true },
                { "data": "PaidFee", "autoWidth": true },
                { "data": "RemainingBalance", "autoWidth": true },
                { "data": "Date", "autoWidth": true },
                {
                    "data": "StudentId",
                    "autoWidth": true,
                    "render": function (data) {
                        return '<a href="#" onclick="Detail(\'' + data + '\')" data-toggle="tooltip" data-placement="top" title="Student Ledger"><i class="fa fa-info-circle" aria-hidden="true">Ledger</i></a>';

                    }
                }

            ],
            responsive: true,
            dom: '<"html5buttons"B>lTfgitp',
            lengthMenu: [
                [10, 25, 50, 100, 200, 500, 1000, 2000, 5000, 10000],
                [10, 25, 50, 100, 200, 500, 1000, 2000, 5000, 10000]
            ],
            buttons: [
                { extend: 'copy' },
                { extend: 'csv' },
                { extend: 'excel', title: 'FacultyList' },
                { extend: 'pdf', title: 'FacultyList' },

                {
					extend: 'collection',
					text: 'Table control',
					buttons: [						
						{
							collectionTitle: 'Visibility control',
							extend: 'colvis'
						}
					]
				},

                {
                    extend: 'print',
                    customize: function (win) {
                        $(win.document.body).addClass('white-bg');
                        $(win.document.body).css('font-size', '10px');

                        $(win.document.body).find('table')
                            .addClass('compact')
                            .css('font-size', 'inherit');
                    }
                }
            ]
        });
    });

    $("#btn-search").click(function () {
        // window.alert("sem:" + $('#SemesterId').val() + " sess:" + $('#SessionId').val());
        window.oTable.ajax.reload();

    });
    $("#btn-dwn").click(function () {
        var url = "/Students/DownloadGraduatePdfReport?SessionName=" + $('#SessionName').val() + "&DepartmentId=" + $('#DepartmentId').val() + "&Indegeneous=" + $('#Indegeneous').val();
        window.open(url, '_blank');

    });
    $("#btn-excel").click(function () {

        var url = "/Students/DownloadGraduateExcelReport?SessionName=" + $('#SessionName').val() + "&DepartmentId=" + $('#DepartmentId').val() + "&Indegeneous=" + $('#Indegeneous').val();
        window.open(url, '_self');
    });

    function Detail(studentId) {
        var url = "/SchoolFeePayments/StudentLedger?studentId=" + studentId;
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });

    };



</script>


