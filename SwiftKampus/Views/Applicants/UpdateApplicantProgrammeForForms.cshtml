
@{
    ViewBag.Title = "UpdateApplicantProgrammeForForms";
    //Layout = "~/Views/Shared/_LayoutWebSite2.cshtml";
}

<h2>UpdateApplicantProgrammeForForms</h2>

<div class="ibox-content">
    <div class="wrapper wrapper-content animated fadeInRight">
        <div class="row">
            <div class="col-lg-12">
                <div class="ibox float-e-margins">
                    <div class="ibox-title">
                        <h2>Change User Email</h2>

                        <div class="ibox-tools">

                            <a class="collapse-link">
                                <i class="fa fa-chevron-up"></i>
                            </a>
                        </div>
                    </div>

                    <h3 class="text-danger">@ViewBag.Message</h3>
                    @using (Html.BeginForm("UpdateApplicantProgrammeForForms", "Applicants", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Get, new { @class = "form", role = "form" }))
                    {
                        @*@Html.AntiForgeryToken()*@
                        <div class="row">
                            <div class="col-md-5">
                                <div class="form-group">
                                    <label>School Programme</label>
                                    @Html.DropDownList("SchoolProgrammeId", (IEnumerable<SelectListItem>)ViewBag.SchoolProgrammeId, "", new { @class = "form-control js-example-basic-single", @style = "width:460px;" })
                                </div>
                            </div>

                            <div class="col-md-1">
                       
                            </div>

                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="Id">Applicant Email</label>
                                    <input id="ApplicantEmail" name="ApplicantEmail" class="form-control" type="text" placeholder="Applicant Email" />
                                </div>
                            </div>

                        </div>
                       

                        <div class="row">
                            <div class="form-group">
                                <div class="col-md-2">
                                    <label for="Id"></label>
                                    <button class="btn btn-primary btn-sm" type="submit">Update Record<span class="icon-more-icon"></span></button>
                                </div>
                            </div>
                        </div>
                    }
                    <br />
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/Scripts/jquery-3.1.1.min.js"></script>
<link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.9/css/select2.min.css" rel="stylesheet" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.9/js/select2.min.js"></script>
<script type="text/javascript">
    jQuery(function ($) {
        //$(".select-add-placeholder").prepend("<option value='' disabled selected>Select an option...</option>");
        $('.js-example-basic-single').select2({
            placeholder: 'Select an option...',
            allowClear: true
        });
    });

    </script>

