@model SwiftKampus.ViewModels.ApplicantVm
@using SwiftKampus.Extensions

@{
    ViewBag.Title = "Edit";
    Layout = null;
    var dateOfBirth = Model.DateOfBirth.ToString("dd/MM/yyyy");

}

<link href="~/AdminTemplate/css/plugins/sweetalert/sweetalert.css" rel="stylesheet">

