
@{
    ViewBag.Title = "Instruction Page";
}

<div class="card">
<div class="card-head style-primary">
    <header>
        <div class="form-header  purple darken-4">
            <h3> INSTRUCTION PAGE </h3>
        </div>

    </header>

</div><!--end .card-head -->
    <div class="card-body">
        <h3>Please Read the Instructions carefully</h3>
        <p>By completing this registration, you agree that all information and documents herein presented are true<br />
            and you accept liability for any discovered misinformation/false documentation</p>
       
        <h3>Please attach all evidence of </h3>
        <ul>
            <li>O level result(s).</li>
            <li>Pre-degree/Original JAMB result(s).</li>
            <li>Post UTME result.</li>
            <li>Certificate of LGA of origin.</li>
            <li>Recent Passport.</li>
        </ul>
        <div style="text-align: center;">
            <a class="btn btn-primary btn-lg" href="@Url.Action("Edit","Applicants")"> Proceed</a>
        </div>
    </div>
</div>

