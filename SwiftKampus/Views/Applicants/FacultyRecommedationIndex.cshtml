@model IEnumerable<SwiftKampusModel.AddmissionApplicant.Applicant>
@using SwiftKampus.Models

<link href="~/AdminTemplate/css/plugins/sweetalert/sweetalert.css" rel="stylesheet">

@{
    ViewBag.Title = "Faculty Applicants Recommendation ";
}

<div class="container-fluid">
    <!-- First row -->
    <div class="row">
        <!-- First column -->
        <div class="col-md-12">

            <div class="wrapper wrapper-content animated fadeInRight">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="ibox float-e-margins">
                            <div class="ibox-title">
                                <h5>List of Applicants</h5>
                                <div class="ibox-tools">
                                    @if (ViewBag.Message != null)
                                    {
                                        <div class="alert alert-success">
                                            <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
                                            <strong>@ViewBag.Message</strong>
                                        </div>
                                    }

                                    <a class="collapse-link">
                                        <i class="fa fa-chevron-up"></i>
                                    </a>
                                    <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                                        <i class="fa fa-wrench"></i>
                                    </a>
                                </div>
                                <div class="ibox-content">
                                    <article class="margin-bottom-xxl">
                                        <p class="lead">
                                            Please use the following parameters to perform Query
                                        </p>
                                    </article>
                                    <div class="card-body">
                                        <div class="col-sm-3">
                                            <div class="form-group">
                                                <label>School Programme</label>
                                                @Html.DropDownList("SchoolProgrammeId", (SelectList)ViewBag.SchoolProgrammeId, new { @class = "form-control" })
                                            </div>
                                        </div>
                                        <div class="row form-inline">
                                            <div class="col-sm-2">
                                                <div class="form-group">
                                                    <label>Session Name</label>
                                                    @Html.DropDownList("SessionId", (SelectList)ViewBag.SessionId, new { @class = "form-control" })
                                                </div>
                                            </div>
                                            <div class="col-md-2">
                                                <div class="form-group">
                                                    <label> Admission Status</label>
                                                    <select class="form-control dropdown" id="IsApproved" name="IsApproved">
                                                        <option value="null">Pending</option>
                                                        <option value="false">Not Recommended</option>
                                                        <option value="true">Recommended</option>
                                                    </select>
                                                </div>
                                            </div>

                                            <div class="col-md-2">
                                                <div class="form-group">
                                                    <label>Processing</label>
                                                    <select class="form-control dropdown" id="IsDownloaded" name="IsDownloaded">
                                                        <option value="false">Not Downloaded</option>
                                                        <option value="true">Is Downloaded</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="col-md-2">
                                                <div class="form-group">
                                                    <label>Approved Status</label>
                                                    <select class="form-control dropdown" id="IsVcApproved" name="IsVcApproved">
                                                        <option value="false">Not Approved</option>
                                                        <option value="true">Approved</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="row col-md-12">
                                                    <div class="col-sm-6">
                                                        <br />
                                                        <button type="submit" id="btn-search" class="btn btn-primary">Search/View</button>
                                                    </div>

                                                </div>
                                                @if (User.IsInRole(RoleName.PGAdmissionOfficer))
                                                {
                                                    <div class="row col-md-12">
                                                        <div class="col-sm-6">
                                                            <br />
                                                            <button type="submit" id="btn-downloadReport" class="btn btn-primary ink-reaction">Download List</button>
                                                        </div>
                                                        <div class="col-sm-6">
                                                            <br />
                                                            <button type="submit" id="btn-ApproveRecommedReport" class="btn btn-warning ink-reaction">Approve List</button>
                                                        </div>
                                                    </div>
                                                }

                                            </div>

                                        </div>
                                    </div><!--end .row -->

                                </div>
                            </div>

                            <div class="ibox-content">
                                <div class="table-responsive">
                                    <table id="Jdatatable" class="table table-striped table-bordered table-hover table-responsive dataTables-example">
                                        <thead>
                                            <tr>
                                                <th> S/N</th>
                                                <th> Form Id</th>
                                                <th> Programme</th>
                                                <th> Full Name</th>
                                                <th> State </th>
                                                <th> LGA </th>
                                                <th> Gender</th>
                                                <th> Dept Status</th>
                                                <th> Faculty Status</th>
                                                <th> Approved</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- /.First row -->
</div>


<!-- Modal -->
<div class="modal fade inmodal" id="actionsList" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <!--Content-->
        <div class="modal-content animated">
            <!--Header-->
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <div class="flex-center">
                    <h4 class="modal-title">UTME APPLICANTS</h4>
                </div>
            </div>
            <!--Body-->
            <div class="modal-body" id="myModalDivBody">
            </div>
        </div>
        <!--/.Content-->
    </div>
</div>
<!-- /.Modal-->

<script src="~/Scripts/jquery-3.1.1.min.js"></script>
<script src="~/AdminTemplate/js/plugins/sweetalert/sweetalert.min.js"></script>

<script type="text/javascript">
    $(document).ready(function () {
        window.oTable = $("#Jdatatable").DataTable({
            "processing": true, // for show progress bar while loading
            "serverSide": true, // if it is true the preocess is done on server side
            "filter": true, // disables search box
            "info": true,

            "stateSave": true,
            "orderMulti": false, // disable multiple column loading at once
            "ajax": {
                "url": "/Applicants/GetFacultyIndex",
                "type": "POST",
                "datatype": "json",
                "data": function (d) {
                    d.SchoolProgrammeId = $('#SchoolProgrammeId').val();
                    d.SessionId = $('#SessionId').val();
                    d.IsApproved = $('#IsApproved').val();
                    d.IsVcApproved = $('#IsVcApproved').val();
                    d.IsDownloaded = $('#IsDownloaded').val();
                }

            },
            "columns": [
                { "data": "Sn", "autoWidth": true, "orderable": true },
                { "data": "ApplicantId", "autoWidth": true, "orderable": true },
                { "data": "ProgrammeName", "autoWidth": true, "orderable": true },
                { "data": "FullName", "autoWidth": true, "orderable": true },
                { "data": "StateOfOrigin", "autoWidth": true },
                { "data": "Lga", "autoWidth": true },
                { "data": "Gender", "autoWidth": true },
                { "data": "Status", "autoWidth": true },
                { "data": "FacultyStatus", "autoWidth": true },
                { "data": "VcStatus", "autoWidth": true },
                {
                    "data": "Email",
                    "autoWidth": true,
                    "render": function (data) {
                        return '<a href="#" onclick="Detail(\'' + data + '\')" data-toggle="tooltip" data-placement="top" title="View Details"><i class="fa fa-info-circle" aria-hidden="true">&nbsp;Details&nbsp;&nbsp;</i></a>';

                    }
                }
            ],
            dom: '<"html5buttons"B>lTfgitp',
            buttons: [
                { extend: 'copy' },
                { extend: 'csv' },
                { extend: 'excel', title: 'FacultyList' },
                { extend: 'pdf', title: 'FacultyList' },

                {
                    extend: 'print',
                    customize: function (win) {
                        $(win.document.body).addClass('white-bg');
                        $(win.document.body).css('font-size', '10px');

                        $(win.document.body).find('table')
                            .addClass('compact')
                            .css('font-size', 'inherit');
                    }
                }
            ]
        });
        window.oTable.fnSort([[1, "asc"], [2, "desc"]]);

    });

    $(window).scroll(function () {
        $("#mydetailBody").stop().animate({ "marginTop": ($(window).scrollTop()) + "px", "marginLeft": ($(window).scrollLeft()) + "px" }, "slow");
    });

    $("#btn-search").click(function () {
        window.oTable.ajax.reload();
    });

    function Detail(applicantId) {
        var url = "/Applicants/ApproveDetails?id=" + applicantId
        window.open(url, '_blank');
    };

    $("#btn-downloadReport").click(function () {
        swal({
            title: "Download Recommeded List",
            text: "Check the Recommeded List and be sure you want to Download Recommeded List for processing?..",
            type: "warning",
            showCancelButton: true,
            confirmButtonColor: "#ab973a",
            confirmButtonText: "Yes, Download Now!",
            cancelButtonText: "No, Pls Cancel!",
            closeOnConfirm: false,
            closeOnCancel: false
        },
            function (isConfirm) {
                if (isConfirm) {
                    swal({
                        title: "Great",
                        text: "You have downloaded the Recommeded List successfully",
                        type: "success",
                    });
                    var url = "/Applicants/DownloadRecommededReport?SessionId=" + $('#SessionId').val();
                    window.open(url, '_blank');
                } else {
                    swal("Oops", "Try again to Recommeded List again", "warning");
                }
            });
    });

    $("#btn-ApproveRecommedReport").click(function () {
        swal({
            title: "Approve Admission",
            text: "Are you sure you want to Approve this Admission?..",
            type: "warning",
            showCancelButton: true,
            confirmButtonColor: "#ab973a",
            confirmButtonText: "Yes, Approve Now!",
            cancelButtonText: "No, Pls Cancel!",
            closeOnConfirm: false,
            closeOnCancel: false
        },
            function (isConfirm) {
                if (isConfirm) {
                    var AllData = {
                        "SessionId": $('#SessionId').val(),
                    };
                    var Mydata = JSON.stringify(AllData);
                    $.ajax({
                        contentType: 'application/json',
                        type: "POST",
                        url: "/Applicants/ApproveDeptAdmission",
                        data: Mydata,
                        success: function (data) {
                            if (data.status) {
                                swal({
                                    title: "Great",
                                    text: data.message,
                                    type: "success",
                                });
                                toastr["success"](data.message);
                            } else {
                                swal({
                                    title: "Warning",
                                    text: data.message,
                                    type: "warning",
                                });
                                toastr["error"](data.message);
                            }
                        }
                    });
                } else {
                    swal("Oops", "Try again to Approve Admission", "warning");
                }
            });
    });
</script>
