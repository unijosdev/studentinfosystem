@model SwiftKampus.ViewModels.StudentBioData.RefereeVm
@using SwiftKampusModel
@using SwiftKampus.Controllers

@{
    ViewBag.Title = "Sponsors";
    Layout = null;
    ApplicantTypeVm ApplicantType = (ApplicantTypeVm)ViewBag.ApplicantType;

}
<link href="~/AdminTemplate/css/plugins/sweetalert/sweetalert.css" rel="stylesheet">

<form id="myform" onsubmit="return false;">

    <div class="row wrapper border-bottom white-bg page-heading">
        <div class="col-lg-10">
            <h2>Add Sponsors @ViewBag.ModeOfEntry</h2>
        </div>
        <div class="col-lg-2">
            <br />
            <span class="col-md-12" input-group-btn col-sm-2">
                <button id="btnRefereeAddMore" type="button" class="btn btn-primary"><i class="fa fa-plus">Add</i></button>
            </span>
        </div>
    </div>

    <div class="wrapper wrapper-content animated fadeInRight">
        <div class="row">
            <div class="col-md-2">
                <div class="com-md-12">
                    <h4 class="text-center">Instruction</h4>
                    @*<ol class="bold">
                            <li>You are only allowed to Add 5 results from <i class="bold italic">Maximum of two sittings</i> </li>
                            <li>Select Exam Type</li>
                            <li>Select Subject(s)</li>
                            <li>Add Grade based on the order of subject selected</li>
                        </ol>*@
                </div>
            </div>
            <div class="col-md-10">
                <div class="ibox float-e-margins">
                    <div class="ibox-content form-horizontal">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        <div class="refereeRepeatable">
                            @if (Model.Referees != null && Model.Referees.Count() > 0)
                            {
                                for (int i = 0; i < Model.Referees.Count(); i++)
                                {
                                    <div class="row">
                                        <div class="col-md-4">
                                            <div class="col-md-12">
                                                <div class="form-group">
                                                    @Html.LabelFor(model => model.Referees[i].LastName)
                                                    @Html.EditorFor(model => model.Referees[i].LastName, new { htmlAttributes = new { @class = "form-control rlastName" } })
                                                    @Html.ValidationMessageFor(model => model.Referees[i].LastName, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="col-md-12">
                                                <div class="form-group">
                                                    @Html.LabelFor(model => model.Referees[i].FirstName)
                                                    @Html.EditorFor(model => model.Referees[i].FirstName, new { htmlAttributes = new { @class = "form-control rfirstName" } })
                                                    @Html.ValidationMessageFor(model => model.Referees[i].FirstName, "", new { @class = "text-danger" })
                                                </div>

                                            </div>
                                        </div>


                                        <div class="col-md-4">
                                            <div class="col-md-12">
                                                <div class="form-group">
                                                    @Html.LabelFor(model => model.Referees[i].Address)
                                                    @Html.EditorFor(model => model.Referees[i].Address, new { htmlAttributes = new { @class = "form-control raddress" } })
                                                    @Html.ValidationMessageFor(model => model.Referees[i].Address, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="col-md-12">
                                                <div class="form-group">
                                                    @Html.LabelFor(model => model.Referees[i].Email)
                                                    @Html.EditorFor(model => model.Referees[i].Email, new { htmlAttributes = new { @class = "form-control remail" } })
                                                    @Html.ValidationMessageFor(model => model.Referees[i].Email, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="col-md-12">
                                                <div class="form-group">
                                                    @Html.LabelFor(model => model.Referees[i].PhoneNumber)
                                                    @Html.EditorFor(model => model.Referees[i].PhoneNumber, new { htmlAttributes = new { @class = "form-control rphoneNumber" } })
                                                    @Html.ValidationMessageFor(model => model.Referees[i].PhoneNumber, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="col-md-12">
                                                <div class="form-group">
                                                    @Html.LabelFor(model => model.Referees[i].Relationship)
                                                    @Html.EditorFor(model => model.Referees[i].Relationship, new { htmlAttributes = new { @class = "form-control rrelationship" } })
                                                    @Html.ValidationMessageFor(model => model.Referees[i].Relationship, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>
                                        <span class="col-md-12" onclick="remove_Refereebutton(this)" input-group-btn col-sm-2">
                                            <button type="button" class="btn btn-primary"><i class="fa fa-minus"></i></button>
                                        </span>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="col-md-12">
                                            <div class="form-group">
                                                @Html.LabelFor(model => model.Referee.LastName)
                                                @Html.EditorFor(model => model.Referee.LastName, new { htmlAttributes = new { @class = "form-control rlastName" } })
                                                @Html.ValidationMessageFor(model => model.Referee.LastName, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="col-md-12">
                                            <div class="form-group">
                                                @Html.LabelFor(model => model.Referee.FirstName)
                                                @Html.EditorFor(model => model.Referee.FirstName, new { htmlAttributes = new { @class = "form-control rfirstName" } })
                                                @Html.ValidationMessageFor(model => model.Referee.FirstName, "", new { @class = "text-danger" })
                                            </div>

                                        </div>
                                    </div>


                                    <div class="col-md-4">
                                        <div class="col-md-12">
                                            <div class="form-group">
                                                @Html.LabelFor(model => model.Referee.Address)
                                                @Html.EditorFor(model => model.Referee.Address, new { htmlAttributes = new { @class = "form-control raddress" } })
                                                @Html.ValidationMessageFor(model => model.Referee.Address, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="col-md-12">
                                            <div class="form-group">
                                                @Html.LabelFor(model => model.Referee.Email)
                                                @Html.EditorFor(model => model.Referee.Email, new { htmlAttributes = new { @class = "form-control remail" } })
                                                @Html.ValidationMessageFor(model => model.Referee.Email, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="col-md-12">
                                            <div class="form-group">
                                                @Html.LabelFor(model => model.Referee.PhoneNumber)
                                                @Html.EditorFor(model => model.Referee.PhoneNumber, new { htmlAttributes = new { @class = "form-control rphoneNumber" } })
                                                @Html.ValidationMessageFor(model => model.Referee.PhoneNumber, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="col-md-12">
                                            <div class="form-group">
                                                @Html.LabelFor(model => model.Referee.Relationship)
                                                @Html.EditorFor(model => model.Referee.Relationship, new { htmlAttributes = new { @class = "form-control rrelationship" } })
                                                @Html.ValidationMessageFor(model => model.Referee.Relationship, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                    <span class="col-md-12" onclick="remove_Refereebutton(this)" input-group-btn col-sm-2">
                                        <button type="button" class="btn btn-primary">Remove</button>
                                    </span>
                                </div>
                            }

                        </div>

                        <br />
                        <div class="form-group">
                            <div class="col-md-10">
                                <input type="submit" id="btnSaveRef" value="SAVE AND CONTINUE" class="btn btn-primary block btn-lg" />
                            </div>
                        </div>
                    </div>
                    <br />
                    <div class="col-md-12">
                        <a id="btnSrefereePrevious" href="#" class="btn btn-warning btn-lg btnPrevious" data-dismiss="modal">PREVIOUS</a>
                        @if (ViewBag.ModeOfEntry == "DE")
                        {
                            <a id="btnSrefereeNextDE" href="#" class="btn btn-warning btn-lg btnNext" data-dismiss="modal">NEXT</a>
                        }
                        else if (ViewBag.ModeOfEntry == "UTME")
                        {
                            <a id="btnSrefereeNextUTME" href="#" class="btn btn-warning btn-lg btnNext" data-dismiss="modal">NEXT</a>
                        }
                        else
                        {
                            <a id="btnSrefereeNext" href="#" class="btn btn-warning btn-lg btnNext" data-dismiss="modal">FINISH</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

</form>

<script src="~/Scripts/jquery-3.3.1.min.js"></script>
<script src="~/AdminTemplate/js/plugins/sweetalert/sweetalert.min.js"></script>
<script>

    var modeOfEntry = '@ViewBag.ModeOfEntry';
    var count = 1;

    $(document).ready(function () {

        $('#btnRefereeAddMore').click(function () {
            if (count < 5) {
                var new_field = `<div class="row"> <div class="hr-line-dashed"></div>
                                <div class="col-md-4">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.Referee.LastName)
                                            @Html.EditorFor(model => model.Referee.LastName, new { htmlAttributes = new { @class = "form-control rlastName" } })
                                            @Html.ValidationMessageFor(model => model.Referee.LastName, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.Referee.FirstName)
                                            @Html.EditorFor(model => model.Referee.FirstName, new { htmlAttributes = new { @class = "form-control rfirstName" } })
                                            @Html.ValidationMessageFor(model => model.Referee.FirstName, "", new { @class = "text-danger" })
                                        </div>

                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.Referee.Address)
                                            @Html.EditorFor(model => model.Referee.Address, new { htmlAttributes = new { @class = "form-control raddress" } })
                                            @Html.ValidationMessageFor(model => model.Referee.Address, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.Referee.Email)
                                            @Html.EditorFor(model => model.Referee.Email, new { htmlAttributes = new { @class = "form-control remail" } })
                                            @Html.ValidationMessageFor(model => model.Referee.Email, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.Referee.PhoneNumber)
                                            @Html.EditorFor(model => model.Referee.PhoneNumber, new { htmlAttributes = new { @class = "form-control rphoneNumber" } })
                                            @Html.ValidationMessageFor(model => model.Referee.PhoneNumber, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.Referee.Relationship)
                                            @Html.EditorFor(model => model.Referee.Relationship, new { htmlAttributes = new { @class = "form-control rrelationship" } })
                                            @Html.ValidationMessageFor(model => model.Referee.Relationship, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                            <span class="col-md-12" onclick="remove_Refereebutton(this)" input-group-btn col-sm-2">
                                <button type="button" class="btn btn-primary">Remove</button>
                            </span>
                            </div>

                        </div>`;
                $('.refereeRepeatable').append(new_field);
                count++;
            }
            else
            {
                swal({
                    title: "Warning",
                    text: "Maximum number of fields exceeded!",
                    type: "warning",
                });            }
        });

        $('#btnSaveRef').click(function () {
            var lastName = [];
            var firstName = [];
            var address = [];
            var email = [];
            var phoneNumber = [];
            var relationship = [];
            var emplymentDetailList = [];

            //pulling the form data using the class and adding it to a list
            $.each($('.rlastName'), function () {
                lastName.push($(this).val());
            });

            $.each($('.rfirstName'), function () {
                firstName.push($(this).val());
            });
            $.each($('.raddress'), function () {
                address.push($(this).val());
            });
            $.each($('.remail'), function () {
                email.push($(this).val());
            });

            $.each($('.rphoneNumber'), function () {
                phoneNumber.push($(this).val());
            });

            $.each($('.rrelationship'), function () {
                relationship.push($(this).val());
            });

            //append to list for c# in controller
            for (var i = 0; i < lastName.length; i++) {
                var data = {
                    "LastName": lastName[i],
                    "FirstName": firstName[i],
                    "Address": address[i],
                    "Email": email[i],
                    "PhoneNumber": phoneNumber[i],
                    "Relationship": relationship[i]
                };
                emplymentDetailList.push(data);
            }

            var Mydata = JSON.stringify(emplymentDetailList);

            $.ajax({
                contentType: 'application/json',
                type: "POST",
                url: "/Referees/UGCreate",
                data: Mydata,
                success: function (data) {
                    if (data.status) {
                        swal({
                            title: "Referee saved successfully",
                            //text: "Do you  Proceed?..",
                            type: "warning",
                            showCancelButton: true,
                            confirmButtonColor: "#ab973a",
                            confirmButtonText: "Proceed!",
                            //cancelButtonText: "No, See Result List!",
                            closeOnConfirm: false,
                            closeOnCancel: false
                        },
                            function (isConfirm) {
                                if (isConfirm) {
                                    swal("Great!", "Proceed!!!.", "success");
                                    //goNextRef();
                                    if (modeOfEntry == 'UTME') {
                                        $("#admissionLetter").click();
                                    }
                                    else if (modeOfEntry == 'DE') {
                                            $("#deexam").click();
                                    }
                                    else {
                                         window.open('@Url.Action("StudentFullDetail", "Students")', '_self');
                                    }

                                } else {
                                    swal("Great", "You can click the next button to proceed", "success");
                                    //window.open('@Url.Action("Index", "ApplicantOLevelResults")', '_self');

                                }
                            });
                        toastr["success"](data.message);
                    } else {
                        swal({
                            title: "Warning",
                            text: data.message,
                            type: "warning",
                        });
                        toastr["success"](data.message);
                    }

                }
            });
        });

    });

    function remove_Refereebutton(elem) {
        $(elem).closest('div').remove();
    }

    function goNextRef() {
        var check = '@ViewBag.Status2';
        if (check === 'PHD') {
            $("#thesis").click();
        } else if (check === 'MSC') {
            $("#uploaddocument").click();
        }

    }

    $("#btnSrefereeNextDE").click(function () {
        $("#deexam").click();
    });

    $("#btnSrefereeNextUTME").click(function () {
        $("#admissionLetter").click();
    });
        
    $("#btnSrefereeNext").click(function () {
        window.open('@Url.Action("StudentFullDetail", "Students")', '_self');
    });

    $("#btnSrefereePrevious").click(function () {
        $("#address").click();
    });


</script>