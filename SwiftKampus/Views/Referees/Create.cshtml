@model SwiftKampusModel.Referee

@{
    ViewBag.Title = "Referee";
}
<link href="~/AdminTemplate/css/plugins/sweetalert/sweetalert.css" rel="stylesheet">

<form id="myform" onsubmit="return false;">

    <div class="row wrapper border-bottom white-bg page-heading">
        <div class="col-lg-10">
            <h2>Add Referee</h2>
        </div>
        <div class="col-lg-2">

        </div>
    </div>

    <div class="wrapper wrapper-content animated fadeInRight">
        <div class="row">
            <div class="col-md-2">
                <div class="com-md-12">
                    <h4 class="text-center">Instruction</h4>
                    @*<ol class="bold">
                            <li>You are only allowed to Add 5 results from <i class="bold italic">Maximum of two sittings</i> </li>
                            <li>Select Exam Type</li>
                            <li>Select Subject(s)</li>
                            <li>Add Grade based on the order of subject selected</li>
                        </ol>*@
                </div>
            </div>
            <div class="col-md-10">
                <div class="ibox float-e-margins">
                    <div class="ibox-content form-horizontal">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        <div class="repeatable">
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.LastName)
                                            @Html.EditorFor(model => model.LastName, new { htmlAttributes = new { @class = "form-control lastName" } })
                                            @Html.ValidationMessageFor(model => model.LastName, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.FirstName)
                                            @Html.EditorFor(model => model.FirstName, new { htmlAttributes = new { @class = "form-control firstName" } })
                                            @Html.ValidationMessageFor(model => model.FirstName, "", new { @class = "text-danger" })
                                        </div>

                                    </div>
                                </div>


                                <div class="col-md-4">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.Address)
                                            @Html.EditorFor(model => model.Address, new { htmlAttributes = new { @class = "form-control address" } })
                                            @Html.ValidationMessageFor(model => model.Address, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.Email)
                                            @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control email" } })
                                            @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.PhoneNumber)
                                            @Html.EditorFor(model => model.PhoneNumber, new { htmlAttributes = new { @class = "form-control phoneNumber" } })
                                            @Html.ValidationMessageFor(model => model.PhoneNumber, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.Relationship)
                                            @Html.EditorFor(model => model.Relationship, new { htmlAttributes = new { @class = "form-control relationship" } })
                                            @Html.ValidationMessageFor(model => model.Relationship, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>

                                <span class="col-md-12" input-group-btn col-sm-2">
                                    <button id="btnAddMore" type="button" class="btn btn-primary"><i class="fa fa-plus"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="hr-line-dashed"></div>
                    <div class="form-group">
                        <div class="col-md-offset-2 col-md-10">
                            <input type="submit" id="btnSave" value="Add Referee/Sponsor" class="btn btn-primary btn-lg" />

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</form>

<script src="~/Scripts/jquery-3.3.1.min.js"></script>
<script src="~/AdminTemplate/js/plugins/sweetalert/sweetalert.min.js"></script>
<script>
    var count = 1;
    $(document).ready(function () {

        $('#btnAddMore').click(function () {
            if (count < 3) {
                var new_field = ` <div class="row">
                                <div class="col-md-4">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.LastName)
                                            @Html.EditorFor(model => model.LastName, new { htmlAttributes = new { @class = "form-control lastName" } })
                                            @Html.ValidationMessageFor(model => model.LastName, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.FirstName)
                                            @Html.EditorFor(model => model.FirstName, new { htmlAttributes = new { @class = "form-control firstName" } })
                                            @Html.ValidationMessageFor(model => model.FirstName, "", new { @class = "text-danger" })
                                        </div>

                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.Address)
                                            @Html.EditorFor(model => model.Address, new { htmlAttributes = new { @class = "form-control address" } })
                                            @Html.ValidationMessageFor(model => model.Address, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.Email)
                                            @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control email" } })
                                            @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.PhoneNumber)
                                            @Html.EditorFor(model => model.PhoneNumber, new { htmlAttributes = new { @class = "form-control phoneNumber" } })
                                            @Html.ValidationMessageFor(model => model.PhoneNumber, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.Relationship)
                                            @Html.EditorFor(model => model.Relationship, new { htmlAttributes = new { @class = "form-control relationship" } })
                                            @Html.ValidationMessageFor(model => model.Relationship, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                            <span class="col-md-12" onclick="remove_button(this)" input-group-btn col-sm-2">
                                <button type="button" class="btn btn-primary"><i class="fa fa-minus"></i></button>
                            </span>
                            </div>

                        </div>`;
                $('.repeatable').append(new_field);
                count++;
            }
            else
            {
                swal({
                    title: "Warning",
                    text: "Maximum number of fields exceeded!",
                    type: "warning",
                });            }
        });

        $('#btnSave').click(function () {
            var lastName = [];
            var firstName = [];
            var address = [];
            var email = [];
            var phoneNumber = [];
            var relationship = [];
            var emplymentDetailList = [];

            //pulling the form data using the class and adding it to a list
            $.each($('.lastName'), function () {
                lastName.push($(this).val());
            });

            $.each($('.firstName'), function () {
                firstName.push($(this).val());
            });
            $.each($('.address'), function () {
                address.push($(this).val());
            });
            $.each($('.email'), function () {
                email.push($(this).val());
            });

            $.each($('.phoneNumber'), function () {
                phoneNumber.push($(this).val());
            });

            $.each($('.relationship'), function () {
                relationship.push($(this).val());
            });

            //////validation
            ////if (subjectid.length == 0 || subjectgrade.length == 0) {
            ////    alert("Invalid selection!");
            ////}
            ////else {

            ////}
            //append to list for c# in controller
            for (var i = 0; i < lastName.length; i++) {
                var data = {
                    "LastName": lastName[i],
                    "FirstName": firstName[i],
                    "Address": address[i],
                    "Email": email[i],
                    "PhoneNumber": phoneNumber[i],
                    "Relationship": relationship[i]
                };
                emplymentDetailList.push(data);
            }
            //var AllData = {
            //    //"ResultName": $('#ResultName').val(),
            //    //"ExaminationCenter": $('#ExaminationCenter').val(),
            //    //"Year": $('#Year').val(),
            //    "SubjectGrades": subjectgradelist
            //};


            var Mydata = JSON.stringify(emplymentDetailList);
            alert(Mydata);


            $.ajax({
               // type: "POST",
               // contentType: 'application/json',
               // url: "/ApplicantOLevelResults/Create",
               //// data: JSON.stringify(AllData),
                //data: AllData,
                contentType: 'application/json',
                type: "POST",
                url: "/Referees/Create",
                data: Mydata,
                success: function (data) {
                    if (data.status) {
                        swal({
                            title: "Good Job!!!",
                            text: "Did you want to add More Result?..",
                            type: "warning",
                            showCancelButton: true,
                            confirmButtonColor: "#ab973a",
                            confirmButtonText: "Yes, Add More it!",
                            cancelButtonText: "No, See Result List!",
                            closeOnConfirm: false,
                            closeOnCancel: false
                        },
                            function (isConfirm) {
                                if (isConfirm) {
                                    swal("Great!", "You can now add more.", "success");
                                } else {
                                    swal("Great", "You can now see your result list", "success");
                                    window.open('@Url.Action("Index", "Referees")', '_self');

                                }
                            });
                        toastr["success"](data.message);
                    } else {
                        swal({
                            title: "Warning",
                            text: data.message,
                            type: "warning",
                        });
                        toastr["success"](data.message);
                    }

                }
            });
        });

    });

    function remove_button(elem) {
        if (count > 1) {
            $(elem).closest('div').remove();
            count--;
        }
    }




</script>