@model SwiftKampus.ViewModels.StudentBioData.RefereeVm
@using SwiftKampusModel
@using SwiftKampus.Controllers

@{
    ViewBag.Title = "Referee";
    Layout = null;
    ApplicantTypeVm ApplicantType = (ApplicantTypeVm)ViewBag.ApplicantType;
}
<link href="~/AdminTemplate/css/plugins/sweetalert/sweetalert.css" rel="stylesheet">

<form id="myform" class="form-horizontal" onsubmit="return false;">

    <div class="ibox float-e-margins">
        <div class="row">
            <div class="col-md-12">
                <div class="wrapper border-bottom white-bg page-heading">
                    <div class="row">
                        <div class="col-md-6">
                            <h2>Add Referee</h2>
                        </div>
                        <div class="col-md-6">
                            <h2>
                                <button id="btnRefereeAddMore" type="button" class="btn btn-primary pull-right"><i class="fa fa-plus"></i> Add</button>
                            </h2>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <div class="row ibox-content">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <div class="refereeRepeatable">
                        @if (Model.Referees != null && Model.Referees.Count() > 0)
                        {
                            for (int i = 0; i < Model.Referees.Count(); i++)
                            {
                        <div class="row">
                            <div class="col-md-4">
                                <div class="col-md-12">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.Referees[0].LastName)
                                        @Html.EditorFor(model => model.Referees[0].LastName, new { htmlAttributes = new { @class = "form-control rlastName", @placeholder = "Enter Last Name" } })
                                        @Html.ValidationMessageFor(model => model.Referees[0].LastName, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="col-md-12">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.Referees[0].FirstName)
                                        @Html.EditorFor(model => model.Referees[0].FirstName, new { htmlAttributes = new { @class = "form-control rfirstName", @placeholder = "Enter First Name" } })
                                        @Html.ValidationMessageFor(model => model.Referees[0].FirstName, "", new { @class = "text-danger" })
                                    </div>

                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="col-md-12">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.Referees[0].Address)
                                        @Html.EditorFor(model => model.Referees[0].Address, new { htmlAttributes = new { @class = "form-control raddress", @placeholder = "Enter Address" } })
                                        @Html.ValidationMessageFor(model => model.Referees[0].Address, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="col-md-12">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.Referees[0].Email)
                                        @Html.EditorFor(model => model.Referees[0].Email, new { htmlAttributes = new { @class = "form-control remail", @placeholder = "Enter Email" } })
                                        @*@Html.ValidationMessageFor(model => model.Referees[0].Email, "", new { @class = "text-danger" })*@
                                        <span class="refereeEmailValidate" style="color:red"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="col-md-12">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.Referees[0].PhoneNumber)
                                        @Html.EditorFor(model => model.Referees[0].PhoneNumber, new { htmlAttributes = new { @class = "form-control rphoneNumber", @placeholder = "Enter Phone Number" } })
                                        @Html.ValidationMessageFor(model => model.Referees[0].PhoneNumber, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="col-md-12">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.Referees[0].Relationship)
                                        @Html.EditorFor(model => model.Referees[0].Relationship, new { htmlAttributes = new { @class = "form-control rrelationship", @placeholder = "Enter Relationship Status" } })
                                        @*@Html.ValidationMessageFor(model => model.Referees[0].Relationship, "", new { @class = "text-danger" })*@
                                        <span class="validateRelationship" style="color:red"></span>
                                    </div>
                                </div>
                            </div>
                            <span class="col-sm-2" onclick="remove_Refereebutton(this)" input-group-btn col-sm-2">
                                <button type="button" class="btn btn-primary"><i class="fa fa-minus"></i></button>
                            </span>
                        </div>
                            }
                        }
                        else
                        {
                        <div class="row">
                            <div class="col-md-4">
                                <div class="col-md-12">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.Referee.LastName)
                                        @Html.EditorFor(model => model.Referee.LastName, new { htmlAttributes = new { @class = "form-control rlastName", @placeholder = "Enter Last Name" } })
                                        @Html.ValidationMessageFor(model => model.Referee.LastName, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="col-md-12">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.Referee.FirstName)
                                        @Html.EditorFor(model => model.Referee.FirstName, new { htmlAttributes = new { @class = "form-control rfirstName", @placeholder = "Enter First Name" } })
                                        @Html.ValidationMessageFor(model => model.Referee.FirstName, "", new { @class = "text-danger" })
                                    </div>

                                </div>
                            </div>


                            <div class="col-md-4">
                                <div class="col-md-12">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.Referee.Address)
                                        @Html.EditorFor(model => model.Referee.Address, new { htmlAttributes = new { @class = "form-control raddress", @placeholder = "Enter Address" } })
                                        @Html.ValidationMessageFor(model => model.Referee.Address, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="col-md-12">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.Referee.Email)
                                        @Html.EditorFor(model => model.Referee.Email, new { htmlAttributes = new { @class = "form-control remail", @placeholder = "Enter Email" } })
                                        @*@Html.ValidationMessageFor(model => model.Referee.Email, "", new { @class = "text-danger" })*@
                                        <span class="refereeEmailValidate" style="color:red"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="col-md-12">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.Referee.PhoneNumber)
                                        @Html.EditorFor(model => model.Referee.PhoneNumber, new { htmlAttributes = new { @class = "form-control rphoneNumber", @placeholder = "Enter Phone Number" } })
                                        @Html.ValidationMessageFor(model => model.Referee.PhoneNumber, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="col-md-12">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.Referee.Relationship)
                                        @Html.EditorFor(model => model.Referee.Relationship, new { htmlAttributes = new { @class = "form-control rrelationship", @placeholder = "Enter Relationship Status" } })
                                        @*@Html.ValidationMessageFor(model => model.Referee.Relationship, "", new { @class = "text-danger" })*@
                                        <span class="validateRelationship" style="color:red"></span>
                                    </div>
                                </div>
                            </div>
                            @*<span class="col-md-12" onclick="remove_Refereebutton(this)" input-group-btn col-sm-2">
                                    <button type="button" class="btn btn-primary">Remove</button>
                                </span>*@
                        </div>
                        }

                    </div>

                    <br />
                    <div class="form-group">
                        <div class="col-md-6">

                        </div>
                        <div class="col-md-6 pull-right">
                            <span class="pull-right">
                                <input type="submit" id="btnSaveRef" value="SAVE AND CONTINUE" class="btn btn-primary block btn-sm" />
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            @*Get the program type of the applicant*@
        <div class="col-md-12">
            <a id="btnrefereePrevious" href="#" class="btn btn-warning btn-lg btnPrevious" data-dismiss="modal">PREVIOUS</a>

            @if (ApplicantType.ApplicantType.Equals(ProgrammeCategory.Masters.ToString()) ||
                        ApplicantType.ApplicantType.Equals(ProgrammeCategory.MBA.ToString()) ||
                        ApplicantType.ApplicantType.Equals(ProgrammeCategory.Post_Graduate.ToString()))
            {
                ViewBag.Status = "PG";
            }

            @if (ApplicantType.ApplicantType.Equals(ProgrammeCategory.Phd.ToString()))
            {
                ViewBag.Status = "PHD";
            }

            @if (ApplicantType.ApplicantType.Equals(ProgrammeCategory.IJMB.ToString()))
            {
                ViewBag.Status = "IJMB";

            }
            @if (ApplicantType.ApplicantType.Equals(ProgrammeCategory.Remedial_Science.ToString()) ||
                ApplicantType.ApplicantType.Equals(ProgrammeCategory.Preliminary_French.ToString()) ||
                ApplicantType.ApplicantType.Equals(ProgrammeCategory.Institute_Of_Education.ToString()) ||
                ApplicantType.ApplicantType.Equals(ProgrammeCategory.Diploma.ToString()))
            {
                ViewBag.Status = "PRE";
            }

            @if (ApplicantType.ApplicantType.Equals(ProgrammeCategory.UnderGraduate.ToString()) &&
                ApplicantType.TimeType.Equals(ProgrammeType.Part_Time.ToString()))
            {
            }

        </div>
        </div>
    </div>
</form>

<script src="~/Scripts/jquery-3.3.1.min.js"></script>
<script src="~/AdminTemplate/js/plugins/sweetalert/sweetalert.min.js"></script>
<script>
    var count = 3;
    $(document).ready(function () {
        $('#btnRefereeAddMore').click(function () {
            if (count < 3) {
                var new_field = `<div class="row"> <div class="hr-line-dashed"></div>
                                <div class="col-md-4">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.Referee.LastName)
                                            @Html.EditorFor(model => model.Referee.LastName, new { htmlAttributes = new { @class = "form-control rlastName", @placeholder ="Enter Last Name" } })
                                            @Html.ValidationMessageFor(model => model.Referee.LastName, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.Referee.FirstName)
                                            @Html.EditorFor(model => model.Referee.FirstName, new { htmlAttributes = new { @class = "form-control rfirstName", @placeholder ="Enter First Name" } })
                                            @Html.ValidationMessageFor(model => model.Referee.FirstName, "", new { @class = "text-danger" })
                                        </div>

                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.Referee.Address)
                                            @Html.EditorFor(model => model.Referee.Address, new { htmlAttributes = new { @class = "form-control raddress", @placeholder ="Enter Address" } })
                                            @Html.ValidationMessageFor(model => model.Referee.Address, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.Referee.Email)
                                            @Html.EditorFor(model => model.Referee.Email, new { htmlAttributes = new { @class = "form-control remail", @placeholder ="Enter Email" } })
                                            @*@Html.ValidationMessageFor(model => model.Referee.Email, "", new { @class = "text-danger" })*@
                                            <span class="refereeEmailValidate" style="color:red"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.Referee.PhoneNumber)
                                            @Html.EditorFor(model => model.Referee.PhoneNumber, new { htmlAttributes = new { @class = "form-control rphoneNumber", @placeholder ="Enter Email" } })
                                            @Html.ValidationMessageFor(model => model.Referee.PhoneNumber, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.Referee.Relationship)
                                            @Html.EditorFor(model => model.Referee.Relationship, new { htmlAttributes = new { @class = "form-control rrelationship", @placeholder ="Enter Relationship Status" } })
                                            @*@Html.ValidationMessageFor(model => model.Referee.Relationship, "", new { @class = "text-danger" })*@
                                            <span class="validateRelationship" style="color:red"></span>
                                        </div>
                                    </div>
                                </div>
                            <span class="col-sm-2" onclick="remove_Refereebutton(this)" input-group-btn col-sm-2">
                                <button type="button" class="btn btn-primary"><i class="fa fa-minus"></i> Remove</button>
                            </span>
                            </div>

                        </div>`;
                $('.refereeRepeatable').append(new_field);
                count++;
            }
            else
            {
                swal({
                    title: "Warning",
                    text: "Maximum number of fields exceeded!",
                    type: "warning",
                });            }
        });

        $('#btnSaveRef').click(function () {
            var lastName = [];
            var firstName = [];
            var address = [];
            var email = [];
            var phoneNumber = [];
            var relationship = [];
            var refereeDetailList = [];

            // Validate the data entered in the form
            var refereeEmail = $('#Referees_0__Email').val();
            var refereeRelationship = $('.rrelationship').val();

            if (refereeEmail == "") {
                $('.refereeEmailValidate').html("Referee email is required");
            }
            

            //pulling the form data using the class and adding it to a list
            $.each($('.rlastName'), function () {
                lastName.push($(this).val());
            });

            $.each($('.rfirstName'), function () {
                firstName.push($(this).val());
            });
            $.each($('.raddress'), function () {
                address.push($(this).val());
            });
            $.each($('.remail'), function () {
                email.push($(this).val());
            });

            $.each($('.rphoneNumber'), function () {
                phoneNumber.push($(this).val());
            });

            $.each($('.rrelationship'), function () {
                relationship.push($(this).val());
            });

            //append to list for c# in controller
            for (var i = 0; i < lastName.length; i++) {
                var data = {
                    "LastName": lastName[i],
                    "FirstName": firstName[i],
                    "Address": address[i],
                    "Email": email[i],
                    "PhoneNumber": phoneNumber[i],
                    "Relationship": relationship[i]
                };
                refereeDetailList.push(data);
            }

            var Mydata = JSON.stringify(refereeDetailList);

            if (refereeRelationship !== "") {

                $.ajax({
                    contentType: 'application/json',
                    type: "POST",
                    url: "/Referees/PCreate",
                    data: Mydata,
                    success: function (data) {
                        if (data.status) {
                            swal({
                                title: "Referee saved successfully",
                                //text: "Do you  Proceed?..",
                                type: "warning",
                                showCancelButton: true,
                                confirmButtonColor: "#ab973a",
                                confirmButtonText: "Proceed!",
                                //cancelButtonText: "No, See Result List!",
                                closeOnConfirm: false,
                                closeOnCancel: false
                            },
                                function (isConfirm) {
                                    if (isConfirm) {
                                        swal("Great!", "Proceed!!!.", "success");
                                        goNextRef();
                                    } else {
                                        swal("Great", "You can click the next button to proceed", "success");
                                        //window.open('@Url.Action("Index", "ApplicantOLevelResults")', '_self');

                                    }
                                });
                            toastr["success"](data.message);
                        } else {
                            swal({
                                title: "Warning",
                                text: data.message,
                                type: "warning",
                            });
                            toastr["success"](data.message);
                        }

                    }
                });
            }
            else if (refereeRelationship == "") {
                $('.validateRelationship').html("Referee relationship is required");
            }
        });

    });

    function remove_Refereebutton(elem) {
        $(elem).closest('div').remove();
    }

    function goNextRef() {
        var check = '@ViewBag.Status';
        var isStudent = $('#isStudent').val();

        if ((check === 'PG' || check === 'PHD') && isStudent != 'Student') {
            $("#aqualification").click();
        }
        else if (check === 'PG' && isStudent === 'Student') {
            $("#uploaddocument").click();
        }
        else if (check === 'PHD' && isStudent === 'Student') {
            $("#thesis").click();
        }
    }

    $("#btnrefereeNext").click(function () {
        $("#uploaddocument").click();
    });

    $("#btnrefereeNext2").click(function () {
        $("#thesis").click();
    });

    $("#btnrefereePrevious").click(function () {
        $("#employment").click();
    });


</script>