@model IEnumerable<SwiftKampusModel.Course>

@{
    ViewBag.Title = "Prerequisite Course List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>List of Pre-Requisite Courses</h5>
                    <div class="ibox-tools">
                        <a href="#" onclick="myFunction()" class="btn btn-primary"><i class="fa fa-plus left"></i> ADD PREREQUISITE COURSE</a>
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                        <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                            <i class="fa fa-wrench"></i>
                        </a>

                    </div>
                    <div class="ibox-content">
                        <article class="margin-bottom-xxl">
                            <p class="lead">
                                Please use the following parameters to perform Query
                            </p>
                        </article>
                        <div class="card-body">
                            <form class="form-inline" id="formFilter" onsubmit="return false;">
                                <div class="row">
                                    <div class="col-md-5">
                                        <div class="form-group">
                                            <label>Department Option</label>
                                            @Html.DropDownList("ProgrammeId", (SelectList)ViewBag.DepartmentId, "", new { @class = "form-control" })
                                        </div>
                                    </div>
                                    <div class="col-md-1">
                                        <div class="form-group">
                                            <label for="LevelId">Level Name</label>
                                            @Html.DropDownList("LevelId", (SelectList)ViewBag.LevelId, "", new { @class = "form-control" })
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="form-group">
                                            <label>Semester Name</label>
                                            @Html.DropDownList("SemesterId", (SelectList)ViewBag.SemesterId, "", new { @class = "form-control" })
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="form-group">
                                            <label>Student Type</label>
                                            @Html.DropDownList("SchoolProgrammeId", (SelectList)ViewBag.SchoolProgrammeId, "", new { @class = "form-control" })
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <br />
                                        &nbsp; &nbsp;
                                        <button type="submit" id="btn-search" class="btn btn-primary">Search/View</button>
                                    </div>
                                </div>

                            </form>
                        </div><!--end .row -->

                    </div>
                </div>
                <div class="ibox-content">

                    <div class="table-responsive">
                        <table id="Jdatatable" class="table table-striped table-bordered table-hover table-responsive dataTables-example">
                            <thead>
                                <tr>
                                    <th>Dept Option</th>
                                    <th>Course Code</th>
                                    <th>Course Name</th>
                                    <th>Course Type</th>
                                    <th>Course Credit</th>
                                    <th>Level</th>
                                    <th>Semester</th>
                                    <th>Pre-Requisites</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                        </table>

                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/Scripts/jquery-1.11.3.min.js"></script>

<script type="text/javascript">
    $(document).ready(function () {

        var error = "@ViewBag.Error";
        var message = "@ViewBag.Message";
        var success = "@ViewBag.Success";
        if (error || message) {
            toastr["error"](error);
            toastr["error"](message);
        }
        if (success) {
            toastr["success"](success);
        }

        window.oTable = $("#Jdatatable").DataTable({
            "processing": true, // for show progress bar while loading
            "serverSide": true, // if it is true the preocess is done on server side
            "filter": true, // disables search box
            "info": true,

            "stateSave": true,
            "orderMulti": false, // disable multiple column loading at once
            "ajax": {
                "url": "/CoursePrerequisites/GetIndex",
                "type": "POST",
                "datatype": "json",
                "data": function (d) {
                    d.LevelId = $('#LevelId').val();
                    d.SchoolProgrammeId = $('#SchoolProgrammeId').val();
                    d.SemesterId = $('#SemesterId').val();
                    d.ProgrammeId = $('#ProgrammeId').val();
                }

            },
            "columns": [
                { "data": "ProgrammeName", "autoWidth": true },
                { "data": "CourseCode", "autoWidth": true },
                { "data": "CourseName", "autoWidth": true },
                { "data": "CourseType", "autoWidth": true },
                { "data": "Credits", "autoWidth": true },
                { "data": "LevelName", "autoWidth": true },
                { "data": "SemesterName", "autoWidth": true },
                { "data": "PrerequisiteCourse", "autoWidth": true },
                {
                    "data": "PrerequisiteCourse",
                    "autoWidth": true,
                    "render": function (data) {
                        return '<a href="#" onclick="myFunction()">  <i class="fa fa-pencil" aria-hidden="true" >&nbsp;Edit</i></a>&nbsp;&nbsp;';
                            //'<a href="#" class="text-danger" onclick="Delete(' + data + ')" ><i class="fa fa-remove" aria-hidden="true" >&nbsp;Remove<i /></a>';
                    }
                }
            ],
            responsive: true,
            dom: '<"html5buttons"B>lTfgitp',
            buttons: [
                { extend: 'copy' },
                { extend: 'csv' },
                { extend: 'excel', title: 'CourseList' },
                { extend: 'pdf', title: 'CourseList' },

                {
                    extend: 'print',
                    customize: function (win) {
                        $(win.document.body).addClass('white-bg');
                        $(win.document.body).css('font-size', '10px');

                        $(win.document.body).find('table')
                            .addClass('compact')
                            .css('font-size', 'inherit');
                    }
                }
            ]
        });

    });

    $("#btn-search").click(function () {
        // window.alert("sem:" + $('#SemesterId').val() + " sess:" + $('#SessionId').val());
        window.oTable.ajax.reload();

    });

    function myFunction() {
    window.open('@Url.Action("Create", "CoursePrerequisites")', '_self');

    };

</script>