@model Unijos.Web.ViewModels.MisconductViewModel
@{
    ViewBag.Title = "Edit";
}
<h2>Edit</h2>

@using (Html.BeginForm("Edit", "Misconduct", FormMethod.Post))
{
    @Html.Raw(ViewBag.Message)
    @Html.AntiForgeryToken()
    <div class="ibox float-e-margins col-md-10 col-md-offset-1">
        <div class="ibox-title">
            <div class="form-horizontal">
                <h4>Misconduct</h4>
                <hr />
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                @Html.HiddenFor(model => model.MisconductId)

                <div class="form-group">
                    @Html.LabelFor(model => model.MisconductName, "Course", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.MisconductName, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.MisconductName, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <input type="submit" value="Save" class="btn btn-default" />
                    </div>
                </div>
            </div>
            <p>
                @Html.ActionLink("Back to List", "Index")
            </p>
        </div>
        </div>
}
            
