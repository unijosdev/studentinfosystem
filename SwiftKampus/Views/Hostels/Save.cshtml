@model SwiftKampusModel.Accomodation.Hostel

<form id="myform" onsubmit="return false;">
    @Html.AntiForgeryToken()


    <div class="card">
        <div class="card-head style-primary">
           
        </div><!--end .card-head -->
        <div class="card-body">

            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            @if (Model != null && Model.HostelId > 0)
            {
                @Html.HiddenFor(model => model.HostelId)
            }
            <div class="form-group">
                @Html.Label("Hostel Code")
                @Html.EditorFor(model => model.HostelCode, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.HostelCode, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.Label("Hostel Name")
                @Html.EditorFor(model => model.HostelName, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.HostelName, "", new { @class = "text-danger" })
            </div>

           
            <div class="form-group">
                @Html.Label("Hostel Price")
                @Html.EditorFor(model => model.HostelPrice, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.HostelPrice, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.Remark)
                @Html.EditorFor(model => model.Remark, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Remark, "", new { @class = "text-danger" })
            </div>


            <div class="md-form">

                @if (Model != null && Model.HostelId > 0)
                {
                    <input id="btnsubmit" type="submit" value="Update" class="btn btn-primary btn-lg" />
                }
                else
                {
                    <input id="btnsubmit" type="submit" value="Save" class="btn btn-primary btn-lg" />
                }
                <a href="#" class="btn btn-danger btn-lg" data-dismiss="modal">Cancel</a>
            </div>
        </div><!--end .card-body -->
    </div><!--end .card -->
</form>
@*@section Scripts {
        @Scripts.Render("~/bundles/jqueryval")
    }*@

<script type="text/javascript">
    $("#btnsubmit").click(function () {

        var data = $("#myform").serialize();

        $.ajax({
            type: "POST",
            url: "/Hostels/Save",
            data: data,
            success: function (data) {
                if (data.status) {
                    $('#actionsList').modal("hide");

                    window.oTable.ajax.reload(); //run my_fun() ondomready
                    toastr["success"](data.message);
                    $('#myform')[0].reset();
                } else {
                    //$('#actionsList').modal("hide");
                    toastr["error"](data.message);
                }

            }
        });
    });
</script>


