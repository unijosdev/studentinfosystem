@using SwiftKampus.Extensions
@model SwiftKampus.ViewModels.StudentBioData.RelevantQualificationVm

@{
    ViewBag.Title = "Add Qualification";
    Layout = null;
}

<link href="~/AdminTemplate/css/plugins/sweetalert/sweetalert.css" rel="stylesheet">

<div class="row wrapper border-bottom white-bg page-heading">
    <div class="col-md-10">
        <h2>
            <i class="fa fa-plus"></i> ADD OTHER RELEVANT QUALIFICATION

        </h2>
    </div>
    <div class="col-md-2">
        <br />
        <span class="col-md-12" input-group-btn col-sm-2">
            <button id="btnAddQualification" type="button" class="btn btn-primary"><i class="fa fa-plus">Add More</i></button>
        </span>
    </div>
</div>
<div class="card">

</div><!--end .card-head -->




<form id="myform" onsubmit="return false;">
    <div class="wrapper wrapper-content animated fadeInRight">
        <div class="row">
            <div class="col-md-2">
                <div class="com-md-12">
                    @*<h4 class="text-center">Instruction</h4>*@
                    @*<ol class="bold">
                            <li>You are only allowed to Add 5 results from <i class="bold italic">Maximum of two sittings</i> </li>
                            <li>Select Exam Type</li>
                            <li>Select Subject(s)</li>
                            <li>Add Grade based on the order of subject selected</li>
                        </ol>*@
                </div>
            </div>
            <div class="col-md-10">
                <div class="ibox float-e-margins">
                    <div class="ibox-content form-horizontal">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        <div class="relevantQualifactionRepeatable">
                            @if (Model.Qualifications != null && Model.Qualifications.Count() > 0)
                            {
                                for (int i = 0; i < Model.Qualifications.Count(); i++)
                                {
                            <div class="row">
                                <div class="hr-line-dashed"></div>
                                <div class="col-md-6">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.Qualifications[i].NameOfInstitution)
                                            @Html.EditorFor(model => model.Qualifications[i].NameOfInstitution, new { htmlAttributes = new { @class = "form-control nameOfInstitution" } })
                                            @Html.ValidationMessageFor(model => model.Qualifications[i].NameOfInstitution, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.Qualifications[i].QualificationName) @**@
                                            @Html.EditorFor(model => model.Qualifications[i].NameOfInstitution, new { htmlAttributes = new { @class = "form-control qualificationName" } })
                                            @Html.ValidationMessageFor(model => model.Qualifications[i].QualificationName, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.Qualifications[i].FromDate)
                                            @Html.EditorFor(model => model.Qualifications[i].FromDate, new { htmlAttributes = new { @class = "form-control fromDate" } })
                                            @Html.ValidationMessageFor(model => model.Qualifications[i].FromDate, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.Qualifications[i].ToDate)
                                            @Html.EditorFor(model => model.Qualifications[i].ToDate, new { htmlAttributes = new { @class = "form-control toDate" } })
                                            @Html.ValidationMessageFor(model => model.Qualifications[i].ToDate, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.Qualifications[i].Grade)
                                            @Html.EditorFor(model => model.Qualifications[i].Grade, new { htmlAttributes = new { @class = "form-control grade" } })
                                            @Html.ValidationMessageFor(model => model.Qualifications[i].Grade, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <span class="col-md-12" onclick="remove_RelevantQbutton(this)" input-group-btn col-sm-2">
                                    <button type="button" class="btn btn-primary"><i class="fa fa-minus"></i></button>
                                </span>

                            </div>

                                   

                                }
                            }
                            else
                            {
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="col-md-12">
                                            <div class="form-group">
                                                @Html.LabelFor(model => model.Qualification.NameOfInstitution)
                                                @Html.EditorFor(model => model.Qualification.NameOfInstitution, new { htmlAttributes = new { @class = "form-control nameOfInstitution" } })
                                                @Html.ValidationMessageFor(model => model.Qualification.NameOfInstitution, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="col-md-12">
                                            <div class="form-group">
                                                @Html.LabelFor(model => model.Qualification.QualificationName)
                                                @Html.EditorFor(model => model.Qualification.NameOfInstitution, new { htmlAttributes = new { @class = "form-control qualificationName" } })
                                                @Html.ValidationMessageFor(model => model.Qualification.QualificationName, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="col-md-12">
                                            <div class="form-group">
                                                @Html.LabelFor(model => model.Qualification.FromDate)
                                                @Html.EditorFor(model => model.Qualification.FromDate, new { htmlAttributes = new { @class = "form-control fromDate" } })
                                                @Html.ValidationMessageFor(model => model.Qualification.FromDate, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="col-md-12">
                                            <div class="form-group">
                                                @Html.LabelFor(model => model.Qualification.ToDate)
                                                @Html.EditorFor(model => model.Qualification.ToDate, new { htmlAttributes = new { @class = "form-control toDate" } })
                                                @Html.ValidationMessageFor(model => model.Qualification.ToDate, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="col-md-12">
                                            <div class="form-group">
                                                @Html.LabelFor(model => model.Qualification.Grade)
                                                @Html.EditorFor(model => model.Qualification.Grade, new { htmlAttributes = new { @class = "form-control grade" } })
                                                @Html.ValidationMessageFor(model => model.Qualification.Grade, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                    <span class="col-md-12" onclick="remove_RelevantQbutton(this)" input-group-btn col-sm-2">
                                        <button type="button" class="btn btn-primary"><i class="fa fa-minus"></i></button>
                                    </span>
                                </div>
                            }

                        </div>
                        <div class="form-group">
                            <div class="col-md-10">
                                <br />
                                <br />
                                <input type="submit" id="btnRelevantQualificationSave" value="SAVE AND CONTINUE" class="btn btn-primary btn-lg" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-12">
                    <a id="btnAQualificationPrevious" href="#" class="btn btn-warning btn-lg btnPrevious" data-dismiss="modal">PREVIOUS</a>
                    <a id="btnAQualificationNext" href="#" class="btn btn-warning btn-lg btnNext" data-dismiss="modal">NEXT</a>
                </div>
            </div>
        </div>
    </div>

</form>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
<script src="~/Scripts/jquery-3.3.1.min.js"></script>
<script src="~/AdminTemplate/js/plugins/sweetalert/sweetalert.min.js"></script>
<script>
    var count = 1;
    $(document).ready(function () {
        $('#btnAddQualification').click(function () {
            if (count <= 5) {
                var new_field = `<div class="hr-line-dashed"></div>
                                 <div class="row">
                                    <div class="col-md-6">
                                        <div class="col-md-12">
                                            <div class="form-group">
                                                @Html.LabelFor(model => model.Qualification.NameOfInstitution)
                                                @Html.EditorFor(model => model.Qualification.NameOfInstitution, new { htmlAttributes = new { @class = "form-control nameOfInstitution" } })
                                                @Html.ValidationMessageFor(model => model.Qualification.NameOfInstitution, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="col-md-12">
                                            <div class="form-group">
                                                @Html.LabelFor(model => model.Qualification.QualificationName) @**@
                                                @Html.EditorFor(model => model.Qualification.NameOfInstitution, new { htmlAttributes = new { @class = "form-control qualificationName" } })
                                                @Html.ValidationMessageFor(model => model.Qualification.QualificationName, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="col-md-12">
                                            <div class="form-group">
                                                @Html.LabelFor(model => model.Qualification.FromDate)
                                                @Html.EditorFor(model => model.Qualification.FromDate, new { htmlAttributes = new { @class = "form-control fromDate" } })
                                                @Html.ValidationMessageFor(model => model.Qualification.FromDate, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="col-md-12">
                                            <div class="form-group">
                                                @Html.LabelFor(model => model.Qualification.ToDate)
                                                @Html.EditorFor(model => model.Qualification.ToDate, new { htmlAttributes = new { @class = "form-control toDate" } })
                                                @Html.ValidationMessageFor(model => model.Qualification.ToDate, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="col-md-12">
                                            <div class="form-group">
                                                @Html.LabelFor(model => model.Qualification.Grade)
                                                @Html.EditorFor(model => model.Qualification.Grade, new { htmlAttributes = new { @class = "form-control grade" } })
                                                @Html.ValidationMessageFor(model => model.Qualification.Grade, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>

                            <span class="col-md-12" onclick="remove_RelevantQbutton(this)" input-group-btn col-sm-2">
                                <button type="button" class="btn btn-primary"><i class="fa fa-minus"></i></button>
                            </span>
                        </div>`;
                $('.relevantQualifactionRepeatable').append(new_field);
                count++;
            }
            else {
                swal({
                    title: "Warning",
                    text: "Maximum number of fields exceeded!",
                    type: "warning",
                });
            }
        });
        $("#ijmbQualification").hide();
        $("#normalQualification").show();
        $("#ijmbgrade").hide();

    });

    function loadDiscipline() {
        var qualificationName = $("#QualificationName").val();
        if (qualificationName === 'NCE') {
            $('.discipline').val('');
            $("#ijmbQualification").show();
            $("#normalQualification").hide();

            $("#ijmbgrade").hide();
            $("#normalGrade").show();
        }
        else {
            $('.discipline').val('');

            $("#ijmbQualification").hide();
            $("#normalQualification").show();

            $("#ijmbgrade").hide();
            $("#normalGrade").show();
        }
        if (qualificationName === 'IJMB') {
            $('.discipline').val('');
            $("#ijmbQualification").show();
            $("#normalQualification").hide();

            $("#ijmbgrade").show();
            $("#normalGrade").hide();

        }

    }

    $('#btnRelevantQualificationSave').click(function () {
        var nameOfInstitution = [];
        var qualificationName = [];
        var grade = [];
        var fromDate = [];
        var toDate = [];

        var relevantQualificationList = [];

        //pulling the form data using the class and adding it to a list
        $.each($('.nameOfInstitution'), function () {
            nameOfInstitution.push($(this).val());
        });
        $.each($('.qualificationName'), function () {
            qualificationName.push($(this).val());
        });
        $.each($('.grade'), function () {
            grade.push($(this).val());
        });
        $.each($('.fromDate'), function () {
            fromDate.push($(this).val());
        });
        $.each($('.toDate'), function () {
            toDate.push($(this).val());
        });

        for (var i = 0; i < nameOfInstitution.length; i++) {
            var data = {
                "NameOfInstitution": nameOfInstitution[i],
                "QualificationName": qualificationName[i],
                "Grade": grade[i],
                "FromDate": fromDate[i],
                "ToDate": toDate[i]
            };
            relevantQualificationList.push(data);
        }

        var Mydata = JSON.stringify(relevantQualificationList);

        $.ajax({
            contentType: 'application/json',
            type: "POST",
            url: "/Qualifications/PCreate",
            data: Mydata,
            success: function (data) {
                if (data.status) {
                    swal({
                        title: "Good Job!!!",
                        text: "Did you want to add More Result?..",
                        type: "warning",
                        showCancelButton: true,
                        confirmButtonColor: "#ab973a",
                        confirmButtonText: "Yes, Proceed!",
                        cancelButtonText: "No, Cancel!",
                        closeOnConfirm: false,
                        closeOnCancel: false
                    },
                        function (isConfirm) {
                            if (isConfirm) {
                                swal("Great!", "You can proceed now.", "success");
                                $("#publications").click();
                            } else {
                                swal("Great", "You can click procced button to continue", "success");

                            }
                        });
                    toastr["success"](data.message);
                } else {
                    swal({
                        title: "Warning",
                        text: data.message,
                        type: "warning",
                    });
                    toastr["success"](data.message);
                }

            }
        });
    });

    function remove_RelevantQbutton(elem) {
        $(elem).closest('div').remove();
    }


    $("#btnAQualificationPrevious").click(function () {
        $("#awardprices").click();
    });

    $("#btnAQualificationNext").click(function () {
        $("#publications").click();
    });

</script>

