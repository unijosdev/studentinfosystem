@using SwiftKampus.Extensions
@model SwiftKampusModel.Qualification

@{
    ViewBag.Title = "Add Qualification";

}
<div class="row wrapper border-bottom white-bg page-heading">
    <div class="col-lg-12">
        <h2>
            <i class="fa fa-plus"></i> ADD ACADEMIC QUALIFICATION

        </h2>
    </div>
    <div class="col-lg-2">

    </div>
</div>
<div class="card">

</div><!--end .card-head -->


<link href="~/AdminTemplate/css/plugins/sweetalert/sweetalert.css" rel="stylesheet">


<form id="myform" onsubmit="return false;">
    <div class="wrapper wrapper-content animated fadeInRight">
        <div class="row">
            <div class="col-md-2">
                <div class="com-md-12">
                    @*<h4 class="text-center">Instruction</h4>*@
                    @*<ol class="bold">
                            <li>You are only allowed to Add 5 results from <i class="bold italic">Maximum of two sittings</i> </li>
                            <li>Select Exam Type</li>
                            <li>Select Subject(s)</li>
                            <li>Add Grade based on the order of subject selected</li>
                        </ol>*@
                </div>
            </div>
            <div class="col-md-10">
                <div class="ibox float-e-margins">
                    <div class="ibox-content form-horizontal">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        <div class="repeatable">
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="col-md-12">
                                                <div class="form-group">
                                                    @Html.LabelFor(model => model.NameOfInstitution)
                                                    @Html.EditorFor(model => model.NameOfInstitution, new { htmlAttributes = new { @class = "form-control" } })
                                                    @Html.ValidationMessageFor(model => model.NameOfInstitution, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="col-md-12">
                                                <div class="form-group">
                                                    @Html.LabelFor(model => model.QualificationName) @**@
                                                    @Html.DropDownList("QualificationName", null, htmlAttributes: new { @class = "form-control", @onchange = "loadDiscipline()" })
                                                    @Html.ValidationMessageFor(model => model.QualificationName, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div id="normalQualification">
                                            <div class="col-md-6">
                                                <div class="col-md-12">
                                                    <div class="form-group">
                                                        @Html.LabelFor(model => model.Discipline)
                                                        @Html.EditorFor(model => model.Discipline, new { htmlAttributes = new { @class = "form-control discipline", @id = "discipline2" } })
                                                        @Html.ValidationMessageFor(model => model.Discipline, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div id="ijmbQualification">
                                            <div class="col-md-6">
                                                <div class="col-md-12">
                                                    <div class="row">
                                                        <div class="col-md-12">
                                                            <div class="form-group">
                                                                @Html.Label("Subject One")
                                                                @Html.EditorFor(model => model.Discipline, new { htmlAttributes = new { @class = "form-control discipline" } })
                                                                @Html.ValidationMessageFor(model => model.Discipline, "", new { @class = "text-danger" })
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="row">
                                                        <div class="col-md-12">
                                                            <div class="form-group">
                                                                @Html.Label("Subject Two")
                                                                @Html.EditorFor(model => model.Discipline, new { htmlAttributes = new { @class = "form-control discipline" } })
                                                                @Html.ValidationMessageFor(model => model.Discipline, "", new { @class = "text-danger" })
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="row">
                                                        <div class="col-md-12">
                                                            <div class="form-group">
                                                                @Html.Label("Subject Three")
                                                                @Html.EditorFor(model => model.Discipline, new { htmlAttributes = new { @class = "form-control discipline" } })
                                                                @Html.ValidationMessageFor(model => model.Discipline, "", new { @class = "text-danger" })
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div id="normalGrade">
                                            <div class="col-md-6">
                                                <div class="col-md-12">
                                                    <div class="form-group">
                                                        @Html.Label("Grade/Point")
                                                        <select id="grade1" class="form-control">
                                                            <option value=""></option>
                                                            <option value="Distinction">Distinction</option>
                                                            <option value="Merit">Merit</option>
                                                            <option value="Upper Credit">Upper Credit</option>
                                                            <option value="Second Class Upper">Second Class Upper</option>
                                                            <option value="Lower Credit">Lower Credit</option>
                                                            <option value="Second Class Lower">Second Class Lower</option>
                                                            <option value="Pass">Pass</option>
                                                        </select>
                                                        @Html.ValidationMessageFor(model => model.Grade, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div id="ijmbgrade">
                                            <div class="col-md-6">
                                                <div class="col-md-12">
                                                    <div class="form-group">
                                                        @Html.Label("Grade/Point")
                                                        <select id="grade2" class="form-control">
                                                            <option value=""></option>
                                                            <option value="7 Point">7 Point</option>
                                                            <option value="8 Point">8 Point</option>
                                                            <option value="9 Point">9 Point</option>
                                                            <option value="10 Point">10 Point</option>
                                                            <option value="11 Point">11 Point</option>
                                                            <option value="12 Point">12 Point</option>
                                                            <option value="13 Point">13 Point</option>
                                                            <option value="14 Point">14 Point</option>
                                                            <option value="15 Point">15 Point</option>
                                                        </select>
                                                        @Html.ValidationMessageFor(model => model.Grade, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>

                        </div>
                        <div class="form-group">
                            <div class="col-md-10">
                                <input type="submit" id="btnSave" value="Save and Continue" class="btn btn-primary btn-lg" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-12">
                    <a id="btnAQualificationPrevious" href="#" class="btn btn-warning btn-lg btnPrevious" data-dismiss="modal">PREVIOUS</a>
                    <a id="btnAQualificationNext" href="#" class="btn btn-warning btn-lg btnNext" data-dismiss="modal">NEXT</a>
                </div>
            </div>
        </div>
    </div>

</form>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
<script src="~/Scripts/jquery-3.3.1.min.js"></script>
<script src="~/AdminTemplate/js/plugins/sweetalert/sweetalert.min.js"></script>
<script>
       var count = 1;
    $(document).ready(function () {
        $("#ijmbQualification").hide();
        $("#normalQualification").show();
        $("#ijmbgrade").hide();

    });

    function loadDiscipline() {
        var qualificationName = $("#QualificationName").val();
        if (qualificationName === 'NCE') {
            $('.discipline').val('');
            $("#ijmbQualification").show();
            $("#normalQualification").hide();

            $("#ijmbgrade").hide();
            $("#normalGrade").show();
        }
        else {
            $('.discipline').val('');

            $("#ijmbQualification").hide();
            $("#normalQualification").show();

            $("#ijmbgrade").hide();
            $("#normalGrade").show();
        }
        if (qualificationName === 'IJMB') {
            $('.discipline').val('');
            $("#ijmbQualification").show();
            $("#normalQualification").hide();

            $("#ijmbgrade").show();
            $("#normalGrade").hide();

        }

    }

     $('#btnSave').click(function () {

        var nameOfInstitution = $("#NameOfInstitution").val();
        var qualificationName = $("#QualificationName").val();
         var discipline = [];
         grade = '';
         var emplymentDetailList = [];

         if (qualificationName === 'IJMB') {
             grade = $("#grade2").val();
         } else {
             grade = $("#grade1").val();
         }


            //pulling the form data using the class and adding it to a list
        $.each($('.discipline'), function () {
            discipline.push($(this).val());
        });


        //append to list for c# in controller
         var data = {
            "NameOfInstitution": nameOfInstitution,
            "QualificationName": qualificationName,
            "Discipline": discipline.toString(),
            "Grade": grade,
        };


         var Mydata = JSON.stringify(data);
      // alert(Mydata);
         $.ajax({
                contentType: 'application/json',
                type: "POST",
                url: "/Qualifications/Create",
                data: Mydata,
                success: function (data) {
                    if (data.status) {
                        swal({
                            title: "Academic qualification saved successfully",
                            text: "Did you want to add More Result?..",
                            type: "warning",
                            showCancelButton: true,
                            confirmButtonColor: "#ab973a",
                            confirmButtonText: "Proceed",
                            closeOnConfirm: false,
                            closeOnCancel: false
                        },
                            function (isConfirm) {
                                if (isConfirm) {
                                    swal("Great!", "You can now add more.", "success");
                                     window.open('@Url.Action("Details", "UtmeApplicants")', '_self');
                                } else {
                                    swal("Great", "You can now see your result list", "success");
                                    window.open('@Url.Action("Index", "Qualifications")', '_self');

                                }
                            });
                        toastr["success"](data.message);
                    } else {
                        swal({
                            title: "Warning",
                            text: data.message,
                            type: "warning",
                        });
                        toastr["success"](data.message);
                    }

                }
            });
        });

    function remove_button(elem) {
        if (count > 1) {
            $(elem).closest('div').remove();
            count--;
        }
    }


    $("#btnAQualificationPrevious").click(function () {
        //$("#awardprices").click();
        window.open('@Url.Action("Create", "ApplicantOLevelResults")', '_self');
    });

    $("#btnAQualificationNext").click(function () {
        //$("#publications").click();
         window.open('@Url.Action("Details", "UtmeApplicants")', '_self');
    });

</script>
