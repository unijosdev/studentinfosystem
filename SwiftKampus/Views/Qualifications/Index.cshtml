@model IEnumerable<SwiftKampusModel.Qualification>

@{
    ViewBag.Title = "Qualification List";
}
<div class="row wrapper border-bottom white-bg page-heading">
    <div class="col-lg-12">
        <h2>
            <i class="fa fa-info"></i> List of Academic Qualifications
            <span><a class="btn btn-primary" href="@Url.Action("Create","Qualifications")">Add Academic Qualifications</a></span>
        </h2>

    </div>
    <div class="col-lg-2">

    </div>
</div>
<div class="card">
  
<div class="card-body">
        
    <br />
    <br />
    
    <table class="table table-responsive">
        <tr>

            <th>
                @Html.DisplayNameFor(model => model.NameOfInstitution)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.QualificationName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FromDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ToDate)
            </th>

            <th></th>
        </tr>

        @foreach (var item in Model)
        {
        <tr>

            <td>
                @Html.DisplayFor(modelItem => item.NameOfInstitution)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.QualificationName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FromDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ToDate)
            </td>

            <td>
                @Html.ActionLink("Edit", "Edit", new { id = item.QualificationId }) |
                @Html.ActionLink("Details", "Details", new { id = item.QualificationId }) |
                @*@Html.ActionLink("Delete", "Delete", new { id=item.QualificationId })*@
            </td>
        </tr>
        }

    </table>
</div>
</div>