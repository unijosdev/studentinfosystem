@model IEnumerable<SwiftKampusModel.TimeTable.LectureRoom>

@{
    ViewBag.Title = "Index";
}


<!-- Modal -->
<div class="modal fade modal-bf-fh" id="actionsList" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <!--Content-->
        <div class="modal-content">
            <!--Header-->
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <div class="flex-center">
                    <h4 class="modal-title">LECTURE ROOM</h4>
                    @*<a class="btn btn-primary btn-sm">Create new action</a>*@
                </div>
            </div>
            <!--Body-->
            <div class="modal-body" id="myModalDivBody">
            </div>
        </div>
        <!--/.Content-->
    </div>
</div>
<!-- /.Modal-->

<div class="ibox float-e-margins">
    <div class="ibox-title">
        <h5>List of Lecture Rooms</h5>
        <div class="ibox-tools">
            <a href="#" onclick="myFunction()" class="btn btn-primary btn-sm"><i class="fa fa-plus left"></i> ADD LECTURE ROOM</a>

            <a class="collapse-link">
                <i class="fa fa-chevron-up"></i>
            </a>
            <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                <i class="fa fa-wrench"></i>
            </a>

        </div>
        <div class="ibox-content">

            <table id="Jdatatable" class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Building Name</th>
                        <th>Room Name</th>
                        <th>Room Code</th>
                        <th>Room Capacity</th>
                        <th>Sitting Capacity</th>
                        <th>Is General Hall?</th>
                        <th>Action</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>


<script src="~/Scripts/jquery-3.1.1.min.js"></script>

<script type="text/javascript">
    $(document).ready(function () {

        window.oTable = $("#Jdatatable").DataTable({
            "processing": true, // for show progress bar while loading
            //"serverSide": true, // if it is true the preocess is done on server side
            //"filter": true, // disables search box
            //"info": true,
            //"stateSave": true,
            //"orderMulti": false, // disable multiple column loading at once
            "ajax": {
                "url": "/LectureRooms/GetIndex",
                "type": "POST",
                "datatype": "json"
            },
            "columns": [
                { "data": "LectureRoomId", "autoWidth": true },
                { "data": "LectureRoomName", "autoWidth": true },
                { "data": "LectureRoomCode", "autoWidth": true },
                { "data": "LectureRoomCapacity", "autoWidth": true },
                { "data": "SittingCapacity", "autoWidth": true },
                { "data": "IsGeneralLectureHall", "autoWidth": true },
                {
                    "data": "LectureRoomId",
                    "autoWidth": true,
                    "render": function (data) {
                        return '<a href="#" data-toggle="modal" data-target="#actionsList" onclick="Edit(' + data + ')" >  <i class="fa fa-pencil" aria-hidden="true" >&nbsp;Edit</i></a>&nbsp;&nbsp;' +
                            '<a href="#" class="text-danger" data-toggle="modal" data-target="#actionsList"  onclick="Delete(' + data + ')" ><i class="fa fa-remove" aria-hidden="true" >&nbsp;Remove<i /></a>';
                    }
                }

                //{ "data": "EmailID", "autoWidth": true },
                //{ "data": "Phone", "autoWidth": true },
            ]
        });

    });
    function Edit(lectureRoomId) {
        var url = "/LectureRooms/Save?id=" + lectureRoomId;
        $('#myModal').appendTo("body").modal('show');
        //window.alert(url);
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal('show');
            });
    };
    function Delete(lectureRoomId) {
        var url = "/LectureRooms/Delete?id=" + lectureRoomId;
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
    };
    function myFunction() {
        var url = "/LectureRooms/Save?id=0";

        $('#actionsList').modal('show');
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
    };
</script>
