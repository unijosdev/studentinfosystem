
@{
    ViewBag.Title = "Student E-Learning";
}

<div class="row wrapper border-bottom white-bg page-heading">
    <div class="col-lg-8">
        <h3>E-Learning</h3>
        <div id="nestable-menu">
            <button type="button" data-action="expand-all" class="btn btn-white btn-sm">Expand All</button>
            <button type="button" data-action="collapse-all" class="btn btn-white btn-sm">Collapse All</button>
        </div>
    </div>
</div>

<div class="wrapper wrapper-content">
    <div class="row">
        <div class="col-sm-5">
            <div class="ibox float-e-margins">
                <div class="ibox-content coursedropdown">
                    <div class="file-manager">

                        <button class="btn btn-primary btn-block">Registered Courses</button>
                        <div class="ibox-content">
                            <div id="courseTable" class="fadeInRight animated" style="overflow-y: scroll; height:400px;">

                            </div>

                        </div>
                        <div class="clearfix"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-7 animated fadeInRight">
            <div class="row">
                <div id="mydetailBody2" class="fadeInRight animated"></div>
            </div>
            <div class="row">
                <div id="mydetailBody3" class="fadeInRight animated"></div>

            </div>
        </div>
    </div>
    <div class="row">
        <div id="topicContentDetail"  class="fadeInRight animated"></div>
    </div>
   
</div>

<div id="wait" style="display:none;width:89px;height:89px;border:1px solid black;position:absolute;top:50%;left:50%;padding:2px;"><img src='~/Content/images/demo_wait.gif' width="84" height="84" /><br>Processing..</div>
