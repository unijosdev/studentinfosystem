@model SwiftKampus.ViewModels.Result.DeptRejectVm
<form id="myDeptform" onsubmit="return false;">
    @Html.AntiForgeryToken()
    <div class="card">
        <div class="card-head style-primary">


        </div><!--end .card-head -->
        <div class="card-body">

            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            @if (Model != null && Model.ContinuousAssessmentId > 0)
            {
                @Html.HiddenFor(model => model.ContinuousAssessmentId)
                @Html.HiddenFor(model => model.ResultLevel)
            }

            
            <div class="form-group">
                @Html.Label("Reason For Rejecting Result ")
                @Html.EditorFor(model => model.ReasonForReject, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.ReasonForReject, "", new { @class = "text-danger" })
            </div>

           
            <div class="md-form">               
                <input id="btndeptsubmit" type="submit" value="Save" data-dismiss="modal" class="btn btn-primary btn-lg" />
                
                <a id="dmodal" href="#" class="btn btn-danger btn-lg" data-dismiss="modal">Cancel</a>
            </div>
        </div><!--end .card-body -->

    </div>
</form>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}


<script type="text/javascript">

    $("#btndeptsubmit").click(function () {
        var data = $("#myDeptform").serialize();

        $.ajax({
            type: "POST",
            url: "/ContinuousAssessments/DeptRejectSave",
            data: data,
            success: function (data) {
                if (data.status) {                      
                    submitSearch();//window.oTable.ajax.reload(); //run my_fun() ondomready
                    swal("Success", data.message, "sucess");
                    toastr["success"](data.message);
                    $('#myform')[0].reset();
                    $('#actionsList').modal("hide");
                } else {
                    swal("Ooops", data.message, "warning");
                    //$('#actionsList').modal("hide");

                }

            }
        });
    });
</script>

