@model IEnumerable<SwiftKampus.ViewModels.Result.DeptApprovalVm>

@{
    ViewBag.Title = "Dept Approval";
    Layout = null;
}
<link href="~/AdminTemplate/css/plugins/sweetalert/sweetalert.css" rel="stylesheet">


<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox-content">
                <div class="table-responsive">
                    @*<table id="Jdatatable" class="table table-striped table-bordered table-hover table-responsive dataTables-example">*@
                    <table class="table table-striped table-bordered table-hover table-responsive">
                        <thead>
                            <tr>
                                <th>Dept Option</th>
                                <th>Course Code</th>
                                <th>Level</th>
                                <th>Semester Name</th>
                                <th>Session Name</th>
                                <th>Dept Approval</th>
                                <th>Status  </th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.ProgrammeName</td>
                                <td>@item.CourseCode</td>
                                <td>@item.LevelName</td>
                                <td>@item.SemesterName</td>
                                <td>@item.SessionName</td>
                                <td>@item.IsDeptApproved</td>
                                <td>@item.ReasonForReject</td>
                                <td>
                                    <a onclick="Details('@item.ContinuousAssessmentId')">  <i class="fa fa-edit" aria-hidden="true">&nbsp;View</i></a>
                                </td>
                            </tr>

                        }
                    </table>

                </div>

            </div>
        </div>
    </div>
</div>
<!-- Modal -->
<div class="modal fade modal-bf-fh" id="actionsList" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <!--Content-->
        <div class="modal-content">
            <!--Header-->
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <div class="flex-center">
                    <h4 class="modal-title">UPLOAD CA</h4>
                    @*<a class="btn btn-primary btn-sm">Create new action</a>*@
                </div>
            </div>
            <!--Body-->
            <div class="modal-body" id="myModalDivBody">
            </div>
        </div>
        <!--/.Content-->
    </div>
</div>
<!-- /.Modal-->

<script src="~/AdminTemplate/js/plugins/sweetalert/sweetalert.min.js"></script>

<script type="text/javascript">

    function Details(continuousAssessmentId) {
        var url = "/ContinuousAssessments/DisplayResultDetails?id=" + continuousAssessmentId;
        window.open(url, '_blank');
    };

    

</script>

