
@model List<SwiftKampus.ViewModels.ContinuousAssessmentVm>
@{
    ViewBag.Title = "CreateCa";
}

<div class="card">
    <div class="card-head style-primary">
        <header>
            <h3>
                Create/Edit Continuous Assessment
            </h3>
        </header>

    </div><!--end .card-head -->
    <div class="card-body">
        <h3>
            Continuous Assessment for @Model[0].Course.CourseName in @Model[0].Programme.ProgrammeName Department at <br />
            at @Model[0].Level.LevelName level in @Model[0].Semester.SemesterName semester of @Model[0].Session.SessionName
        </h3>

        @using (Html.BeginForm("SaveCa", "ContinuousAssessments", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
        {
            @Html.AntiForgeryToken()

            <table class=" table table-responsive table-condensed table-striped">
                <tr>
                    <th>
                        <strong>Student ID</strong>
                    </th>
                    <th>
                        <strong>Student Name</strong>
                    </th>

                    @*<th>
                        <strong>First Test</strong>
                    </th>
                    <th>
                        <strong>Second Test</strong>
                    </th>*@
                    <th>
                        <strong>Ca SCore</strong>
                    </th>
                    <th>
                        <strong>Exam Score</strong>
                    </th>

                    <th></th>
                </tr>
                @*@foreach (var item in Model.StudentId)*@
                @for (var i = 0; i < Model.Count; i++)
                {

                    @Html.HiddenFor(model => model[i].ContinuousAssessmentId)
                    @Html.HiddenFor(model => model[i].CourseId)
                    @Html.HiddenFor(model => model[i].LevelId)
                    @Html.HiddenFor(model => model[i].SemesterId)
                    @Html.HiddenFor(model => model[i].SessionId)

                    @Html.HiddenFor(model => model[i].StudentId)
                    @Html.HiddenFor(model => model[i].ProgrammeId)


                    @Html.TextBoxFor(model => model[i].ContinuousAssessmentId, new { style = "display:none" })
                    @Html.TextBoxFor(model => model[i].CourseId, new { style = "display:none" })
                    @Html.TextBoxFor(model => model[i].LevelId, new { style = "display:none" })
                    @Html.TextBoxFor(model => model[i].SemesterId, new { style = "display:none" })
                    @Html.TextBoxFor(model => model[i].SessionId, new { style = "display:none" })
                    @Html.TextBoxFor(model => model[i].ProgrammeId, new { style = "display:none" })

                    <tr>
                        <td>
                            @Html.DisplayFor(model => model[i].StudentId)
                        </td>


                        <td>
                            @Html.EditorFor(model => model[i].Student.FullName, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model[i].Student.FullName, "", new { @class = "text-danger" })
                        </td>

                        @*<td>
                            @Html.EditorFor(model => model[i].FirstTest, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model[i].FirstTest, "", new { @class = "text-danger" })
                        </td>
                        <td>
                            @Html.EditorFor(model => model[i].SecondTest, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model[i].SecondTest, "", new { @class = "text-danger" })
                        </td>*@
                        <td>
                            @Html.EditorFor(model => model[i].CaScore, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model[i].CaScore, "", new { @class = "text-danger" })
                        </td>
                        <td>
                            @Html.EditorFor(model => model[i].ExamScore, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model[i].ExamScore, "", new { @class = "text-danger" })
                        </td>
                    </tr>

                }

            </table>

            <div class="form-group">
                <div class="col-md-offset-2 col-md-10">
                    <input type="submit" value="ADD/UPDATE CA" class="btn btn-primary btn-lg" />
                </div>
            </div>
        }


    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

