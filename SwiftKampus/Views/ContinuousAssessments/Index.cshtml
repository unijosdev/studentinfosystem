    @model IEnumerable<SwiftKampusModel.ContinuousAssessment>
@using SwiftKampus.Models

@{
    ViewBag.Title = "Continuous Assessments";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/AdminTemplate/css/plugins/sweetalert/sweetalert.css" rel="stylesheet">


<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>List of Results</h5>
                    <div class="ibox-tools">
                        @if (User.IsInRole(RoleName.Academic))
                        {
                            <a onclick="excelUpload()" class="btn btn-primary" data-toggle="modal" data-target="#actionsList"><i class="fa fa-plus left"></i> UPLOAD RESULT</a>
                            <a onclick="myFunction()" class="btn btn-primary" data-toggle="modal" data-target="#actionsList"><i class="fa fa-plus left"></i> ADD CA</a>
                        }
                        else if (User.IsInRole(RoleName.None_Academic))
                        {
                            <a href="@Url.Action("UploadLegacyResult")" class="btn btn-primary">UPLOAD LEGACY RESULT</a>
                        }

                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                        <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                            <i class="fa fa-wrench"></i>
                        </a>

                    </div>
                    <div class="ibox-content">
                        <article class="margin-bottom-xxl">
                            <p class="lead">
                                Please use the following parameters to perform Search
                            </p>
                        </article>
                        <div class="card-body">
                            <form id="formFilter" onsubmit="return false;">
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <label>School Programme</label>
                                            @Html.DropDownList("SchoolProgrammeId", (SelectList)ViewBag.SchoolProgrammeId, "", new { @class = "form-control" })
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <label>Faculty</label>
                                            @Html.DropDownList("FacultyId", (SelectList)ViewBag.FacultyId, "", new { @class = "form-control", @onchange = "getDeptList()" })
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <label>Department</label>
                                            @Html.DropDownList("DepartmentId", (SelectList)ViewBag.DepartmentId, "", new { @class = "form-control", @onchange = "getProgrammeList()" })
                                        </div>
                                    </div>

                                </div>
                                <br />
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <label>Dept Option</label>
                                            @Html.DropDownList("ProgrammeId", (SelectList)ViewBag.ProgrammeId, "", new { @class = "form-control", @onchange = "getCourseList()" })
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <label>Course</label>
                                            @Html.DropDownList("CourseId", (SelectList)ViewBag.CourseId, "", new { @class = "form-control" })
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="form-group">
                                            <label>Session</label>
                                            @Html.DropDownList("SessionId", (SelectList)ViewBag.SessionId, "", new { @class = "form-control" })
                                        </div>
                                    </div>
                                    <span class="col-md-2">
                                        <button type="submit" id="btn-search" class="btn btn-primary">Search/View</button>
                                        <br />
                                        <span>
                                            <button type="submit" id="btn-download" class="btn btn-primary">Download</button>
                                        </span>
                                        <br />
                                        @if (Request.IsAuthenticated && User.IsInRole(RoleName.Admin))
                                        {
                                            <span>
                                                <button type="submit" id="btn-remove" class="btn btn-primary">Remove Result</button>
                                            </span>
                                        }
                                    </span>
                                </div>
                            </form>
                        </div>
                    </div><!--end .row -->

                </div>
            </div>
            <div class="ibox-content">

                <div class="table-responsive">
                    <table id="Jdatatable" class="table table-striped table-bordered table-hover table-responsive dataTables-example">
                        <thead>
                            <tr>
                                <th>Student Id</th>
                                <th>Full Name</th>
                                <th>Course Code</th>
                                <th>Semester Name</th>
                                <th>Session Name</th>
                                <th>Ca Score</th>
                                <th>Exam Score</th>
                                <th>Total</th>
                                <th>Grade</th>
                                <th>Grade Point</th>
                            </tr>
                        </thead>
                    </table>

                </div>

            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade modal-bf-fh" id="actionsList" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <!--Content-->
        <div class="modal-content">
            <!--Header-->
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <div class="flex-center">
                    <h4 class="modal-title">UPLOAD CA</h4>
                    @*<a class="btn btn-primary btn-sm">Create new action</a>*@
                </div>
            </div>
            <!--Body-->
            <div class="modal-body" id="myModalDivBody">
            </div>
        </div>
        <!--/.Content-->
    </div>
</div>
<!-- /.Modal-->

<script src="~/Scripts/jquery-3.1.1.min.js"></script>
<script src="~/AdminTemplate/js/plugins/sweetalert/sweetalert.min.js"></script>

<script type="text/javascript">
    $(document).ready(function () {
        if ("@ViewBag.Message") {
            toastr["success"]("@ViewBag.Message");
        }
        window.oTable = $("#Jdatatable").DataTable({
            "processing": true, // for show progress bar while loading
