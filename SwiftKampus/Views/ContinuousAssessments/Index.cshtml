            //        }
            //    }
            //]
        });
    });

    $("#btn-search").click(function () {
        window.oTable.ajax.reload();
    });

    $("#btn-download").click(function () {
        var schoolProgramme = $('#SchoolProgrammeId').val();
        var courseId = $('#CourseId').val();
        var url = "/ContinuousAssessments/DownloadCaReport?SchoolProgrammeId=" + schoolProgramme + "&CourseId=" + courseId;
        window.open('' + url + '', '_blank');
    });

     $("#btn-remove").click(function () {
         swal({
             title: "Delete CA for the selected course",
             text: "Be sure you want to Delete the Continious Asssesment before processing?..",
             type: "warning",
             showCancelButton: true,
             confirmButtonColor: "#ab973a",
             confirmButtonText: "Yes, Delete Now!",
             cancelButtonText: "No, Pls Cancel!",
             closeOnConfirm: false,
             closeOnCancel: false
         },
        function (isConfirm) {
            if (isConfirm) {
            var data = $("#formFilter").serialize();

                $.ajax({
                    type: "POST",
                    url:"/ContinuousAssessments/RemoveCaResult",
                    data: data,
                    success: function (data) {
                        if (data.status) {                        
                            window.oTable.ajax.reload(); //run my_fun() ondomready
                            toastr["success"](data.message);
                            swal("Good", data.message, "success");


                        } else {
                            toastr["error"](data.message);
                            swal("Oops", data.message, "warning");
                        }
                    }
                });

            }
            else {
            swal("Oops", "Try again to download the List again", "warning");
            }
        });
    });

    function Edit(facultyId) {
        var url = "/ContinuousAssessments/Save?id=0" + facultyId;
        //$('#actionsList').modal("show");
        // window.alert(url);
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
    };
    function Delete(facultyId) {
        var url = "/ContinuousAssessments/Delete?id=" + facultyId;

        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
    };
    function myFunction() {
        var url = "/ContinuousAssessments/CreateCaView";
        window.open('@Url.Action("CreateCaView", "ContinuousAssessments")', '_self');
    };
    function excelUpload() {
        var url = "/ContinuousAssessments/UploadResult";
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
    };

