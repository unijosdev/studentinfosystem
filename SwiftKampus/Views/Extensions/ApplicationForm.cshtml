@model SwiftKampus.ViewModels.StudentStatusMgtVm.ExtensionApplicationViewModel

@{
    ViewBag.Title = "Application Form For Extension of Duration of Studies";
}

<link href="~/AdminTemplate/css/plugins/sweetalert/sweetalert.css" rel="stylesheet">
<link href="~/AdminTemplate/css/plugins/jasny/jasny-bootstrap.min.css" rel="stylesheet" />

<div class="row animated fadeInDown">

    <div class="col-lg-12">
        <div class="ibox float-e-margins">
            <div class="ibox-title">
                <h5>Application Form For Extension of Duration of Studies</h5>
                <div class="ibox-tools">
                    <a class="collapse-link">
                        <i class="fa fa-chevron-up"></i>
                    </a>
                    <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                        <i class="fa fa-wrench"></i>
                    </a>
                    <ul class="dropdown-menu dropdown-user">
                        <li>
                            <a href="#">Config option 1</a>
                        </li>
                        <li>
                            <a href="#">Config option 2</a>
                        </li>
                    </ul>
                    <a class="close-link">
                        <i class="fa fa-times"></i>
                    </a>
                </div>
            </div>
            <div class="ibox-content">
                @using (Html.BeginForm(null, null, FormMethod.Post, new { id = "applicationForm", @class = "applicationForm" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-horizontal">
                        <div class="row">
                            <div class="col-md-4">
                                <dl class="dl-horizontal">

                                    <dt>
                                        @Html.DisplayNameFor(model => model.MatricNumber)
                                    </dt>

                                    <dd>
                                        @Html.DisplayFor(model => model.MatricNumber)
                                    </dd>

                                    <dt>
                                        @Html.DisplayNameFor(model => model.FullName)
                                    </dt>

                                    <dd>
                                        @Html.DisplayFor(model => model.FullName)

                                    </dd>

                                    <dt>
                                        @Html.DisplayNameFor(model => model.Faculty.FacultyName)
                                    </dt>

                                    <dd>
                                        @Html.DisplayFor(model => model.Faculty.FacultyName)
                                    </dd>

                                    <dt>
                                        @Html.DisplayNameFor(model => model.Department.DeptName)
                                    </dt>

                                    <dd>
                                        @Html.DisplayFor(model => model.Department.DeptName)
                                    </dd>

                                    <dt>
                                        @Html.DisplayNameFor(model => model.Programme.ProgrammeName)
                                    </dt>

                                    <dd>
                                        @Html.DisplayFor(model => model.Programme.ProgrammeName)
                                    </dd>

                                    <dt>
                                        @Html.DisplayNameFor(model => model.SessionName)
                                    </dt>

                                    <dd>
                                        @Html.DisplayFor(model => model.SessionName)
                                    </dd>

                                    <dt>
                                        @Html.DisplayNameFor(model => model.PrimaryEmail)
                                    </dt>

                                    <dd>
                                        @Html.DisplayFor(model => model.PrimaryEmail)
                                    </dd>

                                    <dt>
                                        @Html.DisplayNameFor(model => model.SecondaryEmail)
                                    </dt>

                                    <dd>
                                        @Html.DisplayFor(model => model.SecondaryEmail)
                                    </dd>

                                    <dt>
                                        @Html.DisplayNameFor(model => model.PhoneNumber)
                                    </dt>

                                    <dd>
                                        @Html.DisplayFor(model => model.PhoneNumber)
                                    </dd>
                                </dl>
                            </div>
                            <div class="col-md-8">
                                <h3>Upload support document(s) if any</h3>
                                <div class="fileupload col-md-12">
                                    <div class="col-md-10">
                                        <div class="fileinput fileinput-new input-group" data-provides="fileinput">
                                            <div class="form-control" data-trigger="fileinput">
                                                <i class="glyphicon glyphicon-file fileinput-exists"></i>
                                                <span class="fileinput-filename"></span>
                                            </div>
                                            <span class="input-group-addon btn btn-default btn-file">
                                                <span class="fileinput-new">Select file</span>
                                                <span class="fileinput-exists">Change</span>
                                                <input type="file" class="file ignore" id="file" accept=".pdf" />
                                            </span>
                                            <a href="#" class="input-group-addon btn btn-default fileinput-exists" data-dismiss="fileinput">Remove</a>
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <button type="button" class="btn-add btn btn-primary"><i class="fa fa-plus"></i></button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <hr />
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        <div class="form-group">
                            @Html.Label("Session into which extension is sought", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownList("SessionId", null, "--SELECT--", htmlAttributes: new { @class = "form-control" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.Label("Period of extension sought", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownList("PeriodOfExtension", null, "--SELECT--", htmlAttributes: new { @class = "form-control" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.Label("Reason(s) for Extension of Duration of Studies", htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.DropDownList("ExtensionReason", null, "--SELECT--", htmlAttributes: new { @class = "form-control" })
                            </div>
                        </div>

                        @Html.HiddenFor(model => model.StudentId)

                        <div class="form-group">
                            <div class="col-md-offset-4 col-md-8">
                                <input type="submit" id="btnSubmitApplication" value="Submit Application" class="btn btn-primary" />
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script src="~/AdminTemplate/js/jquery-3.1.1.min.js"></script>
<script src="~/AdminTemplate/js/plugins/sweetalert/sweetalert.min.js"></script>
<script src="~/AdminTemplate/js/plugins/jasny/jasny-bootstrap.min.js"></script>
<script>
    $(document).ready(function () {
        var ExtensionReason = $("#ExtensionReason"),
            sessionId = $("#SessionId"),
            PeriodOfExtension = $("#PeriodOfExtension");
        var count = 1;
        $('.btn-add').click(function () {
            if (count < 3) {
                $('.fileupload').append(`<div class="file-container">
                                        <div class="col-md-10">
                                            <div class="fileinput fileinput-new input-group" data-provides="fileinput">
                                                <div class="form-control" data-trigger="fileinput">
                                                    <i class="glyphicon glyphicon-file fileinput-exists"></i>
                                                    <span class="fileinput-filename"></span>
                                                </div>
                                                <span class="input-group-addon btn btn-default btn-file">
                                                    <span class="fileinput-new">Select file</span>
                                                    <span class="fileinput-exists">Change</span>
                                                    <input type="file" class="file ignore" accept=".pdf" />
                                                </span>
                                                <a href="#" class="input-group-addon btn btn-default fileinput-exists" data-dismiss="fileinput">Remove</a>
                                            </div>
                                        </div>
                                        <div class="col-md-2">
                                            <button type="button" class="btn-minus btn btn-danger"><i class="fa fa-minus"></i></button>
                                        </div>
                                    </div >`);
                count++;
            } else {
                swal({
                    title: "Important!",
                    text: "Your cannot upload more than 3 files.",
                    type: "warning",
                });
            }
        });

        $('.fileupload').on("click", '.btn-minus', function () {
            if (count > 0) {
                $(this).closest('.file-container').remove();
                count--;
            }
        });

        $('form[id="applicationForm"]').validate({
            rules: {
                ExtensionReason: {
                    required: true
                },
                SessionId: {
                    required: true
                },
                PeriodOfExtension: {
                    required: true
                }
            },
            messages: {
                SessionId: 'This field is required',
                PeriodOfExtension: 'This field is required',
                ExtensionReason: {
                    minlength: 'This field must be at least 8 characters long'
                }
            },
            submitHandler: function (form) {
                // Checking whether FormData is available in browser
                if (window.FormData !== undefined) {
                    // Create FormData object
                    var fileData = new FormData();

                    var fileUploads = $(".file");

                    jQuery.each(fileUploads, function (key, value) {
                        if (value.files[0] != undefined) {
                            //console.log(key + "," + value.files[0].name);
                            fileData.append(value.files[0].name, value.files[0]);
                        }
                    });

                    // Adding one more key to FormData object
                    fileData.append('ReasonForExtension', ExtensionReason.val());
                    fileData.append('PeriodOfExtensionSought', PeriodOfExtension.val());
                    fileData.append('SessionId', sessionId.val());

                    $.ajax({
                        url: '/Extensions/JSONApplicationForm/',
                        type: "POST",
                        contentType: false, // Not to set any content header
                        processData: false, // Not to process data
                        data: fileData,
                        success: function (result) {
                            swal({
                                title: "Success!",
                                text: "Your application for extension of duration of studies was saved successfully.",
                                type: "success",
                            }, function () {
                                window.location = "/";
                            });
                        },
                        error: function (err) {
                            swal({
                                title: "Important!",
                                text: "The form did not save. Please try again.",
                                type: "warning",
                            });
                        }
                    });
                } else {
                    swal({
                        title: "Important!",
                        text: "Your browser does not support file upload. Please use a different browser.",
                        type: "warning",
                    });
                }
            }
        });
    });
</script>
