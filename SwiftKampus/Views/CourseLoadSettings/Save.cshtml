@model SwiftKampusModel.CourseLoadSetting


<form id="myform" onsubmit="return false;">
    @Html.AntiForgeryToken()


    <div class="card">
        <div class="card-head style-primary">


        </div><!--end .card-head -->
        <div class="card-body">

            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            @if (Model != null && Model.CourseLoadSettingId > 0)
            {
                @Html.HiddenFor(model => model.CourseLoadSettingId)
            }
            <div class="form-group">
                @Html.Label("Department Option Name")
                @Html.DropDownList("ProgrammeId", null, htmlAttributes: new { @class = "form-control js-example-basic-single" })
                @Html.ValidationMessageFor(model => model.ProgrammeId, "", new { @class = "text-danger" })
            </div>
            <div class="form-group">
                @Html.Label("Level Name")
                @Html.DropDownList("LevelId", null, htmlAttributes: new { @class = "form-control js-example-basic-single" })
                @Html.ValidationMessageFor(model => model.LevelId, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.Label("Session Name")
                @Html.DropDownList("SessionId", null, htmlAttributes: new { @class = "form-control js-example-basic-single" })
                @Html.ValidationMessageFor(model => model.SessionId, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.Label("Maximum CreditLoad")
                @Html.EditorFor(model => model.MaximumCreditLoad, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.MaximumCreditLoad, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.Label("Minimum CreditLoad")
                @Html.EditorFor(model => model.MinimumCreditLoad, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.MinimumCreditLoad, "", new { @class = "text-danger" })
            </div>

            <div class="md-form">

                @if (Model != null && Model.CourseLoadSettingId > 0)
                {
                    <input id="btnsubmit" type="submit" value="Update" class="btn btn-success btn-lg" />
                }
                else
                {
                    <input id="btnsubmit" type="submit" value="Save" class="btn btn-success btn-lg" />
                }
                <a href="#" class="btn btn-danger btn-lg" data-dismiss="modal">Cancel</a>
            </div>
        </div><!--end .card-body -->
    </div><!--end .card -->
</form>
@*@section Scripts {
        @Scripts.Render("~/bundles/jqueryval")
    }*@

<script type="text/javascript">
    $(document).ready(function () {
        jQuery(function ($) {
            $('.js-example-basic-single').select2({
                dropdownParent: $('#myModalDivBody'),
                width: '100%',
                placeholder: 'Select an option...',
                allowClear: true
            });
        });
    });

    $("#btnsubmit").click(function () {

        var data = $("#myform").serialize();

        $.ajax({
            type: "POST",
            url: "/CourseLoadSettings/Save",
            data: data,
            success: function (data) {
                if (data.status) {
                    $('#actionsList').modal("hide");

                    window.oTable.ajax.reload(); //run my_fun() ondomready
                    toastr["success"](data.message);
                    $('#myform')[0].reset();
                } else {
                    //$('#actionsList').modal("hide");
                    toastr["error"](data.message);
                }

            }
        });
    });
</script>


