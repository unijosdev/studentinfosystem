<!-- Modal -->
<div class="modal fade inmodal" id="actionsList" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <!--Content-->
        <div class="modal-content animated">
            <!--Header-->
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <div class="flex-center">
                    <h4 class="modal-title">RELEVANT DOCUMENTS OPTION</h4>
                    @*<a class="btn btn-primary btn-sm">Create new action</a>*@
                </div>
            </div>
            <!--Body-->
            <div class="modal-body" id="myModalDivBody">
            </div>
        </div>
        <!--/.Content-->
    </div>
</div>
<!-- /.Modal-->

<script src="~/Scripts/jquery-3.1.1.min.js"></script>

<script type="text/javascript">
        $(document).ready(function () {

            window.oTable = $("#Jdatatable").DataTable({
                "processing": true, // for show progress bar while loading

                "ajax": {
                    "url": "/RelevantDocuments/GetIndex",
                    "type": "POST",
                    "datatype": "json"
                },
                "columns": [
                    { "data": "FileName", "autoWidth": true },
                    //{ "data": "FileAddress", "autoWidth": true },
                    {
                        "data": "RelevantDocumentId",
                        "autoWidth": true,
                        "render": function (data) {
                            return '<a href="#" onclick="Edit(' + data + ')" >  <i class="fa fa-pencil" aria-hidden="true" >&nbsp;View</i></a>&nbsp;&nbsp;' +
                                '<a href="#" class="text-danger" onclick="Delete(' + data + ')" ><i class="fa fa-remove" aria-hidden="true" >&nbsp;Remove<i /></a>';
                        }
                    }
                ]
            });

        });
        function Edit(programmeId) {
            var url = "/RelevantDocuments/Save?id=" + programmeId;
            $('#myModalDivBody').load(url,
                function () {
                    $('#actionsList').modal("show");
                });
        };
        function Delete(programmeId) {
            var url = "/RelevantDocuments/Delete?id=" + programmeId;
            $('#myModalDivBody').load(url,
                function () {
                    $('#actionsList').modal("show");
                });
        };
        function myFunction() {
            var url = "/RelevantDocuments/Save";

            $('#myModalDivBody').load(url,
                function () {
                    $('#actionsList').modal("show");
                });
        };

        $("#btnUploadeNext").click(function () {
            var info = $('.dataTables_empty').html();

            // Make sure at least one document is uploaded
            if (info === "No data available in table") {
                swal({
                    title: "Please upload at least one relevant document",
                    type: "warning",
                    confirmButtonText: "Ok",
                    closeOnConfirm: false,
                    closeOnCancel: false
                });
            }
            else {
            window.open('@Url.Action("PrintDetails", "Applicants")', '_self');
            }
        });

        $("#btnUploadPrevious").click(function () {
            $("#referee").click();
        });

        //$("#btnrefereePrevious").click(function () {
        //    $("#thesis").click();
        //});

</script>
