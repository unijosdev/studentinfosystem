@using SwiftKampus.Controllers


@{
    ViewBag.Title = "Index";
    //Layout = "~/Views/Shared/_Layout.cshtml";
    Layout = null;
    ApplicantTypeVm ApplicantType = (ApplicantTypeVm)ViewBag.ApplicantType;

}
<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">
        @*<div class="col-md-2"></div>*@
        <div class="col-md-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h4>List of Relevant Documents Option</h4>
                    <div class="ibox-tools">
                        <a onclick="myFunction()" class="btn btn-primary"><i class="fa fa-plus left"></i> ADD DOCUMENT</a>
                        @*<a class="collapse-link">
                                <i class="fa fa-chevron-up"></i>
                            </a>
                            <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                                <i class="fa fa-wrench"></i>
                            </a>*@
                    </div>
                </div>

                <div class=" col-md-12">
                    <div class="row ibox-content">
                        <div class="table-responsive">
                            <table style="width: 100%" id="Jdatatable" class="table table-striped table-bordered table-hover table-responsive dataTables-example">
                                <thead>
                                    <tr>
                                        <th>File Name</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                            </table>
                        </div>
                        <div class="row">
                            <div class="col-md-6">

                            </div>
                            <div class="col-md-6">
                                <a id="btnUploadeNext" href="#" class="btn btn-success btn-sm btnNext" data-dismiss="modal">FINISH</a>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
        <div class="col-md-2"></div>
    </div>
</div>
<br />
@*<div class="row">
        <div class="col-md-12">

            @if (ApplicantType.ApplicantType.Equals(ProgrammeCategory.Phd.ToString()))
            {
                ViewBag.Status2 = "PHD";
