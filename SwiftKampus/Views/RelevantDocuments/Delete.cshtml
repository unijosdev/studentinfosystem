@model SwiftKampusModel.AddmissionApplicant.RelevantDocument

@{
    ViewBag.Title = "Delete";
    Layout = null;
}

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Relevant Document</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>
            @Html.DisplayNameFor(model => model.FileName)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.FileName)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.FileAddress)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.FileAddress)
        </dd>

    </dl>

    <form id="mydeleteform" onsubmit="return false;">
        @Html.AntiForgeryToken()

        <div class="form-actions no-color">
            <input type="hidden" id="id" name="id" class="form-control" value="@Model.RelevantDocumentId">

            <input id="btndelete" type="submit" value="Delete" class="btn btn-default" /> |
            @Html.ActionLink("Back to List", "Index")
        </div>
    </form>
</div>

<script type="text/javascript">

    $("#btndelete").click(function () {
        var data = $("#mydeleteform").serialize();
        $.ajax({
            type: "POST",
            url: "/RelevantDocuments/Delete",
            data: data,
            success: function (data) {
                if (data.status) {
                    $('#actionsList').modal("hide");
                    window.oTable.ajax.reload(); //run my_fun() ondomready
                    toastr["info"](data.message);
                } else {
                    toastr["error"](data.message);
                }

            }
        });
    });
</script>
