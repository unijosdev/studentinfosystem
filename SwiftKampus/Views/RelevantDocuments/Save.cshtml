@model SwiftKampusModel.AddmissionApplicant.RelevantDocument
<link href="~/AdminTemplate/css/plugins/sweetalert/sweetalert.css" rel="stylesheet">

<input type="text" id="applicantType" value="@ViewBag.ApplicantType" hidden>

<form id="myUploadform" method="post" enctype="multipart/form-data" onsubmit="return false;">
    <div class="container-fluid">
    </div><!--end .card-head -->
    <div class="card-body">
        <div class="card-block">

            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        @Html.LabelFor(model => model.FileName)
                        @Html.EditorFor(model => model.FileName, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.FileName, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            <!-- Edit Form -->
        </div>
        <!--/.Card content-->
    </div>

    <div class="row">
        <div class="card">

            <div class="card-head style-primary">

            </div><!--end .card-head -->

            <div class="card-body">

                <!-- Card content -->
                <div class="card-block text-center">

                    <input class="btn btn-white btn-block" id="File" type="file" accept=".pdf, image/*" name="File" onchange="loadFile(event)">

                </div>
                <!-- /.Card content -->
            </div>
        </div>
        <!-- /.Card -->
    </div>
    <br />
    <div class="row">
        <div class="col-md-12 text-center">
            <input type="submit" value="Add Document" id="addDocument" class="btn btn-primary btn-lg">
        </div>
    </div>

</form>
<script src="~/AdminTemplate/js/plugins/sweetalert/sweetalert.min.js"></script>


<script>
    var loadFile = function (event) {
        var applicantType = $('#applicantType').val();
        var fileUpload = document.getElementById("File");

        // limit the file upload size to 500kb or less for undergraduate
        if (applicantType == "UnderGraduate") {
            if (typeof (fileUpload.files) !== "undefined") {
                var size = parseFloat(fileUpload.files[0].size / 1024).toFixed(2);
                if (size > 500) {
                    toastr["error"]("The image is bigger than the specified size of (500kb)");
                    var output = document.getElementById('output');
                    output.src = "#";
                    $('#addDocument').attr('disabled', 'true');
                } else {
                    var output2 = document.getElementById('output');
                    output2.src = URL.createObjectURL(event.target.files[0]);
                    $('#addDocument').removeAttr('disabled');
                }
            } else {
                alert("This browser does not support HTML5.");
            }
        }
        else {
            if (typeof (fileUpload.files) !== "undefined") {
                var size = parseFloat(fileUpload.files[0].size / 1024).toFixed(2);
                if (size > 200) {
                    toastr["error"]("The image is bigger than the specified size of (25kb)");
                    var output = document.getElementById('output');
                    output.src = "#";
                } else {
                    var output2 = document.getElementById('output');
                    output2.src = URL.createObjectURL(event.target.files[0]);
                }
            } else {
                alert("This browser does not support HTML5.");
            }
        }
    };

    $("#myUploadform").submit(function (e) {
        e.preventDefault();
        var formData = new FormData(this);
        var applicantType = $('#applicantType').val();

        $.ajax({
            url: "/RelevantDocuments/Save",
            type: 'POST',
            data: formData,
            success: function (data) {
                if (data.status) {
                    $('#actionsList').modal("hide");
                    window.oTable.ajax.reload(); //run my_fun() ondomready
                    swal({
                        title: "Document Saved Successfully",
                        //text: "Do you  Proceed?..",
                        type: "warning",
                        showCancelButton: true,
                        confirmButtonColor: "#ab973a",
                        confirmButtonText: "Proceed to print details!",
                        //cancelButtonText: "No, See Result List!",
                        closeOnConfirm: false,
                        closeOnCancel: false
                    },
                        function (isConfirm) {
                            if (isConfirm) {
                                //swal("Great!", "Proceed!!!.", "success");
                                //$("#olevel").click();
                                if (applicantType == "UnderGraduate") {
                                    window.open('@Url.Action("StudentFullDetail", "Students")', '_self');
                                } else {
                                 window.open('@Url.Action("PrintDetails", "Applicants")', '_self');
                                }
                                        
                            } else {
                                swal("Great", "You can click the next button to proceed", "success");
                            }
                        });
                    toastr["success"](data.message);
                } else {
                    swal({
                        title: "Warning",
                        text: data.message,
                        type: "warning",
                    });
                    toastr["success"](data.message);
                }


            },
            cache: false,
            contentType: false,
            processData: false
        });
    });


</script>


