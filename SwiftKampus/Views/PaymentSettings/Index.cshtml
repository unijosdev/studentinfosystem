@model IEnumerable<SwiftKampusModel.Payment.PaymentSetting>

@{
    ViewBag.Title = "Payment Setting";
}


<!-- Modal -->
<div class="modal fade inmodal" id="actionsList" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <!--Content-->
        <div class="modal-content  animated">
            <!--Header-->
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <div class="flex-center">
                    <h4 class="modal-title">SCHOOL PAYMENT SETTING</h4>
                    @*<a class="btn btn-primary btn-sm">Create new action</a>*@
                </div>
            </div>
            <!--Body-->
            <div class="modal-body" id="myModalDivBody">
            </div>
        </div>
        <!--/.Content-->
    </div>
</div>
<!-- /.Modal-->


<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h3>List of Payment Settings</h3>
                    <div class="ibox-tools">
                        <a href="#" onclick="myFunction()" class="btn btn-primary"><i class="fa fa-plus left"></i> ADD PAYMENT SETTING</a>
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                        <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                            <i class="fa fa-wrench"></i>
                        </a>
                    </div>
                </div>


                <div class="ibox-content">
                    <div class="table-responsive">
                        <table id="Jdatatable" class="table table-striped table-bordered table-hover table-responsive dataTables-example">
                            <thead>
                                <tr>
                                    <th>School Programme</th>
                                    <th>Student Type</th>
                                    <th>Session Name</th>
                                    <th>Consider Dept Fee</th>
                                    <th>Accept Part-Payment</th>
                                    <th>Consider Indigene</th>
                                    <th>Consider Nationality</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@*<a onclick="myFunction()" class="btn btn-primary btn-lg" data-toggle="modal" data-target="#actionsList"><i class="fa fa-plus left"></i> ADD DEPARTMENT</a>*@


<script src="~/Scripts/jquery-3.1.1.min.js"></script>

<script type="text/javascript">
    $(document).ready(function () {

        window.oTable = $("#Jdatatable").DataTable({
            "processing": true, // for show progress bar while loading

            "ajax": {
                "url": "/PaymentSettings/GetIndex",
                "type": "POST",
                "datatype": "json"
            },
            "columns": [
                { "data": "FancyName", "autoWidth": true },                
                { "data": "StudentType", "autoWidth": true },
                { "data": "SessionName", "autoWidth": true },
                { "data": "ConsiderDepartmentalFee", "autoWidth": true },              
                { "data": "AcceptPartPayment", "autoWidth": true },
                { "data": "ConsiderIndigine", "autoWidth": true },
                { "data": "ConsiderNationality", "autoWidth": true },
                {
                    "data": "PaymentSettingId",
                    "autoWidth": true,
                    "render": function (data) {
                        return '<a href="#"  onclick="Edit(' + data + ')" >  <i class="fa fa-pencil" aria-hidden="true" >&nbsp;Edit</i></a>&nbsp;&nbsp;' +
                            '<a href="#" class="text-danger" onclick="Delete(' + data + ')" ><i class="fa fa-remove" aria-hidden="true" >&nbsp;Remove<i /></a>';
                    }
                }
            ],
            responsive: true,
            dom: '<"html5buttons"B>lTfgitp',
            buttons: [
                { extend: 'copy'},
                {extend: 'csv'},
                {extend: 'excel', title: 'Payment Setting'},
                { extend: 'pdf', title: 'Payment Setting'},

                {extend: 'print',
                    customize: function (win){
                        $(win.document.body).addClass('white-bg');
                        $(win.document.body).css('font-size', '10px');

                        $(win.document.body).find('table')
                            .addClass('compact')
                            .css('font-size', 'inherit');
                    }
                }
            ]
        });

    });
    function Edit(paymentSettingId) {
        var url = "/PaymentSettings/Save?id=" + paymentSettingId;
     
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal('show');
            });
    };
    function Delete(paymentSettingId) {
        var url = "/PaymentSettings/Delete?id=" + paymentSettingId;
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
    };
    function myFunction() {
        var url = "/PaymentSettings/Save?id=0";
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
    };
  
</script>
