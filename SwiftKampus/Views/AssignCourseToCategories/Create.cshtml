@model SwiftKampusModel.AssignCourseToCategory

@{
    ViewBag.Title = "Assign Course To Category";
}
<link href="~/AdminTemplate/css/plugins/chosen/bootstrap-chosen.css" rel="stylesheet" />
<script src="~/Scripts/jquery-1.11.3.min.js"></script>
<script src="~/AdminTemplate/js/plugins/chosen/chosen.jquery.js"></script>

<div class="row wrapper border-bottom white-bg page-heading">
    <div class="col-lg-10">
        <h2>Assign Course Category</h2>
    </div>
    <div class="col-lg-3">
    </div>
</div>
<br />
@if (ViewBag.Message != null)
{
    <h2>@ViewBag.Message</h2>
}
<div class="row">
    <div class="col-sm-12">
        <div class="ibox float-e-margins">
            <div class="ibox-content">
                <div class="row">
                    <div class="col-md-2"></div>
                    <div class="col-md-8">
                        @using (Html.BeginForm())
                        {
                            @Html.AntiForgeryToken()

                            <div class="form-horizontal">

                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })


                                <div class="form-group">
                                    @Html.Label("Course Category Name")
                                    @Html.DropDownList("CourseCategoryId", null, htmlAttributes: new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.CourseCategoryId, "", new { @class = "text-danger" })
                                </div>

                                <div class="form-group">
                                    @Html.Label("Course Code")
                                    @Html.DropDownList("CourseId", null, htmlAttributes: new { @class = "form-control chosen-select", @multiple = "true" })
                                    @Html.ValidationMessageFor(model => model.CourseId, "", new { @class = "text-danger" })
                                </div>

                                <div class="form-group">
                                        <input type="submit" value="Assign Course Category" class="btn btn-primary btn-lg" />
                                </div>
                            </div>
                        }

                    </div>
                    <div class="col-md-2"></div>
                </div>


               

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

<script type="text/javascript">

    $('.chosen-select').chosen();
    $(function () {
        $('.listbox').multiselect({
            includeSelectAllOption: true
        });
    });
</script>
