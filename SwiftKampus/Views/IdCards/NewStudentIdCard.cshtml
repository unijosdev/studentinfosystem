@model IEnumerable<SwiftKampus.ViewModels.IdCardPrintVm>
@using SwiftKampus.Models


@if (Model != null && Model.Count() > 0)
{

    <table class="table">
        <tr>
            <th><input type="checkbox" name="Chk" id ="Chk" value="" onclick="selects()"></th>
            <th>Matric Number</th>
            <th>Full Name</th>
            <th>Programme</th>
            <th>Expiring Year</th>
            <th>Blood Group</th>
            <th>Count</th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <th> <input type="checkbox" name="StudentId" value="@item.StudentId" onchange="updateTotal(this, '@item.StudentId')"></th>
                <td>@item.MatricNumber</td>
                <td>@item.FullName</td>
                <td>@item.ProgrammeName</td>
                <td>@item.ExpiringYear</td>
                <td>@item.BloodGroup</td>
                <td>@item.PrintCount</td>
            </tr>
        }
    </table>
    <div class="form-group">
        <div class="col-md-offset-3 col-md-7">
            @if (Request.IsAuthenticated && User.IsInRole(RoleName.IdCardOperator))
            {
                <input id="printCard" type="button" value="Print Card(s)" class="btn btn-primary" />
                <span><input id="markAsPrint" type="button" value="Mark as Printed" class="btn btn-primary" /></span>
            }
            @if (Request.IsAuthenticated && User.IsInRole(RoleName.IdCardSupervisor))
            {
                <span><input id="markAsDispatch" type="button" value="Dispatch Card" class="btn btn-primary" /></span>
            }
        </div>
    </div>

}
else
{
    <h5 class="text-capitalize">No Record Found</h5>
}

<script src="~/Scripts/jquery-3.1.1.min.js"></script>

<script type="text/javascript">
    var studentList = [];

    function updateTotal(elem, studentId) {
        if ($(elem).is(':checked')) {
            studentList.push(studentId);
        } else {
            for (var i = 0; i < studentList.length; i++) {
                if (studentList[i] === studentId) {
                    studentList.splice(i, 1);
                }
            }
        }
    }


    $('#printCard').click(function () {
        for (var i = 0; i < studentList.length; i++) {
            var url = "/IdCards/ViewIdCard?id=" + studentList[i]
            window.open(url, "_blank", "toolbar=yes,scrollbars=yes,resizable=yes,top=500,left=396,width=330,height=400");
        }
    });

    $('#markAsPrint').click(function () {
        var data = {
            "StudentId": studentList
        };
        var Mydata = JSON.stringify(data);
        $.ajax({
            contentType: 'application/json',
            type: "POST",
            url: "/IdCards/MarkAsPrint",
            data: Mydata,
            success: function (data) {
                if (data.status) {
                    swal("Great!", data.message, "success");
                    toastr["success"](data.message);
                } else {
                    swal("Ooops!", data.message, "warning");
                    toastr["warning"](data.message);
                }
            }
        });
    });
    $('#markAsDispatch').click(function () {
        var data = {
            "StudentId": studentList
        };
        var Mydata = JSON.stringify(data);
        $.ajax({
            contentType: 'application/json',
            type: "POST",
            url: "/IdCards/DispatchAsPrint",
            data: Mydata,
            success: function (data) {
                if (data.status) {
                    swal("Great!", data.message, "success");
                    toastr["success"](data.message);
                } else {
                    swal("Ooops!", data.message, "warning");
                    toastr["warning"](data.message);
                }

            }
        });
    });

    function selects(){  
        var ele = document.getElementsByName('StudentId');

        if ($('#Chk').is(":checked")) {
            for (var i = 0; i < ele.length; i++) {
                ele[i].checked = true;
            }
        } else {
            for (var i = 0; i < ele.length; i++) {
                ele[i].checked = false;
            }
        }
        //for(var i=0; i<ele.length; i++){ 
        //    if(ele[i].type=='checkbox' && ele[i].checked == false )  
        //        ele[i].checked = true;
        //    else
        //        ele[i].checked = false;
        //}  
    }  

    function deSelect(){  
        var ele=document.getElementsByName('StudentId');  
        for(var i=0; i<ele.length; i++){  
            if(ele[i].type=='checkbox')  
                ele[i].checked=false;  
                      
        }  
    }             

</script>