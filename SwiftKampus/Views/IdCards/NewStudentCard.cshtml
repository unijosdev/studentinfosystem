@using SwiftKampus.Models
@{
    ViewBag.Title = "IDCard Request";
}
<link href="~/AdminTemplate/css/plugins/sweetalert/sweetalert.css" rel="stylesheet">
<link href="~/AdminTemplate/js/plugins/select2/select2.min.css" rel="stylesheet">

<style>

    .findStudent {
        display: flex;
        flex-direction: column;
        margin-bottom: 20px;
        margin-left: 1px;
    }

        .findStudent label {
            padding-left: 15px;
            margin-bottom: 15px;
            margin-top: -10px;
            font-size: 16px;
            font-weight: normal;
            color: #161616;
        }

        .findStudent .searchStudent {
            display: flex;
            margin-top: -10px
        }

        .findStudent input {
            height: 40px;
            border-radius: 3px;
        }

    .studentsDetail {
        margin-left: 15px;
        margin-right: 15px;
    }
</style>

<div class="container-fluid">
    <!-- First row -->
    <div class="row">
        <div class="col-md-12">
            <div class="wrapper wrapper-content animated fadeInRight">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="ibox float-e-margins">
                            <div class="ibox-title">
                                <h5>List of New ID Card Request</h5>
                                <div class="ibox-tools">
                                    @if (ViewBag.Message != null)
                                    {
                                        <div class="alert alert-success">
                                            <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
                                            <strong>@ViewBag.Message</strong>
                                        </div>
                                    }

                                    <a class="collapse-link">
                                        <i class="fa fa-chevron-up"></i>
                                    </a>
                                    <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                                        <i class="fa fa-wrench"></i>
                                    </a>
                                </div>
                                <div class="ibox-content">
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-2">
                                                <div class="form-group">
                                                    <label>School Programme</label>
                                                    @Html.DropDownList("SchoolProgrammeId", (SelectList)ViewBag.SchoolProgrammeId, "", new { @class = "form-control js-example-basic-single" })
                                                </div>
                                            </div>
                                            <div class="col-md-2">
                                                <div class="form-group">
                                                    <label>Faculty</label>
                                                    @Html.DropDownList("FacultyId", (SelectList)ViewBag.FacultyId, "", new { @class = "form-control js-example-basic-single", @onchange = "getDeptList()" })
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <label>Department</label>
                                                    @Html.DropDownList("DepartmentId", (SelectList)ViewBag.DepartmentId, "", new { @class = "form-control js-example-basic-single", @onchange = "getProgrammeList()" })
                                                </div>
                                            </div>
                                            <div class="col-md-5">
                                                <div class="form-group">
                                                    <label>Dept Option</label>
                                                    @Html.DropDownList("ProgrammeId", (SelectList)ViewBag.ProgrammeId, "", new { @class = "form-control js-example-basic-single", @onchange = "getCourseList()" })
                                                </div>
                                            </div>

                                            <div class="col-sm-2">
                                                <div class="form-group">
                                                    <label>Session Name</label>
                                                    @Html.DropDownList("SessionId", (SelectList)ViewBag.SessionId, "", new { @class = "form-control js-example-basic-single" })
                                                </div>
                                            </div>

                                        </div>
                                        <div class="row ">
                                            <div class="col-md-2">
                                                <div class="form-group">
                                                    <label> Status</label>
                                                    <select class="form-control dropdown" id="IsPrinted" name="IsPrinted">
                                                        <option value="false">Not Printed</option>
                                                        <option value="true">Printed</option>
                                                    </select>
                                                </div>
                                            </div>
                                            @if (Request.IsAuthenticated && User.IsInRole(RoleName.IdCardSupervisor))
                                            {
                                                <div class="col-md-2">
                                                    <div class="form-group">
                                                        <label> Dispatch</label>
                                                        <select class="form-control dropdown" id="IsDispatch" name="IsDispatch">
                                                            <option value="false">Not Dispatch</option>
                                                            <option value="true">Dispatch</option>
                                                        </select>
                                                    </div>
                                                </div>
                                            }
                                            <div class="col-md-2">
                                                <br />
                                                <button type="submit" id="btn-search" class="btn btn-primary">Search/View</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div><!--end .row -->
                        </div>
                    </div>

                    <div class="row findStudent">
                        <label>Search for a single student</label>
                        <div class="col-md-6 searchStudent">
                            <input type="text" name="id" id="studentId" value="" class="form-control" placeholder="Enter matric number" style="" />
                            <button id="findStudent" class="btn btn-primary" type="submit" style="margin-left:10px">Find student</button>
                        </div>
                    </div>
                    <p class="text-danger error" hidden>No student with such details found</p>

                    <div class="ibox-content studentsDetail" hidden>
                        <div class="table-responsive" id="idcard">

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<script src="~/Scripts/jquery-3.1.1.min.js"></script>
<script src="~/AdminTemplate/js/plugins/sweetalert/sweetalert.min.js"></script>
<script src="~/AdminTemplate/js/plugins/select2/select2.min.js"></script>

<script type="text/javascript">

    jQuery(function ($) {
        $('.js-example-basic-single').select2({
            placeholder: 'Select an option...',
            allowClear: true
        });
    });

    $(document).ready(function () {

        $('#btn-search').click(function () {
            $('#btn-search').attr('disabled', true);

            var url = "/IdCards/NewStudentIdCard?ProgrammeId=" + $('#ProgrammeId').val() + "&IsPrinted=" + $('#IsPrinted').val() +
            "&SessionId=" + $('#SessionId').val() + "&SchoolProgrammeId=" + $('#SchoolProgrammeId').val() + "&IsDispatch=" + $('#IsDispatch').val() +
            "&FacultyId=" + $('#FacultyId').val();

            $.ajax(
                $('#idcard').load(url)
            ).then(function () {
                $('#btn-search').attr('disabled', false);
                $('.studentsDetail').attr('hidden', false);
             })
        });

        // handles searching of a single student
        $('#findStudent').click(function () {

            $('#findStudent').attr('disabled', true);
            var id = $('#studentId').val();
            var url = "/IdCards/NewSingleStudentIdCard?id=" + id;

            $.ajax(
                $('#idcard').load(url)
            ).then(function () {
                $('#findStudent').attr('disabled', false);
                $('.studentsDetail').attr('hidden', false);
            })
        });

    });

    //$("#btn-search").click(function () {
    //    var url = "/IdCards/NewStudentIdCard?ProgrammeId=" + $('#ProgrammeId').val() + "&IsPrinted=" + $('#IsPrinted').val() +
    //        "&SessionId=" + $('#SessionId').val() + "&SchoolProgrammeId=" + $('#SchoolProgrammeId').val() + "&IsDispatch=" + $('#IsDispatch').val() +
    //        "&FacultyId=" + $('#FacultyId').val();
    //    jQuery.noConflict();
    //    $('#idcard').load(url);
    //});

    function Detail(studentId) {
        var url = "/Students/PartialDetails?id=" + $('#ProgrammeId').val();
        jQuery.noConflict();
        $('#mydetailBody').load(url);

    };



    function AddNew() {
        window.open('@Url.Action("Create", "Students")', '_self');
    };

    function getDeptList() {
        var facultyId = $("#FacultyId").val();
        $.ajax
            ({
                url: '/Students/GetDeptList?codeId=' + facultyId,
                type: 'GET',
                datatype: 'application/json',
                contentType: 'application/json',
                success: function (result) {
                    $("#DepartmentId").html("");
                    $.each($.parseJSON(result),
                        function (i, city) {
                            $("#DepartmentId").append($('<option></option>').val(city.DepartmentId).html(city.DeptName));
                        });

                },
                error: function () {
                    $("#DepartmentId").html("");
                    $("#ProgrammeId").html("");
                }
            });
    }
    function getProgrammeList() {
        var deptId = $("#DepartmentId").val();
        $.ajax
            ({
                url: '/Students/GetProgrammeList?codeId=' + deptId,
                type: 'GET',
                datatype: 'application/json',
                contentType: 'application/json',
                success: function (result) {
                    $("#ProgrammeId").html("");
                    $.each($.parseJSON(result),
                        function (i, city) {
                            $("#ProgrammeId").append($('<option></option>').val(city.ProgrammeId).html(city.ProgrammeName));
                        });
                },
                error: function () {
                    $("#ProgrammeId").html("");
                }
            });
    }
</script>
