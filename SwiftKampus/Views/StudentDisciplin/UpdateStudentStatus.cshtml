@model SwiftKampus.ViewModels.MisconductVm.FindStudent
@using Vereyon.Web;

@{
    ViewBag.Title = "Get Student";
}
<link href="~/AdminTemplate/css/plugins/sweetalert/sweetalert.css" rel="stylesheet">


<h2>Find Student</h2>

@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "applicationForm", @class = "applicationForm" }))
{
    <div class="ibox float-e-margins col-md-10 col-md-offset-1">
        <div class="ibox-title">
            <div class="form-horizontal">
                <h4>Search for student using Matriculation Number</h4>
                <hr />
                @Html.RenderFlashMessages()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="error">
                </div>
                <div class="form-group col-md-12">
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.MatricNumber, new { htmlAttributes = new { @class = "form-control", @id = "matricNumber", @placeholder = "Matriculation Number" } })
                        @Html.ValidationMessageFor(model => model.MatricNumber, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-2">
                        <a class="btn btn-default" data-toggle="modal" id="findStudent" data-whatever="mdo">Search</a>
                    </div>
                </div>
                <div class="form-group">
                </div>
            </div>
            <p>
                @Html.ActionLink("Back", "Index")
            </p>
        </div>
    </div>
}

<div class="modal fade" id="updateModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title" id="exampleModalLabel">Update Student Status</h3>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            @using (Html.BeginForm(null, null, FormMethod.Post, new { id = "notificationForm", @class = "notificationForm" }))
            {
                <div class="modal-body">
                    <div id="partialview">

                    </div>


                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <label for="message-text" class="col-form-label">Reason for Changing student's status:</label>
                        <textarea class="form-control" name="Reason_" id="Reason_" placeholder="Punishment served..."></textarea>
                    </div>

                </div>
                <div class="modal-footer" id="modal-footer">
                    <button type="submit" class="btn btn-primary" value="Submit" id="btnSave">Update Student</button>
                    <div id="response"></div>
                </div>
            }
        </div>
    </div>
</div>

<script src="~/AdminTemplate/js/jquery-3.1.1.min.js"></script>
<script src="~/AdminTemplate/js/plugins/sweetalert/sweetalert.min.js"></script>

<script>
    $(document).ready(function () {

        var Reason_ = $('#Reason_');

        $('form[id="notificationForm"]').validate({
            rules: {
                Reason_: {
                    required: true,
                    minlength: 10
                }
            },
            messages: {
                Reason_: {
                    minlength: 'This field must be at least 8 characters long'
                }
            },
            submitHandler: function (form) {
                var formData = {
                    Reason: $('#Reason_').val(),
                    studentId: $('#StudentId').val()
                };

                $.ajax({
                    type: "POST",
                    contentType: 'application/json',
                    //processData:false,
                    dataType: 'json',
                    url: "/StudentDisciplin/JSONUpdateStudentStatus/",
                    data: JSON.stringify(formData),
                    success: function (data) {
                        $('#Reason_').val("");

                        swal({
                            title: "Successful!",
                            text: data,
                            type: "success",
                        });

                        $("#updateModal").modal('toggle');
                    }
                });
            }
        });

        //find student using matriculation number
        $('#findStudent').on('click', function () {
            var MatNum = $("#matricNumber").val();
            var forData = { matriculationNumber: MatNum };

            $.ajax({
                url: "/StudentDisciplin/JSONReqestDetailsStudentStatus/",
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(forData),
                success: function (value) {
                    if (value.valueOf() == "null") {
                        console.log(value);
                        swal({
                            title: "Oops!",
                            text: "Student Not found! \n check and correct matriculation number",
                            type: "info",
                        });
                    }
                    else if (value.valueOf() == "redirect") {
                        console.log(value);
                        swal({
                            title: "Oops!",
                            text: "Student can only be activated after \n s/he has applied. check: showRecallRequestList",
                            type: "info",
                        });
                    }
                    else if (value.valueOf() == "case_not_treated") {
                        console.log(value);
                        swal({
                            title: "Oops!",
                            text: "Case has not been treated!",
                            type: "info",
                        });
                    } else {
                        $("#partialview").html(value);
                        console.log(value);
                        $("#updateModal").modal("show");
                    }

                }
            });
            //$("#updateModal").modal("show");

        });


    });
</script>
