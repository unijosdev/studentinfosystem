@model IEnumerable<SwiftKampus.ViewModels.MisconductVm.DefaultersViewModel>
@using Vereyon.Web
@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>
@Html.RenderFlashMessages()
<div class="col-lg-12">
    <div class="ibox float-e-margins">
        <div class="ibox-title">
            <h5>Students' Disciplinary Status Mgnt</h5>
            <div class="ibox-tools">
                @*<a class="btn-box-tool btn-sm btn-success" data-toggle="modal" data-target="#exampleModal" data-whatever="mdo">Send meeting notification</a>*@
                <a class="btn-box-tool btn-sm btn-success" href="@Url.Action("UpdateStudentStatus", "StudentDisciplin")">Update Student</a>
            </div>
        </div>
        <div class="ibox-content">

            <div>
                <div>
                    <div class="table-responsive">
                        <table id="example" class="table table-striped table-bordered table-hover dataTables-example">
                            <thead>
                                <tr>
                                    <th>S/N</th>
                                    <th>@Html.DisplayName("Matriculation Number")</th>
                                    <th>@Html.DisplayName("Fullname")</th>
                                    <th>@Html.DisplayName("Misconduct")</th>
                                    <th>@Html.DisplayName("Status")</th>
                                    <th>@Html.DisplayName("Action")</th>
                                    <th>@Html.DisplayName("Meeting Notification")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var sn = 0;
                                }
                                @foreach (var item in Model)
                                {
                                    sn += 1;
                                <tr>
                                    <td> @sn </td>
                                    <td> @Html.DisplayName(item.MatriculationNumber)</td>
                                    <td> @Html.DisplayName(item.FullName)</td>
                                    <td> @Html.DisplayName(item.MisconductName)</td>
                                    @if (item.CaseTreated == false)
                                    {
                                        <td> @Html.DisplayName("Case Pending")</td>
                                        <td>
                                            @Html.ActionLink("Treat Case", "Details", new { id = item.DefaulterId })
                                        </td>
                                    }
                                    else
                                    {
                                        <td> @Html.DisplayName("Case Treated")</td>
                                        <td>
                                            @Html.ActionLink("Edit Action", "Details", new { id = item.DefaulterId })
                                        </td>
                                    }

                                    @if (item.IsNotified == null)
                                    {
                                        <td>
                                            <a class="btn-sm btn-primary sendNotification" id="sendNotification" data-toggle="modal" data-target="#" data-defaulterid="@item.DefaulterId">Send notification</a>
                                        </td>
                                    }
                                    else if (item.IsNotified == true)
                                    {
                                        <td>
                                            <a class="btn-sm btn-success" data-whatever="mdo">notification sent</a>
                                        </td>
                                    }
                                    else
                                    {
                                        <td>
                                            <a class="btn-sm btn-danger resendNotification" id="resendNotification" data-defaulterid="@item.DefaulterId">Resend notification</a>
                                        </td>
                                    }
                                </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @*@foreach (var item in Model)
                    {

                    }*@

                </div>
                <p>
                    @Html.ActionLink("Back", "Index") 
                </p>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Send Notification</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">

                <form id="notificationForm" class="form-horizontal" data-toggle="validator">
                    @*@Html.AntiForgeryToken()*@
                    <div class="form-group">
                        <label for="recipient-name" class="col-form-label">Message Subject:</label>
                        <input type="text" name="mesgSubject" class="form-control" id="mesgSubject" placeholder="e.g. SUMMON TO APEAR BEFORE DISCIPLINARY COMMITTEE">
                    </div>

                    <div class="form-group">
                        <label for="recipient-name" class="col-form-label">Meeting Date:</label>
                        <input type="text" name="meetingDate" class="form-control" id="meetingDate" placeholder="e.g. 20th May, 2018">
                    </div>

                    <div class="form-group">
                        <label for="recipient-name" class="col-form-label">Meeting Time:</label>
                        <input type="text" name="meetingTime" class="form-control" id="meetingTime" placeholder="e.g. 8:00 AM">
                    </div>

                    <div class="form-group">
                        <label for="recipient-name" class="col-form-label">Meeting Venue:</label>
                        <input type="text" name="meetingVenue" class="form-control" id="meetingVenue" placeholder="e.g. Senate Chambers">
                    </div>

                    <div class="form-group">
                        <label for="message-text" class="col-form-label">Message:</label>
                        <textarea class="form-control" name="messageText" id="messageText" placeholder="Going by the incudence dated 12th June, 2017, you are thereby summuned to appear..."></textarea>
                    </div>
                    <input type="hidden" id="DefaulterId" name="">
                    <div class="modal-footer" id="modal-footer">
                        <button type="submit" class="btn btn-primary" value="Submit" id="btnSave">Send</button>
                        <div id="response"></div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


<script src="~/AdminTemplate/js/jquery-3.1.1.min.js"></script>
<script>
    $(document).ready(function () {
        //var Defaulterd = $(this).data('defaulterid');
        var MesgSubject = $('#mesgSubject');
        var MeetingDate = $('#meetingDate');
        var MeetingTime = $('#meetingTime');
        var MeetingVenue = $('#meetingVenue');
        var MessageText = $('#messageText');
        var id;

        $('#example').DataTable({
            pageLength: 25,
            responsive: true,
            dom: '<"html5buttons"B>lTfgitp',
            buttons: [
                { extend: 'copy' },
                { extend: 'csv' },
                { extend: 'excel', title: 'ExampleFile' },
                { extend: 'pdf', title: 'ExampleFile' },

                {
                    extend: 'print',
                    customize: function (win) {
                        $(win.document.body).addClass('white-bg');
                        $(win.document.body).css('font-size', '10px');

                        $(win.document.body).find('table')
                            .addClass('compact')
                            .css('font-size', 'inherit');
                    }
                }
            ]
        });

        $('.sendNotification').on('click', function () {
            $(this).val(id);
            $('#exampleModal').modal('show');
        });

        $('.resendNotification').on('click', function () {
           // var id = $(this).data('defaulterid');
            $(this).val(id);
            $('#exampleModal').modal('show');
        });

        $('form[id="notificationForm"]').validate({
            rules: {
                mesgSubject: {
                    required: true,
                    minlength: 5
                },
                meetingDate: {
                    required: true,
                    minlength: 5
                },
                meetingTime: {
                    required: true,
                    minlength: 5
                },
                meetingVenue: {
                    required: true,
                    minlength: 10
                },
                messageText: {
                    required: true,
                    minlength: 10
                }
            },
            messages: {
                mesgSubject: {
                    minlength: 'This field must be at least 5 characters long'
                },
                meetingDate: {
                    minlength: 'This field must be at least 5 characters long'
                },
                meetingTime: {
                    minlength: 'This field must be at least 5 characters long'
                },
                meetingVenue: {
                    minlength: 'This field must be at least 5 characters long'
                },
                messageText: {
                    minlength: 'This field must be at least 8 characters long'
                }
            },
            submitHandler: function (form) {
                var formData = {
                    mesgSubject: $('#mesgSubject').val(),
                    meetingDate: $('#meetingDate').val(),
                    meetingTime: $('#meetingTime').val(),
                    meetingVenue: $('#meetingVenue').val(),
                    messageText: $('#messageText').val(),
                    id: $('#DefaulterId').val()
                };

                $.ajax({
                    type: "POST",
                    contentType: 'application/json',
                    //processData:false,
                    dataType: 'json',
                    url: "/StudentDisciplin/JSONSendNotification/",
                    data: JSON.stringify(formData),
                    success: function (data) {
                        // clear HOD's comment
                        $('#mesgSubject').val("");
                        $('#meetingDate').val("");
                        $('#meetingTime').val("");
                        $('#meetingVenue').val("");
                        $('#messageText').val("");

                        swal({
                            title: "Successful!",
                            text: data,
                            type: "success",
                        });
                        
                        $("#updateModal").modal('toggle');
                    }
                });
            }
        });
    });
</script>





