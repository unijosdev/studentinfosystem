@model IEnumerable<SwiftKampus.ViewModels.MisconductVm.RecallRequestListViewModel>
@using Vereyon.Web
@{
    ViewBag.Title = "Index";
}
<link href="~/AdminTemplate/css/plugins/sweetalert/sweetalert.css" rel="stylesheet">

<h2>Index</h2>
@Html.RenderFlashMessages()
<div class="col-lg-12">
    <div class="ibox float-e-margins">
        <div class="ibox-title">
            <h5>Student Disciplinary Status</h5>
            <div class="ibox-tools">
                <a class="btn-box-tool btn-sm btn-success" data-toggle="modal" data-target="#exampleModal" data-whatever="mdo">Send meeting notification</a>

            </div>
        </div>
        <div class="ibox-content">

            <div>
                <div>
                    <div class="table-responsive">
                        <table id="example" class="table table-striped table-bordered table-hover dataTables-example">
                            <thead>
                                <tr>
                                    <th>S/N</th>
                                    <th>@Html.DisplayName("Matric Number")</th>
                                    <th>@Html.DisplayName("Fullname")</th>
                                    <th>@Html.DisplayName("Discipline")</th>
                                    <th>@Html.DisplayName("Recall Session")</th>
                                    <th>@Html.DisplayName("Application Reason")</th>
                                    <th>@Html.DisplayName("Status")</th>
                                    <th>@Html.DisplayName("Update")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var sn = 0;
                                }
                                @foreach (var item in Model)
                                {
                                    sn += 1;
                                    <tr>
                                        <td> @sn </td>
                                        <td> @Html.DisplayName(item.MatriculationNumber)</td>
                                        <td> @Html.DisplayName(item.FullName)</td>
                                        <td> @Html.DisplayName(item.DisciplineName)</td>
                                        <td> @Html.DisplayName(item.RecallSession.ToString())</td>
                                        <td> @Html.DisplayName(item.ReasonForRequest)</td>
                                        @if (item.ApplicationTreated == false)
                                        {
                                            <td> @Html.DisplayName("Application Pending")</td>
                                        }
                                        else
                                        {
                                            <td> @Html.DisplayName("Application Treated")</td>
                                        }

                                        <td>
                                            <a class="btn-sm btn-success matricNumber" id="matricNumber" data-matricnumber="@item.DefaulterId">Update</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @*@foreach (var item in Model)
                        {

                        }*@

                </div>
                <p>
                    @Html.ActionLink("Back", "Index") | <a class="btn btn-default" href="@Url.Action("UpdateStudentStatus", "StudentDisciplin")">Update Student</a>
                </p>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="updateModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title" id="exampleModalLabel">Update Student Status</h3>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            @using (Html.BeginForm(null, null, FormMethod.Post, new { id = "notificationForm", @class = "notificationForm" }))
            {
                <div class="modal-body">
                    <div id="partialview">

                    </div>


                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <label for="message-text" class="col-form-label">Reason for Changing student's status:</label>
                        <textarea class="form-control" name="Reason_" id="Reason_" placeholder="Punishment served..."></textarea>
                    </div>

                </div>
                <div class="modal-footer" id="modal-footer">
                    <button type="submit" class="btn btn-primary" value="Submit" id="btnSave">Update Student</button>
                    <div id="response"></div>
                </div>
            }
        </div>
    </div>
</div>

<script src="~/AdminTemplate/js/jquery-3.1.1.min.js"></script>
<script src="~/AdminTemplate/js/plugins/sweetalert/sweetalert.min.js"></script>

<script>
    $(document).ready(function () {

        $('#example').DataTable({
            pageLength: 25,
            responsive: true,
            dom: '<"html5buttons"B>lTfgitp',
            buttons: [
                { extend: 'copy' },
                { extend: 'csv' },
                { extend: 'excel', title: 'ExampleFile' },
                { extend: 'pdf', title: 'ExampleFile' },

                {
                    extend: 'print',
                    customize: function (win) {
                        $(win.document.body).addClass('white-bg');
                        $(win.document.body).css('font-size', '10px');

                        $(win.document.body).find('table')
                            .addClass('compact')
                            .css('font-size', 'inherit');
                    }
                }
            ]
        });

        var Reason_ = $('#Reason_');

        $('form[id="notificationForm"]').validate({
            rules: {
                Reason_: {
                    required: true,
                    minlength: 10
                }
            },
            messages: {
                Reason_: {
                    minlength: 'This field must be at least 8 characters long'
                }
            },
            submitHandler: function (form) {
                var formData = {
                    Reason: $('#Reason_').val(),
                    studentId: $('#StudentId').val()
                };

                $.ajax({
                    type: "POST",
                    contentType: 'application/json',
                    //processData:false,
                    dataType: 'json',
                    url: "/StudentDisciplin/JSONUpdateStudentStatus/",
                    data: JSON.stringify(formData),
                    success: function (data) {
                        $('#Reason_').val("");

                        swal({
                            title: "Successful!",
                            text: data,
                            type: "success",
                        });

                        $("#updateModal").modal('toggle');
                    }
                });
            }
        });

        $('.matricNumber').on('click', function () {
            var DefaulterId = $(this).data('matricnumber');
            var forData = { DefaulterId: DefaulterId };

            $.ajax({
                url: "/StudentDisciplin/JSONReqestGetStudentDetail/",
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(forData),
                success: function (value) {
                    $("#partialview").html(value);
                    console.log(value);
                    $("#updateModal").modal("show");
                }
            });
            $("#updateModal").modal("show");

        });

    });
</script>







