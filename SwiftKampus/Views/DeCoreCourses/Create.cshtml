@model SwiftKampusModel.DeCoreCourse

@{
    ViewBag.Title = "DE Courses";
}

<link href="~/AdminTemplate/css/plugins/chosen/bootstrap-chosen.css" rel="stylesheet" />
<link href="~/AdminTemplate/css/plugins/sweetalert/sweetalert.css" rel="stylesheet">

<div class="ibox float-e-margins">
    <div class="ibox-title">
        <h5>Add Course Prerequisite</h5>
        @if (ViewBag.Message != null)
        {
            <div class="alert alert-success">
                <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
                <strong>@ViewBag.Message</strong>
            </div>
        }
        <div class="ibox-tools">
            <a href="@Url.Action("Index","DeCoreCourses")" class="btn btn-primary">List of De Courses</a>

            <a class="collapse-link">
                <i class="fa fa-chevron-up"></i>
            </a>
            <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                <i class="fa fa-wrench"></i>
            </a>
        </div>
    </div>
    <div class="ibox-content">
        <form id="myform" onsubmit="return false;">            
            @Html.AntiForgeryToken()

            <div class="form-horizontal">
                <h4>DeCoreCourse</h4>
                <hr />
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="form-group">
                    @Html.LabelFor(model => model.ProgrammeId, "ProgrammeId", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-6">
                        @Html.DropDownList("ProgrammeId", null, htmlAttributes: new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.ProgrammeId, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.LabelFor(model => model.LevelId, "LevelId", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-6">
                        @Html.DropDownList("LevelId", null, htmlAttributes: new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.LevelId, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.CourseId, "CourseId", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-8">
                        @Html.DropDownList("CourseId", null, htmlAttributes: new { @class = "form-control chosen-select", @multiple = "true" })
                        @Html.ValidationMessageFor(model => model.CourseId, "", new { @class = "text-danger" })
                    </div>
                </div>



                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <input type="submit" id="btnsubmit" value="Add/Edit De Courses" class="btn btn-primary btn-lg" />
                    </div>
                </div>
            </div>
            </form>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
<script src="~/Scripts/jquery-1.11.3.min.js"></script>
<script src="~/AdminTemplate/js/plugins/chosen/chosen.jquery.js"></script>
<script src="~/AdminTemplate/js/plugins/sweetalert/sweetalert.min.js"></script>

<script type="text/javascript">

    $('.chosen-select').chosen();

    $("#btnsubmit").click(function () {

        var data = $("#myform").serialize();
        //alert(data);
        $.ajax({
            type: "POST",
            url: "/DeCoreCourses/Create",
            data: data,
            success: function (data) {
                if (data.status) {
                        swal({
                            title: "Good Job!!!",
                            text: "Did you want to add More De Course?..",
                            type: "warning",
                            showCancelButton: true,
                            confirmButtonColor: "#ab973a",
                            confirmButtonText: "Yes, Add More it!",
                            cancelButtonText: "No, See De Course List!",
                            closeOnConfirm: false,
                            closeOnCancel: false
                        },
                            function (isConfirm) {
                                if (isConfirm) {
                                    swal("Great!", "You can now add more.", "success");
                                } else {
                                    swal("Great", "You can now see your course list", "success");
                                    window.open('@Url.Action("Index", "DeCoreCourses")', '_self');

                                }
                            });
                        toastr["success"](data.message);
                    } else {
                        swal({
                            title: "Warning",
                            text: data.message,
                            type: "warning",
                        });
                        toastr["success"](data.message);
                    }

            }
        });
    });
</script>


