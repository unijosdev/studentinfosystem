@model IEnumerable<SwiftKampusModel.Accomodation.SessionAccomodation>

@{
    ViewBag.Title = "Index";
}
<script src="//code.jquery.com/jquery-1.11.3.min.js"></script>
<script src="//cdnjs.cloudflare.com/ajax/libs/chosen/1.4.2/chosen.jquery.min.js"></script>

<!-- Modal -->
<div class="modal fade modal-bf-fh" id="actionsList" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <!--Content-->
        <div class="modal-content">
            <!--Header-->
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <div class="flex-center">
                    <h4 class="modal-title">Session Accommodation</h4>
                    @*<a class="btn btn-primary btn-sm">Create new action</a>*@
                </div>
            </div>
            <!--Body-->
            <div class="modal-body" id="myModalDivBody">
            </div>
        </div>
        <!--/.Content-->
    </div>
</div>
<!-- /.Modal-->
<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">
        <div class="col-lg-12">
            <form id="Myform" onsubmit="return false;">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.Label("Payment Category")
                            @*@Html.DropDownList("SessionId", (SelectList)ViewBag.SessionId, "", new { @class = "form-control" })*@
                            <select class="form-control" id="Session_Id" name="Session_Id">
                                <option value=""></option>
                            </select>
                        </div>
                    </div>
                    @*<div class="col-md-6">
                    <div class="form-group">
                        @Html.Label("Faculty Name")
                        @Html.DropDownList("SessionId", (SelectList)ViewBag.SessionId, "", new { @class = "form-control" })
                    </div>
                </div>*@
                @*<div class="col-md-6">
                    <div class="form-group">
                        @Html.Label("Level Name")
                        @Html.DropDownList("LevelId", (SelectList)ViewBag.LevelId, "", new { @class = "form-control" })
                    </div>
                </div>*@
                    <div class="col-md-6">
                        <div class="md-form">
                            <br />
                            <input id="btnsubmit" type="submit" value="Get Record" class="btn btn-success btn-lg" />
                        </div>
                    </div>
                </div>

            </form>
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>List of Available Hostels</h5>
                    <div class="ibox-tools">
                        <a href="#" onclick="myFunction()" class="btn btn-primary"><i class="fa fa-plus left"></i> ADD SESSION ACCOMODATION</a>

                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                        <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                            <i class="fa fa-wrench"></i>
                        </a>

                    </div>

                    <!-- Row for search parameters -->
                    <div class="row" style="margin-top: 20px; margin-bottom: 10px;">
                        <div class="col-sm-4">
                            <div class="form-group">
                                <label>Session </label>
                                @Html.DropDownList("SessionId", (SelectList)ViewBag.SessionId, "", new { @class = "form-control" })
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Hostel</label>
                                @Html.DropDownList("HostelId", (SelectList)ViewBag.HostelId, "", new { @class = "form-control", @onchange = "getHostelBlockList()" })
                            </div>
                        </div>
                        <div class="col-sm-2">
                            <div class="form-group">
                                <label>Block</label>
                                <select class="form-control dropdown" id="hostelBlock" name="hostelBlock">
                                </select>
                            </div>
                        </div>
                        <div class="col-m-1">
                            <br />
                            <button type="submit" id="btn-search" class="btn btn-primary">Search/View</button>
                        </div>
                    </div>

                </div>
                <div class="ibox-content">

                    <div class="table-responsive">
                        <table id="Jdatatable" class="table table-striped table-bordered table-hover table-responsive dataTables-example">
                            <thead>
                                <tr>
                                    <th>Session Name</th>
                                    <th>Hostel Name</th>
                                    <th>Block Name</th>
                                    <th>Room Name</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                        </table>

                    </div>

                </div>
            </div>
        </div>
    </div>
</div>



<script src="~/Scripts/jquery-3.1.1.min.js"></script>

<script type="text/javascript">
    $(document).ready(function () {
       
        window.oTable = $("#Jdatatable").DataTable({
            "processing": true, // for show progress bar while loading
           
            "ajax": {
                "url": "/SessionAccomodations/GetIndex",
                "type": "POST",
                "datatype": "json",
                "data": function (d) {
                    d.sessionId = $('#SessionId').val();
                    d.hostelId = $('#HostelId').val();
                    d.blockId = $('#hostelBlock').val();
                }
            },
            "columns": [
                { "data": "SessionName", "autoWidth": true },
                { "data": "HostelName", "autoWidth": true },
                { "data": "BlockName", "autoWidth": true },
                { "data": "RoomName", "autoWidth": true },
                {
                    "data": "SessionAccomodationId",
                    "autoWidth": true,
                    "render": function (data) {
                        return '<a href="#" class="text-danger" data-toggle="modal" data-target="#actionsList"  onclick="Delete(' + data + ')" ><i class="fa fa-remove" aria-hidden="true" >&nbsp;Remove<i /></a>';
                    }
                }

                //{ "data": "EmailID", "autoWidth": true },
                //{ "data": "Phone", "autoWidth": true },
            ],
            dom: '<"html5buttons"B>lTfgitp',
            lengthMenu: [
                [10, 25, 50, 100, 200, 500, 1000, 2000, 4000, 5000],
                [10, 25, 50, 100, 200, 500, 1000, 2000, 4000, 5000]
            ],
            buttons: [
                {   extend: 'copy' },
                //{   pageLength: 'pageLength' },
                {   extend: 'csv'},
                {   extend: 'excel', title: 'Student List'},
                {   extend: 'pdf', title: 'Student List' },

                {
					extend: 'collection',
					text: 'Table control',
					buttons: [
						{
							collectionTitle: 'Visibility control',
							extend: 'colvis'
						}
					]
				},

                {extend: 'print',
                    customize: function (win){
                        $(win.document.body).addClass('white-bg');
                        $(win.document.body).css('font-size', '10px');

                        $(win.document.body).find('table')
                            .addClass('compact')
                            .css('font-size', 'inherit');
                    }
                }
            ]
        });

    });
    function Edit(sessionAccomodationId) {
        var url = "/SessionAccomodations/Save?id=" + sessionAccomodationId;
        $('#myModal').appendTo("body").modal('show');
        //window.alert(url);
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal('show');
            });
    };
    function Delete(sessionAccomodationId) {
        var url = "/SessionAccomodations/Delete?id=" + sessionAccomodationId;
        //$('#actionsList').modal("show");
        //window.alert(url);
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
    };
    function myFunction() {
        var url = "/SessionAccomodations/Save?id=0";
        // window.alert(url);
        $('#actionsList').modal('show');
        // $('#actionsList').modal("show");

       
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
    };

    function getHostelBlockList() {
        var hostelId = $("#HostelId").val();
        //alert(stateId);
        $.ajax
            ({
                url: '/SessionAccomodations/GetHostBlocks?hostelId=' + hostelId,
                type: 'GET',
                datatype: 'application/json',
                contentType: 'application/json',
                success: function (data) {
                    $("#hostelBlock").html("");
                    $("#hostelBlock").append($('<option></option>'));
                    $.each($.parseJSON(data),
                        function (i, city) {
                            //alert(result);
                            $("#hostelBlock").append($('<option></option>').val(city.BlockId).html(city.BlockName));
                        });

                },
                error: function () {
                    $("#hostelBlock").html("An error occured");
                }
            });
    }

    $("#btn-search").click(function () {
        window.oTable.ajax.reload();
    });

</script>