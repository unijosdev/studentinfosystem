@model SwiftKampusModel.Accomodation.SessionAccomodation

<link href="~/AdminTemplate/css/plugins/sweetalert/sweetalert.css" rel="stylesheet" />

<form id="myform" onsubmit="return false;">
    @Html.AntiForgeryToken()


    <div class="card">
        <div class="card-head style-primary">
            <header>
                @if (Model != null && Model.SessionAccomodationId > 0)
                {
                    <div class="form-header  purple darken-4">
                        <h3>
                            <i class="fa fa-save"></i> Update Record
                        </h3>
                    </div>
                }
                else
                {
                    <div class="form-header  purple darken-4">
                        <h3><i class="fa fa-save"></i> Save</h3>
                    </div>
                }
            </header>

        </div><!--end .card-head -->
        <div class="card-body">

            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            @if (Model != null && Model.SessionAccomodationId > 0)
            {
                @Html.HiddenFor(model => model.SessionAccomodationId)
            }
            <div class="form-group">
                @Html.Label("Session Name")
                @Html.DropDownList("SessionId", null, htmlAttributes: new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.SessionId, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.Label("Hostel Name")
                @Html.DropDownList("HostelId", (SelectList)ViewBag.HostelId, "", new { @class = "form-control", @onchange = "getAvailableBlocks()" })
                @Html.ValidationMessageFor(model => model.HostelId, "", new { @class = "text-danger" })
            </div>



            <!--<div class="form-group">
                @Html.Label("Block Name")-->
            @*@Html.EditorFor(model => model.BlockId, new { htmlAttributes = new { @class = "form-control" } })*@
            <!--@Html.DropDownList("BlockId", null, htmlAttributes: new { @class = "form-control chosen-select", @multiple = "true" })
                @Html.ValidationMessageFor(model => model.BlockId, "", new { @class = "text-danger" })
            </div>-->

            <div class="btn-group">
                <div class="blockList">

                </div>
            </div>

            <div class="md-form" style="margin-top: 20px;">

                @if (Model != null && Model.SessionAccomodationId > 0)
                {
                    <input id="btnsubmit" type="submit" value="Update" class="btn btn-success btn-lg" />
                }
                else
                {
                    <input id="btnsubmit" type="submit" value="Save" class="btn btn-success btn-lg" />
                }
                <a href="#" class="btn btn-danger btn-lg" style="margin-left: 10px;" data-dismiss="modal">Cancel</a>
            </div>
        </div><!--end .card-body -->
    </div><!--end .card -->
</form>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

<script src="~/AdminTemplate/js/plugins/sweetalert/sweetalert.min.js"></script>
<script type="text/javascript">

    $("#btnsubmit").click(function () {

        $("#btnsubmit").attr("disabled", "true");
        var data = $("#myform").serialize();

        $.ajax({
            type: "POST",
            url: "/SessionAccomodations/Save",
            data: data,
            success: function (data) {
                $("#btnsubmit").removeAttr("disabled");
                if (data.status) {
                    $('#actionsList').modal("hide");

                    window.oTable.ajax.reload(); //run my_fun() ondomready
                    toastr["success"](data.message);
                    $('#myform')[0].reset();
                } else {
                    //$('#actionsList').modal("hide");
                    toastr["error"](data.message);
                }

            }
        });
    });
    $('.chosen-select').chosen();
    $(function () {
        $('.listbox').multiselect({
            includeSelectAllOption: true
        });
    });

    function getAvailableBlocks() {

        var hostelId = $("#HostelId").val();
        var sessionId = $("#SessionId").val();
        //alert(stateId);
        $.ajax
            ({
                url: '/SessionAccomodations/GetAvailableBlocks?hostelId=' + hostelId + '&sessionId=' + sessionId,
                type: 'GET',
                datatype: 'application/json',
                contentType: 'application/json',
                success: function (data) {

                    //prevent adding of blocks that have been made available by displaying an error message
                    if (data == "[]") {
                        //alert("All the blocks in this hostel have already been made available!");
                        swal({
                            title: "All the blocks in this hostel have already been made available!",
                            type: "warning",
                            confirmButtonColor: "#ab973a",
                            confirmButtonText: "Okay",
                            closeOnConfirm: true,
                        })
                    };

                    $(".blockList").html("");
                    $.each($.parseJSON(data),
                        function (i, city) {
                            //alert(city);
                            //$(".blockList").append($('<option></option>').val(city.BlockId).html(city.BlockName));
                            $(".blockList").append($('<input type="checkbox">').val((city.BlockId)).attr({ id: "BlockId", name: "BlockId" }))
                            $(".blockList").append($('<label style="margin-left:8px">' + city.BlockName + '</label > <br>').attr("for", city.BlockName))
                        });
                },
                error: function () {
                    $("#hostel_Block").html("An error occured");
                }
            });
    }

</script>



