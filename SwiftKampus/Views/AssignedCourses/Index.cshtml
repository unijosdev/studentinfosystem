@model IEnumerable<SwiftKampusModel.AssignedCourse>

@{
    ViewBag.Title = "Assign Course";
}

<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">
        <div class="col-lg-8">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>List of Assigned Courses</h5>
                    <div class="ibox-tools">
                        <a onclick="myFunction()" class="btn btn-primary"><i class="fa fa-plus left"></i> ASSIGN COURSES</a>

                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                        <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                            <i class="fa fa-wrench"></i>
                        </a>

                    </div>
                    <div class="ibox-content">
                        <article class="margin-bottom-xxl">
                            <p class="lead">
                                Please use the following parameters to perform Query
                            </p>
                        </article>
                        <div class="card-body">
                            <form class="form-inline" id="formFilter" onsubmit="return false;">
                                <div class="row">

                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <label>School Programme</label>
                                            @Html.DropDownList("SchoolProgrammeId", (SelectList)ViewBag.SchoolProgrammeId, "", new { @class = "form-control", @style = "width:160px" })
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="form-group">
                                            <label>Session Name</label>
                                            @Html.DropDownList("SessionId", (SelectList)ViewBag.SessionId, "", new { @class = "form-control" })
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <br />
                                        <button type="submit" id="btn-search" class="btn btn-primary pull-right">Search/View</button>
                                    </div>
                                </div>

                            </form>
                        </div><!--end .row -->

                    </div>
                </div>
                <div class="ibox-content">

                    <div class="table-responsive">
                        <table id="Jdatatable" class="table table-striped table-bordered table-hover table-responsive dataTables-example">
                            <thead>
                                <tr>
                                    <th>Course Name</th>
                                    <th>Staff Name</th>
                                    <th>Session Name</th>
                                    <th>Semester Name</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                        </table>

                    </div>

                </div>
            </div>
        </div>

        <!-- Second column -->
        <div class="col-md-4">
            <div class="ibox-content">
                <h3>Search for course cordinators outside your department</h3>
                <div class="row">
                    <div class="col-sm-7">
                        <div class="form-group">
                            <label>Dept Option</label>
                            @Html.DropDownList("ProgrammeId", (SelectList)ViewBag.ProgrammeId, "", new { @class = "form-control js-example-basic-single", @onchange = "getCourseList()" })
                        </div>
                    </div>

                    <div class="col-md-5">
                        <div class="form-group">
                            <label>Course Name</label>
                            @Html.DropDownList("CourseId", (SelectList)ViewBag.CourseId, "", new { @class = "form-control js-example-basic-single", @onchange = "getCourseCord()" })
                        </div>
                    </div>

                </div>
                <div class="card contact-card with-padding">
                    <div class="card-body" id="mydetailBody">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade modal-bf-fh inmodal" id="actionsList" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <!--Content-->
        <div class="modal-content animated">
            <!--Header-->
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <div class="flex-center">
                    <h4 class="modal-title">ASSIGN COURSE</h4>
                    @*<a class="btn btn-primary btn-sm">Create new action</a>*@
                </div>
            </div>
            <!--Body-->
            <div class="modal-body" id="myModalDivBody">
            </div>
        </div>
        <!--/.Content-->
    </div>
</div>
<!-- /.Modal-->
@*<script src="~/Scripts/jquery-1.11.3.min.js"></script>*@
<script src="~/Scripts/jquery-3.1.1.min.js"></script>
<link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.9/css/select2.min.css" rel="stylesheet" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.9/js/select2.min.js"></script>

<script type="text/javascript">
    $(document).ready(function () {
        if ("@ViewBag.Message") {
            toastr["success"]("@ViewBag.Message");
        }

        $('.chosen-select').chosen();

        $('.js-example-basic-single').select2({
          placeholder: 'Select an option...',
          allowClear: true
        });

        window.oTable = $("#Jdatatable").DataTable({
            "processing": true, // for show progress bar while loading
            //"serverSide": true, // if it is true the preocess is done on server side
            //"filter": true, // disables search box
            //"info": true,
            //"stateSave": true,
            //"orderMulti": false, // disable multiple column loading at once
            "ajax": {
                "url": "/AssignedCourses/GetIndex",
                "type": "POST",
                "data": function (d) {
                    return $('#formFilter').serialize();
                },
                "datatype": "json"
            },
            "columns": [
                { "data": "CourseName", "autoWidth": true },
                { "data": "FullName", "autoWidth": true },
                { "data": "SessionName", "autoWidth": true },
                { "data": "SemesterName", "autoWidth": true },

                {
                    "data": "AssignedCourseId",
                    "autoWidth": true,
                    "render": function (data) {
                        return '<a onclick="Edit(' + data + ')" >  <i class="fa fa-pencil" aria-hidden="true" >&nbsp;Edit</i></a>&nbsp;&nbsp;' +
                            '<a class="text-danger" onclick="Delete(' + data + ')" ><i class="fa fa-remove" aria-hidden="true" >&nbsp;Remove<i /></a>';
                    }
                }

                //{ "data": "EmailID", "autoWidth": true },
                //{ "data": "Phone", "autoWidth": true },
            ]
        });

    });

    $("#btn-search").click(function () {
        window.oTable.ajax.reload();
    });

    function Edit(assignedCourseId) {
        var url = "/AssignedCourses/Save?id=" + assignedCourseId;
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
    };
    function Delete(assignedCourseId) {
        var url = "/AssignedCourses/Delete?id=" + assignedCourseId;
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
    };
    function myFunction() {
        var url = "/AssignedCourses/Create";
        window.open('' + url + '', '_self');
        //$('#myModalDivBody').load(url,
        //    function () {
        //        $('#actionsList').modal("show");
        //    });
    };

    function getCourseList() {
        var programmeId = $("#ProgrammeId").val();
        $.ajax
            ({
                url: '/Students/GetCourseCodeList?codeId=' + programmeId,
                type: 'GET',
                datatype: 'application/json',
                contentType: 'application/json',
                success: function (result) {
                    $("#CourseId").html("");
                    $.each($.parseJSON(result),
                        function (i, city) {
                            $("#CourseId").append($('<option></option>').val(city.CourseId).html(city.CourseCode));
                        });
                },
                error: function () {
                    $("#CourseId").html("");
                }
            });
    }

    function getCourseCord() {
        var programmeId = $("#CourseId").val();
        url = '/AssignedCourses/ElectiveLecturerGet?codeId=' + programmeId,
            $('#mydetailBody').load(url);
    }

    function assignElectiveCorse() {
        var staffId = $("#staffId").val();
        var electivCourseId = $("#ElectiveCourseId").val();

        $.ajax
            ({
                url: '/AssignedCourses/AssignElectiveCourse?courseId=' + electivCourseId + '&staffId=' + staffId,
                type: 'GET',
                datatype: 'application/json',
                contentType: 'application/json',
                success: function (result) {
                    if (result.status) {
                        swal('success', result.message);
                    } else {
                        swal('info', "Oops! something went wrong");
                    }
                },
                error: function () {
                    $("#CourseId").html("");
                }
            });
    }
</script>