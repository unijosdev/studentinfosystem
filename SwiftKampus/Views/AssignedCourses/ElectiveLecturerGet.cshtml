@model IEnumerable<SwiftKampus.ViewModels.StaffAssigendCourseVm>


@{
    ViewBag.Title = "Error";
    Layout = null;
}

<div class="row">
    <div class="col-lg-12 text-center">
        <h5 class="text-light">Assign Elective Course to this Lecturer</h5>
        <h1 class="text-danger"> </h1>
        <h3>@ViewBag.ErrorInfo</h3>
        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-warning">
                <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
                <strong>@ViewBag.ErrorMessage</strong>
            </div>
        }
        @if (Model != null && Model.Count() > 0)
        {
            <div class="ibox-content">
                <div class="table-responsive">
                    <table id="Jdatatable" class="table table-striped table-bordered table-hover table-responsive">
                        <thead>
                            <tr>
                                <td>name</td>
                                <td>course</td>
                                <td>assign course</td>

                            </tr>
                        </thead>

                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.StaffName</td>
                                <td> @Html.DropDownList("ElectiveCourseId", null, htmlAttributes: new { @class = "form-control chosen-select", })</td>
                                <td><a onclick="assignElectiveCorse()" class="btn btn-sm btn-primary"> <i class="fa fa-plus left"></i></a></td>

                            </tr>
                            <input type="hidden" name="staffId" id="staffId" value="@item.StaffId" />
                        }
                    </table>
                </div>
            </div>
        }

        @if (ViewBag.LineError != null)
        {
            <div class="alert alert-danger">
                <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
                <strong>@ViewBag.LineError</strong>
            </div>
        }

        @if (ViewBag.Message != null)
        {
            <div class="alert alert-success">
                <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
                <strong>@ViewBag.Message</strong>
            </div>
        }
    </div><!--end .col -->
</div><!--end .row -->

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
<script type="text/javascript">

    $('.chosen-select').select2({
          placeholder: 'Select an option...',
          allowClear: true
        });
</script>

