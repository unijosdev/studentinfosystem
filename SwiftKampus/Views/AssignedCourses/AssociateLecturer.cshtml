                "url": "/AssignedCourses/GetAssociateLecturer?id=" + id,
                "type": "POST",
                "datatype": "json"
            },
            "columns": [
                { "data": "StaffId", "autoWidth": true },
                { "data": "FullName", "autoWidth": true },
                { "data": "PhoneNumber", "autoWidth": true },
                { "data": "CourseName", "autoWidth": true },
                { "data": "DeptName", "autoWidth": true },
               
