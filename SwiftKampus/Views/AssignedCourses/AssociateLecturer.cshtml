
<div class="card-head style-primary">
    <header>
        <h3>List of Associate Lecturer</h3>
    </header>

</div>
<br />

<table id="JdatatableStaff" class="table table-striped table-hover">
    <thead>
    <tr>
        <th>Staff Id</th>
        <th>FullName</th>
        <th>Phone Number</th>
        <th>Course Name</th>
        <th>Dept Name</th>

    </tr>
    </thead>
</table>


