
@{
    ViewBag.Title = "UpdateApplicantProgrammeForForms";
    //Layout = "~/Views/Shared/_LayoutWebSite2.cshtml";
}

<h2>UpdateApplicantProgrammeForForms</h2>

<div class="ibox-content">
    <div class="wrapper wrapper-content animated fadeInRight">
        <div class="row">
            <div class="col-lg-12">
                <div class="ibox float-e-margins">
                    <div class="ibox-title">
                        <h2>Change User Email</h2>

                        <div class="ibox-tools">

                            <a class="collapse-link">
                                <i class="fa fa-chevron-up"></i>
                            </a>
                        </div>
                    </div>

                    <h3 class="text-danger">@ViewBag.Message</h3>
                    @using (Html.BeginForm("UpdateApplicantProgrammeForForms", "Applicants", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Get, new { @class = "form", role = "form" }))
                    {
                        @Html.AntiForgeryToken()
                        <div class="form-group">
                            <div class="col-sm-4">
                                <label>School </label>
                                @Html.DropDownList("SchoolProgrammeId", (SelectList)ViewBag.SchoolProgrammeId, "", new { @class = "form-control" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-4">
                                <label for="Id">Applicant Email</label>
                                <input id="Email" name="Email" class="form-control" type="text" placeholder="Applicant Email" />

                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-2">
                                <label for="Id"></label>
                                <button class="btn btn-primary btn-sm" type="submit">Update Record<span class="icon-more-icon"></span></button>
                            </div>
                        </div>
                    }
                    <br />
                </div>
            </div>
        </div>
    </div>
</div>

