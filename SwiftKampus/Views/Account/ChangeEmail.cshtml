
@{
    ViewBag.Title = "ChangeEmail";
}

<div class="ibox-content">
    <div class="wrapper wrapper-content animated fadeInRight">
        <div class="row">
            <div class="col-lg-12">
                <div class="ibox float-e-margins">
                    <div class="ibox-title">
                        <h2>Change User Email</h2>

                        <div class="ibox-tools">

                            <a class="collapse-link">
                                <i class="fa fa-chevron-up"></i>
                            </a>
                        </div>
                    </div>

                    <h3 class="text-danger">@ViewBag.Message</h3>
                    @using (Html.BeginForm("ChangeEmail", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Get, new { @class = "form", role = "form" }))
                    {
                        <div class="form-group">
                            <div class="col-md-4">
                                <label for="Id">Jamb RegNo/Email</label>
                                <input id="Id" name="id" class="form-control" type="text" placeholder="Jamb RegNo/Email" />
                                <br />
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-md-4">
                                @Html.Label("Category")
                                @Html.DropDownList("ChangeDetailFeeId", null, htmlAttributes: new { @class = "form-control" })
                                <br />
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-md-4">
                                @Html.Label("Student Category")
                                @Html.DropDownList("StudentType", null, htmlAttributes: new { @class = "form-control" })
                                <br />
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-md-6">
                                <label for="Email">Remita Retrieval Reference (RRR)</label>
                                <input id="rrr" name="rrr" class="form-control" type="number" placeholder="RRR" />
                                <br />
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-md-6">
                                <label for="Email">New Correct Email</label>
                                <input id="Email" name="Email" class="form-control" type="email" placeholder="Email" />
                                <br />
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-md-7">
                                <button class="btn btn-primary btn-lg" type="submit">Update Record<span class="icon-more-icon"></span></button>
                            </div>
                        </div>
                    }
                    <br />
                </div>
            </div>
        </div>
    </div>
</div>

