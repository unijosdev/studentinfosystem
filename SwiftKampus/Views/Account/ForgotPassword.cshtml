@model SwiftKampus.Models.ForgotPasswordViewModel
@using SwiftKampus.Models

@{
    ViewBag.Title = "Forgot your password?";
    Layout = "~/Views/Shared/_LayoutWebSite2.cshtml";

}
<link href="~/Content/my_css/footer.css" rel="stylesheet" />



<section class="divider">
    <div class="container">
        <div class="row">
            <div class="col-md-8 col-md-push-2">
                <div class="border-1px p-20 mb-0" style="border: 1px solid #cac9c9 !important;">
                    <div class="row">
                        <div class="col-md-6 border-right">
                            <h4>@ViewBag.Title.</h4>

                            <h5>Please type in your registered Email Address and we will send you a recovery Link</h5>
                            <hr />
                            <a class="btn btn-primary btn-sm" href="@Url.Action("Login","Account")">Back to Login Page</a>

                        </div>

                        <div class="col-md-6">
                            <div class="col-md-12">                          

                                <h4 class="text-center">Enter your email.</h4>
                                @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
                                {
                                    @Html.AntiForgeryToken()

                                    <br />
                                    @Html.ValidationSummary("", new { @class = "text-danger" })
                                    <div class="form-group">
                                        <div class="col-md-12">
                                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", @placeholder = "Enter your email here" })
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <div class="col-md-offset-4 col-md-10">
                                            <input type="submit" class="btn btn-primary" value="Email Link" />
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
        </div>
    </div>
    </div>

</section>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
