@model SwiftKampus.Models.RegisterViewModel
@using SwiftKampus.Models
@{
    ViewBag.Title = "Student Registration";
    Layout = "~/Views/Shared/_LayoutWebSite2.cshtml";


}

<section class="divider">
    <div class="container">
        <div class="row">
            <div class="col-md-8 col-md-push-2">
                <div class="border-1px p-20 mb-0" style="border: 1px solid #cac9c9 !important;">

                    <div class="row">

                        <div class="col-md-6 border-right">
                            <div class="col-md-12">
                                @if (Model.IsNewStudent)
                                {
                                    <h4 class="text-success text-center bold text-xl-center">
                                        Congratulations!!! <br />
                                        You have been offered Provisional Admission
                                    </h4>
                                }
                                <h5 class="text-center">
                                    Please read the following Instructions.
                                </h5>
                                <ul class="list check">
                                    <li>Be sure your detail is correct before you proceed.</li>
                                    @if (!string.IsNullOrEmpty(Model.Email))
                                    {
                                        <li>Confirm or Edit that your email is the <span class="text-danger">Current and Active</span> Email Address.</li>
                                    }
                                    else
                                    {
                                        <li>Type in your <span class="text-danger">Current and Active</span> Email Address.</li>
                                    }
                                    <li>Update your current  <span class="text-danger">Level</span></li>
                                    <li>Use a simple and easy to remember <span class="text-danger">Password</span></li>
                                    <li>The Grey text-fields cannot be edited.</li>
                                </ul>
                                <p class="text-danger">@ViewBag.Message</p>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="col-md-12">
                                @using (Html.BeginForm("RegisterStudent", "Account", FormMethod.Post, new { role = "form" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <p class="text-danger">@ViewBag.Message</p>
                                    @Html.HiddenFor(m => m.StudentId)
                                    @Html.ValidationSummary("", new { @class = "text-danger" })

                                    <div class="form-group">
                                        @Html.LabelFor(m => m.FirstName)
                                        @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control", @readonly = true })
                                    </div>

                                    <div class="form-group">
                                        @Html.LabelFor(m => m.LastName)
                                        @Html.TextBoxFor(m => m.LastName, new { @class = "form-control", @readonly = true })
                                    </div>

                                    @*<div class="form-group">
                                            @Html.LabelFor(m => m.StudentId)
                                            @Html.TextBoxFor(m => m.StudentId, new { @class = "form-control", @readonly = true })
                                        </div>*@

                                    <div class="form-group">
                                        @Html.LabelFor(m => m.Department)
                                        @Html.TextBoxFor(m => m.Department, new { @class = "form-control", @readonly = true })
                                    </div>
                                    if (Model.IsRemedial.Equals(false))
                                    {
                                        <div class="form-group">
                                            @Html.Label("Current Level")
                                            @Html.DropDownList("LevelId", (SelectList)ViewBag.LevelId, "", new { @class = "form-control" })
                                            @Html.ValidationMessageFor(model => model.LevelId, "", new { @class = "text-danger" })
                                        </div>
                                    }

                                    if (Model.IsNewStudent)
                                    {
                                        <div class="form-group">
                                            @Html.LabelFor(m => m.Email)
                                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="form-group">
                                            @Html.LabelFor(m => m.Email)
                                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", @readonly = true })
                                            @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
                                        </div>
                                    }

                                        <div class="form-group">
                                            <div class="password-wrapper">
                                                @Html.LabelFor(m => m.Password)
                                                @Html.PasswordFor(m => m.Password, new { @class = "form-control password" })
                                                <button class="unmask" type="button" title="Mask/Unmask password to check content">Unmask</button>
                                                @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger" })
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <div class="password-wrapper">
                                                @Html.LabelFor(m => m.ConfirmPassword)
                                                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control password" })
                                                <button class="unmask" type="button" title="Mask/Unmask password to check content">Unmask</button>
                                                @Html.ValidationMessageFor(model => model.ConfirmPassword, "", new { @class = "text-danger" })
                                            </div>
                                        </div>

                                            <div class="form-group">

                                                <input type="submit" class="btn btn-primary block col-md-12" value="Sign Up" />
                                            </div>
                                            }
                                        </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
