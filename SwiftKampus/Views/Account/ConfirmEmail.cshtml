@using SwiftKampus.Models

@{
    ViewBag.Title = "Confirm Email";
    Layout = "~/Views/Shared/_LayoutWebSite2.cshtml";
}

<link href="~/Content/my_css/footer.css" rel="stylesheet" />

<section class="divider">
    <div class="container">
        <div class="row">
            <div class="col-md-6 col-md-push-3">
                <div class="border-1px p-20 mb-0" style="border: 1px solid #cac9c9 !important;">
                    <div class="row">
                        <div class="col-md-12">
                            <h2>Email Confirmed Successfully</h2>
                            <div>
                                <p class="text-center">
                                    Thank you for confirming your email. Please @Html.ActionLink("Click here to Log in", "Login", "Account", routeValues: null, htmlAttributes: new { id = "loginLink" })
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
