
@{
    ViewBag.Title = "Search Email";
}

<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h2>Search Email</h2>

                    <div class="ibox-tools">

                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                    <h2 class="text-success">@ViewBag.Message</h2>
                    @using (Html.BeginForm("SearchEmail", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Get, new { @class = "form", role = "form" }))
                    {
                        <div class="form-group">
                            <div class="col-md-7">
                                <label for="Id">Jamb RegNo/Email</label>
                                <input id="Id" name="id" class="form-control" type="text" placeholder="Jamb RegNo/Email" />
                            </div>
                        </div>
                        <br />
                        <div class="form-group">
                            <button class="btn btn-primary btn-lg" type="submit">Search Email<span class="icon-more-icon"></span></button>
                        </div>
                    }

                    <br />
                    <br />
                    <br />

                </div>
            </div>
        </div>
    </div>
</div>

