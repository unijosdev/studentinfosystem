@{
    ViewBag.Title = "Forgot Password Confirmation";
    Layout = "~/Views/Shared/_LayoutWebSite2.cshtml";

    var schoolImage = @System.Configuration.ConfigurationManager.AppSettings["SchoolImage"];

}
<link href="~/Content/my_css/footer.css" rel="stylesheet" />



<section class="divider">
    <div class="container">
        <div class="row">
            <div class="col-md-8 col-md-push-2">
                <div class="border-1px p-20 mb-0" style="border: 1px solid #cac9c9 !important;">
                    <div class="row">
                        <div class="col-md-6 border-right">
                            <h4>@ViewBag.Title</h4>
                            <h5>
                                Please check your email to reset your password.
                            </h5>
                            <hr />
                            <a class="btn btn-primary btn-sm" href="@Url.Action("Login","Account")">Back to Login Page</a>

                        </div>
                       
                      
                        <div class="col-md-6">
                            <div class="col-md-12">
                                <p class="text-center">We have Successfully sent a recovery email to the registered email Address.</p>
                                <p class="text-center">Please follow subsequent instructions to complete the password recovery process.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
