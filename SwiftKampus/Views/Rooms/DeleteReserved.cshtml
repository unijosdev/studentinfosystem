@model SwiftKampusModel.Accomodation.ReservedRoom

@{
    ViewBag.Title = "Remove Reserved Room";
}


<div class="card">
    <div class="card-head style-primary">
        <header>
            <h3>
                <i class="fa fa-remove"></i> Delete Reserved Room
            </h3>
        </header>

    </div><!--end .card-head -->
    <div class="card-body">
        <h3>Are you sure you want to delete this?</h3>
        <div>
            <dl class="dl-horizontal">
              

                <dt>
                    Room Name
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.Room.RoomName)
                </dd>

                <dt>
                   Room Capacity
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.Room.RoomCapacity)
                </dd>

            </dl>

            <form id="myform" onsubmit="return false;">
                @Html.AntiForgeryToken()

                <input type="hidden" id="id" name="id" class="form-control" value="@Model.ReservedRoomId">
                <input id="btndelete" type="submit" value="Delete" class="btn btn-danger" /> |

                <a href="#" class="btn btn-info" data-dismiss="modal">Cancel</a>
            </form>
        </div>
    </div>
</div>

<script type="text/javascript">

    $("#btndelete").click(function () {

        var data = $("#myform").serialize();
        //window.alert(data);
        $.ajax({
            type: "POST",
            url: "/Rooms/DeleteReserved",
            data: data,
            success: function (data) {
                if (data.status) {
                    $('#actionsList').modal("hide");
                    window.oTable.ajax.reload(); //run my_fun() ondomready

                    toastr["info"](data.message);
                    $('#myform')[0].reset();
                } else {
                    //$('#actionsList').modal("hide");
                    toastr["error"](data.message);
                }

            }
        });
    });
</script>
