
@{
    ViewBag.Title = "Reserved Index";
}


<!-- Modal -->
<div class="modal fade modal-bf-fh" id="actionsList" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <!--Content-->
        <div class="modal-content">
            <!--Header-->
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <div class="flex-center">
                    <h4 class="modal-title">RESERVED ROOM</h4>
                    @*<a class="btn btn-primary btn-sm">Create new action</a>*@
                </div>
            </div>
            <!--Body-->
            <div class="modal-body" id="myModalDivBody">
            </div>
        </div>
        <!--/.Content-->
    </div>
</div>
<!-- /.Modal-->

<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>List of Reserved Rooms</h5>
                    <div class="ibox-tools">
                        <a onclick="myFunction()" class="btn btn-primary "><i class="fa fa-plus left"></i> ADD RESEREVED ROOM</a>
                        <a onclick="UploadReservedRoom()" class="btn btn-primary"><i class="fa fa-plus left"></i> UPLOAD RESERVED ROOM</a>

                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                        <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                            <i class="fa fa-wrench"></i>
                        </a>

                    </div>
                </div>
                <div class="ibox-content">

                    <div class="table-responsive">
                        <table id="Jdatatable" class="table table-striped table-bordered table-hover table-responsive dataTables-example">
                            <thead>
                                <tr>
                                    <th>Block Name</th>
                                    <th>Room Name</th>
                                    <th>Reason for Reserve</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                        </table>

                    </div>

                </div>
            </div>
        </div>
    </div>
</div>


<script src="~/Scripts/jquery-3.1.1.min.js"></script>

<script type="text/javascript">
    $(document).ready(function () {

        window.oTable = $("#Jdatatable").DataTable({
            "processing": true, // for show progress bar while loading
          
            "ajax": {
                "url": "/Rooms/GetReservedIndex",
                "type": "POST",
                "datatype": "json"
            },
            "columns": [
                { "data": "BlockName", "autoWidth": true },
                { "data": "RoomName", "autoWidth": true },
                { "data": "ReasonForReserve", "autoWidth": true },

                {
                    "data": "ReservedRoomId",
                    "autoWidth": true,
                    "render": function (data) {
                        return '<a href="#" data-toggle="modal" data-target="#actionsList" onclick="Reserve(' + data + ')" >  <i class="fa fa-pencil" aria-hidden="true" >&nbsp;Edit</i></a>&nbsp;&nbsp;' +
                            '<a href="#" class="text-danger" data-toggle="modal" data-target="#actionsList"  onclick="Delete(' + data + ')" ><i class="fa fa-remove" aria-hidden="true" >&nbsp;Remove<i /></a>';
                    }
                }

                //{ "data": "EmailID", "autoWidth": true },
                //{ "data": "Phone", "autoWidth": true },
            ],
            dom: '<"html5buttons"B>lTfgitp',
            lengthMenu: [
                [10, 25, 50, 100, 200, 500, 1000, 2000],
                [10, 25, 50, 100, 200, 500, 1000, 2000]
            ],
            buttons: [
                {   extend: 'copy' },
                //{   pageLength: 'pageLength' },
                //{   extend: 'csv'},
                //{   extend: 'excel', title: 'Student List'},
                {   extend: 'pdf', title: 'Student List' },

                {
					extend: 'collection',
					text: 'Table control',
					buttons: [
						{
							collectionTitle: 'Visibility control',
							extend: 'colvis'
						}
					]
				},

                {extend: 'print',
                    customize: function (win){
                        $(win.document.body).addClass('white-bg');
                        $(win.document.body).css('font-size', '10px');

                        $(win.document.body).find('table')
                            .addClass('compact')
                            .css('font-size', 'inherit');
                    }
                }
            ]
        });

    });
   
    function Delete(roomId) {
        var url = "/Rooms/DeleteReserved?id=" + roomId;
        //alert(url);
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
    };
    function myFunction() {
        var url = "/Rooms/Reserve?id=0";
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
    };
    function Reserve(roomId) {
        var url = "/Rooms/Reserve?id=" + roomId;

        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
    };
 
    function UploadReservedRoom() {
        var url = "/Rooms/UploadReserverdRooms";
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
    };
</script>