@model SwiftKampus.ViewModels.AttendedSchoolsVm
@using SwiftKampus.Extensions

@{
    ViewBag.Title = "School History";
    Layout = null;
}
<link href="~/AdminTemplate/css/plugins/sweetalert/sweetalert.css" rel="stylesheet">


<form id="myform" class="form-horizontal" onsubmit="return false;">
    <div class="ibox float-e-margins">
        <div class="row">
            <div class="col-md-12">
                <div class="wrapper border-bottom white-bg page-heading">
                    <div class="row">
                        <div class="col-md-3">
                            <h2>Edit School History</h2>
                        </div>
                        <div class="col-md-9">

                            <h2 class="pull-right">
                                <span>
                                    <a href="@Url.Action("Index","AttendedSchools")" class="btn btn-primary"> LIST OF SCHOOL ATTENDED</a>
                                </span>
                                <span>
                                    <button id="btnAttendedSchoolAddMore" type="button" class="btn btn-primary"><i class="fa fa-plus"></i> Add</button>
                                </span>
                            </h2>
                        </div>
                    </div>

                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                <div class="wrapper wrapper-content animated fadeInRight">
                    <div class="row">
                        <div class="ibox-content">
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            <div class="atendedSchoolrepeatable">
                                @if (Model.AttendedSchools != null && Model.AttendedSchools.Count() > 0)
                                {
                                    for (int i = 0; i < Model.AttendedSchools.Count(); i++)
                                    {
                                        <div class="row">
                                            <div class="col-md-4">
                                                <div class="col-md-12">
                                                    <div class="form-group">
                                                        @Html.LabelFor(model => model.AttendedSchools[i].SchoolName)
                                                        @Html.EditorFor(model => model.AttendedSchools[i].SchoolName, new { htmlAttributes = new { @class = "form-control schoolName" } })
                                                        @Html.ValidationMessageFor(model => model.AttendedSchools[i].SchoolName, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="col-md-12">
                                                    <div class="form-group">
                                                        @Html.LabelFor(model => model.AttendedSchools[i].CourseOfStudy)
                                                        @Html.EditorFor(model => model.AttendedSchools[i].CourseOfStudy, new { htmlAttributes = new { @class = "form-control courseOfStudy" } })
                                                        @Html.ValidationMessageFor(model => model.AttendedSchools[i].CourseOfStudy, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="col-md-12">
                                                    <div class="form-group">
                                                        @Html.LabelFor(model => model.AttendedSchools[i].ClassOfDegree)
                                                        @Html.EditorFor(model => model.AttendedSchools[i].ClassOfDegree, new { htmlAttributes = new { @class = "form-control classOfDegree" } })
                                                        @Html.ValidationMessageFor(model => model.AttendedSchools[i].ClassOfDegree, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>


                                            <div class="col-md-3">
                                                <div class="col-md-12">
                                                    <div class="form-group">
                                                        @Html.LabelFor(model => model.AttendedSchools[i].Degree)
                                                        @Html.EditorFor(model => model.AttendedSchools[i].Degree, new { htmlAttributes = new { @class = "form-control degree" } })
                                                        @Html.ValidationMessageFor(model => model.AttendedSchools[i].Degree, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="col-md-12">
                                                    <div class="form-group">
                                                        @Html.LabelFor(model => model.AttendedSchools[i].ResultGrade)
                                                        @Html.EditorFor(model => model.AttendedSchools[i].ResultGrade, new { htmlAttributes = new { @class = "form-control resultGrade" } })
                                                        @Html.ValidationMessageFor(model => model.AttendedSchools[i].ResultGrade, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="col-md-12">
                                                    <div class="form-group">
                                                        @Html.LabelFor(model => model.AttendedSchools[i].FromDate)
                                                        @Html.EditorFor(model => model.AttendedSchools[i].FromDate, new { htmlAttributes = new { @class = "form-control AfromDate", type = "text", placeholder = "dd/mm/yyyy" } })
                                                        @Html.ValidationMessageFor(model => model.AttendedSchools[i].FromDate, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="col-md-12">
                                                    <div class="form-group">
                                                        @Html.LabelFor(model => model.AttendedSchools[i].ToDate)
                                                        @Html.EditorFor(model => model.AttendedSchools[i].ToDate, new { htmlAttributes = new { @class = "form-control AtoDate", type = "text", placeholder = "dd/mm/yyyy" } })
                                                        @Html.ValidationMessageFor(model => model.AttendedSchools[i].ToDate, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>
                                            <span class="col-md-12" onclick="remove_AttendedSch0olbutton(this)" input-group-btn col-sm-2">
                                                <button type="button" class="btn btn-primary"><i class="fa fa-minus"></i></button>
                                            </span>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="row">
                                        <div class="col-md-4">
                                            <div class="col-md-12">
                                                <div class="form-group">
                                                    @Html.LabelFor(model => model.AttendedSchool.SchoolName)
                                                    @Html.EditorFor(model => model.AttendedSchool.SchoolName, new { htmlAttributes = new { @class = "form-control schoolName" } })
                                                    @Html.ValidationMessageFor(model => model.AttendedSchool.SchoolName, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="col-md-12">
                                                <div class="form-group">
                                                    @Html.LabelFor(model => model.AttendedSchool.CourseOfStudy)
                                                    @Html.EditorFor(model => model.AttendedSchool.CourseOfStudy, new { htmlAttributes = new { @class = "form-control courseOfStudy" } })
                                                    @Html.ValidationMessageFor(model => model.AttendedSchool.CourseOfStudy, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="col-md-12">
                                                <div class="form-group">
                                                    @Html.LabelFor(model => model.AttendedSchool.ClassOfDegree)
                                                    @Html.EditorFor(model => model.AttendedSchool.ClassOfDegree, new { htmlAttributes = new { @class = "form-control classOfDegree" } })
                                                    @Html.ValidationMessageFor(model => model.AttendedSchool.ClassOfDegree, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-3">
                                            <div class="col-md-12">
                                                <div class="form-group">
                                                    @Html.LabelFor(model => model.AttendedSchool.Degree)
                                                    @Html.EditorFor(model => model.AttendedSchool.Degree, new { htmlAttributes = new { @class = "form-control degree" } })
                                                    @Html.ValidationMessageFor(model => model.AttendedSchool.Degree, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="col-md-12">
                                                <div class="form-group">
                                                    @Html.LabelFor(model => model.AttendedSchool.ResultGrade)
                                                    @Html.EditorFor(model => model.AttendedSchool.ResultGrade, new { htmlAttributes = new { @class = "form-control resultGrade" } })
                                                    @Html.ValidationMessageFor(model => model.AttendedSchool.ResultGrade, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="col-md-12">
                                                <div class="form-group">
                                                    @Html.LabelFor(model => model.AttendedSchool.FromDate)
                                                    @Html.EditorFor(model => model.AttendedSchool.FromDate, new { htmlAttributes = new { @class = "form-control AfromDate", type = "text", placeholder = "dd/mm/yyyy" } })
                                                    @Html.ValidationMessageFor(model => model.AttendedSchool.FromDate, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="col-md-12">
                                                <div class="form-group">
                                                    @Html.LabelFor(model => model.AttendedSchool.ToDate)
                                                    @Html.EditorFor(model => model.AttendedSchool.ToDate, new { htmlAttributes = new { @class = "form-control AtoDate", type = "text", placeholder = "dd/mm/yyyy" } })
                                                    @Html.ValidationMessageFor(model => model.AttendedSchool.ToDate, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }

                            </div>
                            <div class="hr-line-dashed"></div>
                            <div class="form-group">
                                <div class="col-md-6">

                                </div>
                                <div class="col-md-6">
                                    <input type="submit" id="btnAttendedSchoolSave" value="Save and Continue" class="btn btn-primary btn-sm pull-right" />
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
            <input id="schoolProgrammeName" hidden value="@ViewBag.schoolProgrammeName" />




            <div class="col-md-6 pull-right">
                <span class="pull-right" id="spanAttendedSchools" hidden>
                    <a id="btnTranscriptNext" href="#" class="btn btn-warning btn-lg btnNext" data-dismiss="modal">NEXT</a>
                </span>
            </div>
            <div class="col-md-6">
                <a id="btnAcademicQualPrevious" href="#" class="btn btn-warning btn-lg btnPrevious" data-dismiss="modal">PREVIOUS</a>
            </div>
        </div>
    </div>

</form>

@*load transcript view here*@
<div id="transcriptContainer"></div>

@*<button class="btn btn-danger" id="thisButton">click me</button>*@

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
<script src="~/Scripts/jquery-3.3.1.min.js"></script>
<script src="~/AdminTemplate/js/plugins/sweetalert/sweetalert.min.js"></script>
<script>
       var count = 1;
    $(document).ready(function () {

        $('#btnAttendedSchoolAddMore').click(function () {
            if (count <= 3) {
                var new_field = `<div class="row">
                                  <div class="hr-line-dashed"></div>
                                <div class="col-md-4">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.AttendedSchool.SchoolName)
                                            @Html.EditorFor(model => model.AttendedSchool.SchoolName, new { htmlAttributes = new { @class = "form-control schoolName" } })
                                            @Html.ValidationMessageFor(model => model.AttendedSchool.SchoolName, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.AttendedSchool.CourseOfStudy)
                                            @Html.EditorFor(model => model.AttendedSchool.CourseOfStudy, new { htmlAttributes = new { @class = "form-control courseOfStudy" } })
                                            @Html.ValidationMessageFor(model => model.AttendedSchool.CourseOfStudy, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.AttendedSchool.ClassOfDegree)
                                            @Html.EditorFor(model => model.AttendedSchool.ClassOfDegree, new { htmlAttributes = new { @class = "form-control classOfDegree" } })
                                            @Html.ValidationMessageFor(model => model.AttendedSchool.ClassOfDegree, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-3">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.AttendedSchool.Degree)
                                            @Html.EditorFor(model => model.AttendedSchool.Degree, new { htmlAttributes = new { @class = "form-control degree" } })
                                            @Html.ValidationMessageFor(model => model.AttendedSchool.Degree, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.AttendedSchool.ResultGrade)
                                            @Html.EditorFor(model => model.AttendedSchool.ResultGrade, new { htmlAttributes = new { @class = "form-control resultGrade" } })
                                            @Html.ValidationMessageFor(model => model.AttendedSchool.ResultGrade, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.AttendedSchool.FromDate)
                                            @Html.EditorFor(model => model.AttendedSchool.FromDate, new { htmlAttributes = new { @class = "form-control fromDate", type = "text", placeholder = "dd/mm/yyyy" } })
                                            @Html.ValidationMessageFor(model => model.AttendedSchool.FromDate, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.AttendedSchool.ToDate)
                                            @Html.EditorFor(model => model.AttendedSchool.ToDate, new { htmlAttributes = new { @class = "form-control toDate", type = "text", placeholder = "dd/mm/yyyy" } })
                                            @Html.ValidationMessageFor(model => model.AttendedSchool.ToDate, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>

                            <span class="col-md-12" onclick="remove_button(this)" input-group-btn col-sm-2">
                                <button type="button" class="btn btn-primary"><i class="fa fa-minus"></i></button>
                            </span>

                        </div>

                        </div>`;
                $('.atendedSchoolrepeatable').append(new_field);
                count++;
            }
            else
            {
                swal({
                    title: "Warning",
                    text: "Maximum number of fields exceeded!",
                    type: "warning",
                });            }
        });

        $('#btnAttendedSchoolSave').click(function () {
            var schoolName = [];
            var courseOfStudy = [];
            var classOfDegree = [];
            var grade = [];
            var degree = [];
            var fromDate = [];
            var toDate = [];
            var emplymentDetailList = [];

            //pulling the form data using the class and adding it to a list
            $.each($('.schoolName'), function () {
                schoolName.push($(this).val());
            });

            $.each($('.courseOfStudy'), function () {
                courseOfStudy.push($(this).val());
            });
            $.each($('.classOfDegree'), function () {
                classOfDegree.push($(this).val());
            });
            $.each($('.resultGrade'), function () {
                grade.push($(this).val());
            });

            $.each($('.AfromDate'), function () {
                fromDate.push($(this).val());
            });

            $.each($('.AtoDate'), function () {
                toDate.push($(this).val());
            });

            $.each($('.degree'), function () {
                degree.push($(this).val());
            });

            //////validation
            ////if (subjectid.length == 0 || subjectgrade.length == 0) {
            ////    alert("Invalid selection!");
            ////}
            ////else {

            ////}
            //append to list for c# in controller
            for (var i = 0; i < schoolName.length; i++) {
                var data = {
                    "SchoolName": schoolName[i],
                    "CourseOfStudy": courseOfStudy[i],
                    "ClassOfDegree": classOfDegree[i],
                    "ResultGrade": grade[i],
                    "Degree": degree[i],
                    "FromDate": fromDate[i],
                    "ToDate": toDate[i]
                };
                emplymentDetailList.push(data);
            }

            var Mydata = JSON.stringify(emplymentDetailList);
            //alert(Mydata);


            $.ajax({
                contentType: 'application/json',
                type: "POST",
                url: "/AttendedSchools/PCreate",
                data: Mydata,
                success: function (data) {
                    if (data.status) {
                        swal({
                            title: "Schools are added successfully",
                            //text: "Did you want to add More Qualifications?..",
                            text: "You can request transcript below.",
                            type: "success",
                            //showCancelButton: true,
                            confirmButtonColor: "#ab973a",
                            confirmButtonText: "Proceed",
                            //cancelButtonText: "No, See Result List!",
                            closeOnConfirm: true,
                            closeOnCancel: false
                        },
                            function (isConfirm) {
                                if (isConfirm) {
                                    //var url = "/AttendedSchools/RegIndex";
                                    //$('#transcriptContainer').load(url);
                                    fetch('/AttendedSchools/RegIndex')
                                        .then(data => {
                                            return data.text()
                                        })
                                        .then(data => {
                                            document.getElementById("transcriptContainer").innerHTML = data;
                                        })

                                    $('#spanAttendedSchools').removeAttr("hidden");

                                    swal("Great!", "You can now proceed.", "success");
                                }
                                //} else {
                                //     var url = "/AttendedSchools/RegIndex";
                                //       $('#tab15').load(url);
                                //    //var url = "/RelevantDocuments/AIndex";
                                //    //   $('#tab9').load(url);
                                //    swal("Great", "You can now see your Qualification list", "success");
                                //}
                            });
                        toastr["success"](data.message);
                    } else {
                        swal({
                            title: "Warning",
                            text: data.message,
                            type: "warning",
                        });
                        toastr["success"](data.message);
                    }

                }
            });
        });

    });

    function remove_button(elem) {
        if (count > 1) {
            $(elem).closest('div').remove();
            count--;
        }
    }

    function goNextTranscript() {
        var schoolProgrammeName = $("#schoolProgrammeName").val();
        if (schoolProgrammeName != "Phd") {
            $("#uploaddocument").click();
        }
        else {
            $("#thesis").click();
        }
    }

    $("#btnAcademicQualPrevious").click(function () {
        $("#referee").click();
    });

    $("#btnTranscriptNext").click(function () {
        goNextTranscript();
    });

    //$("#btnAcademicNext").click(function () {
    //    $("#uploaddocument").click();
    //});

    //$(document).on('click', '#thisButton', function () {
    //    var url = "/AttendedSchools/RegIndex";
    //    $('#tab15').load(url);
    //});

</script>