@model IEnumerable<SwiftKampusModel.AddmissionApplicant.Publication>

@{
    ViewBag.Title = "Publication";
}

<div class="container-fluid">
    <div class="wrapper wrapper-content animated fadeInRight">
        <div class="row">
            <div class="col-lg-12">
                <div class="ibox float-e-margins">
                    <div class="ibox-title">
                        <h5>List of Publications</h5>
                        <div class="ibox-tools">
                            <a href="@Url.Action("Create","Publications")" class="btn btn-primary"> <i class="fa fa-plus left"></i> ADD PUBLICATIONS</a>

                            <a class="collapse-link">
                                <i class="fa fa-chevron-up"></i>
                            </a>
                        </div>
                    </div>
                    <div class="ibox-content">
                        <table class="table table-responsive">
                            <tr>
                                <th>
                                    @Html.DisplayNameFor(model => model.Title)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Institution)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.PublicationType)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Qualification)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Publisher)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.PublishedDate)
                                </th>
                                <th></th>
                            </tr>

                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Title)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Institution)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.PublicationType)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Qualification)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Publisher)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.PublishedDate)
                                    </td>
                                    <td>
                                        @Html.ActionLink("Edit", "Edit", new { id = item.PublicationId }) |
                                        @Html.ActionLink("Details", "Details", new { id = item.PublicationId }) |
                                        @Html.ActionLink("Delete", "Delete", new { id = item.PublicationId })
                                    </td>
                                </tr>
                            }

                        </table>
                    </div>
                </div>
            </div>
        </div>
