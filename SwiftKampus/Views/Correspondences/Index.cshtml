@model IEnumerable<SwiftKampus.ViewModels.CorrespondenceIndexVM>

@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table">
    <tr>
        <th>
            Student's Name
        </th>
        <th>
            Correspondence Type
        </th>
        <th>
            Department Code
        </th>
        
        <th>
            Subject
        </th>
        <th>
            Correspondence Date
        </th>
        <th>
            Approval
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.StudentFullName)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.CorrespondenceDate)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.DeptCode)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.CorrespondenceDate)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Approval)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Subject)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.CorrespondenceDate)
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id=item.CorrespondenceId }) |
            @Html.ActionLink("Details", "Details", new { id=item.CorrespondenceId }) |
            @Html.ActionLink("Delete", "Delete", new { id=item.CorrespondenceId })
        </td>
    </tr>
}

</table>
