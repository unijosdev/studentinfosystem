@model SwiftKampusModel.Accomodation.AssignedHostelVm

<form id="myform" onsubmit="return false;">
    @Html.AntiForgeryToken()
    <div class="card">
        <div class="card-head style-primary">
        </div><!--end .card-head -->
        <div class="card-body">

            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            @if (Model != null && Model.AssignedHostelId > 0)
            {
                @Html.HiddenFor(model => model.AssignedHostelId)
            }
            <div class="form-group">
                @Html.Label("Hostel Name")
                @Html.DropDownList("HostelId", null, htmlAttributes: new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.HostelId, "", new { @class = "text-danger" })
            </div>

            @if (Model != null && Model.AssignedHostelId > 0)
            {
                <div class="form-group">
                    @Html.Label("Faculty Name")
                    @Html.DropDownList("FacultyId", null, htmlAttributes: new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.FacultyId, "", new { @class = "text-danger" })
                </div>
            }
            else
            {
                <div class="form-group">
                    @Html.Label("Faculty Name")
                    @Html.DropDownList("FacultyId", null, htmlAttributes: new { @class = "form-control", @multiple = "true" })
                    @Html.ValidationMessageFor(model => model.FacultyId, "", new { @class = "text-danger" })
                </div>
            }
            <div class="md-form">

                @if (Model != null && Model.AssignedHostelId > 0)
                {
                    <input id="btnsubmit" type="submit" value="Update" class="btn btn-success btn-lg" />
                }
                else
                {
                    <input id="btnsubmit" type="submit" value="Save" class="btn btn-success btn-lg" />
                }
                <a href="#" class="btn btn-danger btn-lg" data-dismiss="modal">Cancel</a>
            </div>
        </div><!--end .card-body -->
    </div><!--end .card -->
</form>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

<script type="text/javascript">
    $("#btnsubmit").click(function () {
        var data = $("#myform").serialize();
        $.ajax({
            type: "POST",
            url: "/AssignedHostels/Save",
            data: data,
            success: function (data) {
                if (data.status) {
                    $('#actionsList').modal("hide");

                    window.oTable.ajax.reload(); //run my_fun() ondomready
                    toastr["success"](data.message);
                    $('#myform')[0].reset();
                } else {
                    //$('#actionsList').modal("hide");
                    toastr["error"](data.message);
                }

            }
        });
    });
</script>


