@model SwiftKampusModel.AddmissionApplicant.SchoolProgramme

<form id="myform" onsubmit="return false;">
    @Html.AntiForgeryToken()


    <div class="card">
        <div class="card-head style-primary">
            <header>
                @if (Model != null && Model.SchoolProgrammeId > 0)
                {
                    <div class="form-header  purple darken-4">
                        <h3>
                            <i class="fa fa-save"></i> Update Record
                        </h3>
                    </div>
                }
                else
                {
                    <div class="form-header  purple darken-4">
                        <h3><i class="fa fa-save"></i> Save</h3>
                    </div>
                }
            </header>

        </div><!--end .card-head -->
        <div class="card-body">

            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            @if (Model != null && Model.SchoolProgrammeId > 0)
            {
                @Html.HiddenFor(model => model.SchoolProgrammeId)
            }

            <div class="form-group">
                @Html.LabelFor(model => model.ProgrammeCategory)
                @Html.DropDownList("ProgrammeCategory", null, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.ProgrammeCategory, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.ProgrammeType)
                @Html.DropDownList("ProgrammeType", null, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.ProgrammeType, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.Label("Display Name")
                @Html.EditorFor(model => model.FancyName, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.FancyName, "", new { @class = "text-danger" })
            </div>
            <div class="form-group">
                @Html.Label("Programme Code")
                @Html.EditorFor(model => model.SchoolProgrammeCode, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.SchoolProgrammeCode, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.Label("Programme Duration")
                @Html.EditorFor(model => model.Duration, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Duration, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.Label("Description")
                @Html.EditorFor(model => model.Description, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.Label("Closing Date")
                @*@Html.EditorFor(model => model.ClosingDate, new { htmlAttributes = new { @class = "form-control" } })*@
                <input type="date" class="form-control" value="@Model.ClosingDate.ToString("yyyy-MM-dd")" name="ClosingDate" />
                @Html.ValidationMessageFor(model => model.ClosingDate, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.Label("Image Url")
                @Html.EditorFor(model => model.ImageName, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.ImageName, "", new { @class = "text-danger" })
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.SessionId)
                @Html.DropDownList("SessionId", null, "", new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.SessionId, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.ActiveSale, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-10">
                    <div class="checkbox">
                        @Html.EditorFor(model => model.ActiveSale)
                        @Html.ValidationMessageFor(model => model.ActiveSale, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            <br />
            <br />
            <br />

            <div class="md-form">

                @if (Model != null && Model.SchoolProgrammeId > 0)
                {
                    <input id="btnsubmit" type="submit" value="Update" class="btn btn-success btn-lg" />
                }
                else
                {
                    <input id="btnsubmit" type="submit" value="Save" class="btn btn-success btn-lg" />
                }
                <a href="#" class="btn btn-danger btn-lg" data-dismiss="modal">Cancel</a>
            </div>
        </div><!--end .card-body -->
    </div><!--end .card -->
</form>
@section Scripts {
        @Scripts.Render("~/bundles/jqueryval")
    }

<script type="text/javascript">
    $("#btnsubmit").click(function () {

        var data = $("#myform").serialize();

        $.ajax({
            type: "POST",
            url: "/SchoolProgrammes/Save",
            data: data,
            success: function (data) {
                if (data.status) {
                    $('#actionsList').modal("hide");

                    window.oTable.ajax.reload(); //run my_fun() ondomready
                    toastr["success"](data.message);
                    $('#myform')[0].reset();
                } else {
                    //$('#actionsList').modal("hide");
                    toastr["error"](data.message);
                }

            }
        });
    });
</script>



