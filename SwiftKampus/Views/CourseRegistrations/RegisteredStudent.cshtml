
@{
    ViewBag.Title = "Student Course Registration";
}
<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>List of Registered Students</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                        <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                            <i class="fa fa-wrench"></i>
                        </a>

                    </div>
                </div>
                <div class="ibox-content">
                    <article class="margin-bottom-xxl">
                        <p class="lead">
                            Please use the following parameters to perform Query
                        </p>
                    </article>
                    <div class="card-body">
                        <div class="row">
                            <form class="form-inline" id="formFilter" onsubmit="return false;">

                                <div class="col-md-5">
                                    <div class="form-group">
                                        <label>School Programme</label>
                                        @Html.DropDownList("SchoolProgrammeId", (SelectList)ViewBag.SchoolProgrammeId, new { @class = "form-control" })
                                    </div>
                                </div>
                                <div class="col-sm-4">
                                    <div class="form-group">
                                        <label>Faculty Name</label>
                                        @Html.DropDownList("FacultyId", (SelectList)ViewBag.FacultyId, "", new { @class = "form-control" })
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label>Department Name</label>
                                        @Html.DropDownList("DepartmentId", (SelectList)ViewBag.DepartmentId, "", new { @class = "form-control" })
                                    </div>
                                </div>
                                <div class="col-md-1">
                                    <div class="form-group">
                                        <label>Session</label>
                                        @Html.DropDownList("SessionId", (SelectList)ViewBag.SessionId, "", new { @class = "form-control" })
                                    </div>
                                </div>
                                <div class="col-md-1">
                                    <div class="form-group">
                                        <label> Level</label>
                                        @Html.DropDownList("LevelId", (SelectList)ViewBag.LevelId, "", new { @class = "form-control" })
                                    </div>
                                </div>
                                <div class="col-md-1">
                                    <br />
                                    <button type="submit" id="btn-search" class="btn btn-primary">Search</button>
                                </div>
                            </form>
                        </div>

                    </div><!--end .row -->

                </div>

                <div class="ibox-content">
                    <div class="table-responsive">
                        <table id="Jdatatable" class="table table-striped table-bordered table-hover table-responsive">
                            <thead>
                                <tr>
                                    <th>Matric No</th>
                                    <th>FullName</th>
                                    <th>Gender</th>
                                    <th>Department</th>
                                    <th>Programme Name</th>
                                    <th>Level</th>
                                    <th>PhoneNumber</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div><!--end .table-responsive -->
                </div>
            </div>

        </div>

    </div>
</div>

<script src="~/Scripts/jquery-3.1.1.min.js"></script>

<script type="text/javascript">
    $(document).ready(function () {
        window.oTable = $("#Jdatatable").DataTable({
            "processing": true, // for show progress bar while loading
            "serverSide": true, // if it is true the preocess is done on server side
            "filter": true, // disables search box
            "info": true,

            "stateSave": true,
            "orderMulti": false, // disable multiple column loading at once
            "ajax": {
                "url": "/CourseRegistrations/GetRegisteredStudent",
                "type": "POST",
                "datatype": "json",
                "data": function (d) {
                    //return $('#formFilter').serialize();
                    d.SchoolProgrammeId = $('#SchoolProgrammeId').val();
                    d.FacultyId = $('#FacultyId').val();
                    d.DepartmentId = $('#DepartmentId').val();
                    d.SessionId = $('#SessionId').val();
                    d.LevelId = $('#LevelId').val();
                    //d.HasPayed = $('#hasPayed').val();
                    //d.StartDate = $('#StartDate').val();
                    //d.EndDate = $('#EndDate').val();
                },
            },
            "columns": [
                { "data": "MatricNo", "autoWidth": true },
                { "data": "FullName", "autoWidth": true },
                { "data": "Gender", "autoWidth": true },
                { "data": "DeptName", "autoWidth": true },
                { "data": "ProgrammeName", "autoWidth": true },
                { "data": "LevelName", "autoWidth": true },
                { "data": "PhoneNumber", "autoWidth": true },
                
            ],
            responsive: true,
            dom: '<"html5buttons"B>lTfgitp',
            lengthMenu: [
                [10, 25, 50, 100, 200, 500, 1000, 2000, 5000, 10000],
                [10, 25, 50, 100, 200, 500, 1000, 2000, 5000, 10000]
            ],
            buttons: [
                { extend: 'copy' },
                { extend: 'csv' },
                { extend: 'excel', title: 'FacultyList' },
                { extend: 'pdf', title: 'FacultyList' },

                {
					extend: 'collection',
					text: 'Table control',
					buttons: [						
						{
							collectionTitle: 'Visibility control',
							extend: 'colvis'
						}
					]
				},

                {
                    extend: 'print',
                    customize: function (win) {
                        $(win.document.body).addClass('white-bg');
                        $(win.document.body).css('font-size', '10px');

                        $(win.document.body).find('table')
                            .addClass('compact')
                            .css('font-size', 'inherit');
                    }
                }
            ]
        });
    });

    $("#btn-search").click(function () {
        //alert(" sess:" + $('#SessionId').val());
        window.oTable.ajax.reload();

    });


</script>
