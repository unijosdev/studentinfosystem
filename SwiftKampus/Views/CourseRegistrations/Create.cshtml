@using SwiftKampusModel
@model SwiftKampusModel.CourseRegistrationVm

@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
    List<Course> courses = (List<Course>)ViewBag.Courses;
    List<Course> deCourses = (List<Course>)ViewBag.DeCourses;
    List<Course> carryOverCourses = (List<Course>)ViewBag.CarryOverCourses;
    int sumOfCore = courses.Where(x => x.CourseType.ToUpper().Equals("CORE")).Sum(x => x.Credits);
    int sumOfCO = carryOverCourses.Sum(x => x.Credits);
    int total = sumOfCore  + deCourses.Sum(x => x.Credits);
    int remaining = Model.MaximumCreditLoad - total;
}
<link href="~/AdminTemplate/css/plugins/chosen/bootstrap-chosen.css" rel="stylesheet" />
<script src="~/Scripts/jquery-1.11.3.min.js"></script>
<script src="~/AdminTemplate/js/plugins/chosen/chosen.jquery.js"></script>
<div class="row wrapper border-bottom white-bg page-heading">
    <div class="col-lg-10">
        <h2>Course Registration</h2>
    </div>
    <div class="col-lg-3">
    </div>
</div>
<br />
@if (ViewBag.Message != null)
{
    <div class="ibox-content">
        <h2 class="text-danger">@ViewBag.Message</h2>
    </div>
}

@using (Html.BeginForm())
{
    <div class="row">
        <div class="col-sm-7">
            <div class="ibox float-e-margins">
                <div class="ibox-content">


                    @Html.AntiForgeryToken()

                    <div class="form-horizontal">
                        @Html.HiddenFor(model => model.AvailableCredit)
                        @Html.HiddenFor(model => model.DepartmentId)

                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        @*@for (var i = 0; i < Model.CarryOverCoursesId.Length; i++)
                            {

                                @Html.HiddenFor(model => model.CarryOverCoursesId[i])

                                @Html.TextBoxFor(model => model.CarryOverCoursesId[i], new { style = "display:none" })

                            }

                            @for (var i = 0; i < Model.CoreCourses.Length; i++)
                            {

                                @Html.HiddenFor(model => model.CoreCourses[i])
                                @Html.TextBoxFor(model => model.CoreCourses[i], new { style = "display:none" })

                            }*@
                        @Html.HiddenFor(model => model.StudentId)
                        @Html.HiddenFor(model => model.LevelId)
                        @Html.HiddenFor(model => model.ProgrammeId)
                        @Html.HiddenFor(model => model.SemesterId)
                        @Html.HiddenFor(model => model.SessionId)
                        <div class="row">
                            <div class="ibox float-e-margins">
                                <div class="ibox-content">
                                    <h2>Core Courses</h2>
                                    <div class="alert alert-warning" role="alert">
                                        <h3>
                                            <strong>NOTE!</strong> This table is a list of core courses.
                                            Please pick the elective course of your choice to finish course registration
                                        </h3>
                                    </div>

                                    <table class="table table-striped table-bordered table-hovertable-responsive">
                                        <tr>
                                            <th>Code</th>
                                            <th>Course Name</th>
                                            <th>Credit</th>
                                            <th>Course Type</th>
                                        </tr>

                                        @foreach (var course in courses.Where(x => x.CourseType.ToUpper().Equals("CORE")))
                                        {
                                            <tr>
                                                <td>@course.CourseCode</td>
                                                <td>@course.CourseName</td>
                                                <td>@course.Credits</td>
                                                <td>@course.CourseType</td>
                                                <td>
                                                    <input type="checkbox" name="CoreCourses" value="@course.CourseId" checked onchange="updateTotal(this, @course.Credits)"><br><br>
                                                </td>

                                            </tr>

                                        }
                                        @if (deCourses != null && deCourses.Count > 0)
                                        {
                                            <tr>                                                
                                                <td colspan="3"><strong>De Core Courses are</strong></td>
                                            </tr>
                                            foreach (var course in deCourses)
                                            {
                                                <tr>
                                                    <td>@course.CourseCode</td>
                                                    <td>@course.CourseName</td>
                                                    <td>@course.Credits</td>
                                                    <td>@course.CourseType</td>
                                                    <td>
                                                        <input type="checkbox" name="CourseId" value="@course.CourseId" checked onchange="updateTotal(this, @course.Credits)"><br><br>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        <tr>
                                            <td colspan="3"><strong class="text-lg-center">Electives courses are</strong></td>
                                        </tr>
                                        @foreach (var course in courses.Where(x => x.CourseType.ToUpper() != "CORE"))
                                        {
                                            <tr>
                                                <td>@course.CourseCode</td>
                                                <td>@course.CourseName</td>
                                                <td>@course.Credits</td>
                                                <td>@course.CourseType</td>
                                                <td>
                                                    <input type="checkbox" name="CourseId" value="@course.CourseId" onchange="updateTotal(this, @course.Credits)"><br><br>
                                                </td>
                                            </tr>
                                        }
                                    </table>
                                    @if (Model.PrerequisiteCoursesId.Length > 0)
                                    {
                                        <div class="row">
                                            <div class="card">
                                                <div class="ibox float-e-margins">
                                                    <div class="ibox-content">
                                                        <h4>Unregistered Course(s) based on carry-over course prerequisite</h4>
                                                        <div class="alert alert-warning" role="alert">
                                                            <small>
                                                                <strong>Warning!</strong> Below will display the list of courses that are prerequisite to the carry over courses.
                                                            </small>
                                                        </div>
                                                        <table class="table table-striped table-bordered table-hover table-responsive">
                                                            <tr>
                                                                <th>Course Code</th>
                                                                <th>Course Name</th>
                                                                <th>Credit</th>
                                                                <th>Course Type</th>
                                                            </tr>

                                                            @if (ViewBag.UnRegisteredCourse != null)
                                                            {
                                                                foreach (var course in ViewBag.UnRegisteredCourse)
                                                                {
                                                                    <tr>
                                                                        <td>@course.CourseCode</td>
                                                                        <td>@course.CourseName</td>
                                                                        <td>@course.Credits</td>
                                                                        <td>@course.CourseType</td>

                                                                    </tr>
                                                                }

                                                            }
                                                            else
                                                            {
                                                                <tr>
                                                                    <td>No Prerequisite Course Available</td>
                                                                </tr>
                                                            }
                                                        </table>
                                                    </div><!--end .card-head -->
                                                </div>
                                            </div>
                                        </div>

                                    }
                                </div><!--end .card-head -->
                            </div>
                        </div>
                    </div>

                </div><!--end .card-head -->


            </div>
        </div>
        <div class="col-md-5">
            @if (Model.CarryOverCoursesId.Length > 0)
            {
                <div class="row">
                    <div class="card">
                        <div class="ibox float-e-margins">
                            <div class="ibox-content">
                                @*<h2>List of Carry-Over Courses</h2>*@
                                <h2>List of Previous-Level Courses</h2>
                                <div class="alert alert-warning" role="alert">
                                    <p><strong>NOTE!</strong> Previous Level Courses</p>
                                    <p>
                                        <small>
                                            @*Please be informed that Carry Over Courses that are core courses are registered automatically.*@
                                            Please be informed that previous level courses are there for carry over registration.
                                            Please only add courses to complete the Course registration Load which is <strong>@Model.MaximumCreditLoad</strong>.
                                            Minimum Credit Load is <strong>@Model.MinimumCreditLoad</strong>
                                        </small>
                                    </p>
                                </div>
                                <table class="table table-striped table-bordered table-hover table-responsive">
                                    <tr>
                                        <th>Course Code</th>
                                        <th>Course Name</th>
                                        <th>Credit</th>
                                    </tr>

                                    @if (ViewBag.CarryOverCourses != null)
                                    {
                                        foreach (var course in ViewBag.CarryOverCourses)
                                        {
                                            <tr>
                                                <td>@course.CourseCode</td>
                                                <td>@course.CourseName</td>
                                                <td>@course.Credits</td>
                                                <th> <input type="checkbox" name="CarryOverCoursesId" value="@course.CourseId" onchange="updateTotal(this, @course.Credits)"><br><br></th>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td>No Carry Over Course Available</td>
                                        </tr>
                                    }
                                </table>

                            </div><!--end .card-head -->
                        </div>
                    </div>
                </div>
            }


            <div class="alert alert-warning" role="alert">
                <h4 class="text-danger">@ViewBag.Message</h4>
                @*<h4>
                        <strong>NOTE!</strong> You have the Maximum Credit Load of @Model.MaximumCreditLoad to Register
                        <br />
                        and Minimum Credit Load of @Model.MinimumCreditLoad
                    </h4>*@
                <h4>Available Courses</h4>
                <h4>Core courses is <i>@courses.Where(x => x.CourseType.ToUpper().Equals("CORE")).Sum(x => x.Credits)</i></h4>
                @*@if (carryOverCourses.Count > 0)
                {
                    <h4>Carry-Over courses is <i> @carryOverCourses.Sum(x => x.Credits)</i></h4>
                }*@
                <h4>Total : <span id="total">@total</span></h4>
                <h4>You have <span id="remainig">@remaining</span> Credit Unit Left</h4>
            </div>
            <div class="form-group">
                <div class="col-md-offset-3 col-md-7">
                    <input type="submit" value="Submit Courses" class="btn btn-primary btn-lg" />
                </div>
            </div>


        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

<script type="text/javascript">

    function updateTotal(elem, creditLoad) {
        let total = parseInt($('#total').html());
        let remainingtotal = parseInt($('#remainig').html());
        if ($(elem).is(':checked')) {
            $('#total').html(total + creditLoad);
            $('#remainig').html(remainingtotal - creditLoad);
        } else {
            $('#total').html(total - creditLoad);
            $('#remainig').html(remainingtotal + creditLoad);
        }
        toastr["success"]("You have " + $('#remainig').html() + " unit left");
        toastr["success"]("Total Registered Course is  " + $('#total').html());
    }
    $('.chosen-select').chosen();
    $(function () {
        $('.listbox').multiselect({
            includeSelectAllOption: true
        });
    });
</script>
