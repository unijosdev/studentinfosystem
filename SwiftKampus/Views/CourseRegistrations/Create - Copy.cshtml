@using SwiftKampusModel
@model SwiftKampusModel.CourseRegistrationVm

@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
    List<Course> courses = (List<Course>)ViewBag.Courses;
    List<Course> carryOverCourses = (List<Course>)ViewBag.CarryOverCourses;
}
<link href="~/AdminTemplate/css/plugins/chosen/bootstrap-chosen.css" rel="stylesheet" />
<script src="~/Scripts/jquery-1.11.3.min.js"></script>
<script src="~/AdminTemplate/js/plugins/chosen/chosen.jquery.js"></script>
<div class="row wrapper border-bottom white-bg page-heading">
    <div class="col-lg-10">
        <h2>Course Registration</h2>
    </div>
    <div class="col-lg-3">
    </div>
</div>
<br />
@if (ViewBag.Message != null)
{
    <h2>@ViewBag.Message</h2>
}
<div class="row">
    <div class="col-sm-7">
        <div class="ibox float-e-margins">
            <div class="ibox-content">
                <div class="alert alert-warning" role="alert">
                    <h4 class="text-danger">@ViewBag.Message</h4>
                    <h4>
                        <strong>NOTE!</strong> You have the Maximum Credit Load of @Model.MaximumCreditLoad to Register
                        <br />
                        and Minimum Credit Load of @Model.MinimumCreditLoad
                    </h4>
                    <h4>The total credit load for CORE courses is @courses.Where(x => x.CourseType.ToUpper().Equals("CORE")).Sum(x => x.Credits)</h4>
                    @if (carryOverCourses.Count > 0)
                    {
                        <h4>The total credit load for CARRY-OVER courses is @carryOverCourses.Sum(x => x.Credits)</h4>

                    }
                </div>

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()

                <div class="form-horizontal">
                    @Html.HiddenFor(model => model.AvailableCredit)
                    @Html.HiddenFor(model => model.DepartmentId)

                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    @for (var i = 0; i < Model.CarryOverCoursesId.Length; i++)
                    {

                        @Html.HiddenFor(model => model.CarryOverCoursesId[i])

                        @Html.TextBoxFor(model => model.CarryOverCoursesId[i], new { style = "display:none" })

                    }

                    @for (var i = 0; i < Model.CoreCourses.Length; i++)
                    {

                        @Html.HiddenFor(model => model.CoreCourses[i])

                        @Html.TextBoxFor(model => model.CoreCourses[i], new { style = "display:none" })

                    }
                    <div class="form-group">
                        @Html.Label("Student ID", htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-7">
                            @Html.Editor("StudentId", (string)(ViewBag.StudentId), new { htmlAttributes = new { @class = "form-control", @readonly = "true" } })
                            @Html.ValidationMessageFor(model => model.StudentId, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.Label("Level Name", htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-7">
                            @Html.DropDownList("LevelId", null, htmlAttributes: new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.LevelId, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.Label("Course Option", htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-7">
                            @Html.DropDownList("ProgrammeId", null, htmlAttributes: new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.ProgrammeId, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.Label("Semester Name", htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-7">
                            @Html.DropDownList("SemesterId", null, htmlAttributes: new { @class = "form-control", @readonly = "true" })
                            @Html.ValidationMessageFor(model => model.SemesterId, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.Label("Session Name", htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-7">
                            @Html.DropDownList("SessionId", null, htmlAttributes: new { @class = "form-control", @readonly = "true" })
                            @Html.ValidationMessageFor(model => model.SessionId, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.Label("Course Name", htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-8">
                            @Html.DropDownList("CourseId", null, htmlAttributes: new { @class = "form-control chosen-select", @multiple = "true" })
                            @Html.ValidationMessageFor(model => model.CourseId, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="col-md-offset-3 col-md-7">
                            <input type="submit" value="Submit Courses" class="btn btn-primary btn-lg" />
                        </div>
                    </div>
                </div>
                }
            </div><!--end .card-head -->

         
        </div>
    </div>
    <div class="col-md-5">
        @if (Model.CarryOverCoursesId.Length > 0)
        {
            <div class="row">
                <div class="card">
                    <div class="ibox float-e-margins">
                        <div class="ibox-content">
                            <h2>List of Carry-Over Courses</h2>
                            <div class="alert alert-warning" role="alert">
                               
                                    <p><strong>NOTE!</strong> Carry Over Courses</p> 
                                    <p>
                                        <small>
                                            Please be informed that Carry Over Courses that are CORE COURSE are registered automatically.
                                            Please only add courses to complete the Course registration Load which is <strong>@Model.MaximumCreditLoad</strong>.
                                            Minimum Credit Load is <strong>@Model.MinimumCreditLoad</strong>
                                        </small>
                                        
                                    </p>
                                   
                             
                            </div>
                            <table class="table table-striped table-bordered table-hover table-responsive">
                                <tr>
                                    <th>Course Name</th>
                                    <th>&nbsp;&nbsp;</th>
                                    <th>Credit</th>
                                    <th>&nbsp;&nbsp;</th>
                                    @*<th>Level</th>*@
                                </tr>

                                @if (ViewBag.CarryOverCourses != null)
                                {
                                    foreach (var course in ViewBag.CarryOverCourses)
                                    {
                                        <tr>
                                            <td>@course.CourseName</td>
                                            <th>&nbsp;&nbsp;</th>
                                            <td>@course.Credits</td>
                                            <th>&nbsp;&nbsp;</th>
                                            @*<td>@course.Level.LevelName</td>*@
                                        </tr>
                                    }
                                    <tr>
                                        <th>Total</th>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                }
                                else
                                {
                                    <tr>
                                        <td>No Carry Over Course Available</td>
                                    </tr>
                                }
                            </table>
                        </div><!--end .card-head -->
                    </div>
                </div>
            </div>
        }
        <div class="row">
            <div class="ibox float-e-margins">
                <div class="ibox-content">
                    <h2>Core Courses</h2>
                    <div class="alert alert-warning" role="alert">
                        <h3>
                            <strong>NOTE!</strong> This table is a list of core courses.
                            Please pick the elective course of your choice to finish course registration
                        </h3>
                    </div>

                    <table class="table table-striped table-bordered table-hovertable-responsive">
                        <tr>
                            <th>Code</th>
                            <th>Course Name</th>
                            <th>Credit</th>
                            <th>Course Type</th>
                        </tr>

                        @foreach (var course in courses.Where(x => x.CourseType.ToUpper().Equals("CORE")))
                        {
                            <tr>
                                <td>@course.CourseCode</td>
                                <td>@course.CourseName</td>
                                <td>@course.Credits</td>
                                <td>@course.CourseType</td>
                            </tr>

                        }
                        <tr>
                            <td colspan="3"><strong>Electives courses are</strong></td>
                        </tr>
                        @foreach (var course in courses.Where(x => x.CourseType.ToUpper() != "CORE"))
                        {
                            <tr>
                                <td>@course.CourseCode</td>
                                <td>@course.CourseName</td>
                                <td>@course.Credits</td>
                                <td>@course.CourseType</td>
                            </tr>

                        }
                    </table>
                </div><!--end .card-head -->
            </div>
        </div>
        @if (Model.PrerequisiteCoursesId.Length > 0)
        {
            <div class="row">
                <div class="card">
                    <div class="ibox float-e-margins">
                        <div class="ibox-content">
                            <h2>List of Pre-Requisite Course</h2>
                            <div class="alert alert-warning" role="alert">
                                <small>
                                    <strong>Warning!</strong> The table below will display the list courses that are prerequisite to the carry your carry over courses.
                                    Please be informed that this Course(s) are automatically removed from available course List. <br />
                                    Please only add courses necessary to complete the Course registration Load which is @Model.MaximumCreditLoad. <br />
                                    Minimum Credit Load is @Model.MinimumCreditLoad
                                </small>
                            </div>
                            <table class="table table-striped table-bordered table-hover table-responsive">
                                <tr>
                                    <th>Course Name</th>
                                    <th>&nbsp;&nbsp;</th>
                                    <th>Credit</th>
                                    <th>&nbsp;&nbsp;</th>
                                    @*<th>Level</th>*@
                                </tr>

                                @if (ViewBag.UnRegisteredCourse != null)
                                {
                                    foreach (var course in ViewBag.UnRegisteredCourse)
                                    {
                                        <tr>
                                            <td>@course.CourseName</td>
                                            <th>&nbsp;&nbsp;</th>
                                            <td>@course.Credits</td>
                                            <th>&nbsp;&nbsp;</th>
                                            @*<td>@course.Level.LevelName</td>*@
                                        </tr>
                                    }
                                    <tr>
                                        <th>Total</th>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                }
                                else
                                {
                                    <tr>
                                        <td>No Prerequisite Course Available</td>
                                    </tr>
                                }
                            </table>
                        </div><!--end .card-head -->
                    </div>
                </div>
            </div>
        }



    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

<script type="text/javascript">

    $('.chosen-select').chosen();
    $(function () {
        $('.listbox').multiselect({
            includeSelectAllOption: true
        });
    });
</script>