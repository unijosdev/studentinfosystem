@model IEnumerable<SwiftKampus.ViewModels.CoureRegApprovalVm>
<link href="~/AdminTemplate/css/plugins/sweetalert/sweetalert.css" rel="stylesheet">

<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox-content">
                <div class="ibox-content">

                    <div class="table-responsive">
                        <table id="Jdatatable" class="table table-striped table-bordered table-hover table-responsive dataTables-example">
                            <thead>
                                <tr>
                                    <th>Student Name</th>
                                    <th>Session</th>
                                    <th>Semester</th>
                                    <th>Dept Option</th>
                                    <th>Level</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            @foreach (var item in Model)
                            {
                        <tr>
                            <td>@item.FullName</td>
                            <td>@item.SessionName</td>
                            <td>@item.SemesterName</td>
                            <td>@item.ProgrammeName</td>
                            <td>@item.LevelName</td>
                            <td>@item.IsApproved</td>
                            <td><a href="#" onclick="Detail(@item.CourseRegistrationId)" data-toggle="tooltip" data-placement="top" title="View Details"><i class="fa fa-info-circle" aria-hidden="true">Details&nbsp;&nbsp;</i></a>
                            <span><a href="#" onclick="Approve(@item.CourseRegistrationId)" data-toggle="tooltip" data-placement="top" title="Approve Course registration"><i class="fa fa-pencil" aria-hidden="true"></i>Approve &nbsp;&nbsp;</a></span>
                            <span><a class="text-danger" href="#" onclick="DisApprove(@item.CourseRegistrationId)" data-toggle="tooltip" data-placement="top" title="DisApprove Course registration"><i class="fa fa-pencil" aria-hidden="true"></i>DisApprove</a></span></td>

                            @*@if (item.IsStudentSubmitted.Equals(true) && item.ApprovalStatus.Equals(false))
                            {
                                <td><a href="#" onclick="Approve(@item.CourseRegistrationId)" data-toggle="tooltip" data-placement="top" title="Approve Course registration"><i class="fa fa-pencil" aria-hidden="true"></i>Approve &nbsp;&nbsp;</a></td>
                                <td><a class="text-danger" href="#" onclick="DisApprove(@item.CourseRegistrationId)" data-toggle="tooltip" data-placement="top" title="DisApprove Course registration"><i class="fa fa-pencil" aria-hidden="true"></i>DisApprove</a></td>

                            }
                            @if (item.IsStudentSubmitted.Equals(false))
                            {
                                <td><a class="text-danger" href="#" onclick="DisApprove(@item.CourseRegistrationId)" data-toggle="tooltip" data-placement="top" title="DisApprove Course registration"><i class="fa fa-pencil" aria-hidden="true"></i>DisApprove</a></td>
                            }*@
                        </tr>
                            }
                        </table>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/AdminTemplate/js/plugins/sweetalert/sweetalert.min.js"></script>
<script type="text/javascript">

    function Edit(courseRegistrationId) {
        var url = "/CourseRegistrations/PrintDetails?id=" + courseRegistrationId;
        window.open(url, '_blank');
    };

    function Detail(courseRegistrationId) {
        var url = "/CourseRegistrations/PartialDetails?id=" + courseRegistrationId;
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });

    };

    function Approve(courseRegistrationId) {
        //alert(courseRegistrationId);
            swal({
                title: "Are you sure?",
                text: "You want to Approved these courses!",
                type: "warning",
                showCancelButton: true,
                confirmButtonColor: "#ab973a",
                confirmButtonText: "Yes, Approve it!",
                cancelButtonText: "No, cancel plx!",
                closeOnConfirm: false,
                closeOnCancel: false
            },
                function (isConfirm) {
                    if (isConfirm) {
                        ApproveNow(courseRegistrationId);
                    } else {
                        swal("Cancelled", "Please click approve again to approved course for the selected student :)", "error");
                    }
                });



    };
    function ApproveNow(courseRegistrationId) {
        var url = "/CourseRegistrations/ConfirmApproval?id=" + courseRegistrationId;
        $.ajax({
            url: url, dataType: "json", success: function (data) {
                swal("Approved!", data.Data, "success");
                toastr["success"](data.Data);
                window.oTable.ajax.reload();
            }
        });
    };

    function DisApprove(courseRegistrationId) {
        var url = "/CourseRegistrations/RejectCourseReg?courseRegId=" + courseRegistrationId;
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
        swal("Oops", "Please type in reason why the course registration is rejected", "warning");
    };

    function DisApproveNow(courseRegistrationId) {
        var url = "/CourseRegistrations/ConfirmDisApproval?id=" + courseRegistrationId;
        $.ajax({
            url: url, dataType: "json", success: function (data) {
                swal("Approved!", data.Data, "success");
                toastr["success"](data.Data);
                window.oTable.ajax.reload();
            }
        });
    };

    function Excel() {
        var url = "/CourseRegistrations/ExcelUpload";
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
    };
    function AddNew() {
        window.open('@Url.Action("Create", "CourseRegistrations")', '_self');
    };
</script>
