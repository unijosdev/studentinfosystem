
@{
    ViewBag.Title = "UnRegistered Student";
}

<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>List of Un-Registered Students</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                        <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                            <i class="fa fa-wrench"></i>
                        </a>

                    </div>
                </div>
                <div class="ibox-content">
                    <article class="margin-bottom-xxl">
                        <p class="lead">
                            Please use the following parameters to perform Query
                        </p>
                    </article>
                    <div class="card-body">
                        <div class="row">
                            <form class="form-inline" id="formFilter" onsubmit="return false;">
                                <div class="card">
                                    <div class="card-body">
                                        <div class="form-group">
                                            <label>School Programme</label>
                                            @Html.DropDownList("SchoolProgrammeId", null, htmlAttributes: new { @class = "form-control" })
                                        </div>
                                        <div class="form-group">
                                            <label>Department Name</label>
                                            @Html.DropDownList("DepartmentId", null, htmlAttributes: new { @class = "form-control" })
                                        </div>                                        
                                        <div class="form-group">
                                            <label>Session Name</label>
                                            @Html.DropDownList("SessionId", (SelectList)ViewBag.SessionId, "", new { @class = "form-control" })
                                        </div>
                                        <div class="form-group">
                                            <label>Level</label>
                                            @Html.DropDownList("LevelId", (SelectList)ViewBag.LevelId, "", new { @class = "form-control" })
                                        </div>


                                        <button type="submit" id="btn-search" class="btn btn-raised btn-default-light ink-reaction">Search/View</button>                                        
                                    </div><!--end .card-body -->
                                </div><!--end .card -->
                                @*<em class="text-caption">Inline layout</em>*@
                            </form>
                        </div><!--end .col -->
                    </div><!--end .row -->
                    <!-- END INLINE FORM -->
                </div>
            </div>


            <!-- BEGIN DATATABLE 2 -->
            <div class="row">
                <div class="col-md-12">

                </div><!--end .col -->
                <div class="ibox-content">
                    <div class="table-responsive">
                        <table id="Jdatatable" class="table order-column hover">
                            <thead>
                                <tr>
                                    <th>Matric No</th>
                                    <th>FullName</th>
                                    <th>Gender</th>
                                    <th>Department</th>
                                    <th>Programme Name</th>
                                    <th>Level</th>
                                    <th>PhoneNumber</th>
                                </tr>
                            </thead>
                        </table>
                    </div><!--end .table-responsive -->
                </div><!--end .col -->
            </div><!--end .row -->
            <!-- END DATATABLE 2 -->
        </div>
    </div>
</div>

<script src="~/Scripts/jquery-3.1.1.min.js"></script>

<script type="text/javascript">


    $(document).ready(function () {
        window.oTable = $("#Jdatatable").DataTable({
            "processing": true, // for show progress bar while loading
            //"serverSide": true, // if it is true the preocess is done on server side
            //"filter": true, // disables search box
            //"info": true,
            //"stateSave": true,
            //"orderMulti": false, // disable multiple column loading at once
            "ajax": {
                "url": "/CourseRegistrations/GetUnRegisteredStudent",
                "type": "POST",
                "data": function (d) {
                    return $('#formFilter').serialize();
                },
                "datatype": "json"
            },
            "columns": [
                { "data": "MatricNo", "autoWidth": true },
                { "data": "FullName", "autoWidth": true },
                { "data": "Gender", "autoWidth": true },
                { "data": "DeptName", "autoWidth": true },
                { "data": "ProgrammeName", "autoWidth": true },
                { "data": "LevelName", "autoWidth": true },
                { "data": "PhoneNumber", "autoWidth": true }

            ],
            dom: '<"html5buttons"B>lTfgitp',
            buttons: [
                { extend: 'copy' },
                { extend: 'csv' },
                { extend: 'excel', title: 'Course Reg' },
                { extend: 'pdf', title: 'Course Reg' },

                {
                    extend: 'print',
                    customize: function (win) {
                        $(win.document.body).addClass('white-bg');
                        $(win.document.body).css('font-size', '10px');

                        $(win.document.body).find('table')
                            .addClass('compact')
                            .css('font-size', 'inherit');
                    }
                }
            ]
        });


        $("#btn-search").click(function () {
            // window.alert("sem:" + $('#SemesterId').val() + " sess:" + $('#SessionId').val());
            window.oTable.ajax.reload();

        });
        $("#btn-dwn").click(function () {
            var url = "/Students/DownloadGraduatePdfReport?SessionName=" + $('#SessionName').val() + "&DepartmentId=" + $('#DepartmentId').val() + "&Indegeneous=" + $('#Indegeneous').val();
            window.open(url, '_blank');

        });
        $("#btn-excel").click(function () {

            var url = "/Students/DownloadGraduateExcelReport?SessionName=" + $('#SessionName').val() + "&DepartmentId=" + $('#DepartmentId').val() + "&Indegeneous=" + $('#Indegeneous').val();
            window.open(url, '_self');
        });


    });


</script>


