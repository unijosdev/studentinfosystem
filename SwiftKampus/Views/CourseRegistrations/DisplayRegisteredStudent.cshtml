@using SwiftKampus.ViewModels
@model List<SwiftKampus.ViewModels.CourseRegDisplayVm>

@{
    var modellist = new List<CourseRegDisplayVm>();
    modellist = Model.ToList();
    ViewBag.Title = "DisplayRegisteredStudent";
}
<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">
        <div class="col-lg-12">
            <h2>Registered Student</h2>
            <a class="btn btn-primary" target="_blank" href="@Url.Action("DownloadStudentCourseReg", new { id = ViewBag.AssignedCourseId})">Download</a>

            <div class="ibox-content">
                <div class="table-responsive">
                    <table id="Jdatatable" class="table table-striped table-bordered table-hover table-responsive dataTables-example">
                        <thead>
                            <tr>
                                <th>S/N</th>
                                <th>Matric No</th>
                                <th>FullName</th>
                                <th>Email</th>
                                <th>Level</th>
                                <th>Gender</th>
                                <th>Programme Name</th>
                                <th>Department</th>
                            </tr>
                        </thead>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.No</td>
                                <td>@item.MatricNo</td>
                                <td>@item.FullName</td>
                                <td>@item.Email</td>
                                <td>@item.LevelName</td>
                                <td>@item.Gender</td>
                                <td>@item.ProgrammeName</td>
                                <td>@item.Dept</td>
                            </tr>
                        }
                    </table>
                </div><!--end .table-responsive -->
            </div>
        </div>
    </div>
</div>
