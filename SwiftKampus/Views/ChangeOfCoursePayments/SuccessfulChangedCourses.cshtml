
@{
    ViewBag.Title = "Change of Course Process List";
}
<div class="container-fluid">
    <!-- First row -->
    <div class="row">
        <!-- First column -->
        <div class="col-md-12">
            <div class="wrapper wrapper-content animated fadeInRight">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="ibox float-e-margins">
                            <div class="ibox-title">
                                <h5>List of Change of Course Student</h5>
                                <div class="ibox-tools">
                                    @if (ViewBag.Message != null)
                                    {
                                        <div class="alert alert-success">
                                            <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
                                            <strong>@ViewBag.Message</strong>
                                        </div>
                                    }

                                    <a class="collapse-link">
                                        <i class="fa fa-chevron-up"></i>
                                    </a>
                                    <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                                        <i class="fa fa-wrench"></i>
                                    </a>
                                </div>
                                <div class="ibox-content">
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-sm-4">
                                                <div class="form-group">
                                                    <label>Session </label>
                                                    @Html.DropDownList("SessionId", (SelectList)ViewBag.SessionId, "", new { @class = "form-control" })
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label> Change Type</label>
                                                <select class="form-control dropdown" id="changeType" name="changeType">
                                                    <option></option>
                                                    <option>Change of Course</option>
                                                    <option>Inter Faculty Transfer</option>
                                                 
                                                </select>
                                            </div>
                                        </div>
                                            <div class="col-sm-4">
                                                <div class="form-group">
                                                    <label>School Programme</label>
                                                    @Html.DropDownList("SchoolProgrammeId", (SelectList)ViewBag.SchoolProgrammeId, "", new { @class = "form-control" })
                                                </div>
                                            </div>

                                            <div class="col-md-4">
                                                <div class="form-group">
                                                    <label>Faculty</label>
                                                    @Html.DropDownList("FacultyId", (SelectList)ViewBag.FacultyId, "", new { @class = "form-control", @onchange = "getDeptList()" })
                                                </div>
                                            </div>

                                        </div>
                                        <br />
                                        <div class="row ">
                                            <div class="col-md-4">
                                                <div class="form-group">
                                                    <label>Department</label>
                                                    @Html.DropDownList("DepartmentId", (SelectList)ViewBag.DepartmentId, "", new { @class = "form-control", @onchange = "getProgrammeList()" })
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label>Dept Option</label>
                                                    @Html.DropDownList("ProgrammeId", (SelectList)ViewBag.ProgrammeId, "", new { @class = "form-control", @onchange = "getCourseList()" })
                                                </div>
                                            </div>
                                            <div class="col-md-2">
                                                <br />
                                                <button type="submit" id="btn-search" class="btn btn-primary">Search/View</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div><!--end .row -->
                        </div>
                    </div>


                    <div class="ibox-content">
                        <div class="table-responsive">
                            <table id="Jdatatable" class="table table-striped table-bordered table-hover table-responsive dataTables-example">
                                <thead>
                                    <tr>
                                        <th class="text-uppercase">S/N</th>
                                        <th class="text-uppercase">Reg No</th>
                                        <th class="text-uppercase"> Full Name</th>
                                        @*<th class="text-uppercase"> Score</th>*@
                                        <th class="text-uppercase"> Course Admitted</th>
                                        @*<th class="text-uppercase"> Reason for Rejection</th>*@
                                        @*<th class="text-uppercase"> New Course Applied For</th>*@
                                        @*<th class="text-uppercase"> Action</th>*@
                                        <th class="text-uppercase"> Action</th>
                                    </tr>
                                </thead>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- /.First column -->
    </div>

</div>



<!-- Modal -->
<div class="modal fade inmodal" id="actionsList" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <!--Content-->
        <div class="modal-content animated">
            <!--Header-->
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <div class="flex-center">
                    <h4 class="modal-title">CHANGE COURSE FOR APPLICANT</h4>
                </div>
            </div>
            <!--Body-->
            <div class="modal-body" id="myModalDivBody">
            </div>
        </div>
        <!--/.Content-->
    </div>
</div>
<!-- /.Modal-->

<script src="~/Scripts/jquery-3.1.1.min.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        window.oTable = $("#Jdatatable").DataTable({
            "processing": true, // for show progress bar while loading
            "serverSide": true, // if it is true the preocess is done on server side
            "filter": true, // disables search box
            "info": true,

            "stateSave": true,
            "orderMulti": false, // disable multiple column loading at once
            "ajax": {
                "url": "/ChangeOfCoursePayments/SuccessfulChangedCourseGetIndex",
                "type": "POST",
                "datatype": "json",
                "data": function (d) {
                    d.SchoolProgrammeId = $('#SchoolProgrammeId').val();
                    d.hasRegistered = $('#hasRegistered').val();
                    d.FacultyId = $('#FacultyId').val();
                    d.DepartmentId = $('#DepartmentId').val();
                    d.ProgrammeId = $('#ProgrammeId').val();
                    d.SessionId = $('#SessionId').val();
                }
            },
            "columns": [
                { "data": "Id", "autoWidth": true, "orderable": true },
                { "data": "RegNo", "autoWidth": true, "orderable": true },
                { "data": "FullName", "autoWidth": true, "orderable": true },
                { "data": "CourseAdmitted", "autoWidth": true },
                {
                    "data": "StudentId",
                    "autoWidth": true,
                    "render": function(data) {
                        return '<a href="#" onclick="GetProcessChangeOfCourseView(\'' + data + '\')" data-toggle="tooltip" data-placement="top" title="View Details"><i class="fa fa-edit" aria-hidden="true">Change Course&nbsp;&nbsp;</i></a>'
                    }
                }
            ],
            dom: '<"html5buttons"B>lTfgitp',
            buttons: [
                { extend: 'copy'},
                {extend: 'csv'},
                {extend: 'excel', title: 'Student List'},
                { extend: 'pdf', title: 'Student List'},

                {extend: 'print',
                    customize: function (win){
                        $(win.document.body).addClass('white-bg');
                        $(win.document.body).css('font-size', '10px');

                        $(win.document.body).find('table')
                            .addClass('compact')
                            .css('font-size', 'inherit');
                    }
                }
            ]
        });
        window.oTable.fnSort([[1, "asc"], [2, "desc"]]);

    });

    $(window).scroll(function(){
        $("#mydetailBody").stop().animate({"marginTop": ($(window).scrollTop()) + "px", "marginLeft":($(window).scrollLeft()) + "px"}, "slow" );
    });
    $("#btn-search").click(function () {
        window.oTable.ajax.reload();

    });

    function GetProcessChangeOfCourseView(studentId) {
        var url = "/ChangeOfCoursePayments/ProcessChangeOfCourseView?studentId=" + studentId;
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
    };

    function Detail(studentId) {
        var url = "/Students/PartialDetails?id=" + studentId;
        jQuery.noConflict();
        $('#mydetailBody').load(url);

    };

    function myFunction() {
        var url = "/Students/ExcelUpload";
        $('#myModalDivBody').load(url,
            function () {
                jQuery.noConflict();
                $('#actionsList').modal("show");
            });
    };

    function getDeptList() {
        var facultyId = $("#FacultyId").val();
        //alert(stateId);
        $.ajax
            ({
                url: '/Students/GetDeptList?codeId=' + facultyId,
                type: 'GET',
                datatype: 'application/json',
                contentType: 'application/json',
                success: function (result) {
                    $("#DepartmentId").html("");
                    $.each($.parseJSON(result),
                        function (i, city) {
                            //alert(result);
                            $("#DepartmentId").append($('<option></option>').val(city.DepartmentId).html(city.DeptName));
                        });

                },
                error: function () {
                    $("#DepartmentId").html("");
                    $("#ProgrammeId").html("");
                }
            });
    }
    function getProgrammeList() {
        var deptId = $("#DepartmentId").val();
        //alert(stateId);
        $.ajax
            ({
                url: '/Students/GetProgrammeList?codeId=' + deptId,
                type: 'GET',
                datatype: 'application/json',
                contentType: 'application/json',
                //data: JSON.stringify({
                //    codeId: +stateId
                //}),
                success: function (result) {
                    $("#ProgrammeId").html("");
                    $.each($.parseJSON(result),
                        function (i, city) {
                            //alert(result);
                            $("#ProgrammeId").append($('<option></option>').val(city.ProgrammeId).html(city.ProgrammeName));
                        });

                },
                error: function () {
                    $("#ProgrammeId").html("");
                }
            });
    }
</script>