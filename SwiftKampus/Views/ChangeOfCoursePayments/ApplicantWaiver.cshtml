@model IEnumerable<SwiftKampusModel.AddmissionApplicant.Applicant>

@{
    ViewBag.Title = "Waiver Applicants";
}
<link href="~/AdminTemplate/css/plugins/sweetalert/sweetalert.css" rel="stylesheet">

<div class="container-fluid">
    <!-- First row -->
    <div class="row">
        <!-- First column -->
        <div class="col-md-12">

            <div class="wrapper wrapper-content animated fadeInRight">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="ibox float-e-margins">
                            <div class="ibox-title">
                                <h5>List of Waiver Applicants</h5>
                                <div class="ibox-tools">
                                    @*<a onclick="myFunction()" class="btn btn-primary"><i class="fa fa-file-excel-o"></i> EXCEL UPLOAD</a>*@
                                    <a onclick="ChangeOfCourse()" class="btn btn-primary"><i class="fa fa-user"></i>&nbsp;DOWNLOAD LIST</a>
                                    @*<a onclick="AddNew()" class="btn btn-primary"><i class="fa fa-user"></i>&nbsp;ADD APPLICANT</a>*@
                                    @if (ViewBag.Message != null)
                                    {
                                        <div class="alert alert-success">
                                            <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
                                            <strong>@ViewBag.Message</strong>
                                        </div>
                                    }

                                    <a class="collapse-link">
                                        <i class="fa fa-chevron-up"></i>
                                    </a>
                                    <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                                        <i class="fa fa-wrench"></i>
                                    </a>
                                </div>
                                <div class="ibox-content">
                                    <article class="margin-bottom-xxl">
                                        <p class="lead">
                                            Please use the following parameters to perform Query
                                        </p>
                                    </article>
                                    <div class="card-body">
                                        <div class="row form-inline">
                                            <div class="col-sm-2">
                                                <div class="form-group">
                                                    <label>Is Processed</label>
                                                    <select class="form-control dropdown" id="isDirectEntry" name="isDirectEntry">
                                                        <option>False</option>
                                                        <option>True</option>
                                                    </select>
                                                </div>

                                            </div>
                                            <div class="col-sm-2">
                                                <div class="form-group">
                                                    <label> Has Paid</label>
                                                    <select class="form-control dropdown" id="hasRegistered" name="hasRegistered">
                                                        <option>False</option>
                                                        <option>True</option>

                                                    </select>
                                                </div>
                                            </div>
                                            <div class="col-sm-3">
                                                <div class="form-group">
                                                    <label>Session Name</label>
                                                    @Html.DropDownList("SessionId", (SelectList)ViewBag.SessionId, "", new { @class = "form-control" })
                                                </div>
                                            </div>

                                            <div class="col-sm-3">
                                                <br />
                                                <button type="submit" id="btn-search" class="btn btn-primary">Search/View</button>

                                            </div>
                                        </div>


                                    </div><!--end .row -->

                                </div>
                            </div>


                            <div class="ibox-content">
                                <div class="table-responsive">
                                    <table id="Jdatatable" class="table table-striped table-bordered table-hover table-responsive dataTables-example">
                                        <thead>
                                            <tr>
                                                <th> Form Number</th>
                                                <th> Full Name</th>
                                                <th> Employer</th>
                                                <th> Result Grade</th>
                                                <th> State of Origin</th>
                                                <th> Programme</th>
                                                <th> Dean's Recommendation</th>
                                                <th> Actions</th>
                                            </tr>
                                        </thead>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- /.First column -->
        <!-- Second column -->
        <div class="col-md-3 mb-1">
            <div class="card contact-card with-padding">
                <div class="card-body" id="mydetailBody">
                </div>
            </div>
        </div>
        <!-- /.Second column -->
    </div>
    <!-- /.First row -->
</div>


<!-- Modal -->
<div class="modal fade inmodal" id="actionsList" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <!--Content-->
        <div class="modal-content animated">
            <!--Header-->
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <div class="flex-center">
                    <h4 class="modal-title">UTME APPLICANTS</h4>
                </div>
            </div>
            <!--Body-->
            <div class="modal-body" id="myModalDivBody">
            </div>
        </div>
        <!--/.Content-->
    </div>
</div>
<!-- /.Modal-->

<script src="~/Scripts/jquery-3.1.1.min.js"></script>
<script src="~/AdminTemplate/js/plugins/sweetalert/sweetalert.min.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        window.oTable = $("#Jdatatable").DataTable({
            "processing": true, // for show progress bar while loading
            "serverSide": true, // if it is true the preocess is done on server side
            "filter": true, // disables search box
            "info": true,

            //"stateSave": true,
            //"orderMulti": false, // disable multiple column loading at once
            "ajax": {
                "url": "/ChangeOfCoursePayments/GetApplicantWaiverIndex",
                "type": "POST",
                "datatype": "json",
                "data": function (d) {
                    d.hasRegistered = $('#hasRegistered').val();
                    d.isDirectEntry = $('#isDirectEntry').val();
                    d.SessionId = $('#SessionId').val();
                }

            },
            "columns": [
                { "data": "JambRegNo", "autoWidth": true, "orderable": true },
                { "data": "FullName", "autoWidth": true, "orderable": true },
                //{ "data": "MiddleName", "autoWidth": true, "orderable": true },
                { "data": "Email", "autoWidth": true, "orderable": true },
                { "data": "ResultGrade", "autoWidth": true },
                { "data": "StateOfOrigin", "autoWidth": true },
                { "data": "Lga", "autoWidth": true },
                { "data": "PGRecommendation", "autoWidth": true },
                {
                    "data": "JambRegNo",
                    "autoWidth": true,
                    "render": function(data) {
                        return '<a href="#" onclick="Detail(\'' + data + '\')" data-toggle="tooltip" data-placement="top" title="View Details"><i class="fa fa-info-circle" aria-hidden="true">&nbsp;Process&nbsp;&nbsp;</i></a>';
                            //'<a href="#" onclick="Edit(\'' + data + '\')" data-toggle="tooltip" data-placement="top" title="Edit Student"><i class="fa fa-pencil" aria-hidden="true"></i>&nbsp;Edit</a>';
                            //'<a href="#" onclick="Delete(\'' + data + '\')" data-toggle="tooltip" data-placement="top" title="Delete Student Record">&nbsp;&nbsp;<i class="fa fa-remove" aria-hidden="true" ></i>Delete</a>';
                    }
                }
            ],
            dom: '<"html5buttons"B>lTfgitp',
            lengthMenu: [
                [10, 25, 50, 100, 200, 500, 1000, 2000,3000,5000],
                [10, 25, 50, 100, 200, 500, 1000, 2000,3000,5000]
            ],
            buttons: [
                //{ extend: 'copy'},
                //{extend: 'csv'},
                {extend: 'excel', title: 'FacultyList'},
                { extend: 'pdf', title: 'FacultyList'},

                {extend: 'print',
                    customize: function (win){
                        $(win.document.body).addClass('white-bg');
                        $(win.document.body).css('font-size', '10px');

                        $(win.document.body).find('table')
                            .addClass('compact')
                            .css('font-size', 'inherit');
                    }
                }
            ]
        });
        window.oTable.fnSort([[1, "asc"], [2, "desc"]]);

    });

    $(window).scroll(function(){
        $("#mydetailBody").stop().animate({"marginTop": ($(window).scrollTop()) + "px", "marginLeft":($(window).scrollLeft()) + "px"}, "slow" );
    });

    $("#btn-search").click(function () {
        window.oTable.ajax.reload();

    });
    //function Detail(jambRegNo) {
    //    var url = "/UtmeApplicants/PartialDetails?id=" + jambRegNo;

    //    $('#mydetailBody').load(url);
    //};

     function Detail(studentId) {
        swal({
            title: "Process Waiver Application",
            text: "Are you sure you want to Approve Application?..",
            type: "warning",
            showCancelButton: true,
            confirmButtonColor: "#ab973a",
            confirmButtonText: "Yes, Approve Now!",
            cancelButtonText: "No, Disapprove!",
            closeOnConfirm: false,
            closeOnCancel: false
        },
            function (isConfirm) {
                if (isConfirm) {
                    var AllData = {
                        "id": studentId,
                    };
                    var Mydata = JSON.stringify(AllData);

                    $.ajax({
                        contentType: 'application/json',
                        type: "POST",
                        url: "/ChangeOfCoursePayments/ProcesWaiverApplication?id=" + studentId,
                        data: Mydata,
                        success: function (data) {
                            if (data.status) {
                                swal({
                                    title: "Great",
                                    text: data.message,
                                    type: "success",
                                });
                                window.oTable.ajax.reload(); //run my_fun() ondomready
                                toastr["success"](data.message);
                            } else {
                                swal({
                                    title: "Warning",
                                    text: data.message,
                                    type: "warning",
                                });
                                toastr["error"](data.message);
                            }

                        }
                    });
                    //swal("Great!", "Student has been cleared Successfully.", "success");
                } else {

                    RejectStudent(studentId);
                    swal("Processing...", "Click OK", "info");
                }
            });
    };

    function myFunction() {
        var url = "/UtmeApplicants/UploadUtmeApplicants";
        $('#myModalDivBody').load(url,
            function () {
               jQuery.noConflict();
                $('#actionsList').modal("show");
            });
    };
    function ChangeOfCourse() {
        var url = "/UtmeApplicants/ChangeOfCourseUtmeApplicants";
        $('#myModalDivBody').load(url,
            function () {
               jQuery.noConflict();
                $('#actionsList').modal("show");
            });
    };

    function RejectStudent(studentId) {
        var url = "ChangeOfCoursePayments/DisaproveWaiverApplication?id=" + studentId;
        var AllData = {
                        "id": studentId,
                    };
        var Mydata = JSON.stringify(AllData);
        $.ajax({
                        contentType: 'application/json',
                        type: "POST",
                        url: "/ChangeOfCoursePayments/DisaproveWaiverApplication?id=" + studentId,
                        data: Mydata,
                        success: function (data) {
                            if (data.status) {
                                swal({
                                    title: "Great",
                                    text: data.message,
                                    type: "success",
                                });
                                window.oTable.ajax.reload(); //run my_fun() ondomready
                                toastr["success"](data.message);
                            } else {
                                swal({
                                    title: "Warning",
                                    text: data.message,
                                    type: "warning",
                                });
                                toastr["error"](data.message);
                            }

                        }
                    });
        
    };

    function AddNew() {
        window.open('@Url.Action("Create", "UtmeApplicants")', '_self');
    };
</script>


