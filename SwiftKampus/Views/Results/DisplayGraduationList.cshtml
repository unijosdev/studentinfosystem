@model SwiftKampus.ViewModels.Result.GraduantsListVm

@if (ViewBag.Message != null || !string.IsNullOrEmpty(ViewBag.Message))
{
    <p class="text-danger">@ViewBag.Message</p>
}

@foreach (var item in Model.ClassOfHonour)
{
    if (Model.NyscListVms.Any(x => x.ClassOfDegree.Equals(item)))
    {
        <h3 class="text-uppercase">@item HONORS</h3>

        <table class="table">          

            @foreach (var list in Model.NyscListVms.Where(x => x.ClassOfDegree.Equals(item)))
            {
                <tr>
                    <td>@list.Sn</td>
                    <td>@list.MatricNo</td>
                    <td><strong>@list.Surname</strong>&nbsp;  @list.OtherName</td>
                </tr>
            }
        </table>
    }

}


