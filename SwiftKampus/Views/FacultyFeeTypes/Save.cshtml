
@model SwiftKampus.ViewModels.FacultyFeeTypeVm

<script src="~/AdminTemplate/js/plugins/chosen/chosen.jquery.js"></script>
<link href="~/AdminTemplate/css/plugins/chosen/bootstrap-chosen.css" rel="stylesheet" />

<form id="myform" onsubmit="return false;">
    @Html.AntiForgeryToken()
    <div class="card">
        <div class="card-head style-primary">

        </div><!--end .card-head -->
        <div class="card-body">

            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            @if (Model != null && Model.FacultyFeeTypeId > 0)
            {
                @Html.HiddenFor(model => model.FacultyFeeTypeId)
            }

            <div class="form-group">
                @Html.Label("Faculty Name")
                @Html.DropDownList("FacultyId", null, htmlAttributes: new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.FacultyId, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.Label("Semester Name")
                @Html.DropDownList("SemesterId", null, htmlAttributes: new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.SemesterId, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.Label("School Programme")
                @Html.DropDownList("SchoolProgrammeId", null, htmlAttributes: new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.SchoolProgrammeId, "", new { @class = "text-danger" })
            </div>
            <div class="form-group">
                @Html.Label("Level")
                @Html.DropDownList("LevelId", null, htmlAttributes: new { @class = "form-control chosen-select", @multiple = "true" })
                @Html.ValidationMessageFor(model => model.LevelId, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.Label("Fee Name")
                @Html.EditorFor(model => model.FeeName, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.FeeName, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.Amount)
                @Html.EditorFor(model => model.Amount, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Amount, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.Label("Amount in Words")
                @Html.EditorFor(model => model.AmountInWords, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.AmountInWords, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.Description)
                @Html.EditorFor(model => model.Description, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
            </div>
            <br />
            <br />
            <div class="md-form">

                @if (Model != null && Model.FacultyFeeTypeId > 0)
                {
                    <input id="btnsubmit" type="submit" value="Update" class="btn btn-primary btn-lg" />
                }
                else
                {
                    <input id="btnsubmit" type="submit" value="Save" class="btn btn-primary btn-lg" />
                }
                <a href="#" class="btn btn-danger btn-lg" data-dismiss="modal">Cancel</a>
            </div>
        </div><!--end .card-body -->

    </div>
</form>
@*@section Scripts {
        @Scripts.Render("~/bundles/jqueryval")
    }*@


<script type="text/javascript">
    $(document).ready(function () {
        $('.chosen-select').chosen();
        $(function () {
            $('.listbox').multiselect({
                includeSelectAllOption: true
            });
        });

        $("#btnsubmit").click(function () {

            var data = $("#myform").serialize();

            $.ajax({
                type: "POST",
                url: "/FacultyFeeTypes/Save",
                data: data,
                success: function (data) {
                    if (data.status) {
                        $('#actionsList').modal("hide");
                        window.oTable.ajax.reload(); //run my_fun() ondomready
                        toastr["success"](data.message);
                        $('#myform')[0].reset();
                    } else {
                        toastr["error"](data.message);
                        $('#actionsList').modal("hide");

                    }

                }
            });
        });
    });
</script>



