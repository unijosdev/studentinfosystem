@model IEnumerable<SwiftKampusModel.Audit>

@{
    ViewBag.Title = "Audit Trail";
}

<div class="container-fluid">
    <!-- First row -->
    <div class="row">
        <!-- First column -->
        <div class="col-md-12">

            <div class="wrapper wrapper-content animated fadeInRight">
                <div class="row">

                    <div class="col-lg-12">
                        <div class="ibox float-e-margins">
                            <div class="ibox-title">
                                <h3>List of User Activities</h3>

                                @*<form class="form-inline" id="formFilter" onsubmit="return false;">

                                        <div class="form-group">
                                            <label class="control-label" for="UserName">User Name / Ip Address</label> <br />
                                            <input type="text" id="UserName" name="UserName" class="form-control" placeholder="Type UserName or Ip Address" />
                                        </div>

                                        <div class="form-group">
                                            <label class="control-label" for="AccessDate">Access Date</label><br />
                                            <input type="date" id="AccessDate" name="AccessDate" class="form-control" />
                                        </div>

                                        <button type="submit" id="btn-search" class="btn btn-primary btn-lg">Search/View</button>
                                    </form>*@
                                <div class="ibox-tools">

                                    @if (ViewBag.Message != null)
                                    {
                                        <div class="alert alert-success">
                                            <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
                                            <strong>@ViewBag.Message</strong>
                                        </div>
                                    }

                                    <a class="collapse-link">
                                        <i class="fa fa-chevron-up"></i>
                                    </a>
                                    <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                                        <i class="fa fa-wrench"></i>
                                    </a>
                                </div>
                            </div>

                            <div class="ibox-content">
                                <div class="table-responsive">
                                    <table id="Jdatatable" class="table table-striped table-bordered table-hover table-responsive dataTables-example">
                                        <thead>
                                            <tr>
                                                <th>UserName</th>
                                                <th>IP Addresss</th>
                                                <th>Url Accessed</th>
                                                <th>Action Performed</th>
                                                <th>Time Accessed</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- /.First column -->
    </div>
    <!-- /.First row -->
</div>

<!-- Modal -->
<div class="modal fade modal-bf-fh" id="actionsList" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <!--Content-->
        <div class="modal-content">
            <!--Header-->
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <div class="flex-center">
                    <h4 class="modal-title">SYSTEM AUDIT</h4>
                    @*<a class="btn btn-primary btn-sm">Create new action</a>*@
                </div>
            </div>
            <!--Body-->
            <div class="modal-body" id="myModalDivBody">
            </div>
        </div>
        <!--/.Content-->
    </div>
</div>
<!-- /.Modal-->

<script src="~/AdminTemplate/js/jquery-3.1.1.min.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        var username = '';
        var accessdate = '';
        window.oTable = $("#Jdatatable").DataTable({
            "processing": true, // for show progress bar while loading
            "serverSide": true, // if it is true the preocess is done on server side
            "filter": true, // disables search box
            "info": true,

            "stateSave": true,
            "orderMulti": false, // disable multiple column loading at once
            "ajax": {
                // "url": "/Audits/GetIndex?Username=" + $('#UserName').val() + ",AccesDate=" + $('#AccessDate').val(),
                "url": "/Audits/GetIndex",
                "type": "POST",
                "datatype": "json"
            },
            "columns": [
                { "data": "UserName", "autoWidth": true, "orderable": true },
                { "data": "IpAddress", "autoWidth": true, "orderable": true },
                { "data": "UrlAccessed", "autoWidth": true },
                { "data": "ActionPerformed", "autoWidth": true },
                { "data": "TimeAccessed", "autoWidth": true },
                {
                    "data": "AuditId",
                    "autoWidth": true,
                    "render": function (data) {
                        return '<a href="#" onclick="Detail(\'' + data + '\')" data-toggle="tooltip" data-placement="top" title="View Details"><i class="fa fa-info-circle" aria-hidden="true">Details&nbsp;&nbsp;</i></a>';
                    }
                }
            ],
            dom: '<"html5buttons"B>lTfgitp',
            buttons: [
                { extend: 'copy' },
                { extend: 'csv' },
                { extend: 'excel', title: 'System Audit' },
                { extend: 'pdf', title: 'System Audit' },

                {
                    extend: 'print',
                    customize: function (win) {
                        $(win.document.body).addClass('white-bg');
                        $(win.document.body).css('font-size', '10px');

                        $(win.document.body).find('table')
                            .addClass('compact')
                            .css('font-size', 'inherit');
                    }
                }
            ]
        });
        window.oTable.fnSort([[1, "asc"], [2, "desc"]]);

    });

    $("#btn-search").click(function () {
        username = $('#UserName').val();
        accessdate = $('#AccessDate').val();
        alert(username + " and " + accessdate)
        window.oTable.ajax.reload();
    });
    $(window).scroll(function () {
        $("#mydetailBody").stop().animate({ "marginTop": ($(window).scrollTop()) + "px", "marginLeft": ($(window).scrollLeft()) + "px" }, "slow");
    });

    function Detail(studentId) {
        //window.alert(subjecId);
        var url = "/Audits/PartialDetails?id=" + studentId;
        $('#mydetailBody').load(url);

    };
</script>