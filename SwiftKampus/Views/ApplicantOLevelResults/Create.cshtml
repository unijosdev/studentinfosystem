@model SwiftKampusModel.AddmissionApplicant.ApplicantOLevelResultVm

@{
    ViewBag.Title = "Add OLevel Result";
    ViewBag.Count = Model.UnderGraduateRules.Select(x => x.IsRequired.Equals(true)).Count();
    ViewBag.Max = Model.UnderGraduateRules.Count();
    var remaining = 5 - ViewBag.Count;
    var isAdd = false;

    if (ViewBag.Count > ViewBag.Max)
    {
        isAdd = true;
    }
}


<link href="~/AdminTemplate/css/plugins/sweetalert/sweetalert.css" rel="stylesheet">

<form id="myform" onsubmit="return false;">

    <div class="row wrapper border-bottom white-bg page-heading">
        <div class="col-lg-10">
            <h2>Add O-Level Result</h2>

        </div>
        <div class="col-lg-2">
        </div>
    </div>

    <div class="wrapper wrapper-content animated fadeInRight">
        <div class="row">
            <div class="col-md-3">
                <div class="row">
                    <div class="com-md-12">
                        <h4 class="text-center BigBold-Title">Instruction</h4>

                        <ul class="bold">
                            <li><strong>You are only allowed to enter <i class="BigBold-Title"> Five (5)</i> relevant subjects from <i class="bold italic">not more than two sittings.</i> </strong></li>
                            <li><strong>Editing of results will NOT be allowed once the Post JAMB screening is closed</strong></li>
                        </ul>
                    </div>
                </div>


            </div>

            <div class="col-md-9">
                <div class="ibox float-e-margins">
                    <div class="ibox-content form-horizontal">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        <h3>Enter the required subjects and best grades archieved.</h3>

                        <table width="100%" class="table table-responsive">
                            <tr>
                                <th>Subject Name</th>
                                <th>Grade &nbsp;&nbsp; &nbsp; &nbsp;</th>
                                <th>Awarding Body</th>
                                @*<th>Year</th>
                                    <th>Exam Center</th>*@


                            </tr>
                            @for (var i = 0; i < Model.UnderGraduateRules.Count; i++)
                            {
                                @Html.HiddenFor(model => model.UnderGraduateRules[i].SubjectId, new { @class = "subjectId" })
                                <tr>

                                    <td>
                                        @Html.DisplayFor(model => model.UnderGraduateRules[i].Subject.CourseName)
                                    </td>
                                    <td>
                                        @Html.DropDownList($"SubjectGrade{i}", (SelectList)ViewBag.SubjectGrade, "", new { @class = "form-control subjectGrade" })
                                    </td>
                                    <td>
                                        @Html.DropDownList($"ResultName{i}", (SelectList)ViewBag.ResultName, "", new { @class = "form-control resultName" })
                                    </td>
                                    @*<td>
                                            @Html.EditorFor(model => model.ApplicantOLevelVm[i].Year, new { htmlAttributes = new { @class = "form-control year" } })
                                            @Html.ValidationMessageFor(model => model.ApplicantOLevelVm[i].Year, "", new { @class = "text-danger" })
                                        </td>
                                        <td>
                                            @Html.EditorFor(model => model.ApplicantOLevelVm[i].ExaminationCenter, new { htmlAttributes = new { @class = "form-control examCenter" } })
                                            @Html.ValidationMessageFor(model => model.ApplicantOLevelVm[i].ExaminationCenter, "", new { @class = "text-danger" })
                                        </td>*@
                                    <td></td>
                                </tr>
                            }
                            @for (var i = 0; i < remaining; i++)
                            {
                                <tr>
                                    <td>
                                        @Html.DropDownList($"SubjectId{1}", (SelectList)ViewBag.SubjectId, "", new { @class = "form-control subjectId" })
                                    </td>
                                    <td>
                                        @Html.DropDownList($"SubjectGrade{1}", (SelectList)ViewBag.SubjectGrade, "", new { @class = "form-control subjectGrade" })
                                    </td>
                                    <td>
                                        @Html.DropDownList($"ResultName{1}", (SelectList)ViewBag.ResultName, "", new { @class = "form-control resultName" })
                                    </td>
                                    @*<td>
                                            @Html.EditorFor(model => model.ApplicantOLevelVm[1].Year, new { htmlAttributes = new { @class = "form-control year" } })
                                            @Html.ValidationMessageFor(model => model.ApplicantOLevelVm[1].Year, "", new { @class = "text-danger" })
                                        </td>
                                        <td>
                                            @Html.EditorFor(model => model.ApplicantOLevelVm[1].ExaminationCenter, new { htmlAttributes = new { @class = "form-control examCenter" } })
                                            @Html.ValidationMessageFor(model => model.ApplicantOLevelVm[1].ExaminationCenter, "", new { @class = "text-danger" })
                                        </td>*@
                                </tr>
                            }


                        </table>
                        <div class="form-group">
                            <div class="col-md-10">
                                <input type="submit" id="btnSave" value="Save and Continue" class="btn btn-primary btn-lg" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-12">
                    <a id="btnolevelPrevious" href="@Url.Action("Edit","UtmeApplicants")" class="btn btn-warning btn-lg btnPrevious" data-dismiss="modal">PREVIOUS</a>
                    @if (ViewBag.IsDirectEntry == "True")
                    {
                        <a id="btnolevelNext" href="@Url.Action("Create","Qualifications")" class="btn btn-warning btn-lg btnNext" data-dismiss="modal">NEXT</a>
                    }
                    else
                    {
                        <a id="btnolevelNext" href="@Url.Action("Details", "UtmeApplicants")" class="btn btn-warning btn-lg btnNext" data-dismiss="modal">NEXT</a>
                    }
                </div>
            </div>
        </div>

    </div>
</form>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

<script src="~/Scripts/jquery-3.3.1.min.js"></script>
<script src="~/AdminTemplate/js/plugins/sweetalert/sweetalert.min.js"></script>
<script>
    var count = '@Model.UnderGraduateRules.Count()';
    $(document).ready(function () {
        $('#btnAddMore').click(function () {
            var myCount = '@ViewBag.Count';
            if (count < myCount) {
                var new_field = `<tr>
                                <td>
                                    @Html.DropDownList($"SubjectId{1}", (SelectList)ViewBag.SubjectId, "", new { @class = "form-control subjectId" })
                                </td>
                                <td>
                                    @Html.DropDownList($"SubjectGrade{1}", (SelectList)ViewBag.SubjectGrade, "", new { @class = "form-control subjectGrade" })
                                </td>
                                <td>
                                    @Html.DropDownList($"ResultName{1}", (SelectList)ViewBag.ResultName, "", new { @class = "form-control resultName" })
                                </td>

                                <td>
                                    <span onclick="remove_button(this)" input-group-btn col-sm-2">
                                            <label class="control-label">&nbsp;</label>
                                        <button type="button" class="btn btn-primary"><i class="fa fa-minus"></i></button>
                                    </span>
                                </td>
                        </tr>`;
                $('.repeatable').append(new_field);
                count++;
            }
            else
            {
                swal({
                    title: "Warning",
                    text: "Maximum number of fields exceeded!",
                    type: "warning",
                });            }
        });

        $('#btnSave').click(function () {

            $('#btnSave').attr('disabled', true);

            var subjectid = [];
            var subjectgrade = [];
            var yearlist = [];
            var resultNamelist = [];
            var examCenterlist = [];
            var modelvm = [];


            //pulling the form data using the class and adding it to a list
            $.each($('.subjectId'), function () {
                subjectid.push($(this).val());
            });

            $.each($('.subjectGrade'), function () {
                subjectgrade.push($(this).val());
            });
            $.each($('.year'), function () {
                yearlist.push($(this).val());
            });
            $.each($('.resultName'), function () {
                resultNamelist.push($(this).val());
            });
            $.each($('.examCenter'), function () {
                examCenterlist.push($(this).val());
            });

            for (var i = 0; i < subjectid.length; i++) {
                var data = {
                    "ResultName": resultNamelist[i],
                    "ExaminationCenter": examCenterlist[i],
                    "Year": yearlist[i],
                    "SubjectId": subjectid[i],
                    "SubjectGrades": subjectgrade[i],
                    "MaximumCount": '@ViewBag.Count',
                };
                modelvm.push(data);
            }

            var Mydata = JSON.stringify(modelvm);
            //alert(Mydata);

            $.ajax({
                contentType: 'application/json',
                type: "POST",
                url: "/ApplicantOLevelResults/Create",
                data: Mydata,
                success: function (data) {
                    if (data.status) {
                        swal({
                            title: "Result saved successfully",
                            //text: "Do you  Proceed?..",
                            type: "warning",
                            showCancelButton: true,
                            confirmButtonColor: "#ab973a",
                            confirmButtonText: "Proceed!",
                            //cancelButtonText: "No, See Result List!",
                            closeOnConfirm: false,
                            closeOnCancel: false
                        },
                            function (isConfirm) {
                                if (isConfirm) {
                                    swal("Great!", "Proceed!!!.", "success");
                                    goNext()
                                } else {
                                    swal("Great", "You can now see your result list", "success");
                                    window.open('@Url.Action("Index", "ApplicantOLevelResults")', '_self');

                                }
                            });
                        toastr["success"](data.message);
                    } else {
                        swal({
                            title: "Warning",
                            text: data.message,
                            type: "warning",
                        });
                        toastr["success"](data.message);
                    }

                }
            }).then(function () {
                $('#btnSave').attr('disabled', false);
            });
        });

    });

    function remove_button(elem) {
        if (count > 1) {
            $(elem).closest('tr').remove();
            count--;
        }
    }

    function goNext() {
        var check = '@ViewBag.IsDirectEntry';
        if (check === 'True') {
            window.open('@Url.Action("Create", "Qualifications")', '_self');
        } else {
            window.open('@Url.Action("Details", "UtmeApplicants")', '_self');

        }
    }




</script>

