@model SwiftKampusModel.AddmissionApplicant.ApplicantOLevelResult

<link href="~/AdminTemplate/css/plugins/sweetalert/sweetalert.css" rel="stylesheet">

<div class="ibox float-e-margins">
    <div class="col-md-12">
        <div class="ibox-title">
            <h2>
                Add O-Level Result   <span class="text-right">
                    <button id="addSecondSitting" type="button" class="btn btn-primary"><i class="fa fa-plus"></i>Add Second Sitting</button>
                </span>
            </h2>

            <div class="ibox-tools">
                <a class="collapse-link">
                    <i class="fa fa-chevron-up"></i>
                </a>
            </div>
        </div>
        <div class="row wrapper border-bottom white-bg page-heading">
            <div class="row">
                <div class="col-md-6">
                    <h2>
                        Add O-Level Result(s)
                    </h2>
                </div>
                <div class="col-md-6">
                    <h2>
                        <span class="">
                            <button id="addSecondSitting" type="button" class="btn btn-primary"><i class="fa fa-plus"></i> Add Second Sitting</button>
                        </span>
                        <span class="pull-right">
                            <button id="addSecondSitting2" type="button" class="btn btn-primary"><i class="fa fa-close"></i> Remove Second Sitting</button>
                        </span>
                    </h2>
                </div>
            </div>
            
        </div>
    </div>
    
    <br /><br /><br /><br />
    <div class="col-md-12">
        <div class="row ibox-content">
            <form id="myolevelform" onsubmit="return false;">
                <div class="ibox float-e-margins">
                    <div class="col-md-6 border-right border-3px">

                        <div form-horizontal">
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.Label("Exam Body")
                                        @Html.DropDownList("ResultName", null, htmlAttributes: new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.ResultName, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.Label("Examination Number")
                                        @Html.EditorFor(model => model.ExamNumber, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.ExamNumber, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.Label("Examination Center")
                                        @Html.EditorFor(model => model.ExaminationCenter, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.ExaminationCenter, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.Year)
                                        @Html.EditorFor(model => model.Year, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.Year, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="repeatableolevel">
                                        <div class="row form-group">
                                            <div class="col-sm-5">
                                                <div class="input-group col-md-12">
                                                    @Html.Label("Subject Name")
                                                    @Html.DropDownList("SubjectId", (SelectList)ViewBag.SubjectId, "", new { @class = "form-control subjectId" })
                                                    @Html.ValidationMessageFor(model => model.SubjectId, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                            <div class="col-sm-5">
                                                <div class="input-group  col-md-12">
                                                    @Html.Label("Grade")
                                                    @Html.DropDownList("SubjectGrade", (SelectList)ViewBag.SubjectGrade, "", new { @class = "form-control subjectGrade" })
                                                    @Html.ValidationMessageFor(model => model.SubjectGrade, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                            <span input-group-btn col-sm-2">
                                                <label class="col-sm-2  control-label">&nbsp;</label>
                                                <button id="btnolevelAddMore1" type="button" class="btn btn-primary"><i class="fa fa-plus"></i> Add</button>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div id="sitting2" form-horizontal">
                            
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.Label("Exam Body")
                                        @Html.DropDownList("ResultName", null, htmlAttributes: new { @class = "form-control", @id = "ResultName2" })
                                        @Html.ValidationMessageFor(model => model.ResultName, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.Label("Examination Number")
                                        @Html.EditorFor(model => model.ExamNumber, new { htmlAttributes = new { @class = "form-control", @id = "ExamNumber2" } })
                                        @Html.ValidationMessageFor(model => model.ExamNumber, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.Label("Examination Center")
                                        @Html.EditorFor(model => model.ExaminationCenter, new { htmlAttributes = new { @class = "form-control", @id = "ExaminationCenter2" } })
                                        @Html.ValidationMessageFor(model => model.ExaminationCenter, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.Year)
                                        @Html.EditorFor(model => model.Year, new { htmlAttributes = new { @class = "form-control", @id = "Year2" } })
                                        @Html.ValidationMessageFor(model => model.Year, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="repeatableolevel2">
                                        <div class=" row form-group">
                                            <div class="col-sm-5">
                                                <div class="input-group col-md-12">
                                                    @Html.Label("Subject Name")
                                                    @Html.DropDownList("SubjectId", (SelectList)ViewBag.SubjectId, "", new { @class = "form-control subjectId2" })
                                                    @Html.ValidationMessageFor(model => model.SubjectId, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                            <div class="col-sm-5">
                                                <div class="input-group  col-md-12">
                                                    @Html.Label("Grade")
                                                    @Html.DropDownList("SubjectGrade", (SelectList)ViewBag.SubjectGrade, "", new { @class = "form-control subjectGrade2" })
                                                    @Html.ValidationMessageFor(model => model.SubjectGrade, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                            <span input-group-btn col-sm-2">
                                                <label class="col-sm-2  control-label">&nbsp;</label>
                                                <button id="btnolevelAddMore2" type="button" class="btn btn-primary"><i class="fa fa-plus"></i> Add</button>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="form-group">
                            <div class="col-md-12">
                                <input type="submit" id="btnolevelSave" value="SAVE AND CONTINUE" class="btn btn-primary btn-sm pull-right" />
                            </div>
                        </div>
                    </div>

                </div>
            </form>
        </div>
    </div>
   
        <div class="col-md-12">
            <a id="btnolevelPrevious" href="#" class="btn btn-warning btn-lg btnPrevious" data-dismiss="modal">PREVIOUS</a>
            @*<a id="btnlevelNext2" href="#" class="btn btn-warning btn-lg btnNext" data-dismiss="modal">NEXT</a>*@
        </div>
  
</div>


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

<script src="~/AdminTemplate/js/plugins/sweetalert/sweetalert.min.js"></script>
<script>
    var count = 1;
    var count2 = 1;
    var myCount = 9;
    var myCount2 = 9;
    var secondSitting = false;

    $(document).ready(function () {
        $("#sitting2").hide();
        $('#btnolevelAddMore1').click(function () {
            if (count < myCount) {
                var new_field = `<div class="form-group row">
                                <div class="col-sm-5">
                                    <div class="input-group col-md-12">
                                        @Html.Label("Subject Name")
                                        @Html.DropDownList("SubjectId", (SelectList)ViewBag.SubjectId, "", new { @class = "form-control subjectId" })
                                        @Html.ValidationMessageFor(model => model.SubjectId, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <div class="col-sm-5">
                                    <div class="input-group  col-md-12">
                                        @Html.Label("Grade")
                                        @Html.DropDownList("SubjectGrade", (SelectList)ViewBag.SubjectGrade, "", new { @class = "form-control subjectGrade" })
                                        @Html.ValidationMessageFor(model => model.SubjectGrade, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            <span onclick="remove_button(this)" input-group-btn col-sm-2">
                                    <label class="col-sm-2  control-label">&nbsp;</label>
                                <button type="button" class="btn btn-primary"><i class="fa fa-minus"></i></button>
                            </span>
                        </div>`;
                $('.repeatableolevel').append(new_field);
                count++;
            }
            else
            {
                swal({
                    title: "Warning",
                    text: "Maximum number of fields exceeded!",
                    type: "warning",
                });
            }
        });

        $('#btnolevelAddMore2').click(function () {
            if (count2 < myCount2) {
                var new_field = `<div class="form-group row ">

                                <div class="col-sm-5">
                                    <div class="input-group col-md-12">
                                        @Html.Label("Subject Name")
                                        @Html.DropDownList("SubjectId", (SelectList)ViewBag.SubjectId, "", new { @class = "form-control subjectId2" })
                                        @Html.ValidationMessageFor(model => model.SubjectId, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <div class="col-sm-5">
                                    <div class="input-group  col-md-12">
                                        @Html.Label("Grade")
                                        @Html.DropDownList("SubjectGrade", (SelectList)ViewBag.SubjectGrade, "", new { @class = "form-control subjectGrade2" })
                                        @Html.ValidationMessageFor(model => model.SubjectGrade, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            <span onclick="remove_button2(this)" input-group-btn col-sm-2">
                                    <label class="col-sm-2  control-label">&nbsp;</label>
                                <button type="button" class="btn btn-primary"><i class="fa fa-minus"></i></button>
                            </span>
                        </div>`;
                $('.repeatableolevel2').append(new_field);
                count2++;
            }
            else
            {
                swal({
                    title: "Warning",
                    text: "Maximum number of fields exceeded!",
                    type: "warning",
                });
            }
        });


        $("#addSecondSitting").click(function () {
            $("#sitting2").show();
            secondSitting = true;
        });
        $("#addSecondSitting2").click(function () {
            $("#sitting2").hide();
            secondSitting = false;
        });

        $('#btnolevelSave').click(function () {

            var subjectid = [];
            var subjectgrade = [];
            var subjectgradelist = [];
            var subjectid2 = [];
            var subjectgrade2 = [];
            var subjectgradelist2 = [];
            var myData = [];

            //pulling the form data using the class and adding it to a list
            $.each($('.subjectId'), function () {
                subjectid.push($(this).val());
            });

            $.each($('.subjectGrade'), function () {
                subjectgrade.push($(this).val());
            });

            //pulling the form data using the class and adding it to a list
            $.each($('.subjectId2'), function () {
                subjectid2.push($(this).val());
            });

            $.each($('.subjectGrade2'), function () {
                subjectgrade2.push($(this).val());
            });


            for (var i = 0; i < subjectid.length; i++) {
                var data = {
                    "subject": parseInt(subjectid[i]),
                    "grade": subjectgrade[i]
                };
                subjectgradelist.push(data);
            }


            for (var i = 0; i < subjectid2.length; i++) {
                var data = {
                    "subject": parseInt(subjectid2[i]),
                    "grade": subjectgrade2[i]
                };
                subjectgradelist2.push(data);
            }


            myData[0] = {
                "ResultName": $('#ResultName').val(),
                "ExamNumber": $('#ExamNumber').val(),
                "ExaminationCenter": $('#ExaminationCenter').val(),
                "Year": $('#Year').val(),
                "SubjectGrades": subjectgradelist,
                "MaximumCount": '9'
            };
            if (secondSitting) {
                myData[1] = {
                    "ResultName": $('#ResultName2').val(),
                    "ExamNumber": $('#ExamNumber2').val(),
                    "ExaminationCenter": $('#ExaminationCenter2').val(),
                    "Year": $('#Year2').val(),
                    "SubjectGrades": subjectgradelist2,
                    "MaximumCount": '9'
                };
            }


            var Mydata = JSON.stringify(myData);
            //alert(Mydata);
            $.ajax({
                contentType: 'application/json',
                type: "POST",
                url: "/ApplicantOLevelResults/Save",
                data: Mydata,
                success: function (data) {
                    if (data.status) {
                        swal({
                            title: "Result saved successfully",
                            //text: "Do you  Proceed?..",
                            type: "warning",
                            showCancelButton: true,
                            confirmButtonColor: "#ab973a",
                            confirmButtonText: "Proceed!",
                            //cancelButtonText: "No, See Result List!",
                            closeOnConfirm: false,
                            closeOnCancel: false
                        },
                            function (isConfirm) {
                                if (isConfirm) {
                                    swal("Great!", "Proceed!!!.", "success");
                                    $("#nextKin").click();
                                } else {
                                    swal("Great", "You can click the next button to proceed", "success");
                                    goNextStudentPassport();
                                    //window.open('@Url.Action("Index", "ApplicantOLevelResults")', '_self');

                                }
                            });
                        toastr["success"](data.message);
                    } else {
                        swal({
                            title: "Warning",
                            text: data.message,
                            type: "warning",
                        });
                        toastr["success"](data.message);
                    }
                }
            });
        });

    });

    function remove_button(elem) {
        if (count > 1) {
            $(elem).closest('div').remove();
            count--;
        }
    }

    function remove_button2(elem) {
        if (count2 > 1) {
            $(elem).closest('div').remove();
            count2--;
        }
    }
    function goNextStudentPassport() {
        $("#nextKin").click();
    }
    $("#btnlevelNext2").click(function () {
        $("#nextKin").click();
    });

    $("#btnolevelPrevious").click(function () {
        $("#biodata").click();
    });

</script>



