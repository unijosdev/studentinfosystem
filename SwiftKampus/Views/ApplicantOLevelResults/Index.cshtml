@model IEnumerable<SwiftKampusModel.AddmissionApplicant.ApplicantOLevelResult>

@{
    ViewBag.Title = "O-Level Results";
}


<div class="container-fluid">
    <div class="wrapper wrapper-content animated fadeInRight">
        <div class="row">
            <div class="col-lg-12">
                <div class="ibox float-e-margins">
                    <div class="ibox-title">
                        <h5>List of O-Level Result</h5>

                        <div class="ibox-tools">
                            <a href="@Url.Action("Create","ApplicantOLevelResults")" class="btn btn-primary"> <i class="fa fa-plus left"></i> ADD O-LEVEL RESULT</a>

                            <a class="collapse-link">
                                <i class="fa fa-chevron-up"></i>
                            </a>
                        </div>
                    </div>
                    <div class="ibox-content">
                        <table class=" table table-responsive">
                            <tr>
                                <th>
                                    @Html.DisplayNameFor(model => model.ResultName)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Subject.CourseName)
                                </th>

                                <th>
                                    @Html.DisplayNameFor(model => model.SubjectGrade)
                                </th>
                                @*<th>
                                    @Html.DisplayNameFor(model => model.ExaminationCenter)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Year)
                                </th>*@
                                <th></th>
                            </tr>

                            @foreach (var item in Model)
                            {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.ResultName)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Subject.CourseCode)
                                </td>

                                <td>
                                    @Html.DisplayFor(modelItem => item.SubjectGrade)
                                </td>
                                @*<td>
                                    @Html.DisplayFor(modelItem => item.ExaminationCenter)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Year)
                                </td>*@
                                <td>
                                    @Html.ActionLink("Remove", "Edit", new { id = item.ApplicantOLevelResultId })
                                </td>
                            </tr>
                            }

                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
