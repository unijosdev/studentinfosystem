
@{
    /**/

    ViewBag.Title = "Previous Course Reg";
}


<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>Previous Course Reg </h5>
                    <div class="ibox-tools">

                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                        <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                            <i class="fa fa-wrench"></i>
                        </a>

                    </div>
                </div>
                <div class="ibox-content">
                    <article class="margin-bottom-xxl">
                        <p class="lead">
                            Please use the following parameters to get courses for student
                        </p>
                    </article>
                    <div class="card-body">
                        @using (Html.BeginForm("AdminEdit", "ApplicantOLevelResults", FormMethod.Get))
                        {
                            <div class="row">
                                <div class="col-sm-5">
                                    <div class="form-group">
                                        <label for="email"><strong>Email</strong></label>
                                        <input id="MatNum" name="MatNum" class="form-control" type="text" required placeholder=" student's Email" />
                                        @*@Html.DropDownList("SchoolProgrammeId", null, htmlAttributes: new { @class = "form-control js-example-basic-single" })*@
                                    </div>
                                </div>

                            </div>

                            <div class="row">
                                <div class="col-sm-3">
                                    <div class="col-md-12">
                                        <br />
                                        <input type="submit" value="Send" class="btn btn-primary btn-lg" />
                                    </div>

                                </div>

                            </div>
                        }
                    </div><!--end .row -->

                </div>

            </div>
        </div>
    </div>
</div>


