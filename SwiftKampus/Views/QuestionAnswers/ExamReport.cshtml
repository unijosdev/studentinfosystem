@model IEnumerable<SwiftKampus.ViewModels.ExamsLogVm>

@{
    ViewBag.Title = "Departmental Cleareance";
}
<link href="~/AdminTemplate/css/plugins/sweetalert/sweetalert.css" rel="stylesheet">


<div class="container-fluid">
    <!-- First row -->
    <div class="row">
        <!-- First column -->
        <div class="col-md-12">
            <form id="formFilter" onsubmit="return false;" class="col-md-12">
                <div class="wrapper wrapper-content animated fadeInRight">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="ibox float-e-margins">
                                <div class="ibox-title">
                                    <h5>List of Uncleared Students</h5>
                                    <div class="ibox-tools">
                                        @if (ViewBag.Message != null)
                                        {
                                            <div class="alert alert-success">
                                                <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
                                                <strong>@ViewBag.Message</strong>
                                            </div>
                                        }

                                        <a class="collapse-link">
                                            <i class="fa fa-chevron-up"></i>
                                        </a>
                                        <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                                            <i class="fa fa-wrench"></i>
                                        </a>
                                    </div>
                                    <div class="ibox-content">
                                        <article class="margin-bottom-xxl">
                                            <p class="lead">
                                                Please use the following parameters to perform Query
                                            </p>
                                        </article>
                                        <div class="card-body">
                                            <div class="row form-inline">
                                                <div class="col-sm-6">
                                                    <div class="col-md-12">
                                                        <div class="form-group">
                                                            <label>School Programme</label>
                                                            @Html.DropDownList("CoursesId", (SelectList)ViewBag.Courses, null, new { @class = "form-control" })
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="col-sm-3">
                                                    <div class="form-group">
                                                        <label class="col-sm-12">Admitted Session</label>
                                                        @Html.DropDownList("SessionId", (SelectList)ViewBag.SessionId, "", new { @class = "form-control js-example-basic-single", @onchange = "getProgrammeList()" })
                                                    </div>
                                                </div>

                                                <div class="col-sm-3">
                                                    <div class="form-group">
                                                        <label class="col-sm-12"> Clearance Status</label>
                                                        <select class="form-control dropdown" id="hasRegistered" name="hasRegistered">
                                                            <option>UnCleared</option>
                                                            <option>Cleared</option>
                                                        </select>
                                                    </div>
                                                </div>

                                                <div class="col-sm-2">
                                                    <div class="col-sm-12">
                                                        <br />
                                                        <button type="submit" id="btn-search" class="btn btn-primary">Search/View</button>

                                                    </div>
                                                </div>
                                            </div>


                                        </div><!--end .row -->

                                    </div>
                                </div>


                                <div class="ibox-content">
                                    <div class="table-responsive">
                                        <table id="Jdatatable" class="table table-striped table-bordered table-hover table-responsive dataTables-example">
                                            <thead>
                                                <tr>
                                                    <th>Matric No</th>
                                                    <th> Full Name</th>
                                                    <th> Course </th>
                                                    <th> Total Score</th>
                                                    <th> Score</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </form>

        </div>

        <!-- /.First column -->

    </div>
    <!-- /.First row -->
</div>


<!-- Modal -->
<div class="modal fade inmodal" id="actionsList" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <!--Content-->
        <div class="modal-content animated">
            <!--Header-->
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <div class="flex-center">
                    <h4 class="modal-title">STUDENT</h4>
                </div>
            </div>
            <!--Body-->
            <div class="modal-body" id="myModalDivBody">
            </div>
        </div>
        <!--/.Content-->
    </div>
</div>
<!-- /.Modal-->

<script src="~/Scripts/jquery-3.1.1.min.js"></script>
<script src="~/AdminTemplate/js/plugins/sweetalert/sweetalert.min.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        window.oTable = $("#Jdatatable").DataTable({
            "processing": true, // for show progress bar while loading
            //"serverSide": true, // if it is true the preocess is done on server side
            "filter": true, // disables search box
            "info": true,

            "stateSave": true,
            "orderMulti": false, // disable multiple column loading at once
            "ajax": {
                "url": "/QuestionAnswers/GetStudentsQuestionAnswer",
                "type": "POST",
                "datatype": "json",
                //"data": function (d) {
                //    d.SchoolProgrammeId = $('#SchoolProgrammeId').val();
                //}
                "data": function (d) {
                    return $('#formFilter').serialize();
                },
            },
            "columns": [
                { "data": "MatricNumber", "autoWidth": true, "orderable": true },
                { "data": "FullName", "autoWidth": true, "orderable": true },
                { "data": "CourseName", "autoWidth": true },
                { "data": "TotalScore", "autoWidth": true },
                { "data": "Score", "autoWidth": true },
                {
                    "data": "ExamLogId",
                    "autoWidth": true,
                    "render": function (data) {
                        return '<a href="#" onclick="Detail(\'' + data + '\')" data-toggle="tooltip" data-placement="top" title="View Details"><i class="fa fa-info-circle" aria-hidden="true">Details&nbsp;&nbsp;</i></a>' +
                            '<a href="#" onclick="ClearStudent(\'' + data + '\')" data-toggle="tooltip" data-placement="top" title="Clear Student Now"><i class="fa fa-pencil" aria-hidden="true"></i>Remove</a>';
                    }
                }
            ],
            dom: '<"html5buttons"B>lTfgitp',
            buttons: [
                { extend: 'copy' },
                { extend: 'csv' },
                { extend: 'excel', title: 'FacultyList' },
                { extend: 'pdf', title: 'FacultyList' },

                {
                    extend: 'print',
                    customize: function (win) {
                        $(win.document.body).addClass('white-bg');
                        $(win.document.body).css('font-size', '10px');

                        $(win.document.body).find('table')
                            .addClass('compact')
                            .css('font-size', 'inherit');
                    }
                }
            ]
        });
        window.oTable.fnSort([[1, "asc"], [2, "desc"]]);

    });

    $(window).scroll(function () {
        $("#mydetailBody").stop().animate({ "marginTop": ($(window).scrollTop()) + "px", "marginLeft": ($(window).scrollLeft()) + "px" }, "slow");
    });

    $("#btn-search").click(function () {
        window.oTable.ajax.reload();

    });

    function ClearStudent(studentId) {
        swal({
            title: "Student Clearance",
            text: "Are you sure you want to clear this student?..",
            type: "warning",
            showCancelButton: true,
            confirmButtonColor: "#ab973a",
            confirmButtonText: "Yes, Clear Student Now!",
            cancelButtonText: "No, Reject Student!",
            closeOnConfirm: false,
            closeOnCancel: false
        },
            function (isConfirm) {
                if (isConfirm) {
                    var AllData = {
                        "id": studentId,
                    };
                    var Mydata = JSON.stringify(AllData);

                    $.ajax({
                        contentType: 'application/json',
                        type: "POST",
                        url: "/QuestionAnswers/flagExam?id=" + studentId,
                        data: Mydata,
                        success: function (data) {
                            if (data.status) {
                                swal({
                                    title: "Great",
                                    text: data.message,
                                    type: "success",
                                });
                                window.oTable.ajax.reload(); //run my_fun() ondomready
                                toastr["success"](data.message);
                            } else {
                                swal({
                                    title: "Warning",
                                    text: data.message,
                                    type: "warning",
                                });
                                toastr["error"](data.message);
                            }

                        }
                    });
                    //swal("Great!", "Student has been cleared Successfully.", "success");
                } else {

                    RejectStudent(studentId);
                    swal("Oops", "Please type in reason why the student is rejected", "warning");
                }
            });
    };
    function RejectStudent(studentId) {
        var url = "/Students/RejectStudent?studentId=" + studentId + "&level=Department";
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
    };


    function Detail(studentId) {
        var url = "/QuestionAnswers/ExamFullDetail?id=" + studentId;
        window.open(url, '_blank');
    };



</script>