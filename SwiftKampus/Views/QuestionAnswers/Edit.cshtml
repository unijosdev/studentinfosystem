@model SwiftKampus.ViewModels.CBTE.QuestionAnswerVm

@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";

    <script>
        tinymce.init({
            selector: '#ckeditor'
        });

        tinymce.init({
            selector: '#Option1'
        });
        tinymce.init({
            selector: '#Option2'
        });
        tinymce.init({
            selector: '#Option3'
        });
        tinymce.init({
            selector: '#Option4'
        });
        tinymce.init({
            selector: '#Option5'
        });
        tinymce.init({
            selector: '#Answer'
        });
    </script>
}

<h2>Edit</h2>


