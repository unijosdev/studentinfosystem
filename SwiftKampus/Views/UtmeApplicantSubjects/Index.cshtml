@model IEnumerable<SwiftKampusModel.AddmissionApplicant.UtmeApplicantSubject>

@{
    ViewBag.Title = "Index";
}



<!-- Modal -->
<div class="modal fade modal-bf-fh" id="actionsList" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <!--Content-->
        <div class="modal-content">
            <!--Header-->
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <div class="flex-center">
                    <h4 class="modal-title">UTME SUBJECTS</h4>
                    @*<a class="btn btn-primary btn-sm">Create new action</a>*@
                </div>
            </div>
            <!--Body-->
            <div class="modal-body" id="myModalDivBody">
            </div>
        </div>
        <!--/.Content-->
    </div>
</div>
<!-- /.Modal-->
<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>List of Utme Subjects</h5>
                    <div class="ibox-tools">
                        <a href="#" onclick="myFunction()" class="btn btn-primary "><i class="fa fa-plus left"></i> ADD UTME SUBJECTS</a>
                        <a href="#" onclick="ExcelUpload()" class="btn btn-primary"><i class="fa fa-file-excel-o left"></i> UPLOAD UTME SUBJECTS</a>

                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                        <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                            <i class="fa fa-wrench"></i>
                        </a>

                    </div>
                    <div class="ibox-content">
                        <article class="margin-bottom-xxl">
                            <p class="lead">
                                Please use the following parameters to perform Query
                            </p>
                        </article>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label>Session Name</label>
                                        @Html.DropDownList("SessionId", null, htmlAttributes: new { @class = "form-control" })
                                    </div>
                                </div>
                               

                                <div class="col-md-1">
                                    <br />
                                    <button type="submit" id="btn-search" class="btn btn-primary">Search/View</button>                                    
                                </div>

                            </div>
                        </div><!--end .row -->

                    </div>
                </div>
                <div class="ibox-content">

                    <div class="table-responsive">
                        <table id="Jdatatable" class="table table-striped table-bordered table-hover table-responsive dataTables-example">
                            <thead>
                                <tr>
                                    <th>Jamb Reg No</th>
                                    <th>Subject Name</th>
                                    <th>Score</th>                                    
                                    <th>Action</th>
                                </tr>
                            </thead>
                        </table>

                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/Scripts/jquery-3.1.1.min.js"></script>

<script type="text/javascript">
    $(document).ready(function () {

        window.oTable = $("#Jdatatable").DataTable({
            "processing": true, // for show progress bar while loading
            "serverSide": true, // if it is true the preocess is done on server side
            "filter": true, // disables search box
            "info": true,

            "stateSave": true,
            "orderMulti": false, // disable multiple column loading at once
            "ajax": {
                "url": "/UtmeApplicantSubjects/GetIndex",
                "type": "POST",
                "datatype": "json",
                "data": function (d) {                   
                    d.SessionId = $('#SessionId').val();
                }
            },
            "columns": [
                { "data": "JambRegNo", "autoWidth": true },
                { "data": "SubjectName", "autoWidth": true },
                { "data": "Score", "autoWidth": true },
                {
                    "data": "UtmeApplicantSubjectId",
                    "autoWidth": true,
                    "render": function (data) {
                        return '<a href="#" data-toggle="modal" data-target="#actionsList" onclick="Edit(' + data + ')" >  <i class="fa fa-pencil" aria-hidden="true" >&nbsp;Edit</i></a>&nbsp;&nbsp;' +
                            '<a href="#" class="text-danger" data-toggle="modal" data-target="#actionsList"  onclick="Delete(' + data + ')" ><i class="fa fa-remove" aria-hidden="true" >&nbsp;Remove<i /></a>';
                    }
                }

                //{ "data": "EmailID", "autoWidth": true },
                //{ "data": "Phone", "autoWidth": true },
            ]
        });

    });

      $("#btn-search").click(function () {
        window.oTable.ajax.reload();

    });
    function Edit(blockId) {
        var url = "/UtmeApplicantSubjects/Save?id=" + blockId;
        $('#myModal').appendTo("body").modal('show');
        //window.alert(url);
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal('show');
            });
    };
    function Delete(blockId) {
        var url = "/UtmeApplicantSubjects/Delete?id=" + blockId;

        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
    };
    function myFunction() {
        var url = "/UtmeApplicantSubjects/Save?id=0";
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
    };

    function ExcelUpload() {
        var url = "/UtmeApplicantSubjects/UploadUtmeSubjects";
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
    };
</script>
