    $("#btn-search").click(function () {
        window.oTable.ajax.reload();
    });

    //$("#btn-download").click(function () {
    //    var schoolProgramme = $('#SchoolProgrammeId').val();
    //    var courseId = $('#CourseId').val();
    //    var url = "/ContinuousAssessments/DownloadCaReport?SchoolProgrammeId=" + schoolProgramme + "&CourseId=" + courseId;
    //    window.open('' + url + '', '_blank');
    //});

    function Edit(facultyId) {
        var url = "/ContinuousAssessments/Save?id=0" + facultyId;
        //$('#actionsList').modal("show");
        // window.alert(url);
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
    };
    function Delete(facultyId) {
        var url = "/ContinuousAssessments/Delete?id=" + facultyId;

        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
    };
    function myFunction() {
        var url = "/ContinuousAssessments/CreateCaView";
        window.open('@Url.Action("CreateCaView", "ContinuousAssessments")', '_self');
    };
    function excelUpload() {
        var url = "/ContinuousAssessments/UploadResult";
        $('#myModalDivBody').load(url,
            function () {
                $('#actionsList').modal("show");
            });
    };

    function getMedResultCategory() {
        var levelId = $("#LevelId").val();
        $.ajax
            ({
                url: '/MedContiniousAssesments/GetMedResultCategory?codeId=' + levelId,
                type: 'GET',
                datatype: 'application/json',
                contentType: 'application/json',
                success: function (result) {
                    $("#MedResultCategoryId").html("");
                    $.each($.parseJSON(result),
                        function (i, city) {
                            $("#MedResultCategoryId").append($('<option></option>').val(city.MedResultCategoryId).html(city.CategoryName));
                        });

                },
                error: function () {
                    alert("Whooaaa! Something went wrong..");
                }
            });
    }
   
    function getMedResultCas() {
        var medResultCategoryId = $("#MedResultCategoryId").val();
        $.ajax
            ({
                url: '/MedContiniousAssesments/GetMedResultCas?codeId=' + medResultCategoryId,
                type: 'GET',
                datatype: 'application/json',
                contentType: 'application/json',
                success: function (result) {
                    $("#MedResultCaId").html("");
                    $.each($.parseJSON(result),
                        function (i, city) {
                            $("#MedResultCaId").append($('<option></option>').val(city.MedResultCaId).html(city.ResultCaName));
                        });

                },
                error: function () {
                    alert("Whooaaa! Something went wrong..");
                }
            });
    }
</script>
