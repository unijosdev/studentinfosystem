
@{
    ViewBag.Title = "Search Assessment";
}

<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>List of Continuous Assessment </h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                        <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                            <i class="fa fa-wrench"></i>
                        </a>

                    </div>
                    <div class="ibox-content">
                        <article class="margin-bottom-xxl">
                            <p class="lead">
                                Please use the following parameters to perform Query
                            </p>
                        </article>
                        <div class="card-body">
                            <form class="form-inline" id="formFilter" onsubmit="return false;">
                                <div class="row">
                                    <div class="col-md-2">
                                        <div class="form-group">
                                            <label>Session Name</label>
                                            @Html.DropDownList("SessionId", (SelectList)ViewBag.SessionId, "", new { @class = "form-control" })
                                        </div>
                                    </div>
                                    <div class="col-md-1">
                                        <div class="form-group">
                                            <label>Level Name</label>
                                            @Html.DropDownList("LevelId", (SelectList)ViewBag.LevelId, "", new { @class = "form-control", @onchange = "getMedResultCategory()" })
                                        </div>
                                    </div>

                                    <div class="col-md-3">
                                        <div class="form-group">
                                            <label>Category</label>
                                            @Html.DropDownList("MedResultCategoryId", (SelectList)ViewBag.MedResultCategoryId, "", new { @class = "form-control", @onchange = "getMedResultCas()" })
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <label>Course</label>
                                            @Html.DropDownList("MedResultCaId", (SelectList)ViewBag.MedResultCaId, "", new { @class = "form-control" })
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <button type="submit" id="btn-search" class="btn btn-primary">Search/View</button>
                                        <br />
                                        <span><button type="submit" id="btn-download" class="btn btn-primary">Download</button></span>
                                    </div>

                                </div>

                            </form>
                        </div><!--end .row -->

                    </div>
                </div>
                <div class="ibox-content">
                    <div class="table-responsive">
                        <table id="Jdatatable" class="table table-striped table-bordered table-hover table-responsive dataTables-example">
                            <thead>
                                <tr>
                                    <th>Student Id</th>
                                    <th>Full Name</th>
                                    <th>Result Name</th>
                                    <th>Session Name</th>
                                    <th>Score</th>
                                    <th>Attendance</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


    
<script src="~/Scripts/jquery-3.1.1.min.js"></script>

